    <add key="UseNewTransactionEntryScreen" value="false" />
    <add key="aspnet:MaxJsonDeserializerMembers" value="150000" />
    <add key="LoggerLogDir" value="C:\Program Files (x86)\FuelsManager\ErrorLogging" />
    <add key="autoFormsAuthentication" value="false" />
    <add key="enableSimpleMembership" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ShowIventoryManagementStatisticsPage" value="true" />
