    <add key="EnterpriseManagementEndPointAddress" value="https://1552-DEV-CKENTW.1552-qa-svr.varec.com/FMEnterpriseManagementProxyServices/ServiceClasses" />
    <add key="EnterpriseManagementBehaviorName" value="EnterpriseManagementBehavior" />
    <add key="syncServiceBindingType" value="netTcpBinding" />
