    <client>
      <endpoint address="https://win-i4rs9s3rsug/FuelsManager/FMDataExchange/ExchangeService.svc" binding="customBinding" bindingConfiguration="CustomBinding_IExchangeService" contract="ExchangeService.IExchangeService" name="CustomBinding_IExchangeService" behaviorConfiguration="MessageCertBehavior">
