      <remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
      <remove name="OPTIONSVerbHandler"/>
      <remove name="TRACEVerbHandler"/>
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
    </handlers>
    <directoryBrowse enabled="false"/>
    <defaultDocument>
      <files>
        <clear/>
        <add value="PostWarning.htm"/>
        <add value=" Default.asp"/>
        <add value=" Default.htm"/>
      </files>
    </defaultDocument>
    <httpErrors>
      <clear/>
    </httpErrors>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="100000000"/>
      </requestFiltering>
    </security>
  </system.webServer>
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel" switchValue="Information, ActivityTracing" propagateActivity="true">
        <listeners>
          <add name="traceListener" type="System.Diagnostics.XmlWriterTraceListener" initializeData="c:\log\Traces.svclog"/>
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
  <!-- this section is used by the web application for custom settings -->
  <appSettings file="fuelsmanager.config">
    <!-- Do not change the Accounting/TransactionDetail.aspx value. For other projects -->
    <!-- such as BSME the contain in the fuelsmanager.config file which is project -->
    <!-- specific will override the value with the appropriate value. -->
    <add key="AccountingTransactionDetailURL" value="Accounting/TransactionDetail.aspx"/>
    <!-- Use the fuelsmanager.config file to override any of these values.  You do not have to  -->
    <!-- override each value.  Also, the product will work just fine if the fuelsmanager.config -->
    <!-- does not exist in the application directory.  It will use it, however, if the file     -->
    <!-- is present (Kendall) -->
    <add key="ContactUsLink" value="http://www.varec.com/contact-us.html"/>
    <add key="SupportLink" value="http://www.varec.com/services/techsupport.html"/>
    <add key="PrivacyLink" value="http://www.varec.com/privacy.html"/>
    <add key="CopyrightLink" value="http://www.varec.com/copyright.html"/>
    <!--  These values are used by default.aspx to display a warning banner.  If they are empty,
      no banner page will display. 
  -->
    <add key="WarningTitle" value=""/>
    <add key="WarningText" value=""/>
    <!--  Glossary file name - should point to an HTML file with prepared bookmarks to aliased
      transaction field names.  Paths are relative to the Accounting web app folder.
  -->
    <add key="TransactionGlossaryFile" value=""/>
    <!--  The maximum rows for logs setting is to set a threshold for warning messages on the 
      Alarm & Event log and the Audit log.  Zero means no limit.  Override in the fuelsmanager.config
      file
  -->
    <add key="MaximumNumberOfRowsForLogs" value="0"/>
    <add key="ThreshholdPercentageForLogs" value="100"/>
    <!-- This section contains keys for turning off certain tree views for webapps rolled into the FuelsManager DLL -->
    <add key="SupressInvoiceWebAppMenu" value="false"/>
    <add key="LoginPageSplashImage" value="images/splash_box_v1.jpg"/>
    <add key="LoginPageBackgroundColor" value="#0D256B"/>
    <add key="PageBannerImage" value="images\Page_banner_7.jpg"/>
    <add key="WarningPageImage" value="FMWebApp\\images\\Warn_Box_7.jpg"/>
    <add key="PageFadeImage" value="..\FMWebApp\images\Page_Fade_Blank.bmp"/>
    <add key="ColorHeaderBlue" value="861290"/>
    <add key="ColorDarkBlue" value="190"/>
    <add key="Defaultlimit" value="1500"/>
    <add key="FuelCardlimit" value="1500"/>
    <add key="Equipmentlimit" value="20"/>
    <add key="Companylimit" value="1500"/>
    <add key="Productlimit" value="15"/>
    <add key="Personlimit" value="1500"/>
    <add key="StandingOfferlimit" value="50"/>
    <add key="EndOfMonthReportName" value="TestReport.rdl"/>
    <add key="EndOfMonthReportNameTitle" value="TestReport.rdl"/>
    <!-- Settings for binding to the FMBusinessServices WCF Service -->
    <!-- AZURE-->
    <add key="bindingName" value="NetTcpBindingAzure"/>
    <add key="endPointAddress" value="net.tcp://localhost:9500"/>

    <add key="syncServiceBindingType" value="netTcpBinding"/>
    <add key="syncServiceBindingConfiguration" value="NetTcpBindingSyncService"/>
    <add key="syncServiceBindingEndPointAddress" value="net.tcp://localhost:8523/FMSynchronizationService"/>
    <add key="LoggerDebugFlag" value="false"/>
    <add key="LoggerInfoFlag" value="false"/>
    <add key="LoggerPerformanceFlag" value="false"/>
    <add key="LoggerWarnFlag" value="true"/>
    <add key="LoggerErrorFlag" value="true"/>
    <add key="LoggerCriticalFlag" value="true"/>
    <add key="LoggerLogDir" value="C:\Program Files\FuelsManager\ErrorLogging"/>
    <add key="EnablePerformanceLogging" value="false"/>
    <add key="PerformanceLoggingThresholdMilliseconds" value="4000"/>
  </appSettings>
  <applicationSettings>
    <FuelsManager.Properties.Settings>
      <setting name="FuelsManager_AccountingImportService_ImportService" serializeAs="String">
        <value>http://localhost/AccountingImportExport/ImportService.asmx</value>
      </setting>
      <setting name="FuelsManager_ReportSrv2005_ReportingService2005" serializeAs="String">
        <value>http://localhost/ReportServer/ReportService2005.asmx</value>
      </setting>
    </FuelsManager.Properties.Settings>
  </applicationSettings>
  <dataCacheClients>
