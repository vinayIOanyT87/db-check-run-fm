                                                <span id="ck-p-access-display_DistributedImpact" class="ignore-click"></span>
                                            </label>
                                        </span>
                                    </div>
                                </div>
                                <div id="BulkShipmentOption" class="form-group col-sm-4 col-md-4">
                                    <div class="list-group-item2">
                                        <span class="TransactionAliasCheckboxName" title="@FMBaseController.TranslateText("Bulk Shipment")">@FMBaseController.TranslateText("Bulk Shipment")</span>
                                        <span class="TransactionAliasCheckboxes">
                                            <label class="ignore-click ta-checkbox-group">
                                                <input class="ignore-click" id="BulkShipment" name="BulkShipment" type="checkbox" value="@Model.BulkShipment.ToString()" @(Model.BulkShipment ? "checked" : "") hidden="hidden" @ModifyDisable />
                                                <span id="ck-p-access-display_BulkShipment" class="ignore-click"></span>
                                            </label>
                                        </span>
                                    </div>
                                </div>
                                <div id="UseComboxControlsOption" class="form-group col-sm-4 col-md-4">
                                    <div class="list-group-item2">
                                        <span class="TransactionAliasCheckboxName" title="@FMBaseController.TranslateText("Use Combo Box Controls")">@FMBaseController.TranslateText("Use Combo Box Controls")</span>
                                        <span class="TransactionAliasCheckboxes">
                                            <label class="ignore-click ta-checkbox-group">
                                                <input class="ignore-click" id="UseComboxControls" name="UseComboxControls" type="checkbox" value="@Model.UseComboxControls.ToString()" @(Model.UseComboxControls ? "checked" : "") hidden="hidden" @ModifyDisable />
                                                <span id="ck-p-access-display_UseComboxControls" class="ignore-click"></span>
                                            </label>
                                        </span>
                                    </div>
                                </div>
                                <div id="MultipleWeightReadingsOption" class="form-group col-sm-4 col-md-4">
                                    <div class="list-group-item2">
                                        <span class="TransactionAliasCheckboxName" title="@FMBaseController.TranslateText("Multiple Weight Readings")">@FMBaseController.TranslateText("Multiple Weight Readings")</span>
                                        <span class="TransactionAliasCheckboxes">
                                            <label class="ignore-click ta-checkbox-group">
                                                <input class="ignore-click" id="MultipleWeightReadings" name="MultipleWeightReadings" type="checkbox" value="@Model.MultipleWeightReadings.ToString()" @(Model.MultipleWeightReadings ? "checked" : "") hidden="hidden" @ModifyDisable />
                                                <span id="ck-p-access-display_MultipleWeightReadings" class="ignore-click"></span>
                                            </label>
                                        </span>
                                    </div>
                                </div>
                                <div id="MultipleLineItemsOption" class="form-group col-sm-4 col-md-4">
                                    <div class="list-group-item2">
                                        <span class="TransactionAliasCheckboxName" title="@FMBaseController.TranslateText("Multiple Line Items")">@FMBaseController.TranslateText("Multiple Line Items")</span>
                                        <span class="TransactionAliasCheckboxes">
                                            <label class="ignore-click ta-checkbox-group">
                                                <input class="ignore-click" id="MultipleLineItems" name="MultipleLineItems" type="checkbox" value="@Model.MultipleLineItems.ToString()" @(Model.MultipleLineItems ? "checked" : "") hidden="hidden" @ModifyDisable />
                                                <span id="ck-p-access-display_MultipleLineItems" class="ignore-click"></span>
                                            </label>
