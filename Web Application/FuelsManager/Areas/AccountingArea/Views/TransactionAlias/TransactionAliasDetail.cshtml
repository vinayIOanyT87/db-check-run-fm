<!DOCTYPE html>
<style>
    input[type="checkbox"][disabled="disabled"] + span::before, .setting-radio-control[disabled] {
        background-color: transparent;
        cursor: not-allowed;
    }

    button[disabled] img:hover {
        cursor: not-allowed !important;
    }

    .product-delete[disabled], .status-delete[disabled], .usergroup-delete[disabled]:hover {
        cursor: not-allowed !important;
        pointer-events: none;
    }
    .alwaysselected {
        opacity: .65;
    }
</style>
<script>
</script>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Transaction Alias</title>

</head>
<body style="overflow-y: hidden">

    @{
        var numberFormatInfo = new NumberFormatInfo { NumberGroupSizes = Model.Site.GetNumberGroupSizes(), NumberGroupSeparator = Model.Site.NumberGroupSeparator, NumberDecimalSeparator = Model.Site.NumberDecimalSeparator };

        //Generate FormatInfo JavaScript object in JSON format
        var numberFormatInfoString = String.Format("{{{0}" + "\"NegativeSign\":\"{1}\",{0}" + "\"NumberDecimalDigits\":{2},{0}" + "\"NumberDecimalSeparator\":\"{3}\",{0}" + "\"NumberGroupSeparator\":\"{4}\",{0}" + "\"NumberGroupSizes\":{5},{0}" + "\"NumberNegativePattern\":{6},{0}" + "\"ShortDatePattern\":\"{7}\"{0},{0}" + "\"TimePattern\":\"{8}\"{0}}}", Environment.NewLine, "-", numberFormatInfo.NumberDecimalDigits, Model.Site.NumberDecimalSeparator, Model.Site.NumberGroupSeparator, Model.Site.GetNumberGroupSizes()[0], 1, Model.Site.ShortDatePattern, Model.Site.TimePattern);
        var ApplyButtonDisable = (Model.ModifyEnabled) ? "" : "disabled = 'disabled'";
        var ApplyButtonCursor = (Model.ModifyEnabled) ? "" : "cursor: not-allowed !important;";
        var ModifyDisable = (Model.ModifyEnabled) ? "" : "disabled = disabled";
        var buttonClass = (Model.ModifyEnabled) ? "btn-setting" : "btn-setting disabled";
        var applyButton = @FMBaseController.TranslateText("&Apply");
        var cancelButton = @FMBaseController.TranslateText("&Cancel");
        var okButton = @FMBaseController.TranslateText("&Ok");
        var selectAllButton = @FMBaseController.TranslateText("&Select All");
    }
    @Html.Hidden("urlGetAllEquipmentTypesURL", @Url.Action("GetAllEquipmentTypes", "TransactionAlias"))
    @Html.Hidden("urlGetAllReportsURL", @Url.Action("GetAllReports", "TransactionAlias"))
    @Html.Hidden("EditRightMessage", @FMBaseController.TranslateText("Can Edit Transactions"))
    @Html.Hidden("NoEditRightMessage", @FMBaseController.TranslateText("CANNOT edit transactions"))

    <div class="container-fluid">
        <div id="TransactionAliasMenu" class="row">
            <div id="TransactionAliasTitle" class="col-lg-4 col-md-4">
                <div id="TransactionAliasImageContainer">
                    <img id="TransactionAliasImage" src="~/fmwebapp/images/transaction alias.png" />
                </div>
                <h2 id="TransactionAliasTitleLabel" class="title">@Model.Name</h2>
            </div>
            <ul id="TAMenuItems" class="list-inline col-lg-6 col-md-6">
                <li id="TAGeneral" class="TransactionAliasMenuItem selected"><span><img /></span>@FMBaseController.TranslateText("General")</li>
                <li id="TAFields" class="TransactionAliasMenuItem"><span><img /></span>@FMBaseController.TranslateText("Fields")</li>
                <li id="TALayout" class="TransactionAliasMenuItem"><span><img /></span>@FMBaseController.TranslateText("Layout")</li>
            </ul>

            <div style="position: absolute; right: 55px; padding-top: 5px; padding-bottom: 5px">
                <button id="CancelButtonId" type="submit" onclick="CancelButtonOnClick() " class="pushButton"
                        style="width: 140px; @ApplyButtonCursor" @ApplyButtonDisable>
                    @FMBaseController.TranslateText("Cancel")
                </button>
                <button id="ApplyButtonId" type="submit" onclick="ApplyButtonOnClick() " class="pushButton"
                        style="width: 140px; @ApplyButtonCursor" @ApplyButtonDisable>
                    @FMBaseController.TranslateText("Apply")
                </button>
            </div>
        </div>
        <div class="row">
            @using (Html.BeginForm("TransactionAliasEdit", "TransactionAlias", FormMethod.Post, new { @class = "", @id = "transactionAliasForm" }))
            {
                @Html.HiddenFor(model => model.IdentityGuid)
                @Html.HiddenFor(model => model.SiteGuid)
                @Html.Hidden("ModifyEnabled", (Model.ModifyEnabled))

                @Html.AntiForgeryToken()

                <section id="TADetailHolder" class="PESection">
                    <div id="SettingDivScroll" class="table" style="height: calc(100vh - 80px)">
                        <div id="TALeftPanelSettings" class="col-sm-9 col-md-9">
                            <span class="separator-label">@FMBaseController.TranslateText("DETAILS")</span>
                            <div class="row">
                                <div class="form-group col-sm-6 col-md-6">
                                    @Html.LabelFor(m => m.Name, @FMBaseController.TranslateText("Name"), new { @class = "control-label" })
                                    @Html.TextBoxFor(m => m.Name, (Model.ModifyEnabled) ? (object)new { id = "AliasID", @class = "form-control input-md", maxlength = 30 } : new { id = "AliasID", @class = "form-control input-md", maxlength = 30, @readonly = "readonly" })
                                </div>
                                <div id="UseTransactionDetailWithLayout" class="form-group col-sm-6 col-md-6" data-display="boolean">
                                    <label class="control-label" for="UseTransactionDetailWithLayout">Transaction Detail Form</label>
                                    <div class="control-group transaction-detail-selection">
                                        <label class="setting-radio-control setting-radio-control--radio pull-left" @ModifyDisable>
                                            @FMBaseController.TranslateText("Use Old Transaction Detail")
                                            <input type="radio" name="UseTransactionDetailWithLayout" value="false" @ModifyDisable @{if (!@Model.UseTransactionDetailWithLayout) { <text> checked="checked" </text>  } } />
                                            <div class="setting-radio-control__indicator" ></div>
                                        </label>
                                        <label class="setting-radio-control setting-radio-control--radio pull-right" @ModifyDisable>
                                            @FMBaseController.TranslateText("Use New Transaction Detail")
                                            <input type="radio" name="UseTransactionDetailWithLayout" value="true" @ModifyDisable @{if (@Model.UseTransactionDetailWithLayout) { <text> checked="checked" </text>  } } />
                                            <div class="setting-radio-control__indicator" ></div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-6 col-md-6" id="transactionTypediv">
                                    @Html.LabelFor(m => m.TransTypeID, @FMBaseController.TranslateText("Transaction Type"), new { @class = "control-label" })
                                    <select class="form-control" id="TransTypeID" name="TransTypeID" value="@Model.TransTypeID" @ModifyDisable>
                                        @foreach (var transactionTypes in Model.transactionTypeList.OrderBy(x => x.Name))
                                        {
                                            <option value="@transactionTypes.ID" selected=@(Model.TransTypeID == @transactionTypes.ID ? true : false)>
                                                @transactionTypes.Name
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group col-sm-6 col-md-6" id="showcompanynamediv">
                                    @Html.LabelFor(m => m.ShowCompanyName, @FMBaseController.TranslateText("Show Company Name"), new { @class = "control-label" })
                                    <select class="form-control" id="ShowCompanyName" name="ShowCompanyName" value="@Model.ShowCompanyName" @ModifyDisable>
                                        @foreach (var showCompanyOption in Model.showCompanyOptions.OrderBy(x => x.Name))
                                        {
                                            <option value="@showCompanyOption.ID" selected=@(Model.ShowCompanyName == showCompanyOption.ID ? true : false)>
                                                @showCompanyOption.Name
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-6 col-md-6" id="associatedtransactiondiv">
                                    @Html.LabelFor(m => m.AssociatedAlias, @FMBaseController.TranslateText("Associated Transaction"), new { @class = "control-label" })
                                    <select class="form-control" id="AssociatedAlias" name="AssociatedAlias" value="@Model.AssociatedAlias" @ModifyDisable>
                                        @foreach (var associatedAlias in Model.AssociatedAliases)
                                        {
                                            <option value="@associatedAlias.value" data-type="@associatedAlias.type">
                                                @associatedAlias.key
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div id="TAReportsHeader" class="row settingsection">
                                <a href="#TAReports" data-toggle="collapse" class="col-sm-12 col-md-12 col-lg-12" aria-expanded="true">
                                    <span class="pull-left separator-label">@FMBaseController.TranslateText("REPORTS")</span><span id="expandReports" class="pull-right">
                                        <div class="expand-icon"></div>
                                    </span>
                                </a>
                                <div class="settingsectionhorizontalline"></div>
                            </div>
                            <div id="TAReports" class="row collapse in" aria-expanded="true">
                                <div class="form-group col-sm-6 col-md-6">
                                    @Html.LabelFor(m => m.AssociatedReport, @FMBaseController.TranslateText("Report"), new { @class = "control-label" })
