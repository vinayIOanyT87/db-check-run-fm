                                        @((Model.AssociatedReport != "")? Html.Raw("<option>" + Model.AssociatedReport + "</option>") : Html.Raw(""))
                                    </select>
                                </div>
                                <div class="form-group col-sm-6 col-md-6">
                                    @Html.LabelFor(m => m.AssociatedPreloadReport, @FMBaseController.TranslateText("Preload Report"), new { @class = "control-label" })
                                    <select class="form-control" id="AssociatedPreloadReport" name="AssociatedPreloadReport " value="@Model.AssociatedPreloadReport" @ModifyDisable>
                                        @((Model.AssociatedPreloadReport != "")? Html.Raw("<option>" + Model.AssociatedPreloadReport + "</option>") : Html.Raw(""))
                                    </select>
                                </div>
                            </div>

                            <div id="TAOptionsHeader" class="row settingsection">
                                <a href="#TAOptions" data-toggle="collapse" class="col-sm-12 col-md-12 col-lg-12" aria-expanded="true">
                                    <span class="pull-left separator-label">@FMBaseController.TranslateText("OPTIONS")</span><span id="expandOptions" class="pull-right">
                                        <div class="expand-icon"></div>
                                    </span>
                                </a>
                                <div class="settingsectionhorizontalline"></div>
                            </div>
