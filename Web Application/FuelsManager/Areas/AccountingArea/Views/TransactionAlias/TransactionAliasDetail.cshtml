</div>

<div id="userGroupListTemplate" class="hidden">
    <div class="col-sm-12 col-md-12 col-lg-12 TASettingList TAUserGroupSelected no-side-padding" id="usergroup-<Item1>" data-name="<Item2>" data-guid="<Item1>">
        <div class="form-group col-sm-7">
            @Html.Label("<Item2>", new { @class = "control-label" })
        </div>
        <div class="form-group col-sm-4 text-center  no-side-padding">
            <div class="btn-group access-btn-group" role="group" aria-label="First group">
                <button type="button" title="@FMBaseController.TranslateText("Can Edit Transactions")" class='btn edit-right active' @ModifyDisable>
                    <img class="deleteImg" src="~/fmwebapp/images/Right-Edit.png">
                </button>
                <button type="button" title="@FMBaseController.TranslateText("Can View Transactions")" class="btn read-right active alwaysselected" @ModifyDisable>
                    <img class="deleteImg" src="~/fmwebapp/images/Right-View.png">
                </button>
            </div>
        </div>
        <div class="usergroup-delete form-group col-sm-1 no-side-padding" @ModifyDisable>
            <img class="deleteImg" src="~/fmwebapp/images/Delete-column.png" @ModifyDisable>
        </div>
    </div>
</div>

<script>

    //=================================================================
    // This function handles the Apply Button on click event.
    //=================================================================
    function ApplyButtonOnClick() {
        $('#transactionAliasForm').submit();
    }

    function CancelButtonOnClick() {
        history.back();
    }

    $(document).ready(function () {

        $('#TALeftPanelSettings').niceScroll({
            cursorwidth: '10px'
            , autohidemode: false
            , cursorcolor: "#486899"
            , background: "#f9f9f9"
            , railoffset: true
            , railpadding: { top: 0, right: 0, left: 5, bottom: 0 }
            , smoothscroll: true
        });
        $('#TARightPanelSettings').niceScroll({
            cursorwidth: '10px'
            , autohidemode: false
            , cursorcolor: "#486899"
            , background: "#f9f9f9"
            , railoffset: true
            , railpadding: { top: 0, right: 0, left: -5, bottom: 0 }
            , smoothscroll: true
        });

        FMTransactionAlias.setAssociatedAliasDropdown();
    });


    $("#addUserGroupButton").on('click', function () {
        $('body').modalmanager('loading');

        $.ajax({
            type: 'Get',
            url: '@Url.Action("GetAllUserGroups", "TransactionAlias")',
            dataType: "json",
            success: function (results) {
                $("#userGroupSelectionList").html('');

                // remove already selected groups
                if (results.Data && results.Data.length > 0) {
                    $(".TAUserGroupSelected").each(function (i, obj) {
                        var selectedGuid = obj.getAttribute("data-guid");
                        results.Data = results.Data.filter(function (obj) {
                            return obj.Item1 !== selectedGuid;
                        });
                    });

                    function SortByFieldName(a, b) {
                        var aName = a.Item2.toLowerCase();
                        var bName = b.Item2.toLowerCase();
                        return ((aName < bName) ? -1 : ((aName > bName) ? 1 : 0));
                    }

                    $.each(results.Data.sort(SortByFieldName), function (index, value) {
                        var userGroupEntry = $("<li class='TransactionAliasUserGroupSelectionElement list-group-item' data-name='" + value.Item2 + "' data-guid='" + value.Item1 + "'>" + value.Item2 + "</li>");
                        $("#userGroupSelectionList").append(userGroupEntry);
                    });

                    $(".userGroupSelectionList").niceScroll({ cursorwidth: '10px', horizrailenabled: false, autohidemode: false, cursorcolor: "#486899", background: "white" });
                }
                $('#AddUserGroupModal').modal('show');
                $('body').modalmanager('removeLoading');
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.status);
                alert(thrownError);
            }
        });
    });

    $("#addStatusButton").on('click', function () {
        $('body').modalmanager('loading');

        $.ajax({
            type: 'Get',
            url: '@Url.Action("GetAllStatuses", "TransactionAlias")',
            dataType: "json",
            success: function (results) {
                $("#statusSelectionList").html('');

                // remove already selected statuses
                if (results.Data && results.Data.length > 0) {
                    $(".TAStatusSelected").each(function (i, obj) {
                        var selectedStatus = obj.getAttribute("data-value");
                        results.Data = results.Data.filter(function (obj) {
                            return obj.Item2 !== selectedStatus;
                        });
                    });

                    function SortByFieldName(a, b) {
                        var aName = a.Item2.toLowerCase();
                        var bName = b.Item2.toLowerCase();
                        return ((aName < bName) ? -1 : ((aName > bName) ? 1 : 0));
                    }

                    $.each(results.Data.sort(SortByFieldName), function (index, value) {
                        var userGroupEntry = $("<li class='TransactionAliasStatusSelectionElement list-group-item' data-name='" + value.Item2 + "' data-guid='" + value.Item1 + "'>" + value.Item2 + "</li>");
                        $("#statusSelectionList").append(userGroupEntry);
                    });

                    $(".statusSelectionList").niceScroll({ cursorwidth: '10px', horizrailenabled: false, autohidemode: false, cursorcolor: "#486899", background: "white" });
                }
                $('#AddStatusModal').modal('show');
                $('body').modalmanager('removeLoading');
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.status);
                alert(thrownError);
            }
        });
    });

    $("#addProductButton").on('click', function () {
        $('body').modalmanager('loading');

        $.ajax({
            type: 'Get',
            url: '@Url.Action("GetAllProducts", "TransactionAlias")',
            dataType: "json",
            success: function (results) {
                $("#productsSelectionList").html('');
                // remove already selected products
                if (results.Data && results.Data.length > 0) {

                    $(".TAProductSelected").each(function (i, obj) {
                        var selectedProduct = obj.getAttribute("data-guid");
                        results.Data = results.Data.filter(function (obj) {
                            return obj.Item1 !== selectedProduct;
                        });
                    });
                    function SortByFieldName(a, b) {
                        var aName = a.Item2.toLowerCase();
                        var bName = b.Item2.toLowerCase();
                        return ((aName < bName) ? -1 : ((aName > bName) ? 1 : 0));
                    }

                    $.each(results.Data.sort(SortByFieldName), function (index, value) {
                        var userGroupEntry = $("<li class='TransactionAliasProductSelectionElement list-group-item' data-name='" + value.Item2 + "' data-guid='" + value.Item1 + "'>" + value.Item2 + "</li>");
                        $("#productsSelectionList").append(userGroupEntry);
                    });

                    $(".productsSelectionList").niceScroll({ cursorwidth: '10px', horizrailenabled: false, autohidemode: false, cursorcolor: "#486899", background: "white" });
                }
                $('#AddProductModal').modal('show');
                $('body').modalmanager('removeLoading');
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.status);
                alert(thrownError);
            }
        });
    });

    $("#TAProductSelectAllButton").on('click', function () {
        $("#productsSelectionList .TransactionAliasProductSelectionElement").removeClass("selected").addClass("selected");
    });

    $("#TAProductApplyButton").on('click', function () {
        var selectedProducts = $("#productsSelectionList .TransactionAliasProductSelectionElement.selected");

        if (selectedProducts.length > 0) {
            selectedProducts.each(function (i, obj) {
                var newProduct = $("#excludedProductTemplate > div").clone();
                var data_guid = $(obj).attr("data-guid");
                var data_name = $(obj).attr("data-name");

                $(newProduct).attr("data-name", data_name);
                $(newProduct).attr("id", $(newProduct).attr("id").replace("<Item1>", data_guid));
                $(newProduct).attr("data-guid", data_guid);
                $(newProduct).find("label").text(data_name);

                $("#excludedProductList").append(newProduct);
            });

            $("#TAExcludedProductWarning").removeClass("hidden").addClass("hidden");
        }

        if ($("#excludedProductList > div").length == 0) {
            $("#TAExcludedProductWarning").removeClass("hidden");
        }

        var sortedListofProducts = $("#excludedProductList > div").sort(function (lhs, rhs) {
            return $(lhs).find('label').text().localeCompare($(rhs).find('label').text(), undefined, { sensitivity: 'base' });
        })

        $("#excludedProductList").html(sortedListofProducts);

        $('#AddProductModal').modal('hide');
        $("#productsSelectionList").html("");
    });

    $("#TAProductCancelButton, #TransactionProductSelectScreen_CloseButton").on('click', function () {
        $("#productsSelectionList").html("");
    });

    $("#productsSelectionList").on('click', '.TransactionAliasProductSelectionElement', function () {
        $(this).toggleClass('selected');
    });

    // deleting product
    $("#excludedProductList").on("click", ".product-delete", function () {
        $(this).parent().remove();
        if ($("#excludedProductList > div").length == 0) {
            $("#TAExcludedProductWarning").removeClass("hidden");
        }
    });


    $("#TAStatusSelectAllButton").on('click', function () {
        $("#statusSelectionList .TransactionAliasStatusSelectionElement").removeClass("selected").addClass("selected");
    });


    $("#TAStatusApplyButton").on('click', function () {
        var selectedStatuses = $("#statusSelectionList .TransactionAliasStatusSelectionElement.selected");

        if (selectedStatuses.length > 0) {
            selectedStatuses.each(function (i, obj) {
                var newStatus = $("#statusListTemplate > div").clone();
                var data_name = $(obj).attr("data-name");

                $(newStatus).attr("data-value", data_name);
                $(newStatus).attr("id", $(newStatus).attr("id").replace("<Item1>", data_name));
                $(newStatus).find("label").text(data_name);

                $("#statusList").append(newStatus);
            });

        }

        var sortedListofProducts = $("#statusList > div").sort(function (lhs, rhs) {
            return $(lhs).find('label').text().localeCompare($(rhs).find('label').text(), undefined, { sensitivity: 'base' });
        })

        $("#statusList").html(sortedListofProducts);

        if ($("#statusList > div").length == 0) {
            $("#TAUserGroupWarning").removeClass("hidden");
        }

        $('#AddStatusModal').modal('hide');
        $("#statusSelectionList").html("");
    });

    $("#TAStatusCancelButton, #TransactionStatusSelectScreen_CloseButton").on('click', function () {
        $("#statusSelectionList").html("");
    });

    $("#statusSelectionList").on('click', '.TransactionAliasStatusSelectionElement', function () {
        $(this).toggleClass('selected');
    });

    // deleting status
    $("#statusList").on("click", ".status-delete", function () {
        $(this).parent().remove();
    });

    $("#userGroupList").on("click", ".access-btn-group .edit-right", function () {
        $(this).toggleClass("active");
        if ($(this).hasClass("active")) {
            $(this).attr("title", $("#EditRightMessage").val());
        } else {
            $(this).attr("title", $("#NoEditRightMessage").val());
        }
    });

    $("#TASecuritySelectAllButton").on('click', function () {
        $("#userGroupSelectionList .TransactionAliasUserGroupSelectionElement").removeClass("selected").addClass("selected");
    });

    $("#TASecurityApplyButton").on('click', function () {

        var selectedUserGroups = $("#userGroupSelectionList .TransactionAliasUserGroupSelectionElement.selected");

        if (selectedUserGroups.length > 0) {
            selectedUserGroups.each(function (i, obj) {
                var newUserGroup = $("#userGroupListTemplate > div").clone();
                var data_guid = $(obj).attr("data-guid");
                var data_name = $(obj).attr("data-name");

                $(newUserGroup).attr("data-name", data_name);
                $(newUserGroup).attr("id", $(newUserGroup).attr("id").replace("<Item1>", data_guid));
                $(newUserGroup).attr("data-guid", data_guid);
                $(newUserGroup).find("label").text(data_name);

                $("#userGroupList").append(newUserGroup);
            });

        }

        var sortedListofUserGroups = $("#userGroupList > div").sort(function (lhs, rhs) {
            return $(lhs).find('label').text().localeCompare($(rhs).find('label').text(), undefined, { sensitivity: 'base' });
        })

        $("#userGroupList").html(sortedListofUserGroups);

        if ($("#userGroupList > div").length > 0) {
            $("#TAUserGroupWarning").removeClass("hidden").addClass("hidden");
        }

        $('#AddUserGroupModal').modal('hide');
        $("#userGroupSelectionList").html("");
    });

    $("#TASecurityCancelButton, #TransactionUserGroupSelectScreen_CloseButton").on('click', function () {
        $("#userGroupSelectionList").html("");
    });

    $("#userGroupSelectionList").on('click', '.TransactionAliasUserGroupSelectionElement', function () {
        $(this).toggleClass('selected');
    });

    // deleting user group
    $("#userGroupList").on("click", ".usergroup-delete", function () {
        $(this).parent().remove();
        if ($("#userGroupList > div").length == 0) {
            $("#TAUserGroupWarning").removeClass("hidden");
        }
    });

    // set status as default
    $("#statusList").on("click", ".status-default", function () {
        $("#statusList .status-default").removeClass("active");
        $("#statusList .status-default").attr("title", "Click to set default");
        $(this).addClass("active").attr("title", "");
    });

    // change the title when modifying the name
    $("#AliasID").on("keyup", function (e) {
        $("#TransactionAliasTitleLabel").text(e.currentTarget.value);
    });

</script>
