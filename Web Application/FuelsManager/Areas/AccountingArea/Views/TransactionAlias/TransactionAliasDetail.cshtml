                                        <span class="TransactionAliasCheckboxes">
                                            <label class="ignore-click ta-checkbox-group">
                                                <input class="ignore-click" id="PopulateCompaniesFromEquipment" name="PopulateCompaniesFromEquipment" type="checkbox" hidden="hidden" value="@Model.PopulateCompaniesFromEquipment.ToString()" @(Model.PopulateCompaniesFromEquipment ? "checked" : "") @ModifyDisable />
                                                <span id="ck-p-access-display_HelperPopulateCompaniesByEquipmentID" class="ignore-click"></span>
