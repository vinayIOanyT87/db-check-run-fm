                                            <label class="ignore-click ta-checkbox-group">
                                                <input class="ignore-click" id="PermitNonReferenceData" name="PermitNonReferenceData" type="checkbox" value="@Model.PermitNonReferenceData.ToString()" @(Model.PermitNonReferenceData ? "checked" : "") hidden="hidden" @ModifyDisable />
                                                <span id="ck-p-access-display_PermitNonReferenceData" class="ignore-click"></span>
                                            </label>
                                        </span>
