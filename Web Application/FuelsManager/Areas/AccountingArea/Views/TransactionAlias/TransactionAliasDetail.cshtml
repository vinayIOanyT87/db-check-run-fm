                                    <div class="list-group-item2 ta-checkbox-group">
                                        <span class="TransactionAliasCheckboxName" title="@FMBaseController.TranslateText("Multiple Transport Line Items")">@FMBaseController.TranslateText("Multiple Transport Line Items")</span>
