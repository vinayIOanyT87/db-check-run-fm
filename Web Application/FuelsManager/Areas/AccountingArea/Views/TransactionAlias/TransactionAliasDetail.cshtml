                                    <div class="list-group-item2">
                                        <span class="TransactionAliasCheckboxName" title="@FMBaseController.TranslateText("Use Auto Complete Controls")">@FMBaseController.TranslateText("Use Auto Complete Controls")</span>
                                        <span class="TransactionAliasCheckboxes">
                                            <label class="ignore-click ta-checkbox-group">
                                                <input class="ignore-click" id="EnableAutoCompleteControls" name="EnableAutoCompleteControls" type="checkbox" value="@Model.EnableAutoCompleteControls.ToString()" @(Model.EnableAutoCompleteControls ? "checked" : "") hidden="hidden" @ModifyDisable />
                                                <span id="ck-p-access-display_EnableAutoCompleteControls" class="ignore-click"></span>
                                            </label>
                                        </span>
