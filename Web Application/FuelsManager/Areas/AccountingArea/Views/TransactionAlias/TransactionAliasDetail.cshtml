                                                <span id="ck-p-access-display_LimitSelectionsBasedOnHierarchy" class="ignore-click"></span>
                                            </label>
                                        </span>
                                    </div>
                                </div>
                                <div id="PermitNonReferenceDataOption" class="form-group col-sm-4 col-md-4">
