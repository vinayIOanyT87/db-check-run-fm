@using FuelsManager.Areas.Controllers
@model FuelsManager.Areas.FCEE.ViewModels.FCEDeviceSummaryModel

@{
    ViewBag.Title = "FCEDeviceSummaryView";
    Layout = "~/Areas/Views/Shared/_Layout.cshtml";
}

<link href="~/Areas/Content/bootstrap-modal-bs3patch.css" rel="stylesheet" type="text/css" />
<link href="~/Areas/Content/bootstrap-modal.css" rel="stylesheet" type="text/css" />

<script src="~/Areas/Lib/jquery.nicescroll.min.js"></script>
<script src="~/Areas/Lib/bootstrap-modal.js"></script>
<script src="~/Areas/Lib/bootstrap-modalmanager.js"></script>
<script src="~/Areas/Scripts/FMErrorAndExceptionHandling.js"></script>
<script src="~/Areas/Scripts/FCEDeviceSummary.js"></script>

<script src="~/Areas/Scripts/FCEDeviceEditor.js"></script>

<script src="~/Areas/lib/ace.js"></script>

<style>
    .FMGridContainer {
        max-height: calc(100vh - 175px) !important;
    }

    button.disabled {
        color: #b7b7b7 !important;
    }
</style>

@using (Html.BeginForm("FCEDeviceSummaryView", "FCEDeviceSummaryController", FormMethod.Post, new { id = "FCEDeviceSummaryForm" }))
{
    @Html.AntiForgeryToken()

    var editText = FMBaseController.TranslateText("Edit");
    var deleteText = FMBaseController.TranslateText("Delete");
    var IMEI = FMBaseController.TranslateText("IMEI");
    var FriendlyName = FMBaseController.TranslateText("Friendly Name");
    var SoftwareVersion = FMBaseController.TranslateText("Software Version");
    var addText = FMBaseController.TranslateText("Add");
    var addNewFCEDeviceText = FMBaseController.TranslateText("Add New FCE Device");
    var addAccessKey = "A";
    var addPreFix = "";
    var addPostFix = "";
    var addAccessKeyContainedInAddText = false;
    var addButtonClass = (Model.ReadOnly) ? "disabled" : "";
    var addButtonDisable = (Model.ReadOnly) ? "disabled=\"disabled\"" : "";

    if (addText.Length > 0)
    {
        if (addText.Contains(addAccessKey))
        {
            addAccessKeyContainedInAddText = true;
            var firstIndex = addText.IndexOf(addAccessKey, StringComparison.InvariantCulture);
            if (firstIndex > 0)
            {
                addPreFix = addText.Substring(0, firstIndex);
            }
            if (firstIndex < addText.Length)
            {
                addPostFix = addText.Substring(firstIndex + 1);
            }
        }
    }

    var count = 0;
    if (Model.fceDevices != null && Model.fceDevices.Count > 0)
    {
        count = Model.fceDevices.Count;
    }

    var displayCount = Math.Min(count, 500);

    var translatedCountDisplayText = string.Format(FMBaseController.TranslateText("Limiting display to") + " {0} " + FMBaseController.TranslateText("of") + " {1} " + FMBaseController.TranslateText("total records.  Use filters to reduce record count."), displayCount, count);

    var translatedRecordCountText = string.Format(FMBaseController.TranslateText("Showing") + " {0} " + FMBaseController.TranslateText("record(s)."), count);

    @Html.Hidden("ReadOnly", (Model.ReadOnly))
    <div class="row headline" style="width: 5in; padding-bottom:10px">@FMBaseController.TranslateText("FCE Devices Configuration")</div>

    <div style="padding-top: 5px; padding-bottom: 5px">
        <button id="addFCEDevice1" type="button" title="@addNewFCEDeviceText" class="pushButton @addButtonClass" @addButtonDisable accesskey=@addAccessKey onclick="javascript: return FCEDeviceSummary.EditFCEDevice('00000000-0000-0000-0000-000000000000');">
            @if (addAccessKeyContainedInAddText)
            {
                @addPreFix<u>@addAccessKey</u>@addPostFix
            }
            else
            {
                @addText
            }
        </button>
    </div>


    <section class="FMGridSection" style="max-width: 825px">
        <div class="FMGridContainer">
            <table id="FCEDeviceTable">
                <thead>
                    <tr>
                        <th>
                            @editText<div>@editText</div>
                        </th>
                        <th>
                            @IMEI<div>@IMEI</div>
                        </th>
                        <th>
                            @FriendlyName<div>@FriendlyName</div>
                        </th>
                        <th>
                            @SoftwareVersion<div>@SoftwareVersion</div>
                        </th>
                        <th>
                            @deleteText<div>@deleteText</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var editThisItem = FMBaseController.TranslateText("Edit this item");
                        var delThisItem = FMBaseController.TranslateText("Delete this item");
                        var delNotSupported = FMBaseController.TranslateText("Delete not supported");

                        foreach (var fceDevice in Model.fceDevices)
                        {

                            var deleteConfirmationText = FMBaseController.TranslateText("Are you sure you wish to delete this item?");
                            var deleteClass = (Model.ReadOnly) ? "deleteLinkClassDisabled" : "deleteLinkClass";
                            var deleteTitle = (Model.ReadOnly) ? delNotSupported : delThisItem;
                            var deleteDisabled = (Model.ReadOnly) ? "disabled=\"disabled\"" : "";
                            <tr id="row_@fceDevice.FCEDeviceGuid">
                                <td style="width: 36px; text-align: center">
                                    <a class="editLinkClass" title="@editThisItem" onclick="javascript: return FCEDeviceSummary.EditFCEDevice('@fceDevice.FCEDeviceGuid.ToString()');">@editText</a>
                                </td>
                                <td>@fceDevice.ImeiNumber</td>
                                <td>@fceDevice.FriendlyName</td>
                                <td>@fceDevice.SoftwareVersion</td>
                                <td style="width: 36px; vertical-align: top; text-align: center">
                                    <a class="@deleteClass" @deleteDisabled title="@deleteTitle" onclick="if ( confirm( '@deleteConfirmationText' ) ){FCEDeviceSummary.DeleteFCEDevice( '@fceDevice.FCEDeviceGuid.ToString()' )}else{return false;}">@deleteText</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
    <table class="FMGridFoot" style="width: 100%; max-height: 35px; max-width: 825px">
        <tfoot>
            <tr>
                <th>
                    Showing <span id="rowCountSpan"></span> record(s).
                </th>
            </tr>

        </tfoot>
    </table>

    <div style="padding-top: 5px; padding-bottom: 5px">
        <button id="addFCEDevice2" type="button" title="@addNewFCEDeviceText" class="pushButton @addButtonClass" @addButtonDisable accesskey=@addAccessKey onclick="javascript: return FCEDeviceSummary.EditFCEDevice('00000000-0000-0000-0000-000000000000');">
            @if (addAccessKeyContainedInAddText)
            {
                @addPreFix<u>@addAccessKey</u>@addPostFix
            }
            else
            {
                @addText
            }
        </button>
    </div>
}

<!-- Edit FCE Device Modal -->
@{
    var saveButton = FMBaseController.TranslateText("&Save");
    var cancelButton = FMBaseController.TranslateText("&Cancel");
}
@Html.Hidden("urlFCEDeviceEditor", @Url.Action("FCEDeviceEditor", "FCEDeviceEditor"))

<div class="row">
    <div id="EditFCEDeviceModal" class="modal container fade" data-backdrop="static" data-focus-on="input:first" role="dialog">
        <!-- Edit FCE Device Modal content-->
        <form id="FCEDeviceEditorForm">

            <div class="modal-content">
                <div class="modal-body">
                    <div class="EditFCEDeviceHeader row">
                        <button type="button" class="close" data-dismiss="modal" onclick="$('#FCEDeviceEditorCloseButton').click();">×</button>
                        <div class="col-xs-12">
                            <h4>@FMBaseController.TranslateText("FCE Device|Edit FCE Device")</h4>
                        </div>
                    </div>
                    <section id="FCEDeviceEditorScreen" class=""></section>
                </div>
                <div class="modal-footer">
                    <div class="btn-toolbar">
                        <div class="pull-right" role="group">
                            <label ID="denotesLabel" class="formfieldtitle" style="width:160px; color:crimson; height:8px; text-align:left">* Denotes Required Field</label>
                            <button id="FCEDeviceEditorSaveButton" type="submit" class="formfieldtitle pushButton" accessKey="@FMControls.GetAccessKey(saveButton)">
                                @Html.Raw(FMControls.FormatButtonText(saveButton))
                            </button>
                            <button id="FCEDeviceEditorCloseButton" type="button" class="formfieldtitle pushButton" data-dismiss="modal" accessKey="@FMControls.GetAccessKey(cancelButton)">
                                @Html.Raw(FMControls.FormatButtonText(cancelButton))
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>