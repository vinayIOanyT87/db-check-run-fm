                breadcrumbIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "BreadcrumbVariance")
            {
                var breadcrumbVarianceIconTextbox = document.getElementById("BreadcrumbVarianceIconName");
                breadcrumbVarianceIconTextbox.value = result.FileName;

                var breadcrumbVarianceIconImgTag = document.getElementById("BreadcrumbVarianceIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/BreadcrumbVarianceIcon.png"
                breadcrumbVarianceIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "BreadcrumbInvestigation")
            {
                var breadcrumbInvestigationIconTextbox = document.getElementById("BreadcrumbInvestigationIconName");
                breadcrumbInvestigationIconTextbox.value = result.FileName;

                var breadcrumbInvestigationIconImgTag = document.getElementById("BreadcrumbInvestigationIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/BreadcrumbInvestigationIcon.png"
                breadcrumbInvestigationIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "BreadcrumbCompleteInvestigationFailed")
            {
                var breadcrumbCompleteInvestigationFailedIconTextbox = document.getElementById("BreadcrumbCompleteInvestigationFailedIconName");
                breadcrumbCompleteInvestigationFailedIconTextbox.value = result.FileName;

                var breadcrumbCompleteInvestigationFailedIconImgTag = document.getElementById("BreadcrumbCompleteInvestigationFailedIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/BreadcrumbCompleteInvestigationFailedIcon.png"
                breadcrumbCompleteInvestigationFailedIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "BreadcrumbCompleteInvestigationPassed")
            {
                var breadcrumbCompleteInvestigationPassedIconTextbox = document.getElementById("BreadcrumbCompleteInvestigationPassedIconName");
                breadcrumbCompleteInvestigationPassedIconTextbox.value = result.FileName;

                var breadcrumbCompleteInvestigationPassedIconImgTag = document.getElementById("BreadcrumbCompleteInvestigationPassedIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/BreadcrumbCompleteInvestigationPassedIcon.png"
                breadcrumbCompleteInvestigationPassedIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "Facility")
            {
                var facilityIconTextbox = document.getElementById("FacilityIconName");
                facilityIconTextbox.value = result.FileName;

                var facilityIconImgTag = document.getElementById("FacilityIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/FacilityIcon.png"
                facilityIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "Tank")
            {
                var tankIconTextbox = document.getElementById("TankIconName");
