            }

            if (popupType === "EquipmentCompleteInvestigationPassed")
            {
                var equipmentCompleteInvestigationPassedIconTextbox = document.getElementById("EquipmentCompleteInvestigationPassedIconName");
                equipmentCompleteInvestigationPassedIconTextbox.value = result.FileName;

