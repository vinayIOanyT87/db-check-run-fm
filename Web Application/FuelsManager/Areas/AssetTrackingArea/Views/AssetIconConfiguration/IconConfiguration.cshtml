                tankIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "DeliveryLocation")
            {
                var deliveryLocationIconTextbox = document.getElementById("DeliveryLocationIconName");
                deliveryLocationIconTextbox.value = result.FileName;

                var deliveryLocationIconImgTag = document.getElementById("DeliveryLocationIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/DeliveryLocationIcon.png"
                deliveryLocationIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "MapPin")
            {
                var mapPinIconTextbox = document.getElementById("MapPinIconName");
                mapPinIconTextbox.value = result.FileName;

                var mapPinIconImgTag = document.getElementById("MapPinIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/MapPinIcon.png"
                mapPinIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }
