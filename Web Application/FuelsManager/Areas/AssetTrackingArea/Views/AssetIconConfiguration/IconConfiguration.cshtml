@using System.Web.Configuration
@using FuelsManager.Areas.Controllers
@model FuelsManager.Areas.AssetTrackingArea.ViewModels.AssetIconConfigurationModel
@{
	ViewBag.Title = "IconConfiguration";
}

<header>
	<style>
		.divTable {
			width: 85%;
			height: 50%;
			display: table;
			padding: 3px;
		}

		.divTableRow {
			width: 100%;
			height: 100%;
			display: table-row;
			padding: 3px;
		}

		.divTableCell {
			width: 25%;
			height: 100%;
			display: table-cell;
			padding: 3px;
			vertical-align: top;
		}

		.divTableCell2 {
			width: 25%;
			height: 100%;
			display: table-cell;
			padding: 3px;
			vertical-align: top;
			position: absolute;
			right: 40%;
		}

		.headline {
			font-family: Arial, Helvetica, sans-serif;
			font-size: 18px;
			font-style: italic;
			font-weight: bold;
			color: #0d246a;
			line-height: normal;
			white-space: nowrap;
		}

		.formfieldtitle {
			font-family: Arial, Helvetica, sans-serif;
			font-size: 12px;
			font-style: normal;
			line-height: normal;
			font-weight: bold;
			font-variant: normal;
			text-transform: none;
			white-space: nowrap;
		}

		.formfield input {
			font-family: Arial, Helvetica, sans-serif;
			font-size: 12px;
			font-style: normal;
			line-height: normal;
			font-weight: normal;
			font-variant: normal;
			text-transform: none;
			color: #000000;
		}

		.errorField {
			font-family: Arial, Helvetica, sans-serif;
			font-size: 16px;
			font-style: normal;
			line-height: normal;
			font-weight: bold;
			font-variant: normal;
			text-transform: none;
			color: #FF0000;
		}
	</style>
</header>
@if (ViewBag.Message != null && ViewBag.Message != "")
{
	<script>
	    $(function ()
	    {
	        var msg = '@FMBaseController.TranslateText(ViewBag.Message)';
	        alert(msg);
	    });
	</script>
}
<script>
    window.onload = function (e) {
        window.parent.CurrentHelpKey = "MenuBar/FMMenuBar.aspx?target=../AssetTrackingArea/AssetIconConfiguration/IconConfiguration";
    }

    //==========================================================================
    // This function will display the icon selection popup dialog.
    //==========================================================================
    ShowIconModalPopUp = function (popupType)
    {
        var features = "dialogWidth: 11.81in; dialogHeight: 8in; overflow:auto; scrollbars:no";
        var result = window.showModalDialog("IconConfiguration?isIconPopup=True", "WindowPopup", features);

        var postFromPopupCheckbox = document.getElementById("PostFromPopup");
        postFromPopupCheckbox.value = false;

        if (result != null)
        {
            var path = '@Url.Content(@Model.IconPath)';
            var protocol = window.location.protocol;
            var host = window.location.host;

            postFromPopupCheckbox = document.getElementById("PostFromPopup");
            postFromPopupCheckbox.value = true;

            if (popupType === "Equipment")
            {
                var equipmentIconTextbox = document.getElementById("EquipmentIconName");
                equipmentIconTextbox.value = result.FileName;

                var equipmentIconImgTag = document.getElementById("EquipmentIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/EquipmentIcon.png"
                equipmentIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "EquipmentVariance")
            {
                var equipmentVarianceIconTextbox = document.getElementById("EquipmentVarianceIconName");
                equipmentVarianceIconTextbox.value = result.FileName;

                var equipmentVarianceIconImgTag = document.getElementById("EquipmentVarianceIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/EquipmentVarianceIcon.png"
                equipmentVarianceIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "EquipmentInvestigation")
            {
                var equipmentInvestigationIconTextbox = document.getElementById("EquipmentInvestigationIconName");
                equipmentInvestigationIconTextbox.value = result.FileName;

                var equipmentInvestigationIconImgTag = document.getElementById("EquipmentInvestigationIconImg");

                // Should look like: "http://localhost/FuelsManagerITV/Areas/images/AssetMapImages/MapIcons/EquipmentInvestigationIcon.png"
                equipmentInvestigationIconImgTag.src = protocol + "//" + host + "/" + path + result.FileName;
            }

            if (popupType === "EquipmentCompleteInvestigationFailed")
            {
                var equipmentCompleteInvestigationFailedIconTextbox = document.getElementById("EquipmentCompleteInvestigationFailedIconName");
                equipmentCompleteInvestigationFailedIconTextbox.value = result.FileName;

                var equipmentCompleteInvestigationFailedIconImgTag = document.getElementById("EquipmentCompleteInvestigationFailedIconImg");

