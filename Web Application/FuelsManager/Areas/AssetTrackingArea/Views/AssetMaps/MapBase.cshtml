							<LI>
								<table>
									<tr>
										<td>
											<label class="customCheckbox">
												<input id="@inputId" type="checkbox" value="@itemId" onchange='FMGeoTrackingSideMenu.TankCbOnChange(this);' />
												<span></span>
											</label>
											<label for="@inputId" class="filterGroupItem">@itemId</label>
