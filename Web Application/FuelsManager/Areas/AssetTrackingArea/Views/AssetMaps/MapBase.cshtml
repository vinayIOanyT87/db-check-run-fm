@using FMBusinessObjects.DataObjects
@using FuelsManager.Areas.AssetTrackingArea.Controllers
@using FuelsManager.Areas.Controllers
@model FuelsManager.Areas.AssetTrackingArea.ViewModels.AssetMapsViewModel
@{
	ViewBag.Title = "MapBase";
}

<link href="~/Areas/Content/GeoTrackingMapStyles.css" rel="stylesheet" type="text/css"/>

<script src="~/Areas/Lib/ol2/OpenLayers.js"></script>
<script type="text/javascript" src="https://maps.google.com/maps/api/js?key=AIzaSyCHJQXbg-0_jcxhFTaZE-LXi4Ck0cx-ORk&callback=Function.prototype"></script>
<script src="~/Areas/scripts/GeoTrackingSideMenu.js" type="text/javascript"></script>
<script src="~/Areas/scripts/GeoTrackingMapPopupFormatter.js" type="text/javascript"></script>
<script src="~/Areas/scripts/GeoTrackingEquipmentHistory.js" type="text/javascript"></script>
<script src="~/Areas/scripts/GeoTrackingMap.js" type="text/javascript"></script>
<script src="~/Areas/lib/jquery.nicescroll.min.js"></script>
<script>
    var useExtent = 0;

    window.onload = function (e) {
        window.parent.CurrentHelpKey = "MenuBar/FMMenuBar.aspx?target=../AssetTrackingArea/AssetMaps/MapBase";
    }

	//======================================================================================
	// This function handles the initialization of the OpenLayers map.
	//======================================================================================
	function init()
	{
		var model = FMGeoTrackingMap.GetMapViewModel();
		useExtent = model.UseExtentInt;
		InitializeSideMenu();

		// Build the equipment history records.
		FMGeoTrackingEquipmentHistory.CreatePeriodDropdown();

		$('#MenuItemChange').val(false);

		var mapLat = model.MapLatitude;
		var mapLong = model.MapLongitude;

		var wgs1984Projection			= new OpenLayers.Projection("EPSG:4326");   // Transform from WGS 1984
		var sphericalMecatorProjection	= new OpenLayers.Projection("EPSG:900913"); // to Spherical Mercator Projection
		var mapnik						= null;
		var map							= null;

		// Set the default map to Open Street Map
		if (model.MapSourceIndex === 0)
		{
			// Controls when empty will remove the default Pan/Zoom buttons.
			map		= new OpenLayers.Map("MapHost", {zoomDuration: 1, controls: []});
			mapnik	= new OpenLayers.Layer.OSM();
		}

		// MapServer maps
		if (model.MapSourceIndex === 1)
		{
			// Controls when empty will remove the default Pan/Zoom buttons.
			var options =
			{
				projection: sphericalMecatorProjection,
				numZoomLevels: 24,
				zoomDuration: 1,
				controls: []
			}

			map = new OpenLayers.Map("MapHost", options);
			mapnik = new OpenLayers.Layer.MapServer(
				"Georgia",
				"https://149.8.161.116/MapServer/mapserv.exe",
				{
					map: 'Apps/osm/basemaps/osm-google.map', layers: 'all', srs: 'EPSG:900913',
					mode: 'map'
				});
		}

		// Google maps
		if (model.MapSourceIndex === 2)
		{
			// Controls when empty will remove the default Pan/Zoom buttons.
			map	= new OpenLayers.Map("MapHost", {zoomDuration: 1, controls: []});
			mapnik = new OpenLayers.Layer.Google("Google Streets", { type : google.maps.MapTypeId.ROADMAP, sphericalMercator : true, numZoomLevels: 23, MAX_ZOOM_LEVEL: 22 });
		}

		// Bing maps
		if (model.MapSourceIndex === 3)
		{
			// Controls when empty will remove the default Pan/Zoom buttons.
			map	= new OpenLayers.Map("MapHost", {zoomDuration: 1, controls: []});
			mapnik = new OpenLayers.Layer.Bing({ name: "Bing", key: "AgdSyKfgwxktthiefb80kRKbqMBUUYsxNNAiI6bFibmIHUqLLzH94g7UIkLTGevR", type: "Road" });
		}

		var position	= new OpenLayers.LonLat(mapLong, mapLat).transform(wgs1984Projection, sphericalMecatorProjection);
		var zoom		= model.Zoom;

		if (map == null)
		{
			map		= new OpenLayers.Map("MapHost", {zoomDuration: 1, controls: []});
			mapnik	= new OpenLayers.Layer.OSM();
		}

		map.addLayer(mapnik);
		map.setCenter(position, zoom);

		// Add the controls back in. This was due to removing all controls in order
		// to remove the default zoom buttons.
		map.addControl(new OpenLayers.Control.Navigation());
		map.addControl(new OpenLayers.Control.ArgParser());
		map.addControl(new OpenLayers.Control.Attribution());

		// Add the new zoom and pan buttons in.
		var panZoomCntlHorizontalPos = FMGeoTrackingSideMenu.CalculatePanZoomObjLocation();
		var panZoomCntl = new OpenLayers.Control.PanZoom({ 'position': new OpenLayers.Pixel(panZoomCntlHorizontalPos, 0) });
		map.addControl(panZoomCntl);

		// Bing map is behaving differently than other maps. It is
		// triggering the zoom event when the Refresh button is
		// being pressed. This code is to handle that issue.
		var ignoreBingZoom = false;
		if (model.ActiveButtonIndex === 0)
		{
			ignoreBingZoom = true;
		}

		// Set the zoom change event and capture the most
		// current zoom level.  This is used when the map
		// is refreshed.
		map.events.register('zoomend', map,
			function()
			{
				var zoomInfo;

				// For Bing map this event is triggered on the Refresh button and do not know why.
				// It does not do it for other maps. Therefore, we want to ignore updating the
				// lastest zoom value.
				if (model.MapSourceIndex === 3)
				{
					// If the zoom event was caused by the map zoom buttons (+ or -), then update
					// the current zoom.
					if (ignoreBingZoom === false)
					{
						// With Bing maps the get zoom always comes back one zoom
						// level lower.  Therefore, need to add one to the zoom.
						zoomInfo = map.getZoom() + 1;
						$('#Zoom').val(zoomInfo);
					}

					ignoreBingZoom = false;
				}
				else
				{
					zoomInfo = map.getZoom();
					$('#Zoom').val(zoomInfo);
				}
			});

		// Register the moving of the map event. It will get the new center position
		// of the map and save it for when the map is redrawn. The values have to
		// be transformed back from the spherical mercator projection.
		map.events.on(
		{"moveend": function()
		{
			var point = map.getCenter();
			var centerPosition = point.transform(sphericalMecatorProjection, wgs1984Projection);
			$('#MapLatitudeStr').val(centerPosition.lat.toString());
			$('#MapLongitudeStr').val(centerPosition.lon.toString());
		}
		});

		var vectorLayerAll = new OpenLayers.Layer.Vector("OverlayAll", {rendererOptions: {zIndexing: true }});

		FMGeoTrackingMap.mapObj											= map;
		FMGeoTrackingMap.currentMarkerUrl								= '@Url.Content(@Model.EquipmentIcon)';
		FMGeoTrackingMap.crumbMarkerUrl									= '@Url.Content(@Model.BreadcrumbIcon)';
		FMGeoTrackingMap.currentContaminatedMarkerUrl					= '@Url.Content(@Model.EquipmentContaminatedIcon)';
		FMGeoTrackingMap.currentInvestigationMarkerUrl					= '@Url.Content(@Model.EquipmentInvestigationIcon)';
		FMGeoTrackingMap.currentCompleteInvestigationFailedMarkerUrl	= '@Url.Content(@Model.EquipmentCompleteInvestigationFailedIcon)';
		FMGeoTrackingMap.currentCompleteInvestigationPassedMarkerUrl	= '@Url.Content(@Model.EquipmentCompleteInvestigationPassedIcon)';
		FMGeoTrackingMap.crumbContaminatedMarkerUrl						= '@Url.Content(@Model.BreadcrumbContaminatedIcon)';
		FMGeoTrackingMap.crumbInvestigationMarkerUrl					= '@Url.Content(@Model.BreadcrumbInvestigationIcon)';
		FMGeoTrackingMap.crumbCompleteInvestigationFailedMarkerUrl		= '@Url.Content(@Model.BreadcrumbCompleteInvestigationFailedIcon)';
		FMGeoTrackingMap.crumbCompleteInvestigationPassedMarkerUrl		= '@Url.Content(@Model.BreadcrumbCompleteInvestigationPassedIcon)';
		FMGeoTrackingMap.facilityMarkerUrl								= '@Url.Content(@Model.FacilityIcon)';
		FMGeoTrackingMap.tankMarkerUrl									= '@Url.Content(@Model.TankIcon)';
		FMGeoTrackingMap.deliveryLocationMarkerUrl						= '@Url.Content(@Model.DeliveryLocationIcon)';
		FMGeoTrackingMap.wgs1984Projection								= wgs1984Projection;
		FMGeoTrackingMap.sphericalMecatorProjection						= sphericalMecatorProjection;
		FMGeoTrackingMap.autoRefreshTime								= model.MapRefreshTimeInMilliSeconds;

		FMGeoTrackingMapPopupFormatter.imageRootPath = '@Url.Content("~/Areas/images/AssetMapImages")';

		// Clear retrieving error message and flag.
		FMGeoTrackingMap.retrievingDataErrorMsg = "";
		FMGeoTrackingMap.retrievingDataErrorFlag = false;

		// Retrieve all the data from the server.
		var equipmentMapDataList		= FMGeoTrackingMap.GetEquipmentMapData();
		var facilityMapDataList			= FMGeoTrackingMap.GetFacilityMapData();
		var tankMapDataList				= FMGeoTrackingMap.GetTankMapData();
		var deliveryLocationMapDataList = FMGeoTrackingMap.GetDeliveryLocationMapData();

		// Add the items to the map.
		FMGeoTrackingMap.AddBreadCrumbs(map, vectorLayerAll, equipmentMapDataList);
		FMGeoTrackingMap.AddFacilityMarkers(map, vectorLayerAll, facilityMapDataList);
		FMGeoTrackingMap.AddTankMarkers(map, vectorLayerAll, tankMapDataList);
		FMGeoTrackingMap.AddDeliveryLocationMarkers(map, vectorLayerAll, deliveryLocationMapDataList);

		if (FMGeoTrackingMap.retrievingDataErrorFlag)
		{
			alert(FMGeoTrackingMap.retrievingDataErrorMsg);
		}

		if (useExtent === 1 )
		{
			map.zoomToExtent(vectorLayerAll.getDataExtent());
		}

		// Add a scale to the map.
		var scaleLine = new OpenLayers.Control.ScaleLine();
		map.addControl(scaleLine);
		var elements = document.getElementsByClassName('olControlScaleLine');
		var scaleElement = elements[0];
		var newLeftPos = (window.innerWidth - 250).toString() + "px";
		scaleElement.style.left = newLeftPos;

		// Add a selector control to the vectorLayer that contains the popup functions.
		FMGeoTrackingMap.controls = {
			selector: new OpenLayers.Control.SelectFeature(vectorLayerAll,
			{ hover: false, onSelect: FMGeoTrackingMap.createPopup, onUnselect: FMGeoTrackingMap.destroyPopup })
		};

		map.addControl(FMGeoTrackingMap.controls['selector']);
		FMGeoTrackingMap.controls['selector'].activate();

		// Set auto refreshing.
		FMGeoTrackingMap.AutoRefresh();
	}

	function SubmitForm()
	{
		$("#MapBaseForm").submit();
	}

	//==================================================================
	// This function initializes the side menu.
	//==================================================================
	function InitializeSideMenu()
	{
		FMGeoTrackingSideMenu.imageRootPath = '@Url.Content("~/Areas/images/AssetMapImages/")';

		// Set the menu item checkboxes based on selection from the postback.
		FMGeoTrackingSideMenu.SetMenuCheckboxes();
		FMGeoTrackingSideMenu.selectedEquipment = "-88";
		FMGeoTrackingSideMenu.selectedFacility = "-88";
		FMGeoTrackingSideMenu.selectedTank = "-88";
		FMGeoTrackingSideMenu.selectedDeliveryLocation = "-88";

		// Set the menu item for the radio buttons.
		FMGeoTrackingSideMenu.SetMenuRadioBtns();

		FMGeoTrackingSideMenu.SetInitialMenuExpansion();
	}


	//==============================================================================================
	// This function builds the equipment history popup.  It calls the FMGeoTrackingEquipmentHistory
	// script that does the load of the work.
	//==============================================================================================
	function BuildEquipmentHistoryPopup(vehicleId)
	{
		var breadcrumbState = "Current";
		var fromDateStr = "";
		var endDateStr = "";

		FMGeoTrackingEquipmentHistory.RetrieveHistoryDataFromServer(vehicleId, fromDateStr, endDateStr, breadcrumbState);

		var vehicleIdElement = document.getElementById("EquipmentIdFilterLabel");
		if (vehicleIdElement != null)
		{
			vehicleIdElement.innerHTML = vehicleId;
		}

		// Set the Period dropdown to the Current selection. Meaning to just
		// get the current position.
		var periodDropdownElement = document.getElementById("PeriodDropdown");
		periodDropdownElement.selectedIndex = 2;
		FMGeoTrackingEquipmentHistory.previousBreadcrumbSelection = 2;

		// Make the Equipment History dialog draggable.
		//$("#EquipmentHistoryDiv").draggable({
		//	iframeFix: true,
		//	containment: "window"
		//});

		// This sets the nice scrolling on the Property Window.
		$('#EquipmentHistoryScrollDiv').niceScroll({
			cursorwidth: '5px'
			, autohidemode: false
			, cursorcolor: "#486899"
			, background: "rgb(240, 240, 240)"
			, railoffset: true
			, enablemousewheel: true
			, railpadding: { top: 0, right: 3, left: 7, bottom: 4 }
			, smoothscroll: true
			, mousescrollstep: 5
			, horizrailenabled: false
		});

		// Clear the Date filters
		$("#EquipHistoryStartDate").val("");
		$("#EquipHistoryEndDate").val("");

		// Create the Start and End date pickers.
		$(function() {
			$("#EquipHistoryStartDate").datepicker(
			{
				dateFormat: "yy/mm/dd",
				onSelect: FMGeoTrackingEquipmentHistory.StartDateOnSelect
			});
		});

		$(function() {
			$("#EquipHistoryEndDate").datepicker(
			{
				dateFormat: "yy/mm/dd",
				onSelect: FMGeoTrackingEquipmentHistory.EndDateOnSelect
			});
		});

		FMGeoTrackingEquipmentHistory.imageRootPath = '@Url.Content("~/Areas/images/AssetMapImages")';
		FMGeoTrackingEquipmentHistory.AddEquipmentRecordRows();

		var equipmentTableDiv = document.getElementById("EquipmentHistoryDiv");
		equipmentTableDiv.style.display = "block";
	}
</script>


<body onload="init();" onresize="FMGeoTrackingSideMenu.RefreshMap();" style="overflow-x: hidden;">
<div class="row">
	<div id="MapHost" style="position: absolute; width: 1895px; height: 785px; z-index: 1;"></div>
</div>
</body>
@Html.Hidden("MapViewModel", AssetMapsController.SerializeModel(Model))
@using (Html.BeginForm("MapBase", "AssetMaps", FormMethod.Post, new
{
	id = "MapBaseForm",
	@class = "form-horizontal",
	role = "form"
}))
{
	@Html.AntiForgeryToken()
	@Html.ValidationSummary(true)

	<div class="divTable">
		<div class="divTableRow">
			<div class="divTableCell">
				@Html.ValidationMessage("Error", new { @Class = "errorField", style = "width:360px" })
			</div>
		</div>
	</div>
	<div class="row">
		<input id="autoRefresh" name="autoRefresh" type="hidden" value="" />
		@Html.HiddenFor(model => model.MapName)
		@Html.HiddenFor(model => model.Zoom)
		@Html.HiddenFor(model => model.MapSourceIndex)
		@Html.HiddenFor(model => model.MenuItemChange)
		@Html.HiddenFor(model => model.MapLongitude)
		@Html.HiddenFor(model => model.MapLatitude)
		@Html.HiddenFor(model => model.MapLongitudeStr)
		@Html.HiddenFor(model => model.MapLatitudeStr)
		@Html.HiddenFor(model => model.DropdownModel.EquipmentMenuExpanded)
		@Html.HiddenFor(model => model.DropdownModel.FacilityMenuExpanded)
		@Html.HiddenFor(model => model.DropdownModel.DeliveryLocationMenuExpanded)
		@Html.HiddenFor(model => model.DropdownModel.TankMenuExpanded)
		@Html.HiddenFor(model => model.DropdownModel.BreadcrumbMenuExpanded)
		@Html.HiddenFor(model => model.DropdownModel.SelectedEquipment)
		@Html.HiddenFor(model => model.DropdownModel.SelectedDeliveryLocation)
		@Html.HiddenFor(model => model.DropdownModel.SelectedFacility)
		@Html.HiddenFor(model => model.DropdownModel.SelectedTank)
		@Html.HiddenFor(model => model.DropdownModel.SelectedBreadcrumb)
		@Html.HiddenFor(model => model.DropdownModel.SelectedBreadcrumbIndex)
	</div>
}

