                                    </td>
                                    <td>
                                        <input id="StartDensity" class="formfield" placeholder="Density" readonly="readonly" disabled />
                                    </td>
                                    <td>
                                        <input id="StartDensityTimePicker" type="text" class="HandgaugeDatePickers formfield" placeholder="Density Date/Time" readonly="readonly" disabled />
                                    </td>
                                    <td>
