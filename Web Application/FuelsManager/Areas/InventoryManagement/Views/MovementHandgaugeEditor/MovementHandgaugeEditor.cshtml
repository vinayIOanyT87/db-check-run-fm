    var temperatureLbl = FMBaseController.TranslateText("Movement|Temperature");
    var DensityLbl = FMBaseController.TranslateText("Movement|Density");
    var stdDensityLbl = FMBaseController.TranslateText("Movement|Std Density");
    var densityTempLbl = FMBaseController.TranslateText("Movement|Density Temp");
    var ambientTempLbl = FMBaseController.TranslateText("Movement|Ambient Temp");
    var waterLevelLbl = FMBaseController.TranslateText("Movement|Water Level");
    var refHeightLbl = FMBaseController.TranslateText("Movement|Ref Height");
    var volumeTovLbl = FMBaseController.TranslateText("Movement|Volume (TOV)");
    var grossVolumeLbl = FMBaseController.TranslateText("Movement|Gross Volume");
    var netVolumeLbl = FMBaseController.TranslateText("Movement|Net Volume");
