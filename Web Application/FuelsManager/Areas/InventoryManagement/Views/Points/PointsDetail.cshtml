        <!-- Point Command Editor Modal -->
        <div class="row">
            <div id="PointCommandStatusEditorScreen" class="modal fade" data-backdrop="static" data-focus-on="input:first" role="dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-body">
                        <section id="pointCommandStatusEditorBody" class=""></section>
                    </div>
                    <div class="modal-footer">
                        <div class="btn-toolbar">
                            <div class="pull-left">

                            </div>
                            <div class="pull-right">
                                <button id="PCESaveButton" type="button" class="formfieldtitle pushButton" accessKey="s" style="width: 100px;" onclick='$("#PointCommandStatusEditorScreen").find("form").submit()'>
                                    @FMBaseController.TranslateText("&Save")
                                </button>
                                <button id="PCECloseButton" type="button" class="formfieldtitle pushButton" accessKey="c" data-dismiss="modal" style="width: 100px;">
                                    @FMBaseController.TranslateText("&Close")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
