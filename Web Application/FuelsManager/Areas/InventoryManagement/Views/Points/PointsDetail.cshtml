	// open editor for opc ua connections
	function onOpcUaEdit(paramPointTagGuid, pointTagSelectedIndex)
	{
		$('#PointTagSelectedIndex').val(pointTagSelectedIndex);
		var tagData = { pointTagGuid: paramPointTagGuid };

		// create the backdrop and wait for next modal to be triggered
		$('body').modalmanager('loading');

		// close all the notifications currently openned
		FMErrorAndExceptionHandling.CloseNotifications();

		var stack_bottomright_opcuaeditor = { "dir1": 'up', "dir2": 'left', "firstpos1": 15, "firstpos2": 25, "context": $('#OPCEditorScreen') };

		var notificationAttributes = { addclass: 'stack-bottomright', stack: stack_bottomright_opcuaeditor };


		var token = $('#pointPropertiesForm input[name =__RequestVerificationToken]').val();
		var headers = {};
		headers['__RequestVerificationToken'] = token;

		$.ajax({
			type: "GET",
			cache: false,
			headers: headers,
			url: "@Url.Action("OpcUaBrowser", "OpcUaEditor")",
			data: tagData,
			success: function (response)
			{
