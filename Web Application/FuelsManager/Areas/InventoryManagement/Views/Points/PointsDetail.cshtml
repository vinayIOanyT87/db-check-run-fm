	$(document).ready(function ()
	{
		// see the last tab in use for the point editor
		FMPointEditor.localStorageKey = "FMPointEditor_" + $("#SiteGuid").val() + "_" + $("#UserGuid").val();
		FMPointEditor.pointGuid = $("#IdentityGuid").val();
		FMPointEditor.unitConversionHistory = [];

		var lastSettings = localStorage.getItem(FMPointEditor.localStorageKey);

		// if no previous configuration add one
		if (lastSettings === null)
		{
			localStorage.setItem(FMPointEditor.localStorageKey, JSON.stringify({ pointGuid: FMPointEditor.pointGuid, activeTab: "SETTING" }));
		}
		else
		{
			lastSettings = JSON.parse(lastSettings);
			if (lastSettings.pointGuid === FMPointEditor.pointGuid)
			{
				switch (lastSettings.activeTab)
				{
					case "SETTING":
						break;
					case "TAG":
						$("#PETags").click();
						break;
					case "MODULE":
						$("#PEModules").click();
						break;
					case "ALERT":
						$("#PEAlarms").click();
						break;
				}
			}
		}

		// This sets the nice scrolling on the Point Setting section of the page.
		$('#SettingDivScroll').niceScroll({
			cursorwidth: '10px'
		 , autohidemode: false
		 , cursorcolor: "#486899"
		 , background: "#f9f9f9"
		 , railoffset: true
		 , railpadding: { top: 0, right: 0, left: -5, bottom: 0 }
		 , smoothscroll: true
		});
		// the html helper sets always the attribute 'selected' for the options (sets to false if not selected). select2 expects the selected attribute only for those selected
		$('#PEPointCategory').find('option[selected=false]').removeAttr('selected');
		$('#PEPointCategory').select2();



		// if there is a change to any of the fields mark as the values have changed
		$(".mainPage").on("input", "#PTTPointEditHolder > .row input, #PTTPointEditHolder > .row select, .PESettingPanel input, .PESettingPanel select", function ()
		{
			FMPointEditor.valuesChanged = true;
		});
		// NOTE: events for select control do not bubble up in IE so we cannot use event delegates.
		// we must rewire the event for the setting panels every time we perform a seach since we lose the events when the tags get copied
		$("#PTTPointEditHolder > .row select, .PESettingPanel select").on("change", function ()
		{
			FMPointEditor.valuesChanged = true;
		});

		// NOTE, I have to bind the chnage event because the input event doesn't seem to be working with checkboxes and radio buttons
		$(".mainPage").on("change", "#PTTPointEditHolder > .row input, #TagEditTable input", function ()
		{
			FMPointEditor.valuesChanged = true;
		});

		var applyButton = $('#ApplyButtonId');
		var ampersandIndex = applyButton.text().indexOf('&');
		if (ampersandIndex !== -1)
		{
			var hotKey = applyButton.text().charAt(ampersandIndex + 1);
			applyButton.html(applyButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
			applyButton.attr('accesskey', hotKey);
		}

	});

</script>

