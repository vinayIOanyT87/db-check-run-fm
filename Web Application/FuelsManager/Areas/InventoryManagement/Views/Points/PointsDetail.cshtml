                                <button id="DAMESaveButton" type="button" class="formfieldtitle pushButton" accessKey="s" style="width: 100px;" onclick='$("#DeviceAlarmMapsEditorScreen").find("form").submit()'>
                                    @FMBaseController.TranslateText("&Save")
                                </button>
                                <button id="DAMECloseButton" type="button" class="formfieldtitle pushButton" accessKey="c" data-dismiss="modal" style="width: 100px;">
                                    @FMBaseController.TranslateText("&Close")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dialog Messages -->
        <div class="hidden">
            <div id="dialog-save-confirm" title="@FMBaseController.TranslateText("Save To Continue")">
                <p>@FMBaseController.TranslateText("Do you want to save before proceeding?")</p>
            </div>
        </div>
    </div>
</body>
<script>
    $(document).ready(function () {

        var okButton = $('#DAMESaveButton');   //bds
        ampersandIndex = okButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = okButton.text().charAt(ampersandIndex + 1);
            okButton.html(okButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            okButton.attr('accesskey', hotKey);
        }


        var cancelButton = $('#DAMECloseButton');   //bds
        ampersandIndex = cancelButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = cancelButton.text().charAt(ampersandIndex + 1);
            cancelButton.html(cancelButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            cancelButton.attr('accesskey', hotKey);
        }

        var pceokButton = $('#PCESaveButton');   //bds
        ampersandIndex = pceokButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = pceokButton.text().charAt(ampersandIndex + 1);
            pceokButton.html(pceokButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            pceokButton.attr('accesskey', hotKey);
        }


        var pcecancelButton = $('#PCECloseButton');   //bds
        ampersandIndex = pcecancelButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = pcecancelButton.text().charAt(ampersandIndex + 1);
            pcecancelButton.html(pcecancelButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            pcecancelButton.attr('accesskey', hotKey);
		}
    });
    // when the save button in the Module Property Editor modal is clicked just submit the form inside the editor
	$("#PEMPESavePropertyScreen").click(
		function ()
		{
			$("#ModulePropertyEditorPropertyScreen").find('form').submit();
		});
	// when the apply button in the OPC Editor modal is clicked just submit the form inside the editor
	$("#PEMPESaveOPCEditor").click(
		function ()
		{
			$("#OPCEditorScreen").find('#opcUaBrowserForm').submit();
		});
	// when the apply button in the Point Value Configuration Editor modal is clicked just submit the form inside the editor
	$("#PEMPESavePointValueConfigurationEditor").click(
		function ()
		{
			$("#PEMPESavePointValueConfigurationEditor").attr("disabled", true);
			$("#PointValueConfigurationEditorScreen").find('form').submit();
			$("#PEMPESavePointValueConfigurationEditor").attr("disabled", false);
		});

	$("#PCECloseButton").click(
		function () {
			$('#PointCommandStatusEditorScreen').show();

			$('.tab-content .dataTable').each(function (index, table) {
				$(table).DataTable().destroy();
			});


			$('#pointCommandStatusEditorBody').html('');
		}
	);

	$("#DAMECloseButton").click(
		function () {
			$('#DeviceAlarmMapsEditorScreen').show();

			$('.tab-content .dataTable').each(function (index, table) {
				$(table).DataTable().destroy();
			});

			$('#DeviceAlarmMapsEditorBody').html('');
		}
	);

	window.ReloadAfterFCEE = false;

	$("#PEMPEClosePropertyScreen").click(
		function () {
			if (window.ReloadAfterFCEE) {
				window.ReloadAfterFCEE = false;
				window.location.reload();
			}
			else {
				$('#DeviceAlarmMapsEditorBody').html('');
				$(".modal-header").show();
				$("#moduleEditorPropertyScreen").html('');
				$("#ModulePropertyEditorPropertyScreen .modal-footer .btn-toolbar .pull-left").html('');
			}

		}
	);



	function PointTemplateRedirect(Guid)
								{
									var newUrl = "?target=../InventoryManagement/PointCustomTemplateDetail/PointTemplateDetail/"+Guid+"&CSRFToken=@Session["CSRFToken"]";
									window.top.location.search = newUrl;
								}

</script>
