	// Catch any bubbling focusin events (focus does not bubble)
	$(document).on('focusin', ':input', AlarmEditor.OnFocusIn);

	function onModuleClick(moduleInstanceGuid, pointGuid)
	{
		var module = { 'moduleTemplateGuid': moduleInstanceGuid, 'pointGuid': pointGuid };

		// close all the notifications currently openned
		FMErrorAndExceptionHandling.CloseNotifications();

		var token = $('#pointPropertiesForm input[name =__RequestVerificationToken]').val();
		var headers = {};
		headers['__RequestVerificationToken'] = token;

		$.ajax({
			type: "GET",
			cache: false,
			headers: headers,
			url: "@Url.Action("GetModuleEditorPartialView", "Points")",
			data: module,
			datatype: "json",
			success: function (response)
			{
				FMErrorAndExceptionHandling.HandleMessages(response, function (data, inError)
				{
					if (!inError)
					{
						$('#ModuleDetails').html(data);
					}
				});
			},
			error: function (xhr, textStatus, error)
			{
				FMErrorAndExceptionHandling.ShowException(xhr, textStatus, error);
			}
		});
	}


	// open editor for strap table
	function onStrapTableClickPropertyScreen( paramIsTemplatePoint, paramPointGuid, paramModulePointPropertyGuid)
	{

		var strapTable = {  isTemplatePoint: paramIsTemplatePoint, pointGuid: paramPointGuid, pointPropertyGuid: paramModulePointPropertyGuid };

		var _openStrapTable = function ()
		{
			// create the backdrop and wait for next modal to be triggered
			$('body').modalmanager('loading');
			// close all the notifications currently openned
			FMErrorAndExceptionHandling.CloseNotifications();

			var token = $('#pointPropertiesForm input[name =__RequestVerificationToken]').val();
			var headers = {};
			headers['__RequestVerificationToken'] = token;

			$.ajax({
				type: "GET",
				cache: false,
				headers: headers,
				url: "@Url.Action("StrapTableEditor", "StrapTableEditor")",
				data: strapTable,
				success: function (response)
				{
					FMErrorAndExceptionHandling.HandleMessages(response, function (data, inError)
					{
						if (!inError)
						{
							// replace the holder with the partial view
							$('#moduleEditorPropertyScreen').html(data);
							// change the modal title
							$('#PMEEditorNamePropertyScreen').text('@FMBaseController.TranslateText("Strap Table Editor")');
							// show the modal
							$('#ModulePropertyEditorPropertyScreen').modal('show');
							$('#pointPropertiesForm input[type=button], #pointPropertiesForm input[type=submit]').removeAttr("disabled");
							if ($("#EditorSaveAllowed").val() == "False") {
								$('#PEMPESavePropertyScreen').attr('disabled', true);
								$('#PEMPESavePropertyScreen').attr('style', "cursor: not-allowed !important;");
								$('#addStrapEntryButton_0').attr('style', "display: none;");
								$('#deleteStrapEntriesButton_0').attr('style', "display: none;");
								$('#SEDeleteTable').attr('style', "display: none;");
								$('#importExportdiv').attr('style', "display: none;");
								$('#addTable').attr('style', "display: none;");

							}
						}
						else
						{
							// remove the loading of the modal
							var modalManager = $("body").data("modalmanager");
							modalManager.removeLoading();
						}
					});

				},
				error: function (xhr, textStatus, error)
				{
					FMErrorAndExceptionHandling.ShowException(xhr,
						textStatus,
						error,
						function ()
						{
							// remove the loading of the modal
							var modalManager = $("body").data("modalmanager");
							modalManager.removeLoading();
						});
				}
			});
		}


		// if the user made any changes prompt to save
		if (FMPointEditor.valuesChanged)
		{

			FMLayout.ConfirmSaveCancel($("#dialog-save-confirm"),
				$("#dialog-save-confirm").attr('title'),
				function ()
				{
					// call the save form and tell it to open the strap table if successful
					FMPointEditor.saveChanges($('#pointPropertiesForm').attr("action"), $('#pointPropertiesForm').attr("method"), _openStrapTable, '', '');
				});
		}
			// if no changes then open the modal form directly
		else
		{
			_openStrapTable();

		}

	}


