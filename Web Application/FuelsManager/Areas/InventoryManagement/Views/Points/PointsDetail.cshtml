        <!-- Device Alarm Maps Editor Modal -->
        <div class="row">
            <div id="DeviceAlarmMapsEditorScreen" class="modal fade" data-keyboard="false" data-backdrop="static" data-focus-on="input:first" role="dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-body">
                        <section id="DeviceAlarmMapsEditorBody" class=""></section>
                    </div>
                    <div class="modal-footer">
                        <div class="btn-toolbar">
                            <div class="pull-left">

