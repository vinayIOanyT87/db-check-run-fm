        </div>
        <div id="dialogboxmessages" class="hidden">
            <div id="confirm-scaling-confirmation-dialog" title="Confirm Scaling Change">
                <p>@FMBaseController.TranslateText("PointEditor|New Units Selected.")<br />@FMBaseController.TranslateText("PointEditor|Rescale All Associated Data Values?")</p>
            </div>
            <div id="confirm-name-confirmation-dialog" title="Confirm Name Change">
                <p>@FMBaseController.TranslateText("PointEditor|A new template name was entered.")<br />@FMBaseController.TranslateText("PointEditor|Continue using the new template name?")</p>
            </div>
            <div id="confirm-range-confirmation-dialog" title="Confirm Range Change">
                <p>@FMBaseController.TranslateText("PointEditor|New Range value was entered.")<br />@FMBaseController.TranslateText("PointEditor|Rescale All Associated Alarm Limits and Deadband?")<br />@FMBaseController.TranslateText("PointEditor|If you choose No, some limits may be out of range!")</p>
            </div>
        </div>
        <!-- Modal -->
        @{
            var saveButton = @FMBaseController.TranslateText("&Save");
            var closeButton = @FMBaseController.TranslateText("&Close");
        }
        <div class="row">
            <div id="ModulePropertyEditorPropertyScreen" class="modal fade modal-lg" data-backdrop="static" data-focus-on="input:visible:first" role="dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 id="PMEEditorNamePropertyScreen" class="modal-title">Editor</h4>
                    </div>
                    <div class="modal-body">
                        <section id="moduleEditorPropertyScreen" class=""></section>
                    </div>
                    <div class="modal-footer">
                        <div class="btn-toolbar">
                            <div class="pull-left">

                            </div>
                            <div class="pull-right">
                                <button id="PEMPESavePropertyScreen" type="button" class="formfieldtitle pushButton" style="width: 100px;" accessKey="@FMControls.GetAccessKey( saveButton )">
                                    @Html.Raw(FMControls.FormatButtonText(saveButton))
                                </button>
                                <button id="PEMPEClosePropertyScreen" type="button" class="formfieldtitle pushButton" data-dismiss="modal" style="width: 100px;" accessKey="@FMControls.GetAccessKey( closeButton )">
                                    @Html.Raw(FMControls.FormatButtonText(closeButton))
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @{
            var applyButton = @FMBaseController.TranslateText("&Apply");
            var cancelButton = @FMBaseController.TranslateText("&Cancel");
        }
        <!-- OPC Modal -->
        <div class="row">
            <div id="OPCEditorModal" class="modal fade modal-lg" data-width="1000" data-backdrop="static" data-focus-on="input:first" role="dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-body">
                        <section id="OPCEditorScreen" class=""></section>
                    </div>
                    <div class="modal-footer">
                        <div class="btn-toolbar">
                            <div class="pull-left">

                            </div>
                            <div class="pull-right">
                                <button id="PEMPESaveOPCEditor" type="button" class="formfieldtitle pushButton" accessKey="@FMControls.GetAccessKey( applyButton )">
                                    @Html.Raw(FMControls.FormatButtonText(applyButton))
                                </button>
                                <button id="PEMPECloseOPCEditor" type="button" class="formfieldtitle pushButton" data-dismiss="modal" accessKey="@FMControls.GetAccessKey( cancelButton )">
                                    @Html.Raw(FMControls.FormatButtonText(cancelButton))
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PointValueConfigurationEditor Modal -->
        <div class="row">
            <div id="PointValueConfigurationEditorModal" class="modal fade modal-lg" data-backdrop="static" data-focus-on="input:first" role="dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-body">
                        <section id="PointValueConfigurationEditorScreen" class=""></section>
                    </div>
                    <div class="modal-footer">
                        <div class="btn-toolbar">
                            <div class="pull-left">

                            </div>
                            <div class="pull-right">
                                <button id="PEMPESavePointValueConfigurationEditor" type="button" class="formfieldtitle pushButton" accessKey="@FMControls.GetAccessKey(applyButton)">
                                    @Html.Raw(FMControls.FormatButtonText(applyButton))
                                </button>
                                <button id="PEMPEClosePointValueConfigurationEditor" type="button" class="formfieldtitle pushButton" data-dismiss="modal" accessKey="@FMControls.GetAccessKey(cancelButton)">
                                    @Html.Raw(FMControls.FormatButtonText(cancelButton))
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
