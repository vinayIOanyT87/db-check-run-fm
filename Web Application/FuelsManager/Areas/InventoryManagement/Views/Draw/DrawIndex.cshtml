	function saveImportFile() {
		var inError = false;

		// Point Template selection
		var selectedPointTemplate = $("#wsPointDetailPointTemplate").select2('data');
		var pointTagTemplateGuid = selectedPointTemplate[0].id;
		var pointTagTemplateName = selectedPointTemplate[0].text
		var wsPointDetailName =  $("#wsPointDetailName").val();
		var importFileContent = FMDraw.wizardProperties.fileContent;
		var originalModel = JSON.stringify( FMDraw.wizardProperties.fileContent.graphic.model);

		// change the nodes
		if( FMDraw.wizardProperties.fileContent.graphic.model.modelData.hasOwnProperty( "PointTemplateGuid" )) {
			FMDraw.wizardProperties.fileContent.graphic.model.modelData.PointTemplateGuid = pointTagTemplateGuid;
		}
		// for buttons that open graphics we need to reset them (remove the graphic they are going to open) because they may not exists
		FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray = jQuery.map( FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray, function( obj ) {

			// remove the animation references
			if( obj.hasOwnProperty("AnimationPointValueAssignments")) {
				delete obj.AnimationPointValueAssignments;
			}

			// remove graphic references
			if( obj.hasOwnProperty("buttonActionType") && obj.buttonActionType == "BUTTON_ACTION_GRAPHIC") {
				var removeGraphic = true;
				if ( obj.hasOwnProperty("buttonActionObjectGuid") && obj.buttonActionObjectGuid.hasOwnProperty("drawingGuid")) {
					// if the graphic referenced is in this site there is no need to remove it
					if( FMDraw.wizardProperties.GraphicsList.findIndex(function(t){return (t.Key.toLowerCase() === obj.buttonActionObjectGuid.drawingGuid.toLowerCase())} ) >= 0) {
						removeGraphic = false;
					}
				}

				if (removeGraphic) {
				// check if the graphic exists for this site, if not remove the entry
					if (obj.hasOwnProperty("buttonActionObjectGuid"))  delete obj.buttonActionObjectGuid;
					if (obj.hasOwnProperty("buttonActionObjectId"))  delete obj.buttonActionObjectId;
				}
			}

			// remove button (detail or command) pointing to a specific point (not the template)
			if( obj.hasOwnProperty("buttonActionType") &&
				( obj.buttonActionType == "BUTTON_ACTION_COMMAND" || obj.buttonActionType == "BUTTON_ACTION_DETAIL")
				&& obj.PointGUID != FMDraw.wizardProperties.fileContent.pointTemplateGuid) {
				// if the point exists in the site leave the control alone, otherwise clear the point configuration
				if( obj.PointGUID && FMDraw.wizardProperties.PointList.findIndex(function(t){return (t.Key.toLowerCase() === obj.PointGUID.toLowerCase())} ) >= 0) {

				} else {
					if (obj.hasOwnProperty("buttonActionObjectGuid"))  delete obj.buttonActionObjectGuid;
					if (obj.hasOwnProperty("buttonActionObjectId"))  delete obj.buttonActionObjectId;
					if (obj.hasOwnProperty("PointGUID"))  delete obj.PointGUID;
					if (obj.hasOwnProperty("TagGUID"))  delete obj.TagGUID;
					if (obj.hasOwnProperty("TagPointValueType"))  delete obj.TagPointValueType;
					if (obj.hasOwnProperty("TagPropertyID"))  delete obj.TagPropertyID;
					if (obj.hasOwnProperty("TagPointID"))  delete obj.TagPointID;
					if (obj.hasOwnProperty("TagTagID"))  delete obj.TagTagID;
					if (obj.hasOwnProperty("TagPointIDAndTagID"))  delete obj.TagPointIDAndTagID;
					if (obj.hasOwnProperty("PointTemplateTagSelectionIndicator"))  delete obj.PointTemplateTagSelectionIndicator;
				}
			}
			// remove TAGs and BARs that point to specific points
			if( obj.hasOwnProperty("category") &&
				( obj.category == "tag" || obj.category == "bar")
				&& obj.PointGUID != FMDraw.wizardProperties.fileContent.pointTemplateGuid) {
				// if the point exists in the site leave the control alone, otherwise clear the point configuration
				if( obj.PointGUID && FMDraw.wizardProperties.PointList.findIndex(function(t){return (t.Key.toLowerCase() === obj.PointGUID.toLowerCase())} ) >= 0) {

				} else {
					if (obj.hasOwnProperty("PointGUID"))  delete obj.PointGUID;
					if (obj.hasOwnProperty("TagGUID"))  delete obj.TagGUID;
					if (obj.hasOwnProperty("TagPointValueType"))  delete obj.TagPointValueType;
					if (obj.hasOwnProperty("TagPropertyID"))  delete obj.TagPropertyID;
					if (obj.hasOwnProperty("TagPointID"))  delete obj.TagPointID;
					if (obj.hasOwnProperty("TagTagID"))  delete obj.TagTagID;
					if (obj.hasOwnProperty("TagPointIDAndTagID"))  delete obj.TagPointIDAndTagID;
					if (obj.hasOwnProperty("PointTemplateTagSelectionIndicator"))  delete obj.PointTemplateTagSelectionIndicator;
				}
			}

			if( obj.hasOwnProperty("senderDiagramGUID")) {
				obj.senderDiagramGUID = pointTagTemplateGuid;
			}

			// trend and point detail buttons specify a tag that is always the first tag in the list, we need to update them
			if ( obj.hasOwnProperty("buttonActionType") &&
					( obj.buttonActionType == "BUTTON_POINT_TREND" || obj.buttonActionType == "BUTTON_ACTION_DETAIL")) {

				if ( obj.PointGUID == FMDraw.wizardProperties.fileContent.pointTemplateGuid &&
					FMDraw.wizardProperties.TemplateDataValues.length > 0 ) {
					var destinationTag = FMDraw.wizardProperties.TemplateDataValues[0];
					obj.TagGUID = destinationTag.pointValueIdentifier.IdentityGuid;
					obj.TagPointValueType =  destinationTag.pointValueIdentifier.PointValueType;
					obj.TagPropertyID =  destinationTag.pointValueIdentifier.PropertyID;
					obj.PointGUID = pointTagTemplateGuid;
					obj.TagPointID = pointTagTemplateName;
					obj.TagTagID =  destinationTag.ID;
					obj.TagPointIDAndTagID = pointTagTemplateName + ( obj.TagPointIDAndTagID.indexOf(" : ") >= 0 ? " : " +  destinationTag.ID : "");
					if (obj.hasOwnProperty("buttonActionObjectId"))  {
						obj.buttonActionObjectId = obj.TagPointIDAndTagID;
					}
					if (obj.hasOwnProperty("buttonActionObjectGuid") && obj.PointGUID === FMDraw.wizardProperties.fileContent.pointTemplateGuid)  {
						obj.buttonActionObjectGuid = pointTagTemplateGuid;
					}
				} else {
					delete obj.TagGUID;
					delete obj.TagPointValueType;
					delete obj.TagPropertyID;
					delete obj.PointGUID;
					delete obj.TagPointID;
					delete obj.TagTagID;
					delete obj.TagPointIDAndTagID;
					if (obj.hasOwnProperty("buttonActionObjectGuid"))  delete obj.buttonActionObjectGuid
					if (obj.hasOwnProperty("buttonActionObjectId"))  delete obj.buttonActionObjectId
					if (obj.hasOwnProperty("PointTemplateTagSelectionIndicator"))  delete obj.PointTemplateTagSelectionIndicator;
				}
			}

			return obj;
		});

		// create a temporary property for the TagGuid since we are changing it and we don't want to override it
		FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray = jQuery.map( FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray, function( obj ) {
			if( obj.hasOwnProperty("TagTagID")) {
				obj.OriginalTagTagID = JSON.parse(JSON.stringify(obj.TagTagID)); // I need the actual value not the reference to the object
			};
			return obj;
		});

		// update the tags in the graphic with the selected values in the second page in the wizard
		$( "#wzPointDataValueList tbody tr" ).each(function( index ) {
			var sourceTagName = $( this ).find( "label" ).text();
			var sourceTagIdx = $( this ).find( "td:first" ).attr('data-idx');
			var destTagIdx = $( this ).find( "select" ).val();
			var destTagName = $( this ).find( "select option:selected" ).text();

			var sourceTag = FMDraw.wizardProperties.DataValues[sourceTagIdx];
			var destinationTag = FMDraw.wizardProperties.TemplateDataValues[destTagIdx];


			// process the graphic model with the changes from the wizard

			// change the nodes
			FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray = jQuery.map( FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray, function( obj ) {
				if( obj.hasOwnProperty("TagGUID") && obj.OriginalTagTagID == sourceTagName) {

					if( obj.hasOwnProperty("PointGUID") && obj.PointGUID != FMDraw.wizardProperties.fileContent.pointTemplateGuid) {
						// if refering to specific point don't do anything here since we will deal with it somewhere else
					} else if( destTagIdx == "" ) {
						// if no mapping between point data values or we are using a specific point we need to remove the properties
						delete obj.TagGUID;
						delete obj.TagPointValueType;
						delete obj.TagPropertyID;
						delete obj.TagTagID;
						delete obj.TagPointIDAndTagID;
						if (obj.hasOwnProperty("buttonActionObjectGuid"))  delete obj.buttonActionObjectGuid
						if (obj.hasOwnProperty("buttonActionObjectId"))  delete obj.buttonActionObjectId
						if ( obj.hasOwnProperty("category") &&  ( obj.category == "tag" || obj.category == "bar") ) {
							if (obj.hasOwnProperty("PointTemplateTagSelectionIndicator"))  obj.PointTemplateTagSelectionIndicator = true;
							obj.PointGUID = pointTagTemplateGuid;
							obj.TagPointID = pointTagTemplateName;
						} else {
							if (obj.hasOwnProperty("PointTemplateTagSelectionIndicator"))  delete obj.PointTemplateTagSelectionIndicator;
							delete obj.PointGUID;
							delete obj.TagPointID;
						}

					} else {
						obj.TagGUID = destinationTag.pointValueIdentifier.IdentityGuid;
						obj.TagPointValueType =  destinationTag.pointValueIdentifier.PointValueType;
						obj.TagPropertyID =  destinationTag.pointValueIdentifier.PropertyID;
						obj.PointGUID = pointTagTemplateGuid;
						obj.TagPointID = pointTagTemplateName;
						obj.TagTagID =  destTagName;
						obj.TagPointIDAndTagID = pointTagTemplateName + ( obj.TagPointIDAndTagID.indexOf(" : ") >= 0 ? " : " +  destTagName : "");
						if (obj.hasOwnProperty("buttonActionObjectId"))  {
							obj.buttonActionObjectId = obj.TagPointIDAndTagID;
						}
						if (obj.hasOwnProperty("buttonActionObjectGuid") && obj.PointGUID === FMDraw.wizardProperties.fileContent.pointTemplateGuid)  {
							obj.buttonActionObjectGuid = pointTagTemplateGuid;
						}
					}

				}
				return obj;
			});

		})

		// delete the temporary property created in the process so we don't save it
		FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray = jQuery.map( FMDraw.wizardProperties.fileContent.graphic.model.nodeDataArray, function( obj ) {
			if( obj.hasOwnProperty("OriginalTagTagID")) {
				delete obj.OriginalTagTagID;
			};
			return obj;
		});

		var animationstoUpdate = jQuery.grep( importFileContent.animations, function( obj, idx ) {
			var include = false;
			// only pass to the server new animations or the ones that need to be updated
			if ( FMDraw.wizardProperties.AnimationList[idx].Value == 'NEW') {
				obj.AnimationGuid = "00000000-0000-0000-0000-000000000000";
				return true;
			} else if ( FMDraw.wizardProperties.AnimationList[idx].Value == 'DIFFERENT' &&
				$("#wzAnimationList tbody tr [data-guid='"+ obj.AnimationGuid +"']").next().find("input:checked").val() == 'update') {
				// the animationGuid may have changed if tthere was an existing one at the site
				var newAnimationGuid =  $("#wzAnimationList tbody tr [data-guid='"+ obj.AnimationGuid +"']").next().find("input:checked").attr( 'data-newguid' );
				obj.AnimationGuid = newAnimationGuid;
				return true;
			}
			return false;
		});

		var data = new FormData(); //FormData object
		data.append( "pointTagTemplateGuid", pointTagTemplateGuid );
		data.append( "pointDetailName", wsPointDetailName );
		data.append("published", 'true');
		data.append("pointDetailGraphic", JSON.stringify(importFileContent.graphic));
		data.append( "pointDetailPictures", JSON.stringify(importFileContent.pictures) );
		data.append( "pointDetailAnimations", JSON.stringify(animationstoUpdate) );

		var token = $( 'input[name=__RequestVerificationToken]' ).val();
		var headers = {};
		headers['__RequestVerificationToken'] = token;

		var url = $( '#importPointDetail' ).attr( 'data-url' );

		// remove previous notifications
		PNotify.removeStack( );

		$.ajax( {
			type: 'POST',
			url: url,
			dataType: 'json',
			enctype: 'multipart/form-data',
			headers: headers,
			processData: false,
			contentType: false,
			data: data,
			success: function( result )
			{


				if (typeof result != 'undefined' && result != null) {
					var count = 0;
					if (result && result.SuccessMessage) {
						$.each(result.SuccessMessage, function (key, message) { count = count + 1; });
					}
					if (count > 0) { // if save was succesful
						var messageList = [];
						// add messages but avoid duplicates
						var seen = {};
						$.each(result.SuccessMessage, function (key, message) {
							$.each(message, function (i, val) {
								if (!seen[message[i]]) {
									seen[message[i]] = true;
									messageList.push(message[i]);
								}
							});
						});
						var messages = messageList.join('');
						var res = messages.split("-");

					}
				}
				var returnValue = true;
				FMErrorAndExceptionHandling.HandleMessages(result,
						function (data, inError) {
							if (!inError) {
								FMDraw.wizardProperties.fileContent = {};
								FMDraw.wizardProperties.DataValues = [];
								FMDraw.wizardProperties.AnimationDataValues = [];
								FMDraw.wizardProperties.SpecificPointUsed = false;
								FMDraw.wizardProperties.SpecificGraphicUsed = false;
								FMDraw.wizardProperties.TemplateDataValues = [];
								FMDraw.wizardProperties.PointList = [];
								FMDraw.wizardProperties.GraphicsList = [];
								FMDraw.wizardProperties.AnimationList = [];
								if ($('#layers-dialog').dialog('isOpen')) {
									$('#layers-dialog').dialog('close');}
								// open the graphic that was just imported
								FMDrawIndex.LoadDrawing( data + ',' + wsPointDetailName + ',' + 'Imported');

								$('#ImportPointDetailWizard').modal('hide');
							} else {
								FMDraw.wizardProperties.fileContent.graphic.model = JSON.parse( originalModel );
							}
						});

			},
			error: function( request, status, error )
			{
				FMErrorAndExceptionHandling.ShowException( request, status, error, null );
			}
		} );
	}


	function importRetrievePointDataValues( pointTemplateGuid ) {
		// sort the list of animations by ID
		FMDraw.wizardProperties.fileContent.animations.sort(function(a, b){
			var x = a.ID.toLowerCase();
			var y = b.ID.toLowerCase();
			if (x < y) {return -1;}
			if (x > y) {return 1;}
			return 0;});

		var token = $( 'input[name=__RequestVerificationToken]' ).val();
		var headers = {};
		headers['__RequestVerificationToken'] = token;
		var data = {"pointTemplateGuid": pointTemplateGuid, "pointDetailAnimations": JSON.stringify(FMDraw.wizardProperties.fileContent.animations) };

		$.ajax( {
			type: 'POST',
			cache: false,
			headers: headers,
			url: "GetImportWizardMappingOptions",
			dataType: 'json',
			contentType: 'application/json; charset=utf-8',
			data: JSON.stringify(data),
			success: function( response )
			{
				FMErrorAndExceptionHandling.HandleMessages( response, function( data, inError )
				{
					if ( !inError || ( data != null ) )	{
						FMDraw.wizardProperties.TemplateDataValues = data.pointValueIdentifiers;
						FMDraw.wizardProperties.PointList =  data.pointNameList;
						FMDraw.wizardProperties.GraphicsList =  data.drawingsList;
						FMDraw.wizardProperties.AnimationList =  data.animationList;
						// update the select in the tables with the options
						$( "#wzPointDataValueList tbody tr" ).each(function( index ) {
							var sourceName = $( this ).find( "label" ).text();
							var sourceTagDataType = $( this ).find( "td:first" ).attr('data-datatype');

							$( this ).find('option').remove();

							FMDraw.wizardProperties.TemplateDataValues.sort(function(a, b){
								var x = a.ID.toLowerCase();
								var y = b.ID.toLowerCase();
								if (x < y) {return -1;}
								if (x > y) {return 1;}
								return 0;});

							var option = '<option></option>';
							for (var i = 0; i < FMDraw.wizardProperties.TemplateDataValues.length; i++) {
								if ( sourceTagDataType =="" || FMDraw.wizardProperties.TemplateDataValues[i].DataType == sourceTagDataType || FMDraw.wizardProperties.TemplateDataValues[i].pointValueIdentifier.PointValueType != 0 ) {
									option += '<option value="' + i + '"' + (FMDraw.wizardProperties.TemplateDataValues[i].ID == sourceName  ? "selected" : "") + '>' + FMDraw.wizardProperties.TemplateDataValues[i].ID + '</option>';
								}
							}
							$( this ).find('select').append(option);
						})
						$( "#wzPointDataValueList tbody tr" ).find('select').select2();

						// create the animation screen
						$("#wzAnimationList tbody").html('');

						for (var i = 0; i < FMDraw.wizardProperties.fileContent.animations.length; i++) {
							var sourceTag = "<td data-idx='" + i + "' data-guid='" + FMDraw.wizardProperties.fileContent.animations[i].AnimationGuid + "'><label>" + FMDraw.wizardProperties.fileContent.animations[i].ID + "</label></td>";

							var targetTag = "";
							switch(FMDraw.wizardProperties.AnimationList[i].Value) {
								case 'SAME':
									targetTag = "<td><label>Animation already exists</label></td>";
									break;
								case 'NEW':
									targetTag = "<td><label>Animation will be added</label></td>";
									break;
								case 'DIFFERENT':
									targetTag = "<td><label class='radio-inline'><input type='radio' name='optradio" + i + "' value='update' data-newguid='" + FMDraw.wizardProperties.AnimationList[i].Key + "'checked>Update</label><label class='radio-inline'><input type='radio' name='optradio" + i + "' value='leave'>Leave Existing</label></td>";
									break;
								default:
									break;
							}

							var newRowContent = "<tr>"+ sourceTag + targetTag + "</tr>"
							$("#wzAnimationList tbody").append(newRowContent);
						}
						// open the second page in the import wizard
						// set width of the modal to be 700
						$('body').data().modalmanager.stack[0].options.width = 700;

						// if there are no point values show message, otherwise show list of point values
						if ( $( "#wzPointDataValueList tbody tr" ).length > 0 )
						{

							$("#wzPage2Tags").removeClass("hidden");
							$("#wzPage2NoTags").removeClass("hidden").addClass("hidden");
						} else {
							$("#wzPage2Tags").removeClass("hidden").addClass("hidden");
							$("#wzPage2NoTags").removeClass("hidden");
						}

						// if there are no animations show message, otherwise show list of point values
						if ( $( "#wzAnimationList tbody tr" ).length > 0 )
						{
							$("#wzPage3Animations").removeClass("hidden");
							$("#wzPage3NoAnimations").removeClass("hidden").addClass("hidden");
						} else {
							$("#wzPage3Animations").removeClass("hidden").addClass("hidden");
							$("#wzPage3NoAnimations").removeClass("hidden");
						}
						// reset/initialiaze the fields
						$("#ImportPointDetailWizardPage1").removeClass("hidden").addClass("hidden");
						$("#ImportPointDetailWizardPage2").removeClass("hidden");
						$("#ImportPointDetailWizardPage3").removeClass("hidden").addClass("hidden");
						$("#ImportPointDetailWizardPage4").removeClass("hidden").addClass("hidden");

						$("#ImportPointDetailWizardNextButton").removeClass("hidden");
						$("#ImportPointDetailWizardPreviousButton").removeClass("hidden");
						$("#ImportPointDetailWizardSaveButton").removeClass("hidden").addClass("hidden");

						FMDraw.wizardProperties.activePage = 2;

						$('#ImportPointDetailWizardPage2 input[required]:visible').each(function () {
							$(this).parent().removeClass('has-error');
						});

						// This sets the nice scrolling on the Property Window.
						$('#wzPointDataValueListWrapper').niceScroll({
							cursorwidth: '10px'
							, autohidemode: false
							, cursorcolor: "#486899"
							, background: "rgb(240, 240, 240)"
							, railoffset: true
							, enablemousewheel: true
							, smoothscroll: true
							, mousescrollstep: 5
							, horizrailenabled: false
						});

						$("#wsPointDetailPointTemplate").focus();

						$(window).resize(); // force the modal to center
					}
				} );
			},
			error: function( xhr, textStatus, error )
			{
				FMErrorAndExceptionHandling.ShowException( xhr, textStatus, error, function()
				{
				} );
			}
		} );

	}
</script>

