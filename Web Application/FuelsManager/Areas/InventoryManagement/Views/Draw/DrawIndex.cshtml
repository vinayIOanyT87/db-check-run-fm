		$("#flipvertical").click(function(e){

			var diagram = FMDrawIndex.GetActiveTabGoJSDiagramObject();
			if(!diagram){
				return;
			}

			diagram.startTransaction("flip");
			diagram.selection.each(function(object){
				if(typeof object.data.isGroup === 'boolean' && object.data.isGroup === true){
					object.memberParts.each(function(node){
						var angle = 0;
						if(node.data.angle){
							angle = node.data.angle;
						}
						diagram.model.setDataProperty(node.data, 'angle', -angle);
						var shape = node.findObject('SHAPE');
						if(shape){
							if(shape instanceof go.Shape){
								var geo = shape.geometry.copy();
								geo.scale(-1, 1);
								geo.normalize();
								shape.geometry = geo;
							}

							else if(shape instanceof go.Picture){
							}
						}

						var bgshape = node.findObject('BGSHAPE');
						if(bgshape){
							if(bgshape instanceof go.Shape){
								var geo = bgshape.geometry.copy();
								geo.scale(-1, 1);
								geo.normalize();
								bgshape.geometry = geo;
							}
						}


						// horizontally flip the text
						var valuetable = node.findObject('VALUETABLE');
						if(valuetable && valuetable instanceof go.Panel){
							if(valuetable.angle == 0){
								diagram.model.setDataProperty(object.data, 'valuetableangle', 180);
							}
							else {
								diagram.model.setDataProperty(object.data, 'valuetableangle', 0);
							}
						}
						else{
							var textblock = node.findObject('TEXTBLOCK');
							if(textblock && textblock instanceof go.TextBlock)
							{
								if(textblock.angle == 0){
									diagram.model.setDataProperty(object.data, 'textangle', 180);
								}
								else {
									diagram.model.setDataProperty(object.data, 'textangle', 0);
								}
							}
						}
					});
				}
				else
				{
					// rotate the object through 180 - angle
					var angle = 0;

					if(object.data.angle)
					{
						angle = object.data.angle;
					}
					diagram.model.setDataProperty(object.data, 'angle', 180 - angle);

					// horizontally flip the shape
					var shape = object.findObject('SHAPE');
					var geo;

					if(shape)
					{
						if(shape instanceof go.Shape)
						{
							geo = shape.geometry.copy();
							geo.scale(-1, 1);
							geo.normalize();
							shape.geometry = geo;
						}
						else if(shape instanceof go.Picture)
						{
						}
					}

					var bgshape = object.findObject('BGSHAPE');
					if(bgshape && bgshape instanceof go.Shape)
					{
						geo = bgshape.geometry.copy();
						geo.scale(-1, 1);
						geo.normalize();
						bgshape.geometry = geo;
					}

					// horizontally flip the text
					var valuetable = object.findObject('VALUETABLE');
					if(valuetable && valuetable instanceof go.Panel){
						if(valuetable.angle === 0)
						{
							diagram.model.setDataProperty(object.data, 'valuetableangle', 180);
						}
						else
						{
							diagram.model.setDataProperty(object.data, 'valuetableangle', 0);
						}
					}
					else
					{
						var textblock = object.findObject('TEXTBLOCK');
						if(textblock  && textblock instanceof go.TextBlock)
						{
							if(textblock.angle === 0)
							{
								diagram.model.setDataProperty(object.data, 'textangle', 180);
							}
							else
							{
								diagram.model.setDataProperty(object.data, 'textangle', 0);
							}
						}
					}
				}
			});
			diagram.commitTransaction("flip");
			diagram.focus();
		});

