	FMDraw.wizardProperties.fileContent = {};
   FMDraw.exportAfterSaving = false;

	FMDraw.headerToolsRight = function()
	{
		var ret = 0;
		var headerToolArr = $( "#header a" ).toArray();
		for ( var i = 0; i < headerToolArr.length; i++)
		{
			var headerTool = headerToolArr[i];
			var id = headerTool.id;
			var headerToolObj = $( "#" + id );
			var headerToolRight = headerToolObj.position().left + headerToolObj.width();
			if ( ret < headerToolRight )
			{
				ret = headerToolRight;
			}
		}
		ret = ret + 5;
		return ret;
	}

	FMDraw.close = function (tab)
	{

		FMDraw.closeTarget = tab;
		if ($("div#tabs >ul >li").size() == 1) {
			FMLayout.Alert("One tab must remain active!", 'Alert', null);
			return;
		}

		if (FMDrawIndex.TabDiagramModified(tab))
		{
			$("#confirm-save-dialog").html(FMDrawIndex.GetTabName(tab) + " has not been saved. Would you like to save it first?");
			var tabname = "#tab" + tab;
			var index = $("#tabs a[href='" + tabname + "']").parent().index();
			$('div#tabs').tabs("option", "active", index);
			$("#confirm-save-dialog").dialog("open");
		}
		else
		{
			FMDraw.closetab(false);
		}
	}

	FMDraw.closetab = function (forceClose)
	{
		var tab = FMDraw.closeTarget;
		var tabname;
		var index;

		if (!forceClose && tab !== undefined && FMDrawIndex.ConfirmClearClipboard(tab))
		{
			$("#confirm-clear-clipboard-dialog").html(FMDrawIndex.GetTabName(tab) + " has unsaved image data saved to the clipboard. Are you sure you want to close this drawing?  (Doing so will clear the image data from the clipboard).");
			tabname = "#tab" + tab;
			index = $("#tabs a[href='" + tabname + "']").parent().index();
			$('div#tabs').tabs("option", "active", index);
			$("#confirm-clear-clipboard-dialog").dialog("open");
		}
		else
		{
			tabname = "#tab" + FMDraw.closeTarget;
			if($("#tabs a[href='" + tabname + "']").length == 0){
				return;
			}
			index = $("#tabs a[href='" + tabname + "']").parent().index(); //$('div#tabs').tabs("option", "active", index);
			//var tabindex = $("div#tabs").tabs('option', 'active');
			$("div#tabs").find(".ui-tabs-nav li:eq(" + index + ")").remove();
			$(tabname).remove();

			var collectionIndex = parseInt(tabname.substring(tabname.indexOf("b") + 1));
			FMDrawIndex.ClearTabMemory(collectionIndex);

			$("div#tabs").tabs("refresh");
		}
	}

	//FMDraw.baseUrl = '@Url.Content("~")';

    FMDraw.baseUrl = ApplicationBaseUrl;
    //console.log('FMDraw.baseUrl=' + FMDraw.baseUrl);

	//==================================================================
	// In order for the property menu window to dock on the right side,
	// the following must occur:  1) The property menu window must be
	// shown; 2) It must be dragged over the right side droppable area.
	//==================================================================
	FMDraw.InitiallyDockThePropertyMenu = function()
	{
		FMDraw.propertiespopupmenu.div.show();
		var draggable = FMDraw.propertiespopupmenu.div.draggable();
		var droppable = FMDraw.rightsidebar.div.droppable();

		var draggableOffset = draggable.offset();
		var droppableOffset = droppable.offset();
		var dx = droppableOffset.left - draggableOffset.left;
		var dy = droppableOffset.top - draggableOffset.top;

		FMDraw.propertiespopupmenu.div.simulate( "drag", { dx: dx, dy: dy } );
	}

	FMDraw.RotateToolBarMenu = function()
	{
		// set the initial position of the tools menu only worry about the top left position
		var rect = document.getElementById(FMDraw.sidebar.handle).getBoundingClientRect();

		var rotateToolbar = FMDrawIndex.ReadDrawPersistentData(rect);

		if(rotateToolbar === 0)
		{
			return;
		}

		var dropPositionleft = 15;
		var dropPositiontop = 35;
		var dropped = "sidebar";

		if (FMDraw[dropped] == undefined)
		{
			return;
		}

		if ( dropped === "propertiespopupmenu" )
		{
			return;
		}

		FMDraw.header.dockarray.push(FMDraw[dropped]);

		for (var i in FMDraw.header.dockarray)
		{
			FMDraw.header.dockarray[i].div.stop();
			FMDraw.header.dockarray[i].docked = FMDraw.header;
			FMDraw.header.dockarray[i].div.resizable("disable");
			FMDraw.header.dockarray[i].div.css({ height: FMDraw.header.dockarray[i].xheight });
			FMDraw.header.dockarray[i].div.css({ width: FMDraw.header.dockarray[i].xwidth });
			FMDraw.header.dockarray[i].div.css({ zIndex: 998 });
			var dragPosition = FMDraw.header.dockarray[i].div.offset();

			if ((dropPositionleft + FMDraw.header.dockarray[i].xwidth) > FMDraw.header.div.width())
			{
				dropPositiontop = dropPositiontop + 42;
				dropPositionleft = -233;
			}

			var leftEnd = dropPositionleft - dragPosition.left + FMDraw.headerToolsRight();
			var topEnd = dropPositiontop - dragPosition.top;

			FMDraw.header.dockarray[i].div.animate({
				top: '+=' + topEnd,
				left: '+=' + leftEnd
			}, 200);
			document.getElementById(FMDraw.header.dockarray[i].handle).style.transform = "rotate(90deg)";
			dropPositionleft = dropPositionleft + FMDraw.header.dockarray[i].xwidth;
		}

	}

	//==============================================================
	// This function will close the property window and if it is
	// docked, reset the right side dockable area back to its
	// original size.
	//==============================================================
	FMDraw.ClosePropertyMenuWindow = function()
	{
		FMDraw.propertiespopupmenu.div.hide();

		if ( FMDraw.propertiespopupmenu.docked != null )
		{
			if(FMDraw.propertiespopupmenu.dockedLocation === "RIGHT")
			{
				$("#rightsidebar").css({ 'width': "41px" });
				$("#docking-right").css({ 'width': "41px" });
			}
		}

		if (FMDraw.propertiespopupmenu.dockedLocation === "LEFT")
		{
			// This if for another iteration when the left side docking is resizable.
		}
	}

	//============================================================================
	// This function will handle the resizing of the right side docking area. It
	// works with the docking of the property menu winodw.
	//============================================================================
	FMDraw.isRightSideDockResizing = false;
	FMDraw.didRightSideDockResizeOccur = false;
	$(function () {

		var container	= $('#content'),
		    left		= $('#docking-left'),
		    right		= $('#rightsidebar'),
		    innerRight	= $("#docking-right"),
		    propRight	= $("#propertiespopupmenu"),
		    handle		= $('#rightSideBarDrag');

		handle.on('mousedown', function (e)
		{
			FMDraw.isRightSideDockResizing = true;
		});

		$(document).on('mousemove', function (e)
		{
			// Do not do anything if not resizing and the property menu is not docked.
			if ( FMDraw.isRightSideDockResizing === false || FMDraw.propertiespopupmenu.docked == null ||  FMDraw.propertiespopupmenu.dockedLocation !== "RIGHT")
			{
				return;
			}

			// Do not allow resizing of the right side docking area if the property menu window
			// is not displayed in the dockable area. The property menu window can be docked
			// and not displayed. This only occurs when the page is initially created.
			var propertyMenuDisplayState = FMDraw.propertiespopupmenu.div.css( 'display' );
			if ( propertyMenuDisplayState !== "block" )
			{
				return;
			}

			var offsetRight = container.width() - (e.clientX - container.offset().left);

			// For the property window the minimum width is 276.
			if ( offsetRight < 276 )
			{
				offsetRight = 276;
			}

			left.css('right', offsetRight);
			right.css('width', offsetRight);
			innerRight.css('width', offsetRight);
			propRight.css('width', offsetRight);
			FMDraw.didRightSideDockResizeOccur = true;
		}).on('mouseup', function (e)
		{
			// Stop resizing
			FMDraw.isRightSideDockResizing = false;
			var propertyMenuDisplayState = FMDraw.propertiespopupmenu.div.css( 'display' );

			// In order for the property window scrollbar to reposition after resizing the docking
			// area, it must be hiden and then reopened.  This is only done if it is docked
			// and being displayed.
			if ( FMDraw.propertiespopupmenu.docked != null && propertyMenuDisplayState === 'block' && FMDraw.didRightSideDockResizeOccur === true )
			{
				FMDraw.propertiespopupmenu.div.hide();
				FMDrawPropertyMenu.OpenPropertiesPopupMenu();
				FMDraw.didRightSideDockResizeOccur = false;
			}
		});
	});


