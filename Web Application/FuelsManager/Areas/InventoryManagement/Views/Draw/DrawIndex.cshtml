	// when file in selection box has changed we want to call the import
	$( '#importPointDetail' ).on('change', function() {
		// if we have files
		if ( $( this )[0].files.length > 0 )
		{
			var reader = new FileReader();
			var fileName = $( this )[0].files[0].name;
			// Closure to capture the file information.
			reader.onload = function(readEvt) {
				var fileContents = readEvt.target.result;
				try {
					var importedDrawing = JSON.parse(fileContents);
					if ( importedDrawing.hasOwnProperty( 'version' ) && importedDrawing.hasOwnProperty( 'name' ) ) {
						if ( importedDrawing.version === "1.0" && importedDrawing.name === "FuelsManager Graphic Export") {
							importProcessing(fileName, importedDrawing);
							return;
						}
					}
					FMErrorAndExceptionHandling.ShowError( "Invalid File Format: This file was not generated by FuelsManager." );
				} catch (e) {
					FMErrorAndExceptionHandling.ShowError( "Invalid File Format: " + e );
					return;
				}

			};

			reader.readAsText($( this )[0].files[0]);

		}
		return false;
	} );


	function importProcessing(fileName, importObj) {
		// we need a wizard to resolve some questions before we import

		// create the backdrop and wait for next modal to be triggered
		var modalManager = $('body').modalmanager('loading');

		FMDraw.wizardProperties.fileContent = importObj;
		FMDraw.wizardProperties.DataValues = [];
		FMDraw.wizardProperties.AnimationDataValues = [];
		FMDraw.wizardProperties.SpecificPointUsed = false;
		FMDraw.wizardProperties.SpecificGraphicUsed = false;
		FMDraw.wizardProperties.TemplateDataValues = [];
		FMDraw.wizardProperties.PointList = [];
		FMDraw.wizardProperties.GraphicsList = [];
		FMDraw.wizardProperties.AnimationList = [];

		// get the list of tags in the graphic
		importProcessingGetTags(importObj.graphic.model.nodeDataArray);

		var token = $( 'input[name=__RequestVerificationToken]' ).val();
		var headers = {};
		headers['__RequestVerificationToken'] = token;

		$.ajax( {
			type: 'GET',
			cache: false,
			headers: headers,
			url: "GetListPointTemplates",
			dataType: 'json',
			contentType: 'application/json; charset=utf-8',
			success: function( response )
			{
				FMErrorAndExceptionHandling.HandleMessages( response, function( data, inError )
				{
					if ( !inError || ( data != null ) )
					{
						$('#wsPointDetailPointTemplate').find('option').remove();

						var option = '<option></option>';
						var defaultPointTemplateGuid = FMDraw.wizardProperties.fileContent.pointTemplateGuid;

						for (var i = 0; i < data.length; i++) {
							option += '<option value="' + data[i].PointTemplateGuid + '"' + (data[i].PointTemplateGuid == defaultPointTemplateGuid  ? "selected='true'" : "") + '>' + data[i].ID + '</option>';
						}
						$('#wsPointDetailPointTemplate').append(option);

						// initialize the drop down and set a default value
						$('#wsPointDetailPointTemplate').select2({
							placeholder: "Select a Point Template",
							allowClear: true
						});

						// reset/initialiaze the fields

						$("#ImportPointDetailWizardPage1").removeClass("hidden");
						$("#ImportPointDetailWizardPage2").removeClass("hidden").addClass("hidden");
						$("#ImportPointDetailWizardPage3").removeClass("hidden").addClass("hidden");
						$("#ImportPointDetailWizardPage4").removeClass("hidden").addClass("hidden");

						$("#wzTitleFileName").text(fileName);
						$("#wsPointDetailName").val(fileName.replace(/\.[^/.]+$/, ""));

						// reset buttons
						$("#ImportPointDetailWizardNextButton").removeClass("hidden");
						$("#ImportPointDetailWizardPreviousButton").removeClass("hidden").addClass("hidden");
						$("#ImportPointDetailWizardSaveButton").removeClass("hidden").addClass("hidden");
						FMDraw.wizardProperties.startPage = 1;
						FMDraw.wizardProperties.activePage = 1;

						// create the list of tags in the drawing
						$("#wzPointDataValueList tbody").html('');

						//remove duplicates from the list of data values
						var uniqueDataValues = [];

						$.each(FMDraw.wizardProperties.DataValues, function( index, value ) {
							var valueFoundIdx =  uniqueDataValues.findIndex(function(t){return (t.TagTagID === value.TagTagID)})
							if ( valueFoundIdx < 0) {
								uniqueDataValues.push( value )
							} else {
								if (value.hasOwnProperty("TagDataType") && value.TagDataType != "") {
									uniqueDataValues[ valueFoundIdx ].TagDataType = value.TagDataType

								}
							}

						});
						FMDraw.wizardProperties.DataValues = uniqueDataValues;

						// sort the list of data values by tagid
						FMDraw.wizardProperties.DataValues.sort(function(a, b){
							var x = a.TagTagID.toLowerCase();
							var y = b.TagTagID.toLowerCase();
							if (x < y) {return -1;}
							if (x > y) {return 1;}
							return 0;});

						for (var i = 0; i < FMDraw.wizardProperties.DataValues.length; i++) {
							var sourceTag = "<td data-idx='" + i + "' data-datatype='" + FMDraw.wizardProperties.DataValues[i].TagDataType + "'><label>" + FMDraw.wizardProperties.DataValues[i].TagTagID + "</label></td>";
							var targetTag = "<td><select class='form-control'></select></td>";
							var newRowContent = "<tr>"+ sourceTag + targetTag + "</tr>"
							$("#wzPointDataValueList tbody").append(newRowContent);
						}

						$('#ImportPointDetailWizard').modal('show');
					}
					else {
						$('body').modalmanager('loading'); // remove the loading background
					}
				} );
			},
			error: function( xhr, textStatus, error )
			{
				FMErrorAndExceptionHandling.ShowException( xhr, textStatus, error, function()
				{
					$('body').modalmanager('loading'); // remove the loading background
					FMDraw.wizardProperties.fileContent = {};
					FMDraw.wizardProperties.DataValues = [];
					FMDraw.wizardProperties.AnimationDataValues = [];
					FMDraw.wizardProperties.SpecificPointUsed = false;
					FMDraw.wizardProperties.SpecificGraphicUsed = false;
					FMDraw.wizardProperties.TemplateDataValues = [];
				} );
			}
		} );
	}

	function importProcessingGetTags(obj){
		// traverse the json object getting all the pointvalues
		for (var i = 0; i < obj.length; i++) {
//			if (Array.isArray(obj[i]) ) {
//				importProcessingGetTags(obj[i]);
//			} else {
			if (typeof obj[i] === 'object' && obj[i].hasOwnProperty("TagGUID")) {
					// if the pointguid in the node is the same as the template we are importing then we want it in the list
					// but we want to exclude trend and point detail buttons because they always use the first tag in the template
					if ( obj[i].PointGUID.toLowerCase() == FMDraw.wizardProperties.fileContent.pointTemplateGuid.toLowerCase()
						&& !(obj[i].hasOwnProperty("buttonActionType") && ( obj[i].buttonActionType == "BUTTON_POINT_TREND" || obj[i].buttonActionType == "BUTTON_ACTION_DETAIL"))) {
						FMDraw.wizardProperties.DataValues.push( {"TagGUID": obj[i].TagGUID, "TagPointValueType": obj[i].TagPointValueType, "TagPropertyID": obj[i].TagPropertyID, "TagTagID": obj[i].TagTagID, "TagDataType": (obj[i].hasOwnProperty("TagDataType") ? obj[i].TagDataType: "")} );
					} else {  // else we are using a specific point (unless is a trend or detail button)

						if ( obj[i].PointGUID.toLowerCase() == FMDraw.wizardProperties.fileContent.pointTemplateGuid.toLowerCase()
							&& (obj[i].hasOwnProperty("buttonActionType") && ( obj[i].buttonActionType == "BUTTON_POINT_TREND" || obj[i].buttonActionType == "BUTTON_ACTION_DETAIL"))) {
						} else {
							FMDraw.wizardProperties.SpecificPointUsed  = true;
						}

					}
				}
			// check to see if it has animations
				if ( typeof obj[i] === 'object'
							&& obj[i].hasOwnProperty("AnimationPointValueAssignments")
							&& obj[i].AnimationPointValueAssignments != null
							&& obj[i].AnimationPointValueAssignments.hasOwnProperty("TestGroupPointValueInfoList")
					&& Array.isArray(obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList)) {
					for (var j = 0; j < obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList.length; j++) {
						if ( obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList[j].PointGuid.toLowerCase() == FMDraw.wizardProperties.fileContent.pointTemplateGuid.toLowerCase() ) {
							FMDraw.wizardProperties.AnimationDataValues.push( {"TagGUID": obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList[j].PointValueGuid,
								"TagPointValueType": obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList[j].ValueType,
								"TagPropertyID": obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList[j].PointValueID,
								"TagTagID": obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList[j].PointValueID,
								"TagDataType": (obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList[j].hasOwnProperty("DataType") ? obj[i].AnimationPointValueAssignments.TestGroupPointValueInfoList[j].DataType: "")} );
					} else {  // else we are using a specific point (unless is a trend or detail button)
						if (obj[i].PointGUID !== undefined && obj[i].PointGUID.toLowerCase() == FMDraw.wizardProperties.fileContent.pointTemplateGuid.toLowerCase()) {
						} else {
							FMDraw.wizardProperties.SpecificPointUsed  = true;
						}

					}
				}
			}
		}
	}

	$('#ImportPointDetailWizardNextButton').on('click', function () {
		switch (FMDraw.wizardProperties.activePage) {
			case 1:
				// verify that we pass validation
				var inError = false;

				var controlErrors = $('#ImportPointDetailWizardPage1 .has-error');
				controlErrors.removeClass('has-error');

				$('#ImportPointDetailWizardPage1 input[required]:visible').each(function () {
					if ($(this).val() === "") {
						inError = true;
						$(this).parent().removeClass('has-error').addClass('has-error');
					}
				});

				// check if the point template has been selected
				var selectedPointTemplate = $("#wsPointDetailPointTemplate").select2('data');
				if (selectedPointTemplate[0].id == "") {
					inError = true;
					$('#ImportPointDetailWizardPage1 .select2').addClass('has-error');
				}

				var errorMessage = "";

				if (inError === true && errorMessage !==""){
					FMErrorAndExceptionHandling.CloseNotifications();
					FMErrorAndExceptionHandling.ShowError(errorMessage, function(){});
					return;
				}

				if (inError === true) return;
				//get and populate the list of point data value for the selected template
				importRetrievePointDataValues( selectedPointTemplate[0].id );


				break;
			case 2:
				FMErrorAndExceptionHandling.CloseNotifications();
				// set width of the modal to be 500
