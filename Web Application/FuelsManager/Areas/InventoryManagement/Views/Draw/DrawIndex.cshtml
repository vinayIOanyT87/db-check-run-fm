	 input[type=range] {
		 -webkit-appearance: none;
		 width: 100%;
		 margin: 1px 7px 0;
	 }

	input[type=range]:focus {
		outline: none;
	}

	input[type=range]::-webkit-slider-runnable-track {
		width: 100%;
		height: 2px;
		cursor: pointer;
		box-shadow: 1px 1px 1px #808080, 0px 0px 1px #8d8d8d;
		background: #dddddd;
		border-radius: 1.3px;
		border: 0px solid #010101;
	}

	input[type=range]::-webkit-slider-thumb {
		box-shadow: 1px 1px 1px #000000, 0px 0px 1px #0d0d0d;
		border: 0px solid #000000;
		height: 16px;
		width: 8px;
		border-radius: 4px;
		background: white;
		cursor: pointer;
		-webkit-appearance: none;
		margin-top: -8px;
	}

	input[type=range]:focus::-webkit-slider-runnable-track {
		background: #eaeaea;
	}

	input[type=range]::-moz-range-track {
		width: 100%;
		height: 2px;
		cursor: pointer;
		box-shadow: 1px 1px 1px #808080, 0px 0px 1px #8d8d8d;
		background: #dddddd;
		border-radius: 1.3px;
		border: 0px solid #010101;
	}

	input[type=range]::-moz-range-thumb {
		box-shadow: 1px 1px 1px #000000, 0px 0px 1px #0d0d0d;
		border: 0px solid #000000;
		height: 20px;
		width: 8px;
		border-radius: 4px;
		background: white;
		cursor: pointer;
	}

	input[type=range]::-ms-track {
		width: 100%;
		height: 2px;
		cursor: pointer;
		background: transparent;
		border-color: transparent;
		color: transparent;
	}

	input[type=range]::-ms-fill-lower {
		background: #d0d0d0;
		border: 0px solid #010101;
		border-radius: 2.6px;
		box-shadow: 1px 1px 1px #808080, 0px 0px 1px #8d8d8d;
	}

	input[type=range]::-ms-fill-upper {
		background: #dddddd;
		border: 0px solid #010101;
		border-radius: 2.6px;
		box-shadow: 1px 1px 1px #808080, 0px 0px 1px #8d8d8d;
	}

	input[type=range]::-ms-tooltip {
		display: none;
	}

	input[type=range]::-ms-thumb {
		box-shadow: 1px 1px 1px #000000, 0px 0px 1px #0d0d0d;
		border: 0px solid #000000;
		height: 20px;
		width: 8px;
		border-radius: 4px;
		background: white;
		cursor: pointer;
	}

	input[type=range]:focus::-ms-fill-lower {
		background: #dddddd;
	}

	input[type=range]:focus::-ms-fill-upper {
		background: #eaeaea;
	}



