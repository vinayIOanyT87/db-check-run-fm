		FMDrawPropertyMenu.FMDrawPropertiesMenuDockSetting = FMDraw.propertiespopupmenu;
		FMDraw.sidebar = { div: $("#sidebar"), handle: "toolsdivider", docked: FMDraw.sidebarbackpanel, xwidth: 670, xheight: 39, ywidth: 40, yheight: 480 };

