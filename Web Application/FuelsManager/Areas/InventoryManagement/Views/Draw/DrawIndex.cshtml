		$("#save").click(function (e)
		{
			e.preventDefault();
			var href = $("div#tabs .ui-state-active > a").attr("href");
			href = href.substring(href.indexOf("b") + 1);
			FMDrawIndex.activeTabCanvasContainerIndex = [href];
			var rawmetadata = FMDrawIndex.tabCanvasContainerCollection[href].metaData;

			if (typeof rawmetadata === "string")
			{
				var metadata = rawmetadata.split(",");
				var name = metadata[0];
				var desc = metadata[1];

				var publishedCheckBox = document.getElementById("publishedCheckBox");
				var published = FMDrawIndex.GetDiagramModelDataValue('Published');

				if (published == 'true' && 'false' == ((publishedCheckBox.checked) ? 'true' : 'false')) {
					var href = $("div#tabs .ui-state-active > a").attr("href");
					href = href.substring(href.indexOf("b") + 1);
					$("#confirm-unpublish-dialog").html(FMDrawIndex.GetTabName(href) + " has been published and may be in use. Are you sure you would like to unpublish?");
					var tabname = "#tab" + href;
					var index = $("#tabs a[href='" + tabname + "']").parent().index();
					$('div#tabs').tabs("option", "active", index);
					$("#confirm-unpublish-dialog").dialog("open");
					return;
