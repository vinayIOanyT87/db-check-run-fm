	<div class="dialogDiv ui-widget-content" id="propertiespopupmenu" style="background: #567eb9;">
		<div id="propertiesPopupMenu-div-title" style="background: #3b5780;">
			<div style="padding-left: 5px">
				<label style="color: #ffffff; font-weight: normal; font-size: x-small">PROPERTIES</label>
				<span style="float: right">
					<a href="javascript:void(0)" onclick=" FMDraw.ClosePropertyMenuWindow() ">
						<img id="PropertyMenuCancel" alt="Cancel" src="~/fmwebapp/images/Small-Close-Icon.png" style="float: right; height: 23px" />
					</a>
				</span>
			</div>
		</div>
		<div id="propertiesPopupMenu-table" style="background: #567eb9; width: 100%; height: 100%; overflow: scroll; padding-top: 5px;">
			@foreach (DrawPropertyMenuRecord propertyRecord in Model.CommonPropertyList)
			{
				<div id='@propertyRecord.TableRowId' @propertyRecord.SectionNameWithAttr style="display: block;">

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.Textbox)
					{
						<div style="padding-left: 5px; padding-right: 20px;">
							<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label">@propertyRecord.PropertyLabelName</label>
							<input id="@propertyRecord.TextBoxId" type="text" style="width: @propertyRecord.TextboxWidth" @propertyRecord.TextboxReadonly @propertyRecord.TextboxDisabled onfocus=" this.select() "
									 onblur=" FMDrawPropertyMenu.SetPropertyOnObject( '@propertyRecord.PropertyName', '@propertyRecord.TextBoxId' ); " placeholder="######" class="property-menu-textbox" />
						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.TextboxWithButton)
					{
						<div style="padding-left: 5px; padding-right: 20px;">
							<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label">@propertyRecord.PropertyLabelName</label>
							<button id="@propertyRecord.ButtonId" onclick="@propertyRecord.ButtonActionValue" class="property-menu-actionbutton">...</button>
							<input id="@propertyRecord.TextBoxId" type="text" style="width: @propertyRecord.TextboxWidth" @propertyRecord.TextboxReadonly @propertyRecord.TextboxDisabled onfocus=" this.select() "
									 onblur=" FMDrawPropertyMenu.SetPropertyOnObject( '@propertyRecord.PropertyName', '@propertyRecord.TextBoxId' ); " placeholder="######" class="property-menu-textbox" />

						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.ButtonOnly)
					{
						<div style="padding-left: 5px; padding-right: 20px;">
							<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label">@propertyRecord.PropertyLabelName</label>
							<button id="@propertyRecord.ButtonId" onclick="@propertyRecord.ButtonActionValue" style="width: @propertyRecord.ButtonWidth; font-size: x-small;" class="property-menu-actionbutton">@propertyRecord.ButtonText</button>
						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.Dropdown)
					{
						<div style="padding-left: 5px; padding-right: 20px;">
							<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label">@propertyRecord.PropertyLabelName</label>
							<select id="@propertyRecord.DropdownId" class="property-menu-select" style="width: @propertyRecord.DropdownWidth" onchange=" FMDrawPropertyMenu.SetPropertyOnObject( '@propertyRecord.PropertyName', '@propertyRecord.DropdownId' ); ">
								@foreach (DrawPropertyMenuDropdown dropdownItem in propertyRecord.DropdownItems)
								{
									if (dropdownItem.Selected)
									{
										<option value="@dropdownItem.ValueAttribute" data-value="@dropdownItem.DataValueAttribute" selected>@dropdownItem.Text</option>
									}
									else
									{
										<option value="@dropdownItem.ValueAttribute" data-value="@dropdownItem.DataValueAttribute">@dropdownItem.Text</option>
									}
								}
							</select>
						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.Divider)
					{
						<div id="@propertyRecord.DividerId" style="display: @propertyRecord.HideStr">
							<div class="divTable">
								<div class="divTableRow">
									<div class="divTableCell3">
										<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label">@propertyRecord.SectionLabelName</label>
									</div>
									<div class="divTableCell1">
										<img src="~/fmwebapp/images/divider.jpg" style="width: 100%; height: 1px;" />
									</div>
									<div class="divTableCell2">
										<img id="@propertyRecord.SectionCollapseImageId" src="~/Areas/images/PropertyMenuSection-Arrow-down.png" style="width: 15px; height: 15px; float: right; padding-top: 5px" onclick=" FMDrawPropertyMenu.SectionExpandCollapseEvent( '@propertyRecord.SectionName' ) " />
									</div>
								</div>
							</div>
						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.FillColor)
					{
						<div style="padding-left: 5px; padding-right: 20px;">
							<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label">@propertyRecord.PropertyLabelName</label>
							<span style="float: right">
								<img id="@propertyRecord.FillColorImageId" onclick=" FMDrawPropertyMenu.ExpandColorSpectrum( '@propertyRecord.FillColorSpectrumColumnId' ) " src="~/fmwebapp/images/SmallArrowDown.png" style="width: 10px; height: 15px; vertical-align: top; margin: 0; border: 0; padding: 0" />
								<input id="@propertyRecord.TextBoxId" type="text" readonly="readonly" style="width: 50px; height: 15px; background: @propertyRecord.FillColorHex; border: 0; margin: 0; padding: 0" />
							</span>
						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.FillColorSpectrum)
					{
						<div id="@propertyRecord.FillColorSpectrumColumnId" colspan="2" style="width: 100%; padding-left: 5px; padding-right: 20px; padding-bottom: 5px; display: @propertyRecord.HideTableColumnStr">
							<table id="tableSpectrum" style="background: #ffffff; width: 290px">
								<tr>
									<td style="padding-left: 5px">
										<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label" style="color: #567eb9">Recent Colors</label>
									</td>
									<td style="padding-right: 5px">
										<span style="float: right; padding-top: 2px">
											@foreach (string recentColorId in propertyRecord.RecentColorTextBoxIds)
											{
												<input id="@recentColorId" type="text" readonly="readonly" class="property-menu-input-recent-colors" onclick=" FMDrawPropertyMenu.RecentColorSelection( '@recentColorId', '@propertyRecord.PropertyName' ) " />
											}
										</span>
									</td>
								</tr>
								<tr>
									<td style="padding-left: 5px; vertical-align: top">
										<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label" style="color: #567eb9">Pick a Color</label>
									</td>
									<td style="padding-right: 5px; float: right">
										<input id="@propertyRecord.SpectrumTextBoxId" type="text" style="float: right" />
									</td>
								</tr>
								<tr>
									<td style="padding-left: 5px;">
										<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label" style="color: #567eb9">Color HEX Value</label>
									</td>
									<td style="padding-right: 5px; float: right">
										<span>
											<input id="@propertyRecord.ManualColorTextBoxId" type="text" placeholder="#" style="font-size: 9px; width: 100px; height: 15px; border: 1px solid rgb(86, 126, 185);" oninput="FMDrawPropertyMenu.ManualColorChange('@propertyRecord.PropertyName');" onfocus=" FMDrawPropertyMenu.ManualColorFocus( '@propertyRecord.PropertyName' ); " />
											&nbsp;
											<input id="@propertyRecord.ManualColorSamplerTextBoxId" type="text" style="font-size: 9px; width: 60px; height: 15px; border: 1px solid rgb(86, 126, 185);" readonly="readonly" />
										</span>
									</td>
								</tr>
								<tr>
									<td colspan="2" style="width: 100%; text-align: center;">
										<input type="image" src="~/fmwebapp/images/SmallArrowUp.png" style="width: 10px; height: 15px" onclick=" FMDrawPropertyMenu.CollapseColorSpectrum( '@propertyRecord.FillColorSpectrumColumnId', '@propertyRecord.PropertyName' ) " />
									</td>
								</tr>
							</table>
						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.FillPattern)
					{
						<div style="padding-left: 5px; padding-right: 20px;">
							<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label">@propertyRecord.PropertyLabelName</label>
							<span style="float: right">
								<img id="@propertyRecord.FillPatternImageId" onclick=" FMDrawPropertyMenu.ExpandPatternPalette( '@propertyRecord.FillPatternPaletteColumnId' ) " src="~/fmwebapp/images/SmallArrowDown.png" style="width: 10px; height: 15px; vertical-align: top; margin: 0; border: 0; padding: 0" />
								<canvas id="@propertyRecord.CanvasId" width="50" height="15" style="background: #ffffff"></canvas>
							</span>
						</div>
					}

					@if (propertyRecord.ControlType == DrawPropertyMenuRecord.PropertyControlTypes.FillPatternPalette)
					{
						<div id="@propertyRecord.FillPatternPaletteColumnId" style="width: 300px; padding-left: 5px; padding-right: 20px; padding-bottom: 5px; display: @propertyRecord.HideStr">
							<div id="@propertyRecord.FillPatternPaletteScrollId" style="width: 300px; height: 105px; overflow: scroll">
								@foreach (DrawPropertyMenuPattern pattern in propertyRecord.PatternList)
								{
									<div style="background: #ffffff; width: 300px; height: 20px; padding-right: 20px; padding-left: 20px; padding-top: 5px;">
										@if (pattern.CanvasTagId == "canvasPalatte-propertiesMenu-FILLPATTERNPALETTE-1" || pattern.CanvasTagId == "canvasPalatte-propertiesMenu-LINESTYLEPALETTE-1" || pattern.CanvasTagId == "canvasPalatte-propertiesMenu-LINETOARROWPALETTE-1" || pattern.CanvasTagId == "canvasPalatte-propertiesMenu-LINEFROMARROWPALETTE-1")
										{
											<label id="@propertyRecord.LabelId" originalLabelName="@propertyRecord.PropertyLabelName" alternateLabelName="@propertyRecord.AlternateLabelName" class="property-menu-label" style="float: left; color: #567eb9">@propertyRecord.PropertyLabelName</label>
										}
										<span onclick=" FMDrawPropertyMenu.PatternOnClick( '@pattern.CanvasTagId', '@pattern.PatternNumber', '@propertyRecord.PropertyName' ) ">
											<canvas id="@pattern.CanvasTagId" width="80" height="15" style="float: right; border: 1px solid #3b5780;"></canvas>
										</span>
									</div>
								}
								<div style="background: #ffffff; width: 300px; height: 20px; padding-right: 20px; padding-left: 20px; padding-top: 5px;">
									<canvas id="dummyBecauseOfClipping" width="80" height="15" style="float: right; border: 0px;"></canvas>
								</div>
							</div>
							<div style="background: #ffffff; width: 300px; text-align: center">
								<input type="image" src="~/fmwebapp/images/SmallArrowUp.png" style="width: 10px; height: 15px" onclick=" FMDrawPropertyMenu.CollapsePatternPalette( '@propertyRecord.FillPatternPaletteColumnId' ) " />
							</div>
						</div>
					}
				</div>

			}
		</div>
	</div>

