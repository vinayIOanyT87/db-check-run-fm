			 },
			 // interactively prevent user from dragging the toolbar offscreen
          drag: function (event, ui) {
              var newTop = ui.position.top;
				  var newLeft = ui.position.left;
				  // upper limit
              if (ui.position.top < (0 - $("#header").height())) {
                  newTop = 0 - $("#header").height();
				  }
				  // lower limit
              if (ui.position.top > ($("#footer").offset().top - $("#footer").height())) {
						newTop = $("#footer").offset().top - $("#footer").height();
				  }
				  // leftmost limit
              if (ui.position.left < 0) {
                  newLeft = 0;
				  }
				  // rightmost limit
              if (ui.position.left > $("#rightsidebar").offset().left) {
                  newLeft = $("#rightsidebar").offset().left;
              }
              ui.position.top = newTop;
              ui.position.left = newLeft;
          },
