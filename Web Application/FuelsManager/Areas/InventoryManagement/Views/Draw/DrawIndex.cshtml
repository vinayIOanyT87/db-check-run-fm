							geo.scale(-1, 1);
							geo.normalize();
							shape.geometry = geo;
						}

						else if(shape instanceof go.Picture){
						}
					}

					var bgshape = object.findObject('BGSHAPE');
					if(bgshape && bgshape instanceof go.Shape){
						var geo = bgshape.geometry.copy();
						geo.scale(-1, 1);
						geo.normalize();
						bgshape.geometry = geo;
					}
				}
			});
			diagram.commitTransaction("flip");
		});

