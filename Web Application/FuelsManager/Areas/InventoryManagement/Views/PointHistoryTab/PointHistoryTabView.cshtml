    PointHistoryTab.GetHistoryData = function (controlId, pointGuid, interval, intervalQuantity, range, rangeQuantity, start) {
      var tagIds = [];
      var columns = FMOperateIndex.staticPointHistoryControllers[controlId]._grid.getColumns();
      for (i = 0; i < columns.length; i++) {
        if (columns[i].field !== 'Date Time' && columns[i].field !== '' && !tagIds.includes(columns[i].field)){
          tagIds.push(columns[i].field);
        }
      }

        var timezoneOffsetStr = $("#TimezoneOffsetString").val();
        var timezoneOffset = parseInt(timezoneOffsetStr);

        var startMomentTime = moment(start);
        startMomentTime = startMomentTime.subtract(timezoneOffset, 'minutes'); //go to UTC time
        startMomentTime = startMomentTime.add(startMomentTime.utcOffset(), 'minutes'); //go to client time
        start = startMomentTime.toDate().toLocaleString()

      // put messages on the actual tab
      var stack_bottomright_operatortab = { "dir1": 'up', "dir2": 'left', "firstpos1": 25, "firstpos2": 25, "context": $("#pointhistory" + controlId) };

      $.ajax({
        type: 'post',
        dataType: 'json',
        cache: false,
        url: $('#urlGetPointHistoryData').val(),
        controlId: controlId,
        contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
        data: { pointGuid: pointGuid, startString: start, interval: interval, intervalQuantity: Math.trunc(intervalQuantity), range: range, rangeQuantity: Math.trunc(rangeQuantity), tagIds },
        success: function (response) {
          var messageAttributes = { addclass: 'stack-bottomright', stack: stack_bottomright_operatortab, width: '450px' };
          var controlId = this.controlId;

          FMErrorAndExceptionHandling.HandleMessages(response, function (view, inError) {
            if (!inError || (view != null)) {
              // handle the results
              var data = [];
              for (i = 0; i < response.Data.length; i++) {
                var row = {};
                var momentTime = moment(response.Data[i].Time);

                momentTime = momentTime.subtract(momentTime.utcOffset(), 'minutes'); //go to UTC time
                momentTime = momentTime.add(timezoneOffset, 'minutes'); //go to site time

                row['Date Time'] = moment(momentTime).format('YYYY/MM/DD HH:mm:ss');
                for (const property in response.Data[i].Values) {
                  row[property] = response.Data[i].Values[property];
                }
                data.push(row);
              }

              FMOperateIndex.staticPointHistoryControllers[controlId]._grid.setData(data);
              FMOperateIndex.staticPointHistoryControllers[controlId]._grid.render();
            }
          }, messageAttributes);
        },
        error: function (xhr, textStatus, error) {
          var controlId = this.controlId;

          // need to make sure that the error we are getting is because we close the page before getting the response
          if (xhr.status != 0) {
            FMErrorAndExceptionHandling.ShowException(xhr,
              textStatus,
              error,
              function () {
                $("#loaderpointhistory" + newId).remove();
              });
          }
        }
      });
    }

    PointHistoryTab.HandleRefreshBtnEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid');
    var controlId = '@Model.ControlId';
    var data = PointHistoryTab.GetHistoryData(controlId, '@Model.PointGuid', $("#PointHistoryIntervalSelect_" + controlId).val(), $("#PointHistoryIntervalQuantity_" + controlId).val(), $("#PointHistoryRangeSelect_" + controlId).val(), $("#PointHistoryRangeQuantity_" + controlId).val(), $("#PointHistoryStartTimePicker_" + controlId).val());
  });

</script>

<div id="PointHistoryControlDiv">
  @Html.Hidden("PointHistoryColumns_" + Model.ControlId, Model.Columns)
  <table id="PointHistoryTable_@Model.ControlId">
    <tr>
      <td style="padding-left: 10px;">
        <div id="PointHistoryIdText">@Model.ID</div>
      </td>
      <td style="padding-left: 10px;">
        <label id="PointHistoryStartDateLabel" class="PointHistoryLabel" for="PointHistoryStartTimePicker_@Model.ControlId">Start Date:</label>
      </td>
      <td>
        <input id="PointHistoryStartTimePicker_@Model.ControlId" type="text" class="form-control text-center datepicker" style="width: 180px !important; border: 1px solid #567eb9" />
      </td>
      <td>
        <label id="PointHistoryIntervalLabel" class="PointHistoryLabel" for="PointHistoryIntervalSelect_@Model.ControlId">Interval:</label>
      </td>
      <td>
        <input id="PointHistoryIntervalQuantity_@Model.ControlId" type="number" class="form-control" style="width: 70px !important; border: 1px solid #567eb9" value="1" oninput="PointHistoryTab.HandleIntervalQuantityInputEvent('@Model.ControlId');" onchange="PointHistoryTab.HandleIntervalQuantityChangeEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid');" min="1" />
      </td>
      <td>
        <select id="PointHistoryIntervalSelect_@Model.ControlId" class="form-control" style="width: 100px !important; border: 1px solid #567eb9" onchange="PointHistoryTab.HandleIntervalSelectEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid', true);">
          <option value="0">Minute</option>
          <option value="1" selected>Hour</option>
          <option value="2">Day</option>
        </select>
      </td>
      <td>
        <label id="PointHistoryRangeLabel" class="PointHistoryLabel" for="PointHistoryRangeSelect_@Model.ControlId">Range:</label>
      </td>
      <td>
        <input id="PointHistoryRangeQuantity_@Model.ControlId" type="number" class="form-control" style="width: 70px !important; border: 1px solid #567eb9" value="1" oninput="PointHistoryTab.HandleRangeQuantityInputEvent('@Model.ControlId');" onchange="PointHistoryTab.HandleRangeQuantityChangeEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid');" min="1" />
      </td>
      <td>
        <select id="PointHistoryRangeSelect_@Model.ControlId" class="form-control" style="width: 100px !important; border: 1px solid #567eb9" onchange="PointHistoryTab.HandleRangeSelectEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid');">
          <option value="0">Hour</option>
          <option value="1" selected>Day</option>
          <option value="2">Month</option>
          <option value="3">Year</option>
        </select>
      </td>
      <td style="padding-left: 10px">
        <button id="PointHistoryRefreshButton_@Model.ControlId" type="button" class="PointHistoryHeaderButtonClass" onclick="javascript: return PointHistoryTab.HandleRefreshBtnEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid');">
          <Span>
            <img src="~/fmwebapp/images/RefreshMini.png" alt=@FMBaseController.TranslateText("Point History|Refresh") />
          </Span>
          @FMBaseController.TranslateText("Point History|Refresh")
        </button>
      </td>
    </tr>
  </table>
</div>
