@using System.Web.Mvc.Html
@using FMBusinessObjects.UtilityObjects
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.PointHistoryTabModel


<style>
  .PointHistoryHeaderButtonClass {
    text-align: left;
    padding-top: 4px;
    min-width: 95px;
    background-color: transparent;
    color: #486899 !important;
    border: 1px solid #486899;
    height: 34px;
    white-space: nowrap;
    vertical-align: middle;
    display: inline-block;
    font-size: 13px;
    font-weight: normal;
    line-height: 5px;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    margin-right: 5px;
  }

  button:active {
    background-color: whitesmoke;
  }

  button:hover {
    background-color: whitesmoke;
  }

  .PointHistoryHeaderButtonClass img {
    top: -2px;
    position: relative;
  }

  #PointHistoryTable td {
    padding: 4px;
  }

  .PointHistoryLabel {
    padding-top: 5px;
    padding-right: 10px;
    padding-left: 20px;
    font-size: 14px;
    font-weight: normal;
    color: rgb(72,104,153);
    text-align: left !important;
    vertical-align: middle;
  }

  .input-group.date {
    width: 100%;
  }

  input.hasDatepicker {
    display: inline-block;
    width: 85%;
    height: 34px;
  }

  .ui-datepicker-trigger {
    display: inline-block;
    float: right !important;
    Width: 25px !important;
    height: 25px;
    margin-top: 5px;
  }

  #PointHistoryIdText {
    font-size: 20px;
    padding-right: 20px;
  }

  .pointhistory-header-space {
    height: 5px;
  }
</style>

<script>
  var PointHistoryTab = PointHistoryTab || {
    stack_bottomright_pointhistory: {},
    messageAttributes: {},
  }

  //=====================================================================
  // This function will validate whether the date/time is valid. False
  // indicates invalid.
  //=====================================================================
  PointHistoryTab.ValidateDateTime = function (inDateTime) {
    if (inDateTime == null || inDateTime === "") {
      return true;
    }

   FMErrorAndExceptionHandling.CloseNotifications();
	FMErrorAndExceptionHandling.ClearControlErrors();
   FMErrorAndExceptionHandling.OnlyOneNotification = true;
    var numFormatInfoString = $("#NumberFormatInfoString").val();
    var numFormatInfo = JSON.parse(numFormatInfoString);
    var pattern = numFormatInfo.ShortDatePattern;

    // Moment does not like the slashes in a pattern, but handles the slashes in the date.
    pattern = pattern.replaceAll("/", "-");
    pattern = pattern.replaceAll("y", "Y");
    pattern = pattern.replaceAll("d", "D");
    pattern = pattern.replaceAll("m", "M");

    pattern = pattern + " " + "hh:mm tt";

    var dateTime = moment(inDateTime, pattern);
    var valid = dateTime.isValid();

    if (valid == false) {
      return false;
    }

    return true;
  };

  //=================================================================
  // This function handles the Start Date/Time change event.
  //=================================================================
  PointHistoryTab.HandleStartDateTimeEvent = function (tabId, controlId, pointId, pointGuid) {
    var dateTimeStr = $("#PointHistoryStartTimePicker_"+controlId).val();
    if (PointHistoryTab.ValidateDateTime(dateTimeStr) == false) {
      $("#PointHistoryStartTimePicker_"+controlId).val("");
      FMErrorAndExceptionHandling.ShowError('Start Date/Time is invalid.', null, PointHistoryTab.messageAttributes);
    }

    PointHistoryTab.PersistPointHistory({ tabId: tabId, controlId: controlId, pointId: pointId, pointGuid: pointGuid, start: $("#PointHistoryStartTimePicker_"+controlId).val(), interval: $("#PointHistoryIntervalSelect_"+controlId).val(), intervalQuantity: $("#PointHistoryIntervalQuantity_"+controlId).val(), range: $("#PointHistoryRangeSelect_"+controlId).val(), rangeQuantity: $("#PointHistoryRangeQuantity_"+controlId).val(), columns: $("#PointHistoryColumns_" + controlId).val() });
  };

	PointHistoryTab.SetMaximums = function (controlId) {

	  // Minute Interval & Hour Range
	  if ($("#PointHistoryIntervalSelect_" + controlId).val() === "0"
		  && $("#PointHistoryRangeSelect_" + controlId).val() === "0") {

		  $("#PointHistoryIntervalQuantity_" + controlId).attr("max", 60);
		  $("#PointHistoryRangeQuantity_" + controlId).attr("max", 24);

		  if( $("#PointHistoryIntervalQuantity_" + controlId).val() > 60) {
			  $("#PointHistoryIntervalQuantity_" + controlId).val(60);
		  }

		  if ($("#PointHistoryRangeQuantity_" + controlId).val() > 24) {
			  $("#PointHistoryRangeQuantity_" + controlId).val(24);
		  }
	  }

	  // Minute Interval & Day Range
	  else if ($("#PointHistoryIntervalSelect_" + controlId).val() === "0"
		  && $("#PointHistoryRangeSelect_" + controlId).val() === "1") {

		  $("#PointHistoryIntervalQuantity_" + controlId).attr("max", 60);
		  $("#PointHistoryRangeQuantity_" + controlId).attr("max", 7);

		  if ($("#PointHistoryIntervalQuantity_" + controlId).val() > 60) {
			  $("#PointHistoryIntervalQuantity_" + controlId).val(60);
		  }

		  if ($("#PointHistoryRangeQuantity_" + controlId).val() > 7) {
			  $("#PointHistoryRangeQuantity_" + controlId).val(7);
		  }
	  }

	  // Hour Interval & Day Range
	  else if ($("#PointHistoryIntervalSelect_" + controlId).val() === "1"
		  && $("#PointHistoryRangeSelect_" + controlId).val() === "1") {

		  $("#PointHistoryIntervalQuantity_" + controlId).attr("max", 24);
		  $("#PointHistoryRangeQuantity_" + controlId).attr("max", 31);

		  if ($("#PointHistoryIntervalQuantity_" + controlId).val() > 24) {
			  $("#PointHistoryIntervalQuantity_" + controlId).val(24);
		  }

		  if ($("#PointHistoryRangeQuantity_" + controlId).val() > 31) {
			  $("#PointHistoryRangeQuantity_" + controlId).val(31);
		  }
	  }

	  // Hour Interval & Month Range
	  else if ($("#PointHistoryIntervalSelect_" + controlId).val() === "1"
		  && $("#PointHistoryRangeSelect_" + controlId).val() === "2") {

		  $("#PointHistoryIntervalQuantity_" + controlId).attr("max", 24);
		  $("#PointHistoryRangeQuantity_" + controlId).attr("max", 12);

		  if ($("#PointHistoryIntervalQuantity_" + controlId).val() > 24) {
			  $("#PointHistoryIntervalQuantity_" + controlId).val(24);
		  }

		  if ($("#PointHistoryRangeQuantity_" + controlId).val() > 12) {
			  $("#PointHistoryRangeQuantity_" + controlId).val(12);
		  }
	  }


	  // Day Interval & Month Range
	  else if ($("#PointHistoryIntervalSelect_" + controlId).val() === "2"
		  && $("#PointHistoryRangeSelect_" + controlId).val() === "2") {

		  $("#PointHistoryIntervalQuantity_" + controlId).attr("max", 7);
		  $("#PointHistoryRangeQuantity_" + controlId).attr("max", 12);

		  if ($("#PointHistoryIntervalQuantity_" + controlId).val() > 7) {
			  $("#PointHistoryIntervalQuantity_" + controlId).val(7);
		  }

		  if ($("#PointHistoryRangeQuantity_" + controlId).val() > 12) {
			  $("#PointHistoryRangeQuantity_" + controlId).val(12);
		  }
	  }

	  // Day Interval & Year Range
	  else if ($("#PointHistoryIntervalSelect_" + controlId).val() === "2"
		  && $("#PointHistoryRangeSelect_" + controlId).val() === "3") {

		  $("#PointHistoryIntervalQuantity_" + controlId).attr("max", 7);
		  $("#PointHistoryRangeQuantity_" + controlId).attr("max", 1);

		  if ($("#PointHistoryIntervalQuantity_" + controlId).val() > 7) {
			  $("#PointHistoryIntervalQuantity_" + controlId).val(7);
		  }

		  if ($("#PointHistoryRangeQuantity_" + controlId).val() > 1) {
			  $("#PointHistoryRangeQuantity_" + controlId).val(1);
		  }
	  }
	};

  PointHistoryTab.HandleIntervalSelectEvent = function (tabId, controlId, pointId, pointGuid, updateRange) {

	 var selectedRange = $("#PointHistoryRangeSelect_" + controlId).val();
    var selectedInterval = $("#PointHistoryIntervalSelect_" + controlId).val();

    $("#PointHistoryRangeSelect_"+controlId+" > option").each(function () {
      if ($(this).val() === "0") {
        if (selectedInterval === "0") {
          $(this).show();
        }
        if (selectedInterval === "1") {
          $(this).hide();
        }
        if (selectedInterval === "2") {
          $(this).hide();
        }
      }

      if ($(this).val() === "1") {
        if (selectedInterval === "0") {
          $(this).show();
        }
        if (selectedInterval === "1") {
          $(this).show();
        }
        if (selectedInterval === "2") {
          $(this).hide();
        }
      }

      if ($(this).val() === "2") {
        if (selectedInterval === "0") {
          $(this).hide();
        }
        if (selectedInterval === "1") {
          $(this).show();
        }
        if (selectedInterval === "2") {
          $(this).show();
        }
      }

      if ($(this).val() === "3") {
        if (selectedInterval === "0") {
          $(this).hide();
        }
        if (selectedInterval === "1") {
          $(this).hide();
        }
        if (selectedInterval === "2") {
          $(this).show();
        }
      }

      if (updateRange) {
        if (selectedInterval === "0") {
          $("#PointHistoryRangeSelect_" + controlId).val("0");
          $("#PointHistoryRangeQuantity_" + controlId).val("1");
        }
        if (selectedInterval === "1") {
          $("#PointHistoryRangeSelect_" + controlId).val("1");
          $("#PointHistoryRangeQuantity_" + controlId).val("1");
        }
        if (selectedInterval === "2") {
          $("#PointHistoryRangeSelect_" + controlId).val("2");
          $("#PointHistoryRangeQuantity_" + controlId).val("1");
        }
        PointHistoryTab.HandleRangeSelectEvent(tabId, controlId, pointId, pointGuid);
      }
	 });

	  PointHistoryTab.SetMaximums(controlId);

    PointHistoryTab.PersistPointHistory({ tabId: tabId, controlId: controlId, pointId: pointId, pointGuid: pointGuid, start: $("#PointHistoryStartTimePicker_"+controlId).val(), interval: $("#PointHistoryIntervalSelect_"+controlId).val(), intervalQuantity: $("#PointHistoryIntervalQuantity_"+controlId).val(), range: $("#PointHistoryRangeSelect_"+controlId).val(), rangeQuantity: $("#PointHistoryRangeQuantity_"+controlId).val(), columns: $("#PointHistoryColumns_" + controlId).val() });
  };

	PointHistoryTab.HandleIntervalQuantityInputEvent = function (controlId) {
		var intervalQuantity = $("#PointHistoryIntervalQuantity_" + controlId).val();
    if (intervalQuantity < 1) {
      $("#PointHistoryIntervalQuantity_" + controlId).val(1);
    }
    else if (intervalQuantity > 999) {
      $("#PointHistoryIntervalQuantity_" + controlId).val(999);
    }
    else if (!Number.isInteger(intervalQuantity)) {
      $("#PointHistoryIntervalQuantity_" + controlId).val('');
      $("#PointHistoryIntervalQuantity_" + controlId).val(parseInt(intervalQuantity));
    }

		PointHistoryTab.SetMaximums(controlId);
	}

	PointHistoryTab.HandleIntervalQuantityChangeEvent = function (tabId, controlId, pointId, pointGuid) {
		PointHistoryTab.PersistPointHistory({ tabId: tabId, controlId: controlId, pointId: pointId, pointGuid: pointGuid, start: $("#PointHistoryStartTimePicker_" + controlId).val(), interval: $("#PointHistoryIntervalSelect_" + controlId).val(), intervalQuantity: $("#PointHistoryIntervalQuantity_" + controlId).val(), range: $("#PointHistoryRangeSelect_" + controlId).val(), rangeQuantity: $("#PointHistoryRangeQuantity_" + controlId).val(), columns: $("#PointHistoryColumns_" + controlId).val() });
	};


	PointHistoryTab.HandleRangeQuantityInputEvent = function (controlId) {
		var rangeQuantity = $("#PointHistoryRangeQuantity_" + controlId).val();

		if (rangeQuantity < 1) {
			$("#PointHistoryRangeQuantity_" + controlId).val(1);
		}
    else if (!Number.isInteger(rangeQuantity)) {
      $("#PointHistoryRangeQuantity_" + controlId).val('');
      $("#PointHistoryRangeQuantity_" + controlId).val(parseInt(rangeQuantity));
    }

		PointHistoryTab.SetMaximums(controlId);
	}


	PointHistoryTab.HandleRangeSelectEvent = function (tabId, controlId, pointId, pointGuid) {
     PointHistoryTab.SetMaximums(controlId);

    PointHistoryTab.PersistPointHistory({ tabId: tabId, controlId: controlId, pointId: pointId, pointGuid: pointGuid, start: $("#PointHistoryStartTimePicker_"+controlId).val(), interval: $("#PointHistoryIntervalSelect_"+controlId).val(), intervalQuantity: $("#PointHistoryIntervalQuantity_"+controlId).val(), range: $("#PointHistoryRangeSelect_"+controlId).val(), rangeQuantity: $("#PointHistoryRangeQuantity_"+controlId).val(), columns: $("#PointHistoryColumns_" + controlId).val() });
  };

  PointHistoryTab.HandleRangeQuantityChangeEvent = function (tabId, controlId, pointId, pointGuid) {
    PointHistoryTab.PersistPointHistory({ tabId: tabId, controlId: controlId, pointId: pointId, pointGuid: pointGuid, start: $("#PointHistoryStartTimePicker_" + controlId).val(), interval: $("#PointHistoryIntervalSelect_" + controlId).val(), intervalQuantity: $("#PointHistoryIntervalQuantity_" + controlId).val(), range: $("#PointHistoryRangeSelect_" + controlId).val(), rangeQuantity: $("#PointHistoryRangeQuantity_" + controlId).val(), columns: $("#PointHistoryColumns_" + controlId).val() });
  }

   PointHistoryTab.HandleRefreshBtnEvent = function (tabId, controlId, pointId, pointGuid) {
      var dateTimeStr = $("#PointHistoryStartTimePicker_" + controlId).val();
    if (PointHistoryTab.ValidateDateTime(dateTimeStr) == false) {
      $("#PointHistoryStartTimePicker_" + controlId).val("");
      FMErrorAndExceptionHandling.ShowError('Start Date/Time is invalid.', null, PointHistoryTab.messageAttributes);
      return;
    }

    PointHistoryTab.PersistPointHistory({ tabId: tabId, controlId: controlId, pointId: pointId, pointGuid: pointGuid, start: $("#PointHistoryStartTimePicker_" + controlId).val(), interval: $("#PointHistoryIntervalSelect_" + controlId).val(), intervalQuantity: $("#PointHistoryIntervalQuantity_" + controlId).val(), range: $("#PointHistoryRangeSelect_" + controlId).val(), rangeQuantity: $("#PointHistoryRangeQuantity_" + controlId).val(), columns: $("#PointHistoryColumns_" + controlId).val() });
  };

	PointHistoryTab.PersistPointHistory = function (settings) {
		settings.columns = JSON.parse(settings.columns);
		FMOperateIndex.PersistUpdateDrawingSettings(settings.tabId, settings.controlId, settings);
		var restoring = window.localStorage.getItem('operateBeingRestored') || "false";
		if (restoring === "true") {
			return;
		}
		if (FMOperateIndex.restoringScreenQueueInProgress[settings.controlId] === true) {
			return;
		}

    $.ajax({
      type: 'post',
      dataType: 'json',
      cache: false,
      url: 'SaveOperatePointHistory',
      contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
      data: { "startDateString": settings.start, "intervalQuantity": settings.intervalQuantity, "intervalType": settings.interval, "rangeQuantity": settings.rangeQuantity, "rangeType": settings.range, "columnsDefinition": JSON.stringify(settings.columns) },
      success: function (response) {
        FMErrorAndExceptionHandling.HandleMessages(response, function (data, inError) {
          if (!inError || (data != null)) {
            var controlId = settings.controlId;
            var data = PointHistoryTab.GetHistoryData(controlId, settings.pointGuid, $("#PointHistoryIntervalSelect_" + controlId).val(), $("#PointHistoryIntervalQuantity_" + controlId).val(), $("#PointHistoryRangeSelect_" + controlId).val(), $("#PointHistoryRangeQuantity_" + controlId).val(), $("#PointHistoryStartTimePicker_" + controlId).val());
          }
        });
      },
      error: function (xhr, textStatus, error) {
        var activeTab = this.activeTab;
        var newId = this.newId;

        // need to make sure that the error we are getting is because we close the page before getting the response
        if (xhr.status != 0) {
          FMErrorAndExceptionHandling.ShowException(xhr,
            textStatus,
            error,
            function () {
            });
        }
      }
    });

  }

  $(document).ready(function () {
    PointHistoryTab.stack_bottomright_pointhistory = { "dir1": 'up', "dir2": 'left', "firstpos1": 25, "firstpos2": 25, "context": $("#pointhistory" + "@Model.ControlId") };
    PointHistoryTab.messageAttributes = { addclass: 'stack-bottomright', stack: PointHistoryTab.stack_bottomright_pointhistory };

    $("#PointHistoryStartTimePicker_@Model.ControlId").val("@Model.Start");
    $('#PointHistoryStartTimePicker_@Model.ControlId').datetimepicker({
      buttonImage: FMLayout.calendarLocation + '/calendar.gif',
      buttonImageOnly: true,
      showOn: "button",
      showTimezone: false,
      useLocalTimezone: false,
      defaultTimezone: $("#datepickerTimezoneString").val(),
      dateFormat: FMLayout.dateFormat,
      timeFormat: ConvertToJQueryUITimeFormat("hh:mm tt"),
      beforeShow: function () {
        setTimeout(function () {
          $('.ui-datepicker').css('z-index', 1100);
        }, 0);
      },
      onSelect: function (d, i) {
        if (d !== i.lastVal) {
          $(this).change();
          PointHistoryTab.HandleStartDateTimeEvent("@Model.TabId", "@Model.ControlId", "@Model.ID", "@Model.PointGuid");
        }
      }
    });
    $("#PointHistoryIntervalSelect_@Model.ControlId").val("@Model.IntervalString");
    $("#PointHistoryIntervalQuantity_@Model.ControlId").val("@Model.IntervalQuantity");
    $("#PointHistoryRangeSelect_@Model.ControlId").val("@Model.RangeString");
    $("#PointHistoryRangeQuantity_@Model.ControlId").val("@Model.RangeQuantity");
    PointHistoryTab.HandleIntervalSelectEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid', false);
    PointHistoryTab.HandleRangeSelectEvent('@Model.TabId', '@Model.ControlId', '@Model.ID', '@Model.PointGuid');

    // grid things start here

    // Formatter for the cells in the slickgrid
    //( this is just a proxy to call the formatter in FMPointHistory which may not have been defined yet, it gets defined after the grid is created but this function can be called before is actually created)
    function staticPointHistoryFormatter(row, cell, value, columnDef, dataContext) {
      if (FMOperateIndex.staticPointHistoryControllers['@Model.ControlId']) {
        return FMOperateIndex.staticPointHistoryControllers['@Model.ControlId'].staticPointHistoryFormatter(row, cell, value, columnDef, dataContext);
      }
      else
        return '';
    }

    var data = [];
    var columns = @Html.Raw(@Model.Columns);
    var options =
    {
      editable: false,
      enableCellNavigation: true,
      enableColumnReorder: true,
      forceFitColumns: false,
      asyncEditorLoading: false,
      autoEdit: false,
      fontSize: 14,
      rowHeight: 35
    };

    for (i = 0; i < columns.length; i++) {
      columns[i].formatter = staticPointHistoryFormatter;
    }

    var grid = new Slick.Grid('#PointHistoryTableContainer_@Model.ControlId', data, columns, options);

    FMOperateIndex.staticPointHistoryControllers['@Model.ControlId'] = new FMPointHistoryGrid('@Model.ControlId', grid, '@Model.ID', '@Model.PointGuid', @Model.FontSize);

    var myGridColumns = grid.getColumns();
    // disable the column reordering in the first column (the name)
    grid.onColumnsReordered.subscribe(function (e, args) {
      if (myGridColumns[0].id !== grid.getColumns()[0].id) {
        grid.setColumns(myGridColumns);
      }
      else {
        myGridColumns = grid.getColumns();
      }

      $("#PointHistoryColumns_@Model.ControlId").val(JSON.stringify(args.grid.getColumns().slice(0)));
      PointHistoryTab.PersistPointHistory({ tabId: '@Model.TabId', controlId: '@Model.ControlId', pointId: '@Model.ID', pointGuid: '@Model.PointGuid', start: $("#PointHistoryStartTimePicker_@Model.ControlId").val(), interval: $("#PointHistoryIntervalSelect_@Model.ControlId").val(), intervalQuantity: $("#PointHistoryIntervalQuantity_@Model.ControlId").val(), range: $("#PointHistoryRangeSelect_@Model.ControlId").val(), rangeQuantity: $("#PointHistoryRangeQuantity_@Model.ControlId").val(), columns: $("#PointHistoryColumns_@Model.ControlId").val() });
    });

    var headerMenuPlugin = new Slick.Plugins.HeaderContextMenu({});

    headerMenuPlugin.onBeforeMenuShow.subscribe(function (e, args) {
      // get the different engineering unit types that we have for the points selected in the grid
      var tagValueTypes = FMOperateIndex.staticPointHistoryControllers['@Model.ControlId'].getValueTypesForTag(args.column.field);
      var wellKnownGuids = FMOperateIndex.staticPointHistoryControllers['@Model.ControlId'].getWellKnownGuidsForTag(args.column.field);

      // default the menu items to be enabled
      args.menu.items[0].disabled = false;
      args.menu.items[1].disabled = false;
      args.menu.items[2].disabled = false;
      args.menu.items[3].disabled = false;
      args.menu.items[4].disabled = false;
      args.menu.items[5].disabled = false;
      args.menu.items[6].disabled = false;

      // don't allow to delete the first column
      if (args.column.field === 'Date Time') {
        //args.menu.items[1].disabled = true;
        args.menu.items[2].disabled = true;
        //args.menu.items[3].disabled = true;
        args.menu.items[4].disabled = true;
        args.menu.items[5].disabled = true;
        args.menu.items[6].disabled = true;
      }
      else {
        var tagValue = tagValueTypes[0];
        if (tagValue === "System.Boolean") {
          args.menu.items[4].disabled = true;
          args.menu.items[5].disabled = true;
          args.menu.items[6].disabled = true;
        }
        else if (tagValue === "System.Double" || tagValue === "System.Int16" || tagValue === "System.Int32" || tagValue === "System.Int64") {
          var numericUnits = FMOperateIndex.staticPointHistoryControllers['@Model.ControlId'].getNumericUnitsForTag(args.column.field);
          var numericValueTypes = FMOperateIndex.staticPointHistoryControllers['@Model.ControlId'].getValueTypesForTag(args.column.field);

          var numericUnit = -9999;
          if (numericUnits.length === 1) {
            numericUnit = numericUnits[0];
          }

          var numericValueType = "None";
          if (numericValueTypes.length === 1) {
            numericValueType = numericValueTypes[0];
          }
          if (numericUnit !== -9999 && numericValueType !== "System.Double" && numericValueType !== "System.Int16" && numericValueType !== "System.Int32" && numericValueType !== "System.Int64") {
            args.menu.items[4].disabled = true;
            args.menu.items[5].disabled = true;
            args.menu.items[6].disabled = true;
          }
          else if (numericUnit === 15) // if no units then disable the menus
          {
            args.menu.items[5].disabled = true;
            args.menu.items[6].disabled = true;
          }
          // integers don't need precision since they its always zero
          if (numericValueType === "System.Int16" && numericValueType === "System.Int32" && numericValueType === "System.Int64") {
            args.menu.items[4].disabled = true;
          }
        } else if (tagValue === "System.String") {
          args.menu.items[4].disabled = true;
          args.menu.items[5].disabled = true;
          args.menu.items[6].disabled = true;
        } else if (tagValue === "System.DateTimeOffset") {
          args.menu.items[4].disabled = true;
          args.menu.items[5].disabled = true;
          args.menu.items[6].disabled = true;
        } else if (tagValue === "System.TimeSpan") {
          args.menu.items[4].disabled = true;
          args.menu.items[5].disabled = true;
          args.menu.items[6].disabled = true;
        } else if (tagValue && tagValue.startsWith("FMBusinessObjects.DataObjects.CodedVariables")) {
          args.menu.items[4].disabled = true;
          args.menu.items[5].disabled = true;
          args.menu.items[6].disabled = true;
        } else // not a valid combination so disable the menus (no boolean, or numeric types)
        {
          args.menu.items[4].disabled = true;
          args.menu.items[5].disabled = true;
          args.menu.items[6].disabled = true;
        }

        if (args.column.hasOwnProperty('showunit')) {
          if (args.column.showunit) {
            args.menu.items[6].title = 'Hide Units';
            args.menu.items[6].iconCssClass = 'header-menu-hide-unit';
          }
          else {
            args.menu.items[6].title = 'Show Units';
            args.menu.items[6].iconCssClass = 'header-menu-show-unit';
          }
        }
      }
      e.preventDefault();
    });

    headerMenuPlugin.onCommand.subscribe(function (e, args) {
      if (args.command === "insert-column-tag") {
        selectTagColumn(args);
      }
      else if (args.command === "insert-empty-column") {
        insertEmptyColumn(args);
      }
      else if (args.command === "center-align") {
        var headerCss = "";
        if (args.column.cssClass) {
          headerCss = args.column.cssClass.trim();
        }
        headerCss = headerCss.replace('text-left', '');
        headerCss = headerCss.replace('text-right', '');
        headerCss = headerCss.replace('text-center', '');
        headerCss += ' text-center';
        args.column.cssClass = headerCss;
        grid.invalidateAllRows();
        grid.render();

        $("#PointHistoryColumns_@Model.ControlId").val(JSON.stringify(args.grid.getColumns().slice(0)));
        PointHistoryTab.PersistPointHistory({ tabId: '@Model.TabId', controlId: '@Model.ControlId', pointId: '@Model.ID', pointGuid: '@Model.PointGuid', start: $("#PointHistoryStartTimePicker_@Model.ControlId").val(), interval: $("#PointHistoryIntervalSelect_@Model.ControlId").val(), intervalQuantity: $("#PointHistoryIntervalQuantity_@Model.ControlId").val(), range: $("#PointHistoryRangeSelect_@Model.ControlId").val(), rangeQuantity: $("#PointHistoryRangeQuantity_@Model.ControlId").val(), columns: $("#PointHistoryColumns_@Model.ControlId").val() });
      }
      else if (args.command === "left-align") {
        var headerCss = "";
        if (args.column.cssClass) {
          headerCss = args.column.cssClass.trim();
        }
        headerCss = headerCss.replace('text-left', '');
        headerCss = headerCss.replace('text-right', '');
        headerCss = headerCss.replace('text-center', '');
        headerCss += ' text-left';
        args.column.cssClass = headerCss;
        grid.invalidateAllRows();
        grid.render();

        $("#PointHistoryColumns_@Model.ControlId").val(JSON.stringify(args.grid.getColumns().slice(0)));
