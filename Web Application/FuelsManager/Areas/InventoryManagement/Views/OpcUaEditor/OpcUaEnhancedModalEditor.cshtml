@using System.Web.Mvc.Html
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.OpcUaEditorModel

<script src="~/Areas/Scripts/OpcUaBrowser.js"></script>
<script src="~/Areas/Scripts/OpcUaServers.js"></script>

<style>
	.accordion-wrapper-opc {
		display: inline-block;
		max-height: 100%;
		width: 570px;
	}

	.panel-opctree {
		width: 370px;
		display: inline-block;
		vertical-align: top;
		height: 525px;
	}

	.panel-group .panel-opc {
		 margin-bottom: 0;
		 border-radius: 0px;
	}

	.panel-default-opc {
    border-color: #ddd;
	}
	.panel-body-opc {
		padding: 0px 15px;
	}

	.panel-opc {
		 background-color: #fff;
		 border: 1px solid transparent;
		 border-color: #ddd;
		 -webkit-box-shadow: 0 1px 1px rgba(0,0,0,.05);
		 box-shadow: 0 1px 1px rgba(0,0,0,.05);
	}

.accordion-wrapper-opc ul {
	display: inline-block;
	margin: 0;
	padding: 0;
	overflow: hidden;
	list-style-type: none;
}

.accordion-wrapper-opc li {
	display: inline-block;
	padding: 10px;
	transition: all .5s ease;
	position: relative;
	height: 525px;
	vertical-align: bottom;
}

    
.accordion-wrapper-opc li.active .section-content {
		opacity: 1;
		display: inline-block;
    }

  
.accordion-wrapper-opc .section-title {
    display: inline-block;
    width: 10px;
    margin: 0;
    padding: 0;
    vertical-align: top;
	height: 100%;
	cursor: pointer;
	color: #b2b2b2;
}    

.accordion-wrapper-opc .section-content {
display: none;
    align-items: center;
    margin: 0;
    padding: 0;
    transition: all .25s .1s ease-out;
    width: 490px;
  }

.accordion-wrapper-opc li .inactive-icon {
	display: block;
}
.accordion-wrapper-opc li.active .inactive-icon {
	display: none;
}

.accordion-wrapper-opc li .active-icon {
	display: none;
}
.accordion-wrapper-opc li.active .active-icon {
	display: block;
}

</style>

@{
	var okButton = @FMBaseController.TranslateText("&OK");
	var cancelButton = @FMBaseController.TranslateText("&Cancel");
}

<div>
	<div class="row">
		<div class="col-lg-12">
		<div class="accordion-wrapper-opc">
			<ul class="panel-group-opc" id="accordionopc">
				<li id="opcTagInfoPanel" class="panel-opc active">
					<div class="section-title" >
						<i class="glyphicon glyphicon-chevron-right inactive-icon"></i>
						<i class="glyphicon glyphicon-chevron-left active-icon"></i>
					</div>
					<div class="section-content" >
						<div class="panel-body-opc">
							@using (Html.BeginForm("OpcUaBrowser", "OpcUaEditor", FormMethod.Post, new { id = "opcUaBrowserForm" }))
							{
								@Html.AntiForgeryToken()
								@Html.Hidden("urlSaveChanges", @Url.Action("SaveChanges", "OpcUaEditor"))
								@Html.Hidden("urlServerAddressSpaceSelectionChanged", @Url.Action("ServerAddressSpaceSelectionChanged", "OpcUaEditor"))

								<section id="opcUaBrowserPartial" class="">
									<div class="row">
										<div id="opcServerLeftList" class="col-sm-6 col-md-6 col-lg-6">
											<div class="form-group">
												<div class="label-horizontal-bar">
													@Html.Label(FMBaseController.TranslateText("TAG INFORMATION"), new { @class = "control-label" })
												</div>
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("Tag:"), new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagId, new { ID = "PointTagIdTextBox", disabled = "disabled", @class = "form-control" })
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("Value Type:"), new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagValueType, new { ID = "PointTagValueTypeTextBox", disabled = "disabled", @class = "form-control" })
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("Publishing Interval:"), new { @class = "control-label" })
												@Html.Label(" (ms)", new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagOpcUaPublishingInterval, new { ID = "PointTagOpcUaPublishingIntervalTextBox", @class = "form-control" })
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OpcUaEditorController|Write Holdoff:"), new { @class = "control-label" })
												@Html.Label(" (ms)", new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagOpcUaWriteHoldoff, new { ID = "PointTagOpcUaWriteHoldoffTimeTextBox", @class = "form-control" }).Disable(Model.PointTagInput)
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OPC UA Client Deadband"), new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagOPCClientDeadband, new { ID = "PointTagOpcUaClientDeadbandTextBox", @class = "form-control" }).Disable(Model.PointTagOPCClientDisableFilter)
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OPC UA Readable:"), new { @class = "control-label" })
												@if (Model.PointTagInput)
												{
													@Html.CheckBoxFor(m => m.PointTagOpcUaIsReadable, new { ID = "PointTagOpcUaIsReadableCheckBox", @class = "checkbox", disabled = "disabled" })
												}
												else
												{
													@Html.CheckBoxFor(m => m.PointTagOpcUaIsReadable, new { ID = "PointTagOpcUaIsReadableCheckBox", @class = "checkbox" })
												}
											</div>


										</div>
										<div id="opcServerRightList" class="col-sm-6 col-md-6 col-lg-6">
											<div class="form-group">
												<div class="label-horizontal-bar">
													@Html.Label(FMBaseController.TranslateText("OPC NODE INFORMATION"), new { @class = "control-label" })
												</div>
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OPC UA Server Endpoint:"), new { @class = "control-label", })
												@Html.TextBoxFor(m => m.EndpointUrl, new { ID = "ServerEndpointTextBox", disabled = "disabled", Title = Model.EndpointUrl, @class = "form-control" })
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OPC UA Browse Path:"), new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagOpcUaBrowsePath, new { ID = "PointTagOpcUaBrowsePathTextBox", @class = "form-control" })
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OPC UA Node ID:"), new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagOpcUaNodeId, new { ID = "PointTagOpcUaNodeIdTextBox", @class = "form-control" })
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OpcUaEditorController|Write Periodic Update:"), new { @class = "control-label" })
												@Html.Label(" (ms)", new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagOpcUaWritePeriodicUpdateInterval, new { ID = "PointTagOpcUaWritePeriodicUpdateIntervalTextBox", @class = "form-control" }).Disable(Model.PointTagInput)
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OPC UA Client Holdoff"), new { @class = "control-label" })
												@Html.Label(" (Sec(s))", new { @class = "control-label" })
												@Html.TextBoxFor(m => m.PointTagOPCClientHoldoff, new { ID = "PointTagOpcUaClientHoldoffTextBox", @class = "form-control" }).Disable(Model.PointTagOPCClientDisableFilter)
											</div>
											<div class="form-group">
												@Html.Label(FMBaseController.TranslateText("OpcUaEditorController|OPC UA Server Data Type:"), new { @class = "control-label" })
												@Html.DropDownListFor(m => m.PointTagOpcUaServerDataType, new SelectList(Model.GetServerDataTypeList(), "value", "key"), new { ID = "PointTagOpcUaServerDataTypeDropDownList", @class = "form-control" })
											</div>

										</div>
									</div>
								</section>
							}
						</div>
					</div>
				</li>
				<li id="opcServerInfoPanel" class="panel-opc">
					<div class="section-title">
						<i class="glyphicon glyphicon-chevron-right inactive-icon"></i>
						<i class="glyphicon glyphicon-chevron-left active-icon"></i>
					</div>
					<div class="section-content">
						<div class="panel-body-opc">
						@using (Html.BeginForm("OpcUaServers", "OpcUaEditor", FormMethod.Post, new { id = "opcUaServersForm" }))
						{
							@Html.AntiForgeryToken()
							@Html.Hidden("urlSelectionModeSelectionChanged", @Url.Action("SelectionModeSelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlDomainSelectionChanged", @Url.Action("DomainSelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlServerSelectionChanged", @Url.Action("ServerSelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlOpcUaServerSelectionChanged", @Url.Action("OpcUaServerSelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlOpcUaServerSecuritySelectionChanged", @Url.Action("OpcUaServerSecuritySelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlSecurityModeSelectionChanged", @Url.Action("SecurityModeSelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlSecurityPolicySelectionChanged", @Url.Action("SecurityPolicySelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlMessageEncodingSelectionChanged", @Url.Action("MessageEncodingSelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlUserTokenTypeSelectionChanged", @Url.Action("UserTokenTypeSelectionChanged", "OpcUaEditor"))
							@Html.Hidden("urlUserNameChanged", @Url.Action("UserNameChanged", "OpcUaEditor"))
							@Html.Hidden("urlCertificatePathChanged", @Url.Action("CertificatePathChanged", "OpcUaEditor"))
							@Html.Hidden("urlUserPasswordChanged", @Url.Action("UserPasswordChanged", "OpcUaEditor"))
							@Html.Hidden("urlCertificatePasswordChanged", @Url.Action("CertificatePasswordChanged", "OpcUaEditor"))
							@Html.Hidden("urlEndpointChanged", @Url.Action("EndpointChanged", "OpcUaEditor"))
							@Html.Hidden("urlClose", @Url.Action("Close", "OpcUaEditor"))

							@Html.Hidden("TranslatedUserName", @FMBaseController.TranslateText("User Name:"))
							@Html.Hidden("TranslatedCertificate", @FMBaseController.TranslateText("Certificate:"))

							<section id="opcUaServersPartial" class="" style="overflow: hidden">
								<div class="row">
									<div id="opcServerLeftList" class="col-sm-6 col-md-6 col-lg-6">
										<div class="form-group">
											<div class="label-horizontal-bar">
												@Html.Label(@FMBaseController.TranslateText("SERVER INFORMATION"), new { @class = "control-label" })
											</div>
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("Selection Mode:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.SelectionMode, new SelectList(Model.GetSelectionModeList(), "Key", "Value"), new { ID = "SelectionModeDropDownList", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("Domain:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.Domain, new SelectList(Model.GetDomainList()), new { ID = "DomainDropDownList", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("Server:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.Server, new SelectList(Model.GetServerList()), new { ID = "ServerDropDownList", @class = "form-control" })
											@Html.TextBoxFor(m => m.Server, new { ID = "ServerTextBox", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("OPC UA Server:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.OpcUaServer, new SelectList(Model.GetOpcUaServerList()), new { ID = "OpcUaServerDropDownList", @class = "form-control" })
											@Html.TextBoxFor(m => m.OpcUaServer, new { ID = "OpcUaServerTextBox", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("OPC UA Server Security:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.OpcUaServerSecurity, new SelectList(Model.GetOpcUaServerSecurityList()), new { ID = "OpcUaServerSecurityDropDownList", @class = "form-control" })
										</div>
										<div class="form-group">
											<button id="OPCTestConnectionButton" type="button" class="btn OpcUaServerButton">@FMBaseController.TranslateText("Connect to OPC UA Server")</button>
										</div>

									</div>
									<div id="opcServerRightList" class="col-sm-6 col-md-6 col-lg-6">
										<div class="form-group">
											<div class="label-horizontal-bar">
												@Html.Label(@FMBaseController.TranslateText("END POINT INFORMATION"), new { @class = "control-label" })
											</div>
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("OPC UA Server Endpoint:"), new { @class = "control-label" })
											@Html.TextBoxFor(m => m.EndpointUrl, new { ID = "EndpointUrlTextBox", Title = Model.EndpointUrl, @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("Security Mode:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.SecurityMode, new SelectList(Model.GetSecurityModeList(), "Key", "Value"), new { ID = "SecurityModeDropDownList", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("Security Policy:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.SecurityPolicy, new SelectList(Model.GetSecurityPolicyList(), "Key", "Value"), new { ID = "SecurityPolicyDropDownList", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("Message Encoding:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.MessageEncoding, new SelectList(Model.GetMessageEncodingList(), "Key", "Value"), new { ID = "MessageEncodingDropDownList", @class = "form-control" })
										</div>
										<div class="form-group">
											<div class="label-horizontal-bar">
												@Html.Label(@FMBaseController.TranslateText("AUTHENTICATION SETTINGS"), new { @class = "control-label" })
											</div>
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("User Identity:"), new { @class = "control-label" })
											@Html.DropDownListFor(m => m.UserTokenType, new SelectList(Model.GetUserTokenTypeList(), "Key", "Value"), new { ID = "UserTokenTypeDropDownList", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("User Name:"), new { @class = "control-label", ID = "UserNameOrCertificatePathLabel" })
											@Html.TextBoxFor(m => m.UserName, new { ID = "UserNameTextBox", @class = "form-control" })
											@Html.TextBoxFor(m => m.CertificatePath, new { ID = "CertificatePathTextBox", @class = "form-control" })
										</div>
										<div class="form-group">
											@Html.Label(@FMBaseController.TranslateText("Password:"), new { @class = "control-label" })
											@Html.PasswordFor(m => m.UserPassword, new { ID = "UserPasswordTextBox", @class = "form-control" })
											@Html.PasswordFor(m => m.CertificatePassword, new { ID = "CertificatePasswordTextBox", @class = "form-control" })
										</div>

									</div>
								</div>
							</section>
						}
						</div>
					</div>
				</li>
			</ul>

		</div>
			<div class="panel-opc panel-opctree">
				<div >
					<div class="panel-body-opc">
						<div class="row">
							<div class="col-sm-8 col-md-8 col-lg-8">
								<div class="form-group">
									@Html.Label(FMBaseController.TranslateText("Server Address Space:"), new { ID="ServerAddressLabel", @class = "control-label" })
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-sm-12 col-md-12 col-lg-12">
								<div id="serverAddressSpace">
									<ul>
										@foreach (var opcUaNode in Model.ServerNodeIdList)
										{
											<li id="@opcUaNode.Id">@opcUaNode.DisplayName</li>
										}
									</ul>
								</div>
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<section id="opcUaServersErrors">
	<div id="opcUaServersError"></div>
</section>
<section id="opcUaBrowserErrors">
	<div id="opcUaBrowserError"></div>
</section>


<script type="text/javascript">
	function toggleAccordion() {
		if ($(this).parent().hasClass('active')) {
			$('.accordion-wrapper-opc li').addClass('active');
			$(this).parent().removeClass('active');
		} else {
			$('.accordion-wrapper-opc li').removeClass('active');
			$(this).parent().addClass('active');
		}
	}

	$('.accordion-wrapper-opc .section-title').on('click', toggleAccordion);


	$('#OPCTestConnectionButton').on('click', function () {
		var endpointUrl = $('#EndpointUrlTextBox').val();
		$('#ServerEndpointTextBox').val(endpointUrl).attr('title', endpointUrl);
		FMOpcUaBrowser.serverEndpointChanged();
	});

</script>