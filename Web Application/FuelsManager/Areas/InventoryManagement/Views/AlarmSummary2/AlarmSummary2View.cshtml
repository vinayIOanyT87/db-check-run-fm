@{
	ViewBag.Title = "AlarmSummary2";
	Layout = "~/Areas/Views/Shared/_Layout.cshtml";
	var AlarmHistoryDisplay = (@Model.HasAlarmHistoryRight) ? "" : "display: none;";
}

<h2 id ="alarmsSummaryMainHeader">Alarms</h2>

@using (Html.BeginForm("AlarmSummary2View", "AlarmSummary2", FormMethod.Get))
{
	@Html.AntiForgeryToken()
	<section id="AlarmSummary2Section" class="">
		<div class="tab">
			<button class="tablinks" onclick="javascript: return AlarmSummary2.TabSwitch(event, 'AlarmSummary');" id="defaultOpen">Alarm Summary</button>
			<button class="tablinks" style="@AlarmHistoryDisplay" onclick="javascript: return AlarmSummary2.TabSwitch(event, 'AlarmHistory');">Alarm History</button>
		</div>
		<div id="AlarmSummary" class="tabcontent">
			<section id="AlarmSummaryTabSection" class=""></section>
		</div>

		<div id="AlarmHistory" class="tabcontent">
			<section id="AlarmHistoryTabSection" class=""></section>
		</div>
	</section>
}

<script>
// Get the element with id="defaultOpen" and click on it
	document.getElementById("defaultOpen").click();
</script>

