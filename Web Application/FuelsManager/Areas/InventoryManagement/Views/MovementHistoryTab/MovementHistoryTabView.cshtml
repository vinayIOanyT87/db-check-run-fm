<script type="text/javascript">
  //# sourceURL=_MovementHistoryTabView.cshtml
  $(document).ready(function () {
    $("#MovementHistoryTable").removeClass("hidden").addClass("hidden");
    MovementHistoryTab.HistoryInitialized = false;
    MovementHistoryTab.Init();
  });

  $(window).resize(function () { MovementHistoryTab.HandleWindowResize(); });

  $(document).mouseup(function (e) {
    // handler to make the options and columns dropdowns close back up on
    var dropdownsToCloseOnOutsideClick = new Array();

    // Only check the divs if they currently are visible
    if ($("#MovementHistoryGaugeFilterDiv").length > 0 && !$("#MovementHistoryGaugeFilterDiv").attr('class').includes("hidden")) {
      dropdownsToCloseOnOutsideClick.push($('#MovementHistoryGaugeFilterDiv'));
    }
    if ($("#MovementHistoryColumnFilterDiv").length > 0 && !$("#MovementHistoryColumnFilterDiv").attr('class').includes("hidden")) {
      dropdownsToCloseOnOutsideClick.push($('#MovementHistoryColumnFilterDiv'));
    }

    $.each(dropdownsToCloseOnOutsideClick, function (key, value) {
      if (!$(value).is(e.target) // if the target of the click isn't the container...
        && $(value).has(e.target).length === 0) // ... nor a descendant of the container
      {
        if ($(value).selector == '#MovementHistoryColumnFilterDiv') {
          if ($(e.target).attr('id') != 'MovementHistoryShowHideColumnsDropArrow') {
            MovementHistoryTab.HandleColumnFilterDropdownExpandCollapse();
          }
        } else if ($(value).selector == '#MovementHistoryGaugeFilterDiv') {
          if ($(e.target).attr('id') != 'MovementHistoryShowHideGaugeDropArrow') {
            MovementHistoryTab.HandleGaugeFilterDropdownExpandCollapse();
          }
        }
      }
    })

    return true;
  })
</script>


