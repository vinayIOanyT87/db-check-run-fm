<script type="text/javascript">
    //# sourceURL=_AlarmEditorView.cshtml
    $(document).ready(function () {
        AlarmEditor.Init();

        var okButton = $('#PointTagEditValueOkButton');   //bds
        ampersandIndex = okButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = okButton.text().charAt(ampersandIndex + 1);
            okButton.html(okButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            okButton.attr('accesskey', hotKey);
        }

        var cancelButton = $('#PointTagEditValueCancelButton');   //bds
        ampersandIndex = cancelButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = cancelButton.text().charAt(ampersandIndex + 1);
            cancelButton.html(cancelButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            cancelButton.attr('accesskey', hotKey);
        }


        // click to edit limit value
        $('#alarmTagsTable').on('click', '.limitTagValue', function () {
            if ($('#PointModifyRight').val() == 'False') {
                return;

            }
            var inputTagGuid = $(this).parent().closest('table').parent().closest('table').attr('id').replace('alarmsTable_', '');
            var alarmGuid = $(this).closest('table').attr('id').replace('AlarmTestTable_', '');
            var alarmTestGuid = $(this).attr('id').replace('testLimitValueCellId_', '');

            var limitTagGuid = "";

            var model = AlarmEditor.GetAlarmEditorModel();

            var selectedAlarmTagModel = jQuery.grep(model.Tags, function (a) {
                return a.PointTagGuid === inputTagGuid;
            });
            if (selectedAlarmTagModel.length > 0) {
                if (selectedAlarmTagModel[0].Alarms) {
                    var selectedAlarmModel = jQuery.grep(selectedAlarmTagModel[0].Alarms, function (a) {
                        return a.AlarmGuid === alarmGuid;
                    });
                    if (selectedAlarmModel.length > 0) {
                        var selectedAlarmTestModel = jQuery.grep(selectedAlarmModel[0].AlarmTests, function (a) {
                            return a.AlarmTestGuid === alarmTestGuid;
                        });
                        if (selectedAlarmTestModel.length > 0) {
                            limitTagGuid = selectedAlarmTestModel[0].LimitTagGuid;
                        }
                    }
                }
            }

            if (limitTagGuid === "") {
                FMErrorAndExceptionHandling.CloseNotifications();
                FMErrorAndExceptionHandling.ShowError("Limit Tag not found.", function () { });
                return;
            }

            var dataType = selectedAlarmTestModel[0].LimitTagValueType;
            var id = selectedAlarmTestModel[0].LimitTagId;
            var value = selectedAlarmTestModel[0].LimitValue;
            var unitsType = selectedAlarmTestModel[0].LimitTagUnitsType;
            var units = selectedAlarmTestModel[0].LimitTagUnits;
            var decimalPlaces = selectedAlarmTestModel[0].LimitTagDecimalPlaces;
            var maximum = selectedAlarmTestModel[0].LimitTagMax;
            var minimum = selectedAlarmTestModel[0].LimitTagMin;
            var pointValueIdentifier = { IdentityGuid: limitTagGuid, PointValueType: 'Tag', PropertyID: '' };
            var pointTemplateGuid = FMPointEditor.pointGuid;
            var pointName = $("#PEID").val();
            var AllowOverUnderRange = "True";


            // parse ft-in-16th or ft-in-8th values
            if (units === 19 || units === 27) {
                var numFormatInfoString = $('#NumberFormatInfoString').val();
                var siteNumFormatInfo = JSON.parse(numFormatInfoString);
                siteNumFormatInfo.NumberDecimalDigits = decimalPlaces;
                value = math.number(FMFormatValues.ParseValue(units, siteNumFormatInfo, value, true));
            }

            var requestParms = {
                isPointTemplate: false
                , pointValueIdentifier: pointValueIdentifier
                , valueTypeString: dataType
                , id: id
                , value: value
                , decimalPlaces: decimalPlaces
                , unitType: unitsType
                , unit: units
                , maximum: maximum
                , minimum: minimum
                , pointTemplateGuid: pointTemplateGuid
                , pointName: pointName
                , AllowOverUnderRange: AllowOverUnderRange
            }


            var url = $('#urlEditPointTemplateTags').val();
            var token = $('#pointPropertiesForm input[name=__RequestVerificationToken]').val();
            var headers = {};
            headers['__RequestVerificationToken'] = token;

            FMErrorAndExceptionHandling.CloseNotifications();

            // redefine the function that will be executed when applying changes to tag values
            HandlePointTagEditorNewValueUpdate = function () {
                // get the new value

                var newVal = $("#PointTagNewValueInputId").val();
                var newRawVal = $("#PointTagNewRawValueInputId").val();
                $("#limitValueInputId_" + alarmTestGuid).text(newVal);
                $("#limitValueInputId_" + alarmTestGuid).attr('title', newVal);
                selectedAlarmTestModel[0].LimitValue = newVal;
                AlarmEditor.SetAlarmEditorModel(model);
            }

            // create the backdrop and wait for next modal to be triggered
            var modalManager = $('body').modalmanager('loading');

            $.ajax({
                type: 'POST',
                cache: false,
                headers: headers,
                url: url,
                data: requestParms,
                success: function (response) {
                    FMErrorAndExceptionHandling.HandleMessages(response, function (data, inError) {
                        if (!inError || (data != null)) {
                            $('#PointTagEditValueScreenBody').html(response.Data);
                            $('#PointTagEditValueScreen').modal('show');
                        }
                        else {
                            $('body').modalmanager('loading'); // remove the loading background
                        }
                    });
                },
                error: function (xhr, textStatus, error) {
                    FMErrorAndExceptionHandling.ShowException(xhr, textStatus, error, function () {
                        $('body').modalmanager('loading'); // remove the loading background
                    });
                }
            });
        });
    });

    // This function is called by the EditValue partial page.
    function HandlePointTagEditorNewValueUpdate() {

        AlarmEditor.HandleUpdatingEditLimitTagValue();
    }
</script>
