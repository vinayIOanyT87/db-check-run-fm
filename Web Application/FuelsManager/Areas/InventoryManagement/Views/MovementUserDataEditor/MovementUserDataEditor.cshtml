                </td>
                <td class="MovementUserDataTdPadding2">
                    <input id="MovementUserData04TB" type="text" class="MovementUserDataInput" maxlength="80" />
                </td>
            </tr>
            <tr>
                <td class="MovementUserDataTdPadding1">
                    <label id="UserData05Lbl">@userData05Lbl</label>
                </td>
                <td class="MovementUserDataTdPadding2">
                    <input id="MovementUserData05TB" type="text" class="MovementUserDataInput" maxlength="80" />
                </td>
            </tr>
            <tr>
