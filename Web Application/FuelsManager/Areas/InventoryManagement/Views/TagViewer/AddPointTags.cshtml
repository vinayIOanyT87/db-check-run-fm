@using System.Web.Mvc.Html
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.TagViewerModel

<link href="~/Areas/Content/select2.min.css" rel="stylesheet" type="text/css" />

<script src="~/Areas/Lib/select2.min.js"></script>
<script src="~/Areas/Scripts/TagViewerAddPointTag.js"></script>

<style>
	#tagViewerPointTagSelectScreen .modal-body {
		overflow: hidden;
	}
	 .select2-close-mask{
		 z-index: 3099;
	 }
	.select2-dropdown{
		z-index: 4051;
	}

	.select2-container--default .select2-selection--multiple{
		border-radius: 0px !important;
		border: 1px solid #ccc;
	}
	.select2-results__option[aria-selected=true]{
		background-color:rgb(221,221,221) !important;
		color:rgb(199,200,199) !important;
	}
	.select2-container--default.select2-container--focus .select2-selection--multiple {
		border: 1px solid #ccc;
		outline: 0;
		box-shadow: inset 0 1px 1px rgba(0,0,0,.075),0 0 8px rgba(102,175,233,.6);
	}
</style>


<script>

	$(document).ready(function () {

		$.fn.modal.Constructor.prototype.enforceFocus = function () { };

		$('#PointTagDropDownList').select2();

		/* map user events */
		$( '#PointTemplateTypeDropDownList' ).change( function( ) {
			FMAddPointTags.selectionPointTemplateTypeDropDownListChanged();
		} );

		$( '#PointTemplateDropDownList' ).change( function( ) {
			FMAddPointTags.selectionPointTemplateDropDownListChanged();
		} );

		$( '#PointCategoryDropDownList' ).change( function( ) {
			FMAddPointTags.selectionPointCategoryDropDownListChanged();
		} );

		$( '#PointDropDownList' ).change( function( ) {
			FMAddPointTags.selectionPointDropDownListChanged();
		} );


		$('#PointTagDropDownList').change(function () {
			FMAddPointTags.selectionPointTagDropDownListChanged();
		});

	});
</script>



@using (Html.BeginForm("ButtonSubmit", "TagViewer", FormMethod.Post, new { id = "AddPointTagsForm" }))
{
	@Html.AntiForgeryToken();
	@Html.Hidden("urlPointTemplateTypeSelectionChanged", @Url.Action("PointTemplateTypeSelectionChanged", "TagViewer"));
	@Html.Hidden("urlPointTemplateSelectionChanged", @Url.Action("PointTemplateSelectionChanged", "TagViewer"));
	@Html.Hidden("urlPointCategorySelectionChanged", @Url.Action("PointCategorySelectionChanged", "TagViewer"));
	@Html.Hidden("urlPointSelectionChanged", @Url.Action("PointSelectionChanged", "TagViewer"));

	<section id="AddPointTagsPartial" class="">
		<div class="form-group">@Html.Label(@FMBaseController.TranslateText("Tag Viewer|Point Type:"), new { @class = "control-label" })</div>
		<div class="form-group">@Html.DropDownListFor(m => m.PointTemplateTypeGuid, new SelectList(Model.PointTemplateTypeList, "Key", "Value"), new { ID = "PointTemplateTypeDropDownList", style = "Width:100%", @class = "form-control" })</div>
		<div class="form-group">@Html.Label(@FMBaseController.TranslateText("Tag Viewer|Point Template:"), new { @class = "control-label" })</div>
		<div class="form-group">@Html.DropDownListFor(m => m.PointTemplateGuid, new SelectList(Model.PointTemplateList, "Key", "Value"), new { ID = "PointTemplateDropDownList", style = "Width:100%", @class = "form-control" })</div>
		<div class="form-group">@Html.Label(@FMBaseController.TranslateText("Tag Viewer|Point Category:"), new { @class = "control-label" })</div>
		<div class="form-group">@Html.DropDownListFor(m => m.PointCategoryGuid, new SelectList(Model.PointCategoryList, "Key", "Value"), new { ID = "PointCategoryDropDownList", style = "Width:100%", @class = "form-control" })</div>
		<div class="form-group">@Html.Label(@FMBaseController.TranslateText("Tag Viewer|Point:"), new { @class = "control-label" })</div>
		<div class="form-group">@Html.DropDownListFor(m => m.PointGuid, new SelectList(Model.PointList, "Key", "Value"), new { ID = "PointDropDownList", style = "Width:100%", @class = "form-control" })</div>
		<div class="form-group">@Html.Label(@FMBaseController.TranslateText("Tag Viewer|Tag:"), new { @class = "control-label" })</div>
		<div class="form-group">
			<select id="PointTagDropDownList" name="PointTagDropDownList" multiple="multiple" value="Undefined"  style = "Width:100%">
				@foreach (var keyValuePair in Model.PointTagList)
				{
					<option value="@keyValuePair.Key">@keyValuePair.Value</option>
				}
			</select>
		</div>
	</section>

}

