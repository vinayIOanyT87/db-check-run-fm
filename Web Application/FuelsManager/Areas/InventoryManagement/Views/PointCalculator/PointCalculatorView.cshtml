<div id="pointCalculatorModal" class="modal-body" style="background: #f0f0f0;padding-top:2px;">
	<div class="row">
		<div class="col-md-7">
			<h4 style="margin: 0px">@Model.selectedBasePoint</h4>
		</div>
		<div class="col-md-12 text-right" style="padding-right:20px;">
			<input id="InitiateTransferLevel" type="button" value="Initiate Transfer - Level" class="formfieldtitle" onclick="FMPointCalculator.CheckIfOkToTransfer('Level');" /> &nbsp;
			<input id="InitiateTransferBatch" type="button" value="Initiate Transfer - Batch" class="formfieldtitle" onclick="FMPointCalculator.CheckIfOkToTransfer('Batch');" /> &nbsp;
			<input type="button" value="Reset Calculator" class="formfieldtitle" onclick="FMPointCalculator.Reset();" /> &nbsp;
			<input type="button" value="Generate Report" class="formfieldtitle" onclick="FMPointCalculator.GenerateReport();" /> &nbsp;
			<input type="button" value="Export to CSV" class="formfieldtitle" onclick="FMPointCalculator.GenerateAndDownloadCSV();" />
		</div>
	</div>
	<section class="TagSection">
		<div class="row">
			<div id="tableScroll" class="table-scroll">
				<table id="CalculatorTable" data-pointguid="@Model.selectedBasePointGuid">
					<thead>
						<tr class="FuelsManager-table-header">
							<th class="col-md-5 text-left" style="min-width: 250px;">@FMBaseController.TranslateText("Tag")</th>
							<th class="col-md-1 text-left" style="min-width: 50px;"></th>
							<th class="col-md-2 text-right" style="min-width: 175px;">@FMBaseController.TranslateText("Start Value")</th>
							<th class="col-md-2 text-right" style="min-width: 175px;">@FMBaseController.TranslateText("End Value")</th>
							@{
								string batchdifferentialColumnHeader;
								if (Model.isBatchMode)
								{
									batchdifferentialColumnHeader = FMBaseController.TranslateText("Batch Value");
								}
								else
								{
									batchdifferentialColumnHeader = FMBaseController.TranslateText("Differential Value");
								}
							}

							<th class="col-md-2 text-right" style="min-width: 175px;">@batchdifferentialColumnHeader</th>
						</tr>
					</thead>
					<tbody id="TableData">
						@for (var index = 0; index < @Model.calculatorItemList.Count; ++index)
						{
							var value = Model.calculatorItemList[index];
							if (index == 0)
							{
								Model.colorswipeIndex = -1;
							}
							if (value.tagGuid == null)
							{
								continue;
							}

							if (!value.isVisible)
							{
								continue;
							}

							Model.colorswipeIndex += 1;
							var tag = value.tagName;
							if (value.unitsString != "")
							{
								tag += "   " + "(" + value.unitsString + ")";
							}

							var batchNoEditTagNames = new List<string>
										{
							"Volume Water",
							"Volume Solids",
							"Volume Bottoms",
							"Volume BSW"
							};

							var isDisplayedInBatchMode = value.isBatchModeTag;
							var isNoEditInBatchMode = batchNoEditTagNames.Contains(value.tagName);

							var startvalue = value.startValue;
							var endvalue = value.endValue;
							var difvalue = value.diffValue;


							var disabled = "";
							var batchdisabled = "";

							var pq = 0;

							if (value.editDisabled == 1)
							{
								disabled = "disabled";
								isNoEditInBatchMode = true;
							}

							if ((Model.isBatchMode && !isDisplayedInBatchMode))
							{
								difvalue = string.Empty;
								batchdisabled = "disabled";
								pq = 0;
							}
							else if (!Model.isBatchMode && value.editDisabled == 1)
							{
								batchdisabled = disabled;
								pq = 1;
							}
							else if (Model.isBatchMode && isNoEditInBatchMode)
							{
								batchdisabled = "disabled";
								pq = 2;
							}

							<tr id="calculatortag_@value.tagGuid.ToString()"
								 data-datatype="@value.dataType"
								 data-numberDecimals="@value.numberDecimals"
								 data-unitsType="@value.UnitsType"
								 data-units="@value.units"
								 data-maximum="@value.maximumValue"
								 data-minimum="@value.minimumValue"
								 data-endvalue="@value.endValueRaw"
								 style="display: @(value.isVisible ? "table-row" : "none")">
								<td class="col-md-3 text-left calculator-tag-name" data-name="@value.tagName">
									<span title="@tag">@tag</span>
								</td>
								<td class="col-md-1 text-left calculator-tag-name">
									<span title="@value.acronym">@value.acronym</span>
								</td>
								<td class="col-md-2 text-right calculator-start-value" data-rawData="@value.startValueRaw">
									<span class="value" title="@startvalue">@startvalue</span>
									<span class="calculator-icons pull-right">
										<a title="Edit" class="@(string.IsNullOrEmpty(disabled) ? "editLinkClass" : "editLinkClassDisabled")" @disabled></a>
										<span class="value-up glyphicon glyphicon-arrow-up hidden"></span>
										<span class="value-down glyphicon glyphicon-arrow-down hidden"></span>
										<span class="value-no-change glyphicon glyphicon-minus hidden"></span>
									</span>
								</td>
								<td class="col-md-2 text-right calculator-end-value" data-rawData="@value.endValueRaw">
									<span class="value" title="@endvalue">@endvalue</span>
									<span class="calculator-icons pull-right">
										<a title="Edit" class="@(string.IsNullOrEmpty(disabled) ? "editLinkClass" : "editLinkClassDisabled") pull-right" @disabled></a>
										<span class="value-up glyphicon glyphicon-arrow-up hidden"></span>
										<span class="value-down glyphicon glyphicon-arrow-down hidden"></span>
										<span class="value-no-change glyphicon glyphicon-minus hidden"></span>
									</span>
								</td>
								<td class="col-md-2 text-right calculator-diff-value" data-rawData="@value.diffValueRaw">
									<span class="value" title="@difvalue">@difvalue</span>
									<span class="calculator-icons pull-right">
										<a title="Edit" class="@(string.IsNullOrEmpty(batchdisabled) ? "editLinkClass" : "editLinkClassDisabled") pull-right" @batchdisabled></a>
										<span class="value-up glyphicon glyphicon-arrow-up hidden"></span>
										<span class="value-down glyphicon glyphicon-arrow-down hidden"></span>
										<span class="value-no-change glyphicon glyphicon-minus hidden"></span>
									</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>
</div>
<script>
	$(document).ready(function () {
		FMPointCalculator.Init();
	});
</script>
