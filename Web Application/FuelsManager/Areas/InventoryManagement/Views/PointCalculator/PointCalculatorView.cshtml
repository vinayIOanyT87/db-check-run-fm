<style type="text/css">

	.keyvalue {
		color: rgb(72, 104, 153);
		font-weight: bold;
		/*background-color: rgb(0, 0, 0);*/
	}

	.table-scroll {
		overflow: auto;
		max-height: calc(100vh - 120px);
		scrollbar-color: #486899 white;
	}

	#CalculatorTable {
		margin: 15px;
		display: block;
		overflow: hidden;
		/*max-height: calc( 100vh - 120px );*/
	}

		#CalculatorTable thead tr {
			background: #f0f0f0;
		}

		#CalculatorTable > tbody > tr:nth-child(odd of :not(.hidden)) {
			background-color: #f9f9f9;
		}

	.calculator-tag-name span {
		text-overflow: ellipsis;
		width: 100%;
		overflow: hidden;
		white-space: nowrap;
	}

	#CalculatorTable a.editLinkClassDisabled {
		pointer-events: none;
		display: block;
		width: 36px;
		height: 20px;
	}

	#CalculatorTable tr {
		height: 22px;
		padding-top: 4px;
		padding-bottom: 4px;
		font-size: 12px;
	}

	#CalculatorTable span.value {
		width: calc( 100% - 38px);
		overflow: hidden;
		display: inline-block;
		text-overflow: ellipsis;
	}

	#CalculatorTable .calculator-start-value, #CalculatorTable .calculator-end-value, #CalculatorTable .calculator-diff-value {
		padding-right: 0px;
		cursor: default;
	}

	.calculator-icons .value-up, .calculator-icons .value-down, .calculator-icons .value-no-change {
		padding: 0px 13px;
	}

	.value-up {
		color: #5cb85c;
	}

	.value-down {
		color: #d9534f;
	}

	.font-bold {
		font-weight: bold;
	}

	.pointCalculatorDisableButtonClass {
		cursor: not-allowed !important;
	}
</style>

