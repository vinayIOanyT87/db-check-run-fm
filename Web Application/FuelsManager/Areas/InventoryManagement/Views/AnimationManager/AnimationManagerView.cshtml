																					<td type='text' id="@animationTestPropertyColor1Id" data-show-alpha="true" class="testPropertyStandardColorCol3 text-left testGroupRowTd full">
																						<div class="sp-preview">
																							<div id="@animationTestPropertyColorButton1Id" class="sp-preview-inner" style="background-color: @color1;"></div>
																						</div>
																					</td>
																					<td class="testPropertyStandardColorCol4 text-left testGroupRowTd">
																						<input id="@animationTestPropertyTransparency1Id" value="@trans1" class="animationTransPercentTextbox"
																						       onfocus="AnimationManager.HandleTransparencyTextboxOnFocus('@animationTestPropertyTransparency1Id')"
																						       onblur="AnimationManager.HandleTransparencyTextboxOnBlur('@animationTestPropertyTransparency1Id')"/>
																						<label class="animationPercentLabel">%</label>
																					</td>
																					<td type='text' id="@animationTestPropertyColor2Id" data-show-alpha="true" class="testPropertyStandardColorCol5 text-left testGroupRowTd full">
																						<div class="sp-preview">
																							<div id="@animationTestPropertyColorButton2Id" class="sp-preview-inner" style="background-color: @color2;"></div>
																						</div>
																					</td>
																					<td class="testPropertyStandardColorCol6 text-left testGroupRowTd">
																						<input id="@animationTestPropertyTransparency2Id" value="@trans2" class="animationTransPercentTextbox"
																						       onfocus="AnimationManager.HandleTransparencyTextboxOnFocus('@animationTestPropertyTransparency2Id')"
																						       onblur="AnimationManager.HandleTransparencyTextboxOnBlur('@animationTestPropertyTransparency2Id')"/>
																						<label class="animationPercentLabel">%</label>
																					</td>
                                                                                }
                                                                                else if (property.LookupName == "TEXT_COLOR")
                                                                                {
                                                                                    var color1 = property.VisualStates[0].Value;
                                                                                    var trans1 = property.VisualStates[1].Value;
                                                                                    var color2 = property.VisualStates[2].Value;
                                                                                    var trans2 = property.VisualStates[3].Value;
                                                                                    if (string.IsNullOrEmpty(color1))
                                                                                    {
                                                                                        color1 = "transparent";
                                                                                    }
                                                                                    if (string.IsNullOrEmpty(color2))
                                                                                    {
                                                                                        color2 = "transparent";
                                                                                    }
																					<td type='text' id="@animationTestPropertyColor1Id" data-show-alpha="false" class="testPropertyTextColorCol3 text-left testGroupRowTd full">
																						<div class="sp-preview">
																							<div id="@animationTestPropertyColorButton1Id" class="sp-preview-inner" style="background-color: @color1;"></div>
																						</div>
																					</td>
																					<td type='text' id="@animationTestPropertyColor2Id" data-show-alpha="false" class="testPropertyTextColorCol4 text-left testGroupRowTd full">
																						<div class="sp-preview">
																							<div id="@animationTestPropertyColorButton2Id" class="sp-preview-inner" style="background-color: @color2;"></div>
																						</div>
																					</td>
																					<td></td>
																					<td></td>
																				}
																				else if (property.LookupName == "TEXT")
																				{
																					<td class="testPropertyTextCol3 text-left testGroupRowTd" colspan="4" >
																						<input id="@animationTestPropertyTextboxId" class="testPropertyTB" value="@property.Value" onblur="AnimationManager.HandlePropertyTextboxOnBlur('@animationTestPropertyTextboxId')"/>
																					</td>			}
																				else if (property.LookupName == "VISIBILITY")
																				{
																					if (property.VisualStates[0].Value == "ON")
																					{
																						<td class="testPropertyStandardColorCol3 text-left testGroupRowTd" onclick="AnimationManager.HandleVisibilityPropertyOnClick('@animationTestPropertyVisibityId')">
																							<img id="@animationTestPropertyVisibityId" name="ToggleOn" title='@FMBaseController.TranslateText("Toggle On")' alt='@FMBaseController.TranslateText("Toggle On")' draggable="false" src="~/fmwebapp/images/On.png" />
																						</td>						
																					}
																					else
																					{
																						<td class="testPropertyStandardColorCol3 text-left testGroupRowTd" onclick="AnimationManager.HandleVisibilityPropertyOnClick( '@animationTestPropertyVisibityId' )">
																							<img id="@animationTestPropertyVisibityId" name="ToggleOff" title='@FMBaseController.TranslateText("Toggle Off")' alt='@FMBaseController.TranslateText("Toggle Off")' draggable="false" src="~/fmwebapp/images/Off.png"/>
																						</td>
																					}
																					<td></td>
																					<td></td>
																					<td></td>
																				}
																			</tr>
																		}
																	</tbody>
																</table>
															</td>
														</tr>
													}
												</tbody>
											</table>
										</td>
									</tr>
									}
							</tbody>
						</table>
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
	<section id="AnimationNewModals">
		<div class="row">
			<div id="AnimationNewModalScreen" class="modal fade modal-md animationnewmodal" data-backdrop="static" data-focus-on="input:first" role="dialog">
				<!-- Modal content-->
				<div class="modal-content">
					<div class="modal-header">
						<button id="AnimationNewScreen_CloseButton" type="button" class="close" data-dismiss="modal" onclick="javascript: return AnimationManager.CloseNewAnimation( this );">&times;</button>
						<h4 id="AnimationNewScreen" class="modal-title">@FMBaseController.TranslateText("New Animation")</h4>
					</div>
					<div class="modal-body">
						<div style="display: table">
							<div style="display: table-row">
								<div style="display: table-cell">
									<label for="newanimationname1" class="formfieldtitle">Name</label>
								</div>
								<div style="display: table-cell; padding-left: 10px">
									<input type="text" maxlength="30" name="newanimationname1" id="newanimationname1" class="formfield" style="width: 370px" onblur="javascript: return AnimationManager.HandleAnimationNameTextboxOnChange('newanimationname1', 'AnimationNewOkButton1');" onkeyup="javascript: return AnimationManager.HandleAnimationNameTextboxOnChange('newanimationname1', 'AnimationNewOkButton1');"/>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<div class="btn-toolbar">
							<div class="pull-right">
								<button id="AnimationNewOkButton1" disabled="disabled" type="button" accesskey="O" class="btn" data-dismiss="modal" onclick="javascript: return AnimationManager.CreateNewAnimation( this );"><u>O</u>k</button>
								<button id="AnimationNewCancelButton" type="button" accesskey="C" class="btn btn-default" data-dismiss="modal" onclick="javascript: return AnimationManager.CloseNewAnimation( this );"><u>C</u>ancel</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section id="AnimationCopyAndRenameModals">
		<div class="row">
			<div id="AnimationCopyAndRenameModalScreen" class="modal fade modal-md animationnewmodal" data-backdrop="static" data-focus-on="input:first" role="dialog">
				<!-- Modal content-->
				<div class="modal-content">
					<div class="modal-header">
						<button id="AnimationCopyAndRenameScreen_CloseButton" type="button" class="close" data-dismiss="modal" onclick="javascript: return AnimationManager.CloseCopyAndRenameAnimation( this );">&times;</button>
						<h4 id="AnimationCopyAndRenameScreen" class="modal-title">@FMBaseController.TranslateText("Copy And Rename Animation")</h4>
					</div>
					<div class="modal-body">
						<div style="display: table">
							<div style="display: table-row">
								<div style="display: table-cell">
									<label for="CopyAndRenameAnimationname" class="formfieldtitle">Name</label>
								</div>
								<div style="display: table-cell; padding-left: 10px">
									<input type="text" maxlength="30" name="CopyAndRenameAnimationname" id="CopyAndRenameAnimationname" class="formfield" style="width: 370px" onblur="javascript: return AnimationManager.HandleAnimationNameTextboxOnChange('CopyAndRenameAnimationname', 'AnimationCopyAndRenameOkButton');" onkeyup="javascript: return AnimationManager.HandleAnimationNameTextboxOnChange('CopyAndRenameAnimationname', 'AnimationCopyAndRenameOkButton');" />
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<div class="btn-toolbar">
							<div class="pull-right">
								<button id="AnimationCopyAndRenameOkButton" disabled="disabled" type="button" accesskey="O" class="btn" data-dismiss="modal" onclick="javascript: return AnimationManager.CreateCopyAndRenameAnimation( this );"><u>O</u>k</button>
								<button id="AnimationCopyAndRenameCancelButton" type="button" accesskey="C" class="btn btn-default" data-dismiss="modal" onclick="javascript: return AnimationManager.CloseCopyAndRenameAnimation( this );"><u>C</u>ancel</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

<script type="text/javascript">
	//# sourceURL=_AnimationManagerView.cshtml
	$(document).ready(function ()
	{
	    AnimationManager.Init();
	    AnimationManager.SetCollapsed();
	});

</script>