@{
    AnimationManagerModelAnimation anime = null;
    foreach (var animation in Model.AnimationList)
    {
        if (animation.AnimationGuid == Model.SelectedAnimationGuid)
        {
            anime = animation;
        }
    }
    var animationUseCount = anime == null ? 0 : anime.UseCount;
    //if (Model.AnimationList.Count > 0)
    //{
    //    anime = Model.AnimationList[0];
    //}
    var deleteAnimationConfirmationText = "";

    if (animationUseCount > 0)
    {
        var warningText = FMBaseController.TranslateText("WARNING! Animation is currently in use.");
        var temptext = FMBaseController.TranslateText("Are you sure you wish to delete this item?");
        deleteAnimationConfirmationText = warningText + " " + temptext;
    }
    else
    {
        deleteAnimationConfirmationText = FMBaseController.TranslateText("Are you sure you wish to delete this item?");
    }

<div id="AnimationManagerOutterDiv" class="table" style="height: calc(100vh - 200px)">
	<table id="animationTable" class="animationTable">
		<thead class="tableHeaderFormating">
			<tr class="rowBorder">
				<th class="animationExpand text-center animationRowTd"></th>
				<th class="animationName text-left animationRowTd">@FMBaseController.TranslateText("Animation")</th>
				<th class="animationCount text-center animationRowTd">@FMBaseController.TranslateText("Count")</th>
				<th class="animationAddHeader text-center animationRowTd">@FMBaseController.TranslateText("Add Test Group")</th>
				<th class="animationAddHeader text-center animationRowTd">@FMBaseController.TranslateText("Copy Animation")</th>
				<th class="animationDelHeader text-left animationRowTd">@FMBaseController.TranslateText("Delete Animation")</th>
			</tr>
		</thead>
		<tbody id="animationTableBody">
			<tr id="animationRow" class="animationRowBorder">
				<td id="animationExpand" class="animationExpand text-right animationRowTd" onclick="javascript: return AnimationManager.CollapseAnimation( this );">
					<img name="collapse" draggable="false" title='@FMBaseController.TranslateText("expanded")' alt='@FMBaseController.TranslateText("expanded")' src="~/fmwebapp/images/Arrow-downBl.png">
				</td>
				<td id="animationList" class="animationName text-left animationRowTd">
					<select id="AnnimationDropDown" class="animationDropDown" onchange="AnimationManager.AnimationSelectionChanged( this )">
						@if (anime == null)
						{
							<option selected value="EMPTY"></option>
						}
						<option value="00000000-0000-0000-0000-000000000000">@FMBaseController.TranslateText("<Add New Animation>")</option>
						@foreach (var animation in Model.AnimationList)
						{
							var animationSelected = "";
							if (animation.AnimationGuid == Model.SelectedAnimationGuid)
							{
								animationSelected = "selected";
								anime = animation;
								animationUseCount = anime == null ? 0 : anime.UseCount;
							}
							<option @animationSelected value="@animation.AnimationGuid">@animation.ID</option>
						}
					</select>
				</td>
				<td id="animationCount" class="animationCount text-center animationRowTd">
					@animationUseCount
				</td>
				<td id="animationAdd" class="animationAddHeader text-center animationRowTd" onclick="javascript: return AnimationManager.AddAnimationTestGroup( this );">
					<img name="add" draggable="false" title='@FMBaseController.TranslateText("Add Test Group")' alt='@FMBaseController.TranslateText("Add Test Group")' src="~/fmwebapp/images/Insert-Row.png">
				</td>
				<td id="animationRename" class="animationAddHeader text-center animationRowTd" onclick="javascript: return AnimationManager.OpenCopyAndRenameAnimation(this);">
					<img name="copyandrename" draggable="false" title='@FMBaseController.TranslateText("copy and rename animation")' alt='@FMBaseController.TranslateText("copy and rename animation")' src="~/fmwebapp/images/Rename.png">
				</td>
				<td id="animationDelete" class="animationDelRow text-left animationRowTd" style="cursor: not-allowed" onclick="if(AnimationManager.animationDeleteEnabled === false || AnimationManager.AnimationInEditMode){return ;}; if ( confirm( '@deleteAnimationConfirmationText' ) ){AnimationManager.DelAnimation( this );}">
					<img name="del" draggable="false" title='@FMBaseController.TranslateText("Delete Animation")' alt='@FMBaseController.TranslateText("Delete Animation")' src="~/fmwebapp/images/Trash-icon.png">
				</td>
			</tr>
