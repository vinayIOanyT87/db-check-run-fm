@using System.Web.Mvc.Html
@using System.Globalization
@using Newtonsoft.Json
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.DeviceAlarmMapsEditorModel

<link href="~/Areas/Content/jquery.scrolling-tabs-custom.css" rel="stylesheet">
<link href="~/Areas/Content/DeviceAlarmMapsEditor.css" rel="stylesheet" type="text/css" />
<link href="~/Areas/Content/jquery.contextmenu.css" rel="stylesheet">

<script src="~/Areas/lib/jquery.scrolling-tabs-custom.js"></script>
<script src="~/Areas/lib/jquery.contextmenu.js" type="text/javascript"></script>
<script src="~/Areas/Scripts/DeviceAlarmMapsEditor.js"></script>

<style>
	.select2 {
		width: 100% !important;
	}

	.select2-container--default .select2-selection--single {
		background-color: #fff;
		border: 1px solid #ccc;
		border-radius: 0px;
		height: 34px;
	}

	.select2-container--open {
		z-index: 1060;
	}

</style>



@using (Html.BeginForm("DeviceAlarmMapsEditor", "DeviceAlarmMapsEditor", FormMethod.Post, new { id = "DeviceAlarmMapsForm" }))
{
	var ModifyDAMListDisplay = (@Model.HasModifyRight) ? "" : "display: none;";
	var numberFormatInfo = new NumberFormatInfo { NumberGroupSizes = Model.Site.GetNumberGroupSizes(), NumberGroupSeparator = Model.Site.NumberGroupSeparator, NumberDecimalSeparator = Model.Site.NumberDecimalSeparator };

	//Generate FormatInfo JavaScript object in JSON format
	var numberFormatInfoString = String.Format("{{{0}" + "\"NegativeSign\":\"{1}\",{0}" + "\"NumberDecimalDigits\":{2},{0}" + "\"NumberDecimalSeparator\":\"{3}\",{0}" + "\"NumberGroupSeparator\":\"{4}\",{0}" + "\"NumberGroupSizes\":{5},{0}" + "\"NumberNegativePattern\":{6},{0}" + "\"ShortDatePattern\":\"{7}\"{0}}}", Environment.NewLine, "-", 0, Model.Site.NumberDecimalSeparator, Model.Site.NumberGroupSeparator, Model.Site.GetNumberGroupSizes()[0], 1, Model.Site.ShortDatePattern);


	<input id="NumberFormatInfoString" type="hidden" value='@numberFormatInfoString' />


	@Html.AntiForgeryToken();
	@Html.HiddenFor(m => m.PointTemplateGuid);
	@Html.HiddenFor(m => m.PointTemplateId);

	@Html.Hidden("urlSaveDeviceAlarmMaps", @Url.Action("SaveDeviceAlarmMaps", "DeviceAlarmMapsEditor"));

	var seqText = FMBaseController.TranslateText("Seq.");
	var bitMaskText = FMBaseController.TranslateText("Bit Mask");
	var nameText = FMBaseController.TranslateText("Name");
	var priorityText = FMBaseController.TranslateText("Priority");

	var normalPriorities = new SelectList(@Model.NormalPriorityDictionary.Values.OrderBy(x => x.ID), "IdentityGuid", "ID");
	var alarmPriorities = new SelectList(@Model.AlarmPriorityDictionary.Values.OrderBy(x => x.ID), "IdentityGuid", "ID");
	var alarmCategories = new SelectList(@Model.AlarmCategoryDictionary.OrderBy(x => x.Value), "Key", "Value");
	var dameNotAlarmText = FMBaseController.TranslateText("AlarmTemplateEditor|Not Alarm Text");
	var dameNotInAlarmText = FMBaseController.TranslateText("AlarmTemplateEditor|Not in Alarm Text");
	var dameAlarmCategoryText = FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Category");
	var dameNormalUnakcnowledgedAlarmPriority = FMBaseController.TranslateText("AlarmTemplateEditor|Normal UnAcknowledged Alarm Priority");
	var dameTextText = FMBaseController.TranslateText("AlarmTemplateEditor|Text");
	var dameAddNewDeviceAlarmEntry = FMBaseController.TranslateText("DeviceAlarmMapEditor|Add New Device Alarm Map Entry");
	var dameDeleteDeviceAlarmMapEntries = FMBaseController.TranslateText("DeviceAlarmMapEditor|Delete Device Alarm Map Entries");

	@Html.Hidden("DAMEAlarmCategories", JsonConvert.SerializeObject(alarmCategories));
	@Html.Hidden("DAMEAlarmPriorities", JsonConvert.SerializeObject(alarmPriorities));
	@Html.Hidden("DAMENormalPriorities", JsonConvert.SerializeObject(normalPriorities));


	@Html.Hidden("DAMAlarmNameMusBeAlphaNumeric", FMBaseController.TranslateText("DeviceAlarmMapEditor|Alarm Name must be alphanumeric"));
	@Html.Hidden("DAMEDeleteMapText", FMBaseController.TranslateText("DeviceAlarmMapEditor|Delete &Map"));
	@Html.Hidden("DAMEDuplicateNameText", FMBaseController.TranslateText("DeviceAlarmMapEditor|Duplicate Name"));
	@Html.Hidden("DAMEDuplicateBitMaskText", FMBaseController.TranslateText("DeviceAlarmMapEditor|Duplicate Bit Mask"));
	@Html.Hidden("DAMEDeleteConfirmation", FMBaseController.TranslateText("Are you sure you wish to delete selected item(s)?"));
	@Html.Hidden("DAMEDeleteTableConfirmation", FMBaseController.TranslateText("Are you sure you wish to delete map"));
	@Html.Hidden("DAMESuccessSavingChanges", FMBaseController.TranslateText("Success! saving changes."));
	@Html.Hidden("AddRowDD", FMBaseController.TranslateText("&Add"));
	@Html.Hidden("DeleteRowDD", FMBaseController.TranslateText("De&lete"));
	@Html.Hidden("DAMETextText", dameTextText)
	@Html.Hidden("DAMENotAlarmText", dameNotAlarmText);
	@Html.Hidden("DAMENotInAlarmText", dameNotInAlarmText);
	@Html.Hidden("DAMEAlarmCategoryText", dameAlarmCategoryText);
	@Html.Hidden("DAMENormalUnacknowledgedAlarmPriority", dameNormalUnakcnowledgedAlarmPriority);
	@Html.Hidden("ModifyRight", @Model.HasModifyRight);
	@Html.Hidden("DAMEAddNewDeviceAlarmEntry", dameAddNewDeviceAlarmEntry);
	@Html.Hidden("DAMEDeleteDeviceAlarmMapEntries", dameDeleteDeviceAlarmMapEntries);
	@Html.Hidden("DAMESeqText", seqText);
	@Html.Hidden("DAMEBitMaskText", bitMaskText);
	@Html.Hidden("DAMEPriorityText", priorityText);
	@Html.Hidden("DAMENameText", nameText);

	<section id="DeviceAlarmMapsPartial" class="">
		<div class="DeviceAlarmMapsHeader row">
			<button type="button" class="close" data-dismiss="modal" onclick="$('#DAMECloseButton').click();">&times;</button>
			<div class="col-xs-12">
				<h4>@Model.PointTemplateId</h4>
			</div>
			<div class="col-xs-12">
				<h5>@FMBaseController.TranslateText("DeviceAlarmMapEditor|Device Alarm Maps Editor")</h5>
			</div>
		</div>

		<div id="tabs" class="row">
			<div id="mainTabSection" class="col-xs-12">
				<div id="mainTab">
					<ul class="nav nav-tabs" id="tabList">
						@for (var DeviceAlarmMapIndex = 0; DeviceAlarmMapIndex < Model.DeviceAlarmMaps.Count; DeviceAlarmMapIndex++)
						{
							var DeviceAlarmMap = Model.DeviceAlarmMaps[DeviceAlarmMapIndex];
							if (DeviceAlarmMap == null)
							{
								continue;
							}
						<li class="tab-table">
							<a data-target="#DeviceAlarmMap_@DeviceAlarmMapIndex" data-toggle="tab" onclick="FMDeviceAlarmMapsEditor.onTabChange(this);" ondblclick="FMDeviceAlarmMapsEditor.renameTab(this);">
								@Html.Label(Model.DeviceAlarmMaps[DeviceAlarmMapIndex].ID, new { @class = "tab-name" })
								@Html.HiddenFor(m => m.DeviceAlarmMaps[DeviceAlarmMapIndex].ID, new { @class = "old-tab-name" })
								@Html.HiddenFor(m => m.DeviceAlarmMaps[DeviceAlarmMapIndex].DeviceAlarmMapGuid, new { @class = "tab-guid" })
							</a>
						</li>
						}

						<li class="tab-add-table" style="@ModifyDAMListDisplay">
							<a id="addTable" class="anchor-add-table">
								<label class=""></label>
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div>
				<div class="tab-content">
					@for (var DeviceAlarmMapIndex = 0; DeviceAlarmMapIndex < Model.DeviceAlarmMaps.Count; DeviceAlarmMapIndex++)
					{
						var deviceAlarmMap = Model.DeviceAlarmMaps[DeviceAlarmMapIndex];
						if (deviceAlarmMap == null)
						{
							continue;
						}
						<div class="tab-pane" id="DeviceAlarmMap_@DeviceAlarmMapIndex">
							<div class="form-group  col-xs-3 col-sm-3 col-md-3 col-lg-3">
								<label for="NotInAlarmText_@DeviceAlarmMapIndex">@dameNotAlarmText</label>
								<input id="NotInAlarmText_@DeviceAlarmMapIndex" type="text" class="form-control not-alarm-text" maxlength="100" value="@deviceAlarmMap.NotAlarmText" placeholder="@dameNotInAlarmText" required />
							</div>

							<div class="form-group col-xs-3 col-sm-3 col-md-3 col-lg-3" style="height: 59px">
								<label for="AlarmCategory_@DeviceAlarmMapIndex">@dameAlarmCategoryText</label>
								<select class="form-control alarm-category" id="AlarmCategory_@DeviceAlarmMapIndex">
									@foreach (var alarmCategory in alarmCategories)
									{
										if (alarmCategory.Value == deviceAlarmMap.AlarmCategory.ToString())
										{
											<option value="@alarmCategory.Value" selected>@alarmCategory.Text</option>
										}
										else
										{
											<option value="@alarmCategory.Value">@alarmCategory.Text</option>
										}
									}
								</select>
							</div>

							<div class="form-group col-xs-6 col-sm-6 col-md-6 col-lg-6" style="height: 59px">
								<label for="NormalUnacknowledgedAlarmPriority_@DeviceAlarmMapIndex">@dameNormalUnakcnowledgedAlarmPriority</label>
								<select class="form-control normal-unacknowledged-priority" id="NormalUnacknowledgedAlarmPriority_@DeviceAlarmMapIndex">
									@foreach (var alarmPriority1 in normalPriorities)
									{
										if (alarmPriority1.Value == deviceAlarmMap.NormalUnacknowledgedPriority.ToString())
										{
											<option value="@alarmPriority1.Value" selected>@alarmPriority1.Text</option>
										}
										else
										{
											<option value="@alarmPriority1.Value">@alarmPriority1.Text</option>
										}
									}
								</select>
							</div>

							<div class="DeviceAlarmMaps col-xs-12 col-sm-12 col-md-12 col-lg-12">
								<table id="DeviceAlarmMapEditorTable_@DeviceAlarmMapIndex" class="table table-striped table-bordered hover" style="width:100%">
									<thead class="">
										<tr>
											<th class="text-center">
												@seqText
											</th>
											<th class="text-center">
												@bitMaskText
											</th> 
											<th class="text-center">
												@priorityText
											</th>
											<th class="text-center">
												@nameText
											</th>
										</tr>
									</thead>
									<tbody id="DeviceAlarmMapEditorTableBody">
										@for (var index = 0; index < deviceAlarmMap.DeviceAlarmMapEntryList.Count; ++index)
										{
											var deviceAlarmMapEntry = deviceAlarmMap.DeviceAlarmMapEntryList[index];
											var number = index + 1;
											var alarmPriority2 = Model.AlarmPriorityDictionary[deviceAlarmMapEntry.AlarmPriority];
											var bitMask = "0x" + deviceAlarmMapEntry.BitMask.ToString("X8");

											<tr>
												<td>@number</td>
												<td>@bitMask</td>
												<td>@alarmPriority2.ID<span style="margin-left:10px; padding:0px 15px; background-color: #@alarmPriority2.BackgroundSteady; color: #@alarmPriority2.TextSteady">@dameTextText</span></td>
												<td>@deviceAlarmMapEntry.TestName</td>
											</tr>
										}
									</tbody>
								</table>
								<br />
								<div class="" role="group">
									<button id="addDeviceAlarmMapEntryButton_@DeviceAlarmMapIndex" name="addDeviceAlarmMapEntryButton_@DeviceAlarmMapIndex" type="button" value="addDeviceAlarmMapEntryButton" accesskey="A" class="addDeviceAlarmMapEntryButton formfieldtitle tabPushButton" title="@dameAddNewDeviceAlarmEntry" style="width: 100px; @ModifyDAMListDisplay"><u>A</u>dd</button>
									<button id="deleteDeviceAlarmMapEntriesButton_@DeviceAlarmMapIndex" name="deleteDeviceAlarmMapEntriesButton_@DeviceAlarmMapIndex" type="button" value="deleteDeviceAlarmMapEntriesButton" accesskey="A" class="deleteDeviceAlarmMapEntriesButton formfieldtitle tabPushButton" title="@dameDeleteDeviceAlarmMapEntries" disabled="disabled" style="width: 100px; @ModifyDAMListDisplay"><u>D</u>elete</button>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</section>
}

<section id="DeviceAlarmMapModals">
	<div id="DeviceAlarmMapConfirmationDialog"></div>
</section>



	<script type="text/javascript">
		var dameAlarmPriorityData = [];
		@{
			var alarmTextText = FMBaseController.TranslateText("AlarmTemplateEditor|Text");
			foreach (var alarmPriority in @Model.AlarmPriorityDictionary.Values.OrderBy(x => x.ID))
			{
				<text>
					dameAlarmPriorityData.push({ id: '@alarmPriority.ID', identityGuid: '@alarmPriority.IdentityGuid', html: '<span style="margin-left:10px; padding:0px 15px; background-color: #@alarmPriority.BackgroundSteady; color: #@alarmPriority.TextSteady">@alarmTextText</span>' });
				</text>
			}
		}

		var dameNormalPriorityData = [];
		@{
			var normalTextText = FMBaseController.TranslateText("AlarmTemplateEditor|Text");
			foreach (var normalPriority in @Model.NormalPriorityDictionary.Values.OrderBy(x => x.ID))
			{
				<text>
					dameNormalPriorityData.push({ id: '@normalPriority.ID', identityGuid: '@normalPriority.IdentityGuid', html: '<span style="margin-left:10px; padding:0px 15px; background-color: #@normalPriority.BackgroundSteady; color: #@normalPriority.TextSteady">@normalTextText</span>' });
				</text>
			}
		}



		//--------------------------------------- RUN after page has been loaded but before render -----------------------------

		$(document).ready(function () {

			$('#mainTab').scrollingTabs({ scrollToTabEdge: true });

			// make the first tab active
			var activeTab = 0;
			$('a[data-target="#DeviceAlarmMap_' + activeTab + '"]').tab('show');

			var tabCount = $('#tabList li.tab-table').length;

			for (var DeviceAlarmMapIndex = 0; DeviceAlarmMapIndex < tabCount; DeviceAlarmMapIndex++) {
				$('#AlarmCategory_' + DeviceAlarmMapIndex).select2();

				$('#NormalUnacknowledgedAlarmPriority_' + DeviceAlarmMapIndex).select2({
					templateSelection: function (selection) {
						if (selection.selected) {
							var selectedNormalPriority = jQuery.grep(dameNormalPriorityData, function (a) {
								return a.identityGuid === selection.id;
							});

							if (selectedNormalPriority.length > 0) {
								return $.parseHTML(selection.text + selectedNormalPriority[0].html);
							}
							return $.parseHTML(selection.text);
						}

					},
					templateResult: function (selection) {
						var selectedNormalPriority = jQuery.grep(dameNormalPriorityData, function (a) {
							return a.identityGuid === selection.id;
						});

						if (selectedNormalPriority.length > 0) {
							return $.parseHTML(selection.text + selectedNormalPriority[0].html);
						}
						return $.parseHTML(selection.text);
					}
				});

				var tabDescription = $('#tabList li.tab-table')[DeviceAlarmMapIndex].innerText;

				var standardTankDefault = (FMDeviceAlarmMapsEditor.isStandardTankDefault(tabDescription)) ? true : false;
				var reorderClass = (standardTankDefault) ? 'text-center' : 'reorder text-center';
				var orderable = (standardTankDefault) ? false : true;

				var DAMEDeviceAlarmMap = $('#DeviceAlarmMapEditorTable_' + DeviceAlarmMapIndex).DataTable(
					{
						"retrieve": true,
						"ordering": orderable,
						"select": true,
						"scrollY": '300px',
						"sScrollX": '100%',
						"sScrollXInner": '100%',
						"scrollCollapse": false,
						"paging": false,
						"autoWidth": false,
						"rowReorder": orderable,
						"columnDefs": [
							{ "width": "5%", "targets": [0], "name": 'Seq.', "orderable": false, className: reorderClass },
							{ "width": "20%", "targets": [1], "name": 'Bit Mask', "orderable": false, className: 'DeviceAlarmMapBitMaskColumn text-center' },
							{ "width": "45%", "targets": [2], "name": 'Priority', "orderable": false, className: 'DeviceAlarmMapPriorityColumn text-center' },
							{ "width": "30%", "targets": [3], "name": 'Name', "orderable": false, className: 'DeviceAlarmMapNameColumn text-center' },
						],
						"dom": 'rt',
						"fnInitComplete": function () {
							// custom scroll bars
							$(this).parent()
								.niceScroll({
									cursorwidth: '10px',
									autohidemode: false,
									cursorcolor: '#486899',
									background: 'rgb(240, 240, 240)',
									horizrailenabled: false
								});
						}
					});

				$("#NotInAlarmText_" + DeviceAlarmMapIndex).attr('disabled', standardTankDefault);
				$('#AlarmCategory_' + DeviceAlarmMapIndex).attr('disabled', standardTankDefault);
				$('#NormalUnacknowledgedAlarmPriority_' + DeviceAlarmMapIndex).attr('disabled', standardTankDefault);

				DAMEDeviceAlarmMap.draw();
				FMDeviceAlarmMapsEditor.initializeTabContent(DeviceAlarmMapIndex);

			}


			// adjust the column headers for the active tab
			setTimeout(function () {
				var DAMEDeviceAlarmMap = $('#DeviceAlarmMapEditorTable_' + activeTab).DataTable();
				DAMEDeviceAlarmMap.columns.adjust().draw();
			}, 100);

			// Add Device Alarm Map EntriesList Delete button to footer
			if ($('#ModifyRight').val() == 'True') {
				var leftFooter = $('#DeviceAlarmMapsEditorScreen .modal-footer .btn-toolbar .pull-left');
				leftFooter.html('<button id=\"DAMEDeleteMap\" type=\"button\" class=\"formfieldtitle pushButton\" style=\"width: 100px;margin-left: 5px;\">' + $('#DAMEDeleteMapText').val() + '</button>');
			}

			var delButton = $('#DAMEDeleteMap');
			ampersandIndex = delButton.text().indexOf('&');
			if (ampersandIndex !== -1) {
				var hotKey = delButton.text().charAt(ampersandIndex + 1);
				delButton.html(delButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
				delButton.attr('accesskey', hotKey);
			}

			// Add alignment for the close button in the footer
			$('#PEMPEClosePropertyScreen').css('marginRight', '42px');

			FMDeviceAlarmMapsEditor.enableChangesToTab();

			FMDeviceAlarmMapsEditor.enableAddTab(tabCount);

			$('#DAMEDeleteMap').on('click', function () {
				FMDeviceAlarmMapsEditor.deleteTable();
			});


			FMErrorAndExceptionHandling.CloseNotifications();
		});
	</script>


