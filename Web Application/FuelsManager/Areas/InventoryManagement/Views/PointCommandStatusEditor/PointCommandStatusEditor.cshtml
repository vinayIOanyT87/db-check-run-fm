
@using System.Web.Mvc.Html
@using System.Globalization
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.PointCommandStatusEditorModel

<link href="~/Areas/Content/jquery.scrolling-tabs-custom.css" rel="stylesheet">
<link href="~/Areas/Content/PointCommandStatusEditor.css" rel="stylesheet" type="text/css"/>
<link href="~/Areas/Content/jquery.contextmenu.css" rel="stylesheet">

<script src="~/Areas/lib/jquery.scrolling-tabs-custom.js"></script>
<script src="~/Areas/lib/jquery.contextmenu.js" type="text/javascript"></script>
<script src="~/Areas/Scripts/PointCommandStatusEditor.js"></script>

@using (Html.BeginForm("PointCommandStatusEditor", "PointCommandStatusEditor", FormMethod.Post, new { id = "PointCommandStatusForm" }))
{
	var ModifyPCSListDisplay = (@Model.HasModifyRight) ? "" : "display: none;";
	var numberFormatInfo = new NumberFormatInfo { NumberGroupSizes = Model.Site.GetNumberGroupSizes(), NumberGroupSeparator = Model.Site.NumberGroupSeparator, NumberDecimalSeparator = Model.Site.NumberDecimalSeparator };

	//Generate FormatInfo JavaScript object in JSON format
	var numberFormatInfoString = String.Format("{{{0}" + "\"NegativeSign\":\"{1}\",{0}" + "\"NumberDecimalDigits\":{2},{0}" + "\"NumberDecimalSeparator\":\"{3}\",{0}" + "\"NumberGroupSeparator\":\"{4}\",{0}" + "\"NumberGroupSizes\":{5},{0}" + "\"NumberNegativePattern\":{6},{0}" + "\"ShortDatePattern\":\"{7}\"{0}}}", Environment.NewLine, "-", 0, Model.Site.NumberDecimalSeparator, Model.Site.NumberGroupSeparator, Model.Site.GetNumberGroupSizes()[0], 1, Model.Site.ShortDatePattern);


	<input id="NumberFormatInfoString" type="hidden" value='@numberFormatInfoString' />


	@Html.AntiForgeryToken();
	@Html.HiddenFor(m => m.PointTemplateGuid);
	@Html.HiddenFor(m => m.PointTemplateId);

	@Html.Hidden("urlSavePointCommandStatus", @Url.Action("SavePointCommandStatus", "PointCommandStatusEditor"));

	@Html.Hidden("PCEDeleteListText", FMBaseController.TranslateText("Delete &List"));
	@Html.Hidden("PCEDuplicateKey", FMBaseController.TranslateText("Duplicate Key."));
	@Html.Hidden("PCEDuplicateValue", FMBaseController.TranslateText("Duplicate Value."));
	@Html.Hidden("SEDeleteConfirmation", FMBaseController.TranslateText("Are you sure you wish to delete selected item(s)?"));
	@Html.Hidden("SEDeleteTableConfirmation", FMBaseController.TranslateText("Are you sure you wish to delete list"));
	@Html.Hidden("NumberTextDD", FMBaseController.TranslateText("Number"));
	@Html.Hidden("KeyTextDD", FMBaseController.TranslateText("Key"));
	@Html.Hidden("ValueTextDD", FMBaseController.TranslateText("Value"));
	@Html.Hidden("AddRowDD", FMBaseController.TranslateText("&Add"));
	@Html.Hidden("DeleteRowDD", FMBaseController.TranslateText("De&lete"));
	@Html.Hidden("SESuccessSavingChanges", FMBaseController.TranslateText("Success! saving changes."));
	@Html.Hidden("ModifyRight", @Model.HasModifyRight);

	<section id="PointCommandStatusPartial" class="">
		<div class="PointCommandStatusHeader row">
			<button type="button" class="close" data-dismiss="modal" onclick="$('#PCECloseButton').click();">&times;</button>
			<div class="col-xs-12">
				<h4>@Model.PointTemplateId</h4>
			</div>
			<div class="col-xs-12">
				<h5>@FMBaseController.TranslateText("Point Command-Status Editor")</h5>
			</div>
		</div>

		<div id="tabs" class="row">
			<div id="mainTabSection" class="col-xs-12">
				<div id="mainTab">
					<ul class="nav nav-tabs" id="tabList">
						@for (var pointCommandStatusIndex = 0; pointCommandStatusIndex < Model.PointCommandStatus.CommandStatusLists.Count; pointCommandStatusIndex++)
						{
							var pointCommandStatus = Model.PointCommandStatus.CommandStatusLists[pointCommandStatusIndex];
							if (pointCommandStatus == null)
							{
								continue;
							}
							<li class="tab-table">
								<a data-target="#PointCommandStatus_@pointCommandStatusIndex" data-toggle="tab" onclick="FMPointCommandStatusEditor.onTabChange(this);" ondblclick="FMPointCommandStatusEditor.renameTab(this);">
									@Html.Label(Model.PointCommandStatus.CommandStatusLists[pointCommandStatusIndex].ID, new { @class = "tab-name" })
									@Html.HiddenFor(m => m.PointCommandStatus.CommandStatusLists[pointCommandStatusIndex].ID, new { @class = "old-tab-name" })
									@Html.HiddenFor(m => m.PointCommandStatus.CommandStatusLists[pointCommandStatusIndex].CommandStatusListGuid, new { @class = "tab-guid" })
								</a>
							</li>
						}

						<li class="tab-add-table" style="@ModifyPCSListDisplay">
							<a id="addTable" class="anchor-add-table">
								<label class=""></label>
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div>
				<div class="tab-content">
					@for (var pointCommandStatusIndex = 0; pointCommandStatusIndex < Model.PointCommandStatus.CommandStatusLists.Count; pointCommandStatusIndex++)
					{
						var pointCommandStatus = Model.PointCommandStatus.CommandStatusLists[pointCommandStatusIndex];
						if (pointCommandStatus == null)
						{
							continue;
						}
						<div class="tab-pane" id="PointCommandStatus_@pointCommandStatusIndex">

							<div class="pointCommandStatus col-xs-12 col-sm-12 col-md-12 col-lg-12">
								<table id="PointCommandStatusEditorTable_@pointCommandStatusIndex" class="table table-striped table-bordered hover" style="width:100%">
									<thead class="">
										<tr>
											<th style="" class="text-center">
												@FMBaseController.TranslateText("Number")
											</th>
											<th class="text-center">
												@FMBaseController.TranslateText("Key")
											</th>
											<th class="text-center">
												@FMBaseController.TranslateText("Value")
											</th>
										</tr>
									</thead>
									<tbody id="PointCommandStatusEditorTableBody">
										@for (var index = 0; index < Model.EditorEntries[pointCommandStatusIndex].PointCommandStatusEntries.Count; ++index)
										{
											var entry = Model.EditorEntries[pointCommandStatusIndex].PointCommandStatusEntries[index];
											var number = index + 1;

											<tr>
												<td>@number</td>
												<td>@entry.KeyEntry</td>
												<td>@entry.ValueEntry</td>
											</tr>
										}
									</tbody>
								</table>
								<br />
								<div class="" role="group">
									<button id="addCommandStatusEntryButton_@pointCommandStatusIndex" name="addCommandStatusEntryButton_@pointCommandStatusIndex" type="button" value="addCommandStatusEntryButton" accesskey="A" class="addCommandStatusEntryButton formfieldtitle tabPushButton" title="Add New Command-Status Entry" style="width: 100px; @ModifyPCSListDisplay"><u>A</u>dd</button>
									<button id="deleteCommandStatusEntriesButton_@pointCommandStatusIndex" name="deleteCommandStatusEntriesButton_@pointCommandStatusIndex" type="button" value="deleteCommandStatusEntriesButton" accesskey="A" class="deleteCommandStatusEntriesButton formfieldtitle tabPushButton" title="Delete Command-Status Entries" disabled="disabled" style="width: 100px; @ModifyPCSListDisplay"><u>D</u>elete</button>
								</div>
							</div>
						</div>
				}
				</div>
			</div>
		</div>
	</section>
}

<section id="pointCommandStatusModals">
	<div id="pointCommandStatusConfirmationDialog"></div>
</section>

