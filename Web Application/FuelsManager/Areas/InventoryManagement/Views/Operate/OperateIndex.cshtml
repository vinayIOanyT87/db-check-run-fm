            <div class="alarm-notification-row"><span class="pull-left" id="alarm-notification-priority-label">Priority</span></div>
            <div class="alarm-notification-row"><span class="pull-left" id="alarm-notification-priority"></span><span class="pull-right" id="alarm-notification-time"></span></div>
        </div>
        <div class="alarm-notification-detail-info">Click above to open Summary</div>
    </div>
</div>

