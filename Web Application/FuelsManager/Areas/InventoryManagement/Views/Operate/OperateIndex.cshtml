		});

	// open the menu on click
	$(".hamburger-menu").on("click", function() {
		$("#menuPane").removeClass("hidden");
	});

	// close the menu when losing focus
		$("#menuPane, .hamburger-menu").hover(function () {
			if ($('#menuPane').is(':hover') === true || $('.hamburger-menu').is(':hover') === true){
				$("#menuPane").removeClass("hidden");
				$(".hamburger-menu").removeClass("active").addClass("active");

				if ($(".operateMenuItem.active a").attr("id") && FMOperateIndex.refreshHamburgerMenu) {
					// get the menuid that is being displayed
					var menuId = $(".operateMenuItem.active a").attr("id");
					// refresh the menu if there was a change (added/updated/removed entries)
					if (menuId === "menuPointGroups" || menuId === "menuTrends" || menuId === "menuMovementSummary") {
						$("#" + menuId).click();
					}
				}
				FMOperateIndex.refreshHamburgerMenu = false;
			}
		}, function () {
			setTimeout(function () {
				if ($('#menuPane').is(':hover') === false && $('.hamburger-menu').is(':hover') === false) {

					// NOTE: there is a bug in IE in tha SELECT tags do not propagate events to the parents so the menu gets hidden when a dropdown is opened
					// The following code is a workaround, it checks if the drop downs have focus and if its the case it won't hide the menu
					var activeControl = $(":focus").attr('id');
					if (activeControl !== 'PointTypeId' && activeControl !== 'CategoryId') {
						$("#menuPane").removeClass("hidden").addClass("hidden");
						$(".hamburger-menu").removeClass("active");
					}
				}
			}, 50);
		});

    // initialize the webworker to check for the alarms
		try {
			FMOperateIndex.InitAlarmWebWorker ( '@Url.Content("~/Areas/InventoryManagement/Views/Operate/WebWorkers/AlarmWebWorker.js")');
		}
		catch (err) {
			console.error('Operate alarm worker startup failed.', err);
		}

		try {
			$( "#alarm-notification" ).draggable({
				iframeFix: true
			});
		}
		catch (err) {
			console.error('Operate alarm notification initialization failed.', err);
		}

    // initialize the webworker to update the tags
		try {
			FMOperateIndex.InitTagWebWorker ( '@Url.Content("~/Areas/InventoryManagement/Views/Operate/WebWorkers/TagWebWorker.js")');
		}
		catch (err) {
			console.error('Operate tag worker startup failed.', err);
		}

		try {
			FMOperateIndex.InitStatisticsWebWorker('@Url.Content("~/Areas/InventoryManagement/Views/Operate/WebWorkers/StatisticsWebWorker.js")');
		}
		catch (err) {
			console.error('Operate statistics worker startup failed.', err);
		}

		FMOperateIndex.inlineStartupCompleted = true;
		FMOperateIndex.StartPersistedControlRestore('inline startup');
  });

