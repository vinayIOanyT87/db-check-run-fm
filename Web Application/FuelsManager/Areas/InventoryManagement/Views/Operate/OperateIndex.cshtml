<div class="row">
    <div id="PointGroupReportSchedule" class="modal fade pointGroupReportSchedulemodal" data-width="725" data-backdrop="static" data-focus-on="input:first" role="dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button id="PointGroupReportSchedule_CloseButton" type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 id="PointGroupReportScheduleScreen" class="modal-title">@FMBaseController.TranslateText("Schedule Point Group Report")</h4>
            </div>
            <div class="modal-body">

                <div class="row">
                    <div class="col-sm-3"><label for="PointGroupReportScheduleName">Point Group</label></div>
                    <div class="col-sm-9"><input class="form-control" id="PointGroupReportScheduleName" disabled></div>
                </div>
                <section id="PointGroupReportScheduleSection" class="">
                    <div class="row settingsection">
                        <span class="pull-left separator-label">SCHEDULE</span>
                        <div class="settingsectionhorizontalline"></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3"><label>Start</label></div>
                        <div class="col-sm-9">
                            <input type="text" class="form-control text-center" id="PointGroupReportScheduleStartDate" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3"><label>Repeat</label></div>
                        <div class="col-sm-9">
                            <div id="PointGroupReportScheduleRepeat" class="btn-group" role="group" aria-label="Repeat">
                                <button type="button" id="PointGroupReportScheduleRepeatNever" class="btn btn-primary">Never</button>
                                <button type="button" id="PointGroupReportScheduleRepeatHourly" class="btn btn-primary">Hourly</button>
                                <button type="button" id="PointGroupReportScheduleRepeatDaily" class="btn btn-primary">Daily</button>
                                <button type="button" id="PointGroupReportScheduleRepeatWeekly" class="btn btn-primary">Weekly</button>
                                <button type="button" id="PointGroupReportScheduleRepeatMonthly" class="btn btn-primary">Monthly</button>
                                <button type="button" id="PointGroupReportScheduleRepeatYearly" class="btn btn-primary hidden">Yearly</button>
                            </div>
                        </div>
                    </div>
                    <section id="printscheduleHourly" class="hidden">
                        <div class="row">
                            <div class="col-sm-3"><label for="PointGroupReportScheduleRepeatHourlyEvery">Repeat Every</label></div>
                            <div class="col-sm-9"><input type="number" min="1" max="24" class="form-control" id="PointGroupReportScheduleRepeatHourlyEvery" onkeyup='FMOperateIndex.enforceMinMax(this)'><span>hour(s)</span></div>
                        </div>
                    </section>
                    <section id="printscheduledaily" class="hidden">
                        <div class="row">
                            <div class="col-sm-3"><label for="PointGroupReportScheduleRepeatEvery">Repeat Every</label></div>
                            <div class="col-sm-9"><input type="number" min="1" max="31" class="form-control" id="PointGroupReportScheduleRepeatEvery" onkeyup='FMOperateIndex.enforceMinMax(this)'><span>days(s)</span></div>
                        </div>
                    </section>
                    <section id="printscheduleWeekly" class="hidden">
                        <div class="row">
                            <div class="col-sm-3"><label>Repeat on</label></div>
                            <div class="col-sm-9">
                                <div id="PointGroupReportScheduleRepeatWeekly" class="btn-group" role="group" aria-label="Repeat">
                                    <button type="button" id="PointGroupReportScheduleRepeatSun" class="btn btn-primary">Sun</button>
                                    <button type="button" id="PointGroupReportScheduleRepeatMon" class="btn btn-primary">Mon</button>
                                    <button type="button" id="PointGroupReportScheduleRepeatTue" class="btn btn-primary">Tue</button>
                                    <button type="button" id="PointGroupReportScheduleRepeatWed" class="btn btn-primary">Wed</button>
                                    <button type="button" id="PointGroupReportScheduleRepeatThu" class="btn btn-primary">Thu</button>
                                    <button type="button" id="PointGroupReportScheduleRepeatFri" class="btn btn-primary">Fri</button>
                                    <button type="button" id="PointGroupReportScheduleRepeatSat" class="btn btn-primary">Sat</button>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section id="printschedulemonthly" class="hidden">
                        <div class="row">
                            <div class="col-sm-3"><label for="PointGroupReportScheduleRepeatEveryMonth">Repeat Every</label></div>
                            <div class="col-sm-9">
                                <input type="number" min="1" max="12" class="form-control" id="PointGroupReportScheduleRepeatEveryMonth" onkeyup='FMOperateIndex.enforceMinMax(this)'>
                                <span>months(s)</span>
                                <span class="pull-right" style="font-size:10px">* starting in January</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <label>Repeat On</label>
                            </div>
                            <div class="col-sm-9" style="padding-left:30px">
                                <div class="row">
                                    <label class="setting-radio-control setting-radio-control--radio">
                                        <input type="radio" name="reportscheduleMonthly" value="0" onchange="FMOperateIndex.reportScheduleMonthOptions('0')" />
                                        <div class="setting-radio-control__indicator"></div>
                                    </label>
                                    <span>Day</span>
                                    <input type="number" min="1" max="31" class="form-control" id="PointGroupReportScheduleMonthlyRepeatDay" onkeyup='FMOperateIndex.enforceMinMax(this)'>
                                </div>
                                <div class="row">
                                    <label class="setting-radio-control setting-radio-control--radio">
                                        <input type="radio" name="reportscheduleMonthly" value="1" onchange="FMOperateIndex.reportScheduleMonthOptions('1')" />
                                        <div class="setting-radio-control__indicator"></div>
                                    </label>
                                    <select id="reportscheduleMonthlyWeek" class="form-control">
                                        <option value="1">First</option>
                                        <option value="2">Second</option>
                                        <option value="3">Third</option>
                                        <option value="4">Fourth</option>
                                        <option value="5">Last</option>
                                    </select>
                                    <select id="reportscheduleMonthlyDay" class="form-control">
                                        <option value="1">Day</option>
                                        <option value="2">Weekday</option>
                                        <option value="3">Sunday</option>
                                        <option value="4">Monday</option>
                                        <option value="5">Tuesday</option>
                                        <option value="6">Wednesday</option>
                                        <option value="7">Thursday</option>
                                        <option value="8">Friday</option>
                                        <option value="9">Saturday</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section id="printscheduleyearly" class="hidden">
                        <div class="row">
                            <div class="col-sm-3"><label for="PointGroupReportScheduleRepeatEveryYear">Repeat Every</label></div>
                            <div class="col-sm-9"><input type="number" min="1" max="99" class="form-control" id="PointGroupReportScheduleRepeatEveryYear" onkeyup='FMOperateIndex.enforceMinMax(this)'><span>year(s)</span></div>
                        </div>

                    </section>
                    <section id="printscheduleend" class="hidden">
                        <div class="row">
                            <div class="col-sm-3">
                                <label for="k-event-title">End</label>
                            </div>
                            <div class="col-sm-9" style="padding-left:30px">
                                <div class="row">
                                    <label class="setting-radio-control setting-radio-control--radio">
                                        <input type="radio" name="reportscheduleEndOptions" value="0" onchange="FMOperateIndex.reportscheduleEndOptions('0')" />
                                        <div class="setting-radio-control__indicator"></div>
                                    </label>
                                    <span>Never</span>
                                </div>
                                <div class="row">
                                    <label class="setting-radio-control setting-radio-control--radio">
                                        <input type="radio" name="reportscheduleEndOptions" value="2" onchange="FMOperateIndex.reportscheduleEndOptions('2')" />
                                        <div class="setting-radio-control__indicator"></div>
                                    </label>
                                    <span>On</span>
                                    <input type="text" class="form-control text-center" id="PointGroupReportScheduleEndDate" />
                                </div>
                            </div>
                        </div>
                    </section>
                </section>
                <section id="delivery">
                    <div class="row settingsection">
                        <span class="pull-left separator-label">DELIVERY</span>
                        <div class="settingsectionhorizontalline"></div>
                    </div>

                    <div class="row">
                        <div class="col-sm-3"><label for="PointGroupReportScheduleExportFileFormat">Export File Format</label></div>
                        <div class="col-sm-9">
                            <select class="form-control" id="PointGroupReportScheduleExportFileFormat">
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-3"><label for="PointGroupReportSchedulePrinter">Print to</label></div>
                        <div class="col-sm-9"><select class="form-control" id="PointGroupReportSchedulePrinter"></select></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3"><label for="PointGroupReportScheduleEmail">Email to</label></div>
                        <div class="col-sm-9"><input type="text" maxlength="150" class="form-control" id="PointGroupReportScheduleEmail" placeholder="Email recipients"></div>
                    </div>

                    <section id="fileExportOptions">
                        <div class="row">
                            <div class="col-sm-3">
                                <label for="k-event-title">Export File Options</label>
                            </div>
                            <div class="col-sm-9" style="padding-left:30px">
                                <div class="row">
                                    <label class="setting-radio-control setting-radio-control--radio">
                                        <input type="radio" name="reportscheduleFileExportOverwrite" value="0" onchange="FMOperateIndex.reportscheduleFileExportOverwrite('0')" />
                                        <div class="setting-radio-control__indicator"></div>
                                    </label>
                                    <span>
                                        @FMBaseController.TranslateText("PointGroupSchedule|New file with date/time stamp")&nbsp;&nbsp;&nbsp;
                                    </span>
                                    <label class="setting-radio-control setting-radio-control--radio">
                                        <input type="radio" name="reportscheduleFileExportOverwrite" value="1" onchange="FMOperateIndex.reportscheduleFileExportOverwrite('1')" />
                                        <div class="setting-radio-control__indicator"></div>
                                    </label>
                                    <span>
                                        @FMBaseController.TranslateText("PointGroupSchedule|Overwrite current file")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </section>

                </section>
                <section id="output">
                    <div class="row settingsection">
                        <span class="pull-left separator-label">OUTPUT</span>
                        <div class="settingsectionhorizontalline"></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3"><label for="PointGroupReportScheduleLayout">Layout</label></div>
                        <div class="col-sm-5">
                            <select id="PointGroupReportScheduleLayout" class="form-control">
                                <option value="1">Portrait</option>
                                <option value="2">Landscape</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3"><label for="PointGroupReportScheduleFitToPage">Fit to Page</label></div>
                        <div class="col-sm-5">

                                <input type="checkbox" id="PointGroupReportScheduleFitToPage" name="PointGroupReportScheduleFitToPage"/>

                        </div>
                    </div>
                </section>
                <section id="noschedule" class="hidden">
                    <div class="row">
                        <div class="col-sm-12 text-center">
                            <label>No schedule has been configured for the current Point Group.</label>
                        </div>
                    </div>
                    <div class="btn-toolbar" style="width:100%;margin-left: 0px;justify-content: center;display: flex;margin-bottom: 10px;" role="group">
                        <button type="button" id="PointGroupReportScheduleAdd" class="btn col-sm-5 active"><u>A</u>dd Schedule</button>
                    </div>
                </section>
            </div>
            <div class="modal-footer">
                <div class="btn-toolbar">
                    <div class="pull-left">
                        <button id="pointGroupReportScheduleDeleteButton" type="button" accesskey="@FMControls.GetAccessKey( deleteButton )" class="btn col-sm-5 pull-left">@Html.Raw(FMControls.FormatButtonText(deleteButton))</button>
                    </div>
                    <div class="pull-right">
                        <button id="pointGroupReportScheduleSaveButton" type="button" accesskey="@FMControls.GetAccessKey( saveButton )" class="btn col-sm-5 pull-left">@Html.Raw(FMControls.FormatButtonText(saveButton))</button>
                        <button id="pointGroupReportScheduleCancelButton" type="button" accesskey="@FMControls.GetAccessKey( cancelButton )" class="btn col-sm-5 pull-right" data-dismiss="modal">@Html.Raw(@FMControls.FormatButtonText(cancelButton))</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    TagEditValueClose = function () {
        $("#confirm-exceed-min-dialog").remove();
        $("#confirm-exceed-max-dialog").remove();
        $('#PointTagEditValueOkButton').unbind('click');
        $('#PointTagEditValueCancelButton').unbind('click');
        $('#PointTagEditValueScreenBody').html('');
    }


    $(document).ready(function () {
        // bds

        var okButton = $('#PointTagSelectOkButton');   //bds
        ampersandIndex = okButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = okButton.text().charAt(ampersandIndex + 1);
            okButton.html(okButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            okButton.attr('accesskey', hotKey);
        }


        var cancelButton = $('#PointTagSelectionCancelButton');   //bds
        ampersandIndex = cancelButton.text().indexOf('&');
        if (ampersandIndex !== -1) {
            var hotKey = cancelButton.text().charAt(ampersandIndex + 1);
            cancelButton.html(cancelButton.text().replace('&' + hotKey, '<span style="text-decoration: underline;">' + hotKey + '</span>'));
            cancelButton.attr('accesskey', hotKey);
        }

    });

    //	$(window).unload(function() {
    //		if(updateTimeId != null){
    //			window.clearTimeout(updateTimeId);
    //		}
    //	});


    $('#PointTagSelectScreen_CloseButton').click(function () {
        $("#PointSelection").html('');
    });

    $("#PointTagSelectOkButton").click(function () {
        TagSelection.PointTagSelectionOkButtonPressAction();
        $('#PointTagSelectScreen').modal('hide');
    });

    // alarm notification events
    $("#alarm-notification-acknowledge-button").click(function () {
        var alarmList = [];
        alarmList.push($("#alarm-notification-body-details").attr("data-alarm-guid"));
        $("#alarm-notification-acknowledge-button").removeClass("disabled").addClass("disabled");
        AlarmSummaryTab.AcknowledgeWorker(alarmList);
    });

    $("#alarm-notification-detail-button").click(function () {
        var pointName = $("#alarm-notification-point").text();
        var pointGuid = $("#alarm-notification-body-details").attr("data-point-guid");
        FMOperateIndex.openPoint(pointName, pointGuid);
    });

    $("#alarm-notification-silence-button").click(function () {
        //$( "#alarm-notification-audio" )[0].pause();
        var alarmList = [];
        alarmList.push($("#alarm-notification-body-details").attr("data-alarm-guid"));
        $("#alarm-notification-silence-button").removeClass("disabled").addClass("disabled");
        AlarmSummaryTab.SilenceWorker(alarmList);
    });

    $("#PointGroupReportScheduleRepeatNever").click(function () {
        $("#PointGroupReportScheduleRepeat button").removeClass('active');
        $("#PointGroupReportScheduleRepeatNever").addClass('active');
        $('#PointGroupReportScheduleSection > section').removeClass('hidden').addClass('hidden');
        $(window).resize(); // force the modal to center
    });

    $("#PointGroupReportScheduleRepeatHourly").click(function () {
        $("#PointGroupReportScheduleRepeat button").removeClass('active');
        $("#PointGroupReportScheduleRepeatHourly").addClass('active');
        $('#PointGroupReportScheduleSection > section').removeClass('hidden').addClass('hidden');
        $('#printscheduleHourly').removeClass('hidden')
        $('#printscheduleend').removeClass('hidden')


        $(window).resize(); // force the modal to center
    });

    $("#PointGroupReportScheduleRepeatDaily").click(function () {
        if ($("#PointGroupReportScheduleRepeatEvery").val() === "") {
            $("#PointGroupReportScheduleRepeatEvery").val("1")
        }
        $("#PointGroupReportScheduleRepeat button").removeClass('active');
        $("#PointGroupReportScheduleRepeatDaily").addClass('active');
        $('#PointGroupReportScheduleSection > section').removeClass('hidden').addClass('hidden');
        $('#printscheduledaily').removeClass('hidden')
        $('#printscheduleend').removeClass('hidden')


        $(window).resize(); // force the modal to center
    });
    $("#PointGroupReportScheduleRepeatWeekly").click(function () {
        $("#PointGroupReportScheduleRepeat button").removeClass('active');
        $("#PointGroupReportScheduleRepeatWeekly").addClass('active');
        $('#PointGroupReportScheduleSection > section').removeClass('hidden').addClass('hidden');
        $('#printscheduleWeekly').removeClass('hidden')
        $('#printscheduleend').removeClass('hidden')
        $(window).resize(); // force the modal to center
    });
    $("#PointGroupReportScheduleRepeatMonthly").click(function () {
        if ($("#PointGroupReportScheduleRepeatEveryMonth").val() === "") {
            $("#PointGroupReportScheduleRepeatEveryMonth").val("1");
            $("#PointGroupReportScheduleMonthlyRepeatDay").val("1");
            $("#printschedulemonthly input[name=reportscheduleMonthly][value='0']").click(); // default option to the first one
        }

        $("#PointGroupReportScheduleRepeat button").removeClass('active');
        $("#PointGroupReportScheduleRepeatMonthly").addClass('active');
        $('#PointGroupReportScheduleSection > section').removeClass('hidden').addClass('hidden');
        $('#printschedulemonthly').removeClass('hidden')
        $('#printscheduleend').removeClass('hidden')
        $(window).resize(); // force the modal to center
    });
    $("#PointGroupReportScheduleRepeatYearly").click(function () {
        if ($("#PointGroupReportScheduleRepeatEveryYear").val() === "") {
            $("#PointGroupReportScheduleRepeatEveryYear").val("1");
        }

        $("#PointGroupReportScheduleRepeat button").removeClass('active');
        $("#PointGroupReportScheduleRepeatYearly").addClass('active');
        $('#PointGroupReportScheduleSection > section').removeClass('hidden').addClass('hidden');
        $('#printscheduleyearly').removeClass('hidden')
        $('#printscheduleend').removeClass('hidden')
        $(window).resize(); // force the modal to center
    });

    $("#PointGroupReportScheduleRepeatWeekly button").click(function () {
        $(this).toggleClass('active');
    });

    $("#PointGroupReportSchedule #pointGroupReportScheduleSaveButton").on('click', function () {
        FMOperateIndex.SavePointGroupSchedule();
    });

    $("#PointGroupReportSchedule #pointGroupReportScheduleDeleteButton").on('click', function () {
        FMOperateIndex.DeletePointGroupSchedule();
    });

    $("#PointGroupReportSchedule #PointGroupReportScheduleAdd").on('click', function () {
        FMOperateIndex.AddPointGroupSchedule();
    });

    // Save the contents of the Module Property Editor modal
    $("#PEMPESavePropertyScreen").on('click', function () {
        FMMovementModuleSettingsEditor.SaveChanges();
    });

    // Save the contents of the Movement User Data Editor modal
    $("#MovementUserDataEditorSavePropertyScreen").on('click', function () {
        FMMovementUserDataEditor.SaveChanges();
    });

    // Save the contents of the Movement Start Data Editor modal
    $("#MovementStartDataEditorSavePropertyScreen").on('click', function () {
        FMMovementStartDataEditor.SaveChanges();
    });

    // Save the contents of the Movement Node Start Data Editor modal
    $("#MovementNodeStartDataEditorSavePropertyScreen").on('click', function () {
        FMMovementNodeStartDataEditor.SaveChanges();
    });

    // Save the contents of the Movement Handgauge Data Editor modal
    $("#MovementHandgaugeEditorSavePropertyScreen").on('click', function () {
        MovementHandgauge.SaveChanges();
    });

    // Save the contents of the Movement node start/closeout Data Editor modal
    $("#MovementHistoryNodeEditorSavePropertyScreen").on('click', function () {
        MovementHistoryNodeEditor.SaveChanges();
    });

    // Save the contents of the Movement Data Editor modal
    $("#MovementHistoryMovementDataEditorSavePropertyScreen").on('click', function () {
        MovementHistoryMovementDataEditor.SaveChanges();
    });

</script>
