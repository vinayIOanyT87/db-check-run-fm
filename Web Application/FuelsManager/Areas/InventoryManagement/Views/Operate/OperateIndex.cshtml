@using System.Globalization
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@using FuelsManager.Areas.InventoryManagement.ViewModels
@model FuelsManager.Areas.InventoryManagement.ViewModels.OperateModel

@{
    ViewBag.Title = "Operate";
    Layout = "~/Areas/Views/Shared/_Layout.cshtml";
}

@section AddToHead{


    @Styles.Render("~/Content/operate")
    @Scripts.Render("~/bundles/core")
    @Scripts.Render("~/bundles/operate")



<style type="text/css">
        /* Hide print-specific content on screen */
        .header-for-print, .footer-for-print {
            display: none;
        }

        .gsfBackground {
            border-color: #99ed69;
            font-size: 15;
            margin-bottom: 17;
        }

        .cuiDiv {
            display: none;
            background: #3B577F;
            font-size: 12px;
            line-height: 28px;
            color: white;
            text-align: center;
            vertical-align: middle;
            height: 28px;
            position: fixed;
            left: 0;
            right: 0;
            width: 100%;
        }

        .fullscreen > .cuiDiv {
            display: block;
        }

        .cuiTopDiv {
            top: 0;
            z-index: -1;
        }

        .cuiBottomDiv {
            bottom: 0;
        }

        .hamburger-menu {
            border: 1px solid #ddd;
        }

        .operate-screen-assignments-dialog {
            padding-top: 8px;
        }

        .operate-screen-assignment-title {
            font-weight: bold;
            margin-bottom: 8px;
        }

        .operate-screen-assignment-option {
            display: block;
            font-weight: normal;
            margin: 6px 0;
        }

        .operate-screen-assignment-option input {
            margin-right: 8px;
        }

        @@media print {
            /* Display the banners */
            .header-for-print, .footer-for-print {
                display: block;
                width: 100%;
                background-color: #f0f0f0;
                padding: 10px;
                text-align: center;
            }
        }
</style>

    <script type="text/javascript">

	var FMOperateIndex = FMOperateIndex || {};

