        var csrfToken = security == null ? "CSRFToken=not_found" : security.CSRFTokenWithParamName;
        var changePasswordPage = @Url.RouteUrl("ChangePasswordForm")+"?FromApplication=false&FromOperate=true&"+csrfToken;//an entry for "ChangePasswordForm" in routes.MapPageRoute in RoutConfig.cs should exist for this to work.  If cookieless session is used, this will automatically embed the session id in uri
        var logoutPage = @Url.RouteUrl("LogoutForm") + "?"+csrfToken;//an entry for "LogoutForm" in routes.MapPageRoute in RoutConfig.cs should exist for this to work. If cookieless session is used, this will automatically embed the session id in uri
        var timezoneOffset = (Model.TimeZoneOffset);

    }
    @if (Session.IsCookieless)
    {
        string urlsessionid = string.Format("{0}/(S({1}))", Request.ApplicationPath, Session.SessionID);
        if (logoutPage.IndexOf(urlsessionid, StringComparison.OrdinalIgnoreCase) < 0)
        {
            logoutPage = logoutPage.Replace(Request.ApplicationPath, urlsessionid);
            changePasswordPage = changePasswordPage.Replace(Request.ApplicationPath, urlsessionid);
        }
    }

