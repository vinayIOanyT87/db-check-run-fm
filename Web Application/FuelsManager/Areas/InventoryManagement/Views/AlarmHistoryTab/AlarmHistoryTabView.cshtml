    @Html.Hidden("AlarmsDictionary", FMBaseController.TranslateText("Alarms"))
    @Html.Hidden("EventsDictionary", FMBaseController.TranslateText("Events"))
    @Html.Hidden("AlarmsEventsDictionary", FMBaseController.TranslateText("Alarms & Events"))

	var timeStamp = FMBaseController.TranslateText("TimeStamp");
	var site = FMBaseController.TranslateText("Site");
	var pointType = FMBaseController.TranslateText("Point Type");
	var point = FMBaseController.TranslateText("Point");
	var pointDescription = FMBaseController.TranslateText("Description");
	var variable = FMBaseController.TranslateText("Variable");
	var value = FMBaseController.TranslateText("Value");
	var units = FMBaseController.TranslateText("Units");
	var alarmState = FMBaseController.TranslateText("Alarm State");
	var priority = FMBaseController.TranslateText("Priority");
	var action = FMBaseController.TranslateText("Action");
	var user = FMBaseController.TranslateText("User");
	var comments = FMBaseController.TranslateText("Comments");
	var commentUserName = FMBaseController.TranslateText("User For Comment");
	var commentDateTime = FMBaseController.TranslateText("Date Of Comment");
	var alarmsDictionary = FMBaseController.TranslateText("Alarms");
	var eventsDictionary = FMBaseController.TranslateText("Events");
	var alarmsEventsDictionary = FMBaseController.TranslateText("Alarms & Events");
	var alarmGuid = "Alarm Guid";
	var alarmAndEventRecordGuid = "Alarm And Event Record Guid";


	var numFormatInfoString = String.Format("{{{0}"
											  + "\"NegativeSign\":\"{1}\",{0}"
											  + "\"NumberDecimalDigits\":{2},{0}"
											  + "\"NumberDecimalSeparator\":\"{3}\",{0}"
											  + "\"NumberGroupSeparator\":\"{4}\",{0}"
											  + "\"NumberGroupSizes\":{5},{0}"
											  + "\"NumberNegativePattern\":{6},{0}"
											  + "\"ShortDatePattern\":\"{7}\",{0}"
											  + "\"TimePattern\":\"{8}\"{0}}}",
											  Environment.NewLine,
											  "-",
											  0,
											  Model.Site.NumberDecimalSeparator,
											  Model.Site.NumberGroupSeparator,
											  Model.Site.GetNumberGroupSizes()[0],
											  1,
											  Model.Site.ShortDatePattern,
											  Model.Site.TimePattern);


    <input id="NumberFormatInfoString" type="hidden" value='@numFormatInfoString' />

    <section id="AlarmHistoryTableSection">
        <div id="alarmHistoryTopDiv" style="padding-top: 5px; padding-bottom: 5px;">
            <div id="alarmHistoryTopCustomTypeControlDiv">
                <table id="alarmHistoryTypeControlTable">
                    <tr>
                        <td style="padding-right: 25px;height: 34px;">
                            <div id="columnsTypeDivOutter">
                                <table>
                                    <tr>
                                        <td>
                                            <label id="columnsTypeLabel"></label>
                                        </td>
                                        <td>
                                            <div id="columnsTypeDiv" class="columnsTypeDivNoBorder">
                                                <div id="columnsTypeInputArea" style="width: 140px;" onclick="AlarmHistoryTab.HandleColumnTypeFilterDropdownExpandCollapse()">
                                                    <label id="showHideColumnsTypeLabel">@FMBaseController.TranslateText("Alarms")</label>
                                                    <span class="dropdownarrowicon glyphicon glyphicon-triangle-bottom pull-right"></span>
                                                </div>
                                            </div>
                                            <div id="ColumnTypeFilterDiv" class="hidden" style="width: 140px">
                                                <ul id="ColumnTypeFilterUl">
                                                    <li id="AlarmLi" class="ColumnTypeFilterLiClass">
                                                        <label>
                                                            <input id="AlarmRadioBtn" type="radio" value="0" onchange='AlarmHistoryTab.HandleColumnTypeFilterRadioChange( "AlarmRadioBtn" );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="AlarmRadioBtn" class="ColumnFilterCheckboxLabelClass">@alarmsDictionary</label>
                                                    </li>
                                                    <li id="EventLi" class="ColumnTypeFilterLiClass">
                                                        <label>
                                                            <input id="EventRadioBtn" type="radio" value="0" onchange='AlarmHistoryTab.HandleColumnTypeFilterRadioChange( "EventRadioBtn" );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="EventRadioBtn" class="ColumnFilterCheckboxLabelClass">@eventsDictionary</label>
                                                    </li>
                                                    <li id="AlarmAndEventLi" class="ColumnTypeFilterLiClass">
                                                        <label>
                                                            <input id="AlarmAndEventRadioBtn" type="radio" value="0" onchange='AlarmHistoryTab.HandleColumnTypeFilterRadioChange( "AlarmAndEventRadioBtn" );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="AlarmAndEventRadioBtn" class="ColumnFilterCheckboxLabelClass">@alarmsEventsDictionary</label>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <div id="alarmHistoryTopCustomButtonDiv">
