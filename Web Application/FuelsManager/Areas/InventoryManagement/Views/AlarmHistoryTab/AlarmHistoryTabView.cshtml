@using System.Web.Mvc.Html
@using FMBusinessObjects.UtilityObjects
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.AlarmHistoryTabModel

<link href="~/Areas/Content/AlarmHistoryTab.css" rel="stylesheet" type="text/css" />

<script>
	$(function ()
	{
		FMLayout.calendarLocation = '@Url.Content("~/DispatchWebApp/images")';
	});
</script>

@using (Html.BeginForm("AlarmHistoryTabView", "AlarmHistoryTab", FormMethod.Get, new
{
