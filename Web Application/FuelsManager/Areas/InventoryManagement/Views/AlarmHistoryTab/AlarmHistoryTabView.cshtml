    @Html.Hidden("AlarmHistoryUpdateCommentUrl", @Url.Action("UpdateComment", "AlarmHistoryTab"))
    @Html.Hidden("AlarmHistorySaveViewStateUrl", @Url.Action("SaveViewState", "AlarmHistoryTab"))
    @Html.Hidden("AlarmHistoryTabModel", AlarmHistoryTabController.SerializeModel(Model))
