                                    </button>
                                    <button id="ColumnDataFilterModalOkBtn" type="button" class="formfieldtitle pushButton" data-dismiss="modal" style="width: 100px;" onclick="javascript: return AlarmHistoryTab.HandleSaveCurrentFilterAndRefresh();">
                                        @FMBaseController.TranslateText("OK")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
