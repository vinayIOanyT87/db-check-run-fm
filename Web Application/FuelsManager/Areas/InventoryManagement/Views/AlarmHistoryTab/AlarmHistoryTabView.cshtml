                                                        </label>
                                                        <label for="PointDescriptionCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Description")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
