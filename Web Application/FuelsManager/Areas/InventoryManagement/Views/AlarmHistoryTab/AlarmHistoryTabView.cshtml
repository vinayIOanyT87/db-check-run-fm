                        </div>
                        <div class="modal-footer">
                            <div class="btn-toolbar">
                                <div class="pull-left">

                                </div>
                                <div class="pull-right">
                                    <button id="ColumnDataFilterModalClearBtn" type="button" class="formfieldtitle pushButton" style="width: 100px;" onclick="javascript: return AlarmHistoryTab.HandleClearAllFiltersBtnEvent();">
