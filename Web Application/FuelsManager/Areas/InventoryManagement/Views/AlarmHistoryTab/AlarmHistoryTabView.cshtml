                                                        </label>
                                                        <label for="DateTimeCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Timestamp")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
