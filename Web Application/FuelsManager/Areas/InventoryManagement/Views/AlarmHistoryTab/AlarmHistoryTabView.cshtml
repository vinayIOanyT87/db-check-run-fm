                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                        <td>
                            <div id="alarmHistoryFindDivOutter" style="position: relative;float: right;">
                                <label id="alarmHistoryFindLabel">@FMBaseController.TranslateText("Find"):</label>
                                <div id="alarmHistoryFindDiv" class="findDivNoBorder">
                                    <div id="alarmHistoryFindInputArea">
                                        <input id="alarmHistoryTabFind" type="text" class="form-control" autocomplete="off" onkeypress="javascript: return AlarmHistoryTab.PreventEnterSubmit();">
                                        <img alt="Find Icon" title="Find" src="~/fmwebapp/images/Search Icon.png">
                                    </div>
                                </div>
                                <div id="alarmHistoryFindResultsRow" class="findResultsRowHidden hidden">
                                    <div id="alarmHistoryFindResultsDiv" class="findResultsDivBorder">
                                        <label id="alarmHistoryFindResultsLabel"><i>@FMBaseController.TranslateText("0 results")</i></label>
                                        <button id="alarmHistoryFindPrevButton" type="button" class="alarmHistoryFindButtonClass" onclick="javascript: return AlarmHistoryTab.FindPrev();">
                                            <span class="glyphicon glyphicon-triangle-left"></span>
                                            @FMBaseController.TranslateText("Prev.")
                                        </button>
                                        <button id="alarmHistoryFindNexButton" type="button" class="alarmHistoryFindButtonClass" onclick="javascript: return AlarmHistoryTab.FindNext();">
                                            @FMBaseController.TranslateText("Next")
                                            <span class="glyphicon glyphicon-triangle-right"></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <div id="AlarmHistoryTableContainer" class="col-xs-12">
                <table id="AlarmHistoryTable" class="table table-striped hover alarmHistoryTableClass">
                    <thead style="border: none;">
							  <tr style="border: none;">
							  	<th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.dateTimeColumnIndex); return false;">@timeStamp</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.siteColumnIndex); return false;">@site</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.pointTypeColumnIndex); return false;">@pointType</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.pointColumnIndex); return false;">@point</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.pointDescriptionColumnIndex); return false;">@pointDescription</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.variableColumnIndex); return false;">@variable</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.valueColumnIndex); return false;">@value</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.unitsColumnIndex); return false;">@units</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.alarmStateColumnIndex); return false;">@alarmState</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.priorityColumnIndex); return false;">@priority</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.actionColumnIndex); return false;">@action</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.userColumnIndex); return false;">@user</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.commentsColumnIndex); return false;">@comments<span class="glyphicon glyphicon-pencil" style="margin-left: 5px;"></span></th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.commentUserNameColumnIndex); return false;">@commentUserName</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.commentDateTimeColumnIndex); return false;">@commentDateTime</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.alarmGuidColumnIndex); return false;">@alarmGuid</th>
							  <th class="col-sm-2 col-md-2 text-center alarmHistoryTableCellEx" oncontextmenu="AlarmHistoryTab.HandleTableHeaderOnContextMenuEvent(AlarmHistoryTab.alarmAndEventRecordGuidColumnIndex); return false;">@alarmAndEventRecordGuid</th>
							  </tr>
                    </thead>
                </table>
            </div>
            <!-- Modal -->
            <div class="row">
                <div id="ColumnDataFilterModalDiv" class="modal fade" data-width="500" data-backdrop="static" data-focus-on="input:first" role="dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button id="columnFilterCancelIconId" type="button" class="close" data-dismiss="modal" onclick="AlarmHistoryTab.HandleCancelFiltering();">&times;</button>
                        </div>
                        <div class="modal-body">
                            <section id="ColumnDataFilterSection" class="row">
                                <div class="col-xs-12">
                                    <label class="modalDropdownLabel">@FMBaseController.TranslateText("Choose Columns:")</label>
                                </div>
                                <div class="col-xs-12">
                                    <select id="ChooseColumnDropdownId" class="form-control" onchange="AlarmHistoryTab.HandleChooseColumnDropdownEvent()">
                                        <option selected="selected" value="-99">None</option>
                                    </select>
                                </div>
                                <div class="col-xs-12">
                                    <label> </label>
                                </div>
                                <div id="ColumnFilterDateRowDiv" class="col-xs-12 hidden">
                                    <table style="width: 100%">
                                        <tr>
                                            <td>
                                                <label class="modalDropdownLabel">@FMBaseController.TranslateText("From:")</label>
                                            </td>
                                            <td style="width: 5%"></td>
                                            <td>
                                                <label class="modalDropdownLabel">@FMBaseController.TranslateText("To:")</label>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <input type='text' class="alarmHistory-form-control text-center" id="ColumnFilterFromDateInput" name="AlarmHistory.ColumnFilterFromDate" value="" onblur="AlarmHistoryTab.HandleAvailableFilterDateChangeEvent('FROM')" />
                                            </td>
                                            <td style="width: 5%"></td>
                                            <td>
                                                <input type='text' class="alarmHistory-form-control text-center" id="ColumnFilterToDateInput" name="AlarmHistory.ColumnFilterToDate" value="" onblur="AlarmHistoryTab.HandleAvailableFilterDateChangeEvent('TO')" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div id="ColumnFilterCommentDateRowDiv" class="col-xs-12 hidden">
                                    <table style="width: 100%">
                                        <tr>
                                            <td>
                                                <label class="modalDropdownLabel">@FMBaseController.TranslateText("From:")</label>
                                            </td>
                                            <td style="width: 5%"></td>
                                            <td>
                                                <label class="modalDropdownLabel">@FMBaseController.TranslateText("To:")</label>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <input type='text' class="alarmHistory-form-control text-center" id="ColumnFilterCommentFromDateInput" name="AlarmHistory.ColumnFilterCommentFromDate" value="" onblur="AlarmHistoryTab.HandleAvailableFilterCommentDateChangeEvent('FROM')" />
                                            </td>
                                            <td style="width: 5%"></td>
                                            <td>
                                                <input type='text' class="alarmHistory-form-control text-center" id="ColumnFilterCommentToDateInput" name="AlarmHistory.ColumnFilterCommentToDate" value="" onblur="AlarmHistoryTab.HandleAvailableFilterCommentDateChangeEvent('TO')" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div id="AvailableFilterDropdownLabelDivId" class="col-xs-12">
                                    <label class="modalDropdownLabel">@FMBaseController.TranslateText("Available Filters:")</label>
                                </div>
                                <div id="AvailableFilterDropdownDivId" class="col-xs-12">
                                    <select class="form-control" id="AvailableFilterDropdownId" multiple="multiple" value="Undefined"></select>
                                </div>
