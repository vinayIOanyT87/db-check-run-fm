                    <Span>
                        <img src="~/fmwebapp/images/RefreshMini.png" alt=@FMBaseController.TranslateText("Refresh") />
                    </Span>
                    @FMBaseController.TranslateText("Refresh")
                </button>
                <button id="alarmHistoryCSVButton" type="button" class="alarmHistoryHeaderButtonClass" onclick="javascript: AlarmHistoryTab.ExportCSV();">
                    @FMBaseController.TranslateText("Export CSV")
