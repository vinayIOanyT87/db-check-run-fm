                                                            <input id="ValueCheckbox" type="checkbox" value="6" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="ValueCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Value")</label>
