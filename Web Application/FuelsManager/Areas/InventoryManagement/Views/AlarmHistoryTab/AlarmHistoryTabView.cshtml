                                                        </label>
                                                        <label for="SiteCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Site")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="PointTypeCheckbox" type="checkbox" value="2" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="PointTypeCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Point Type")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="PointCheckbox" type="checkbox" value="3" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="PointCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Point")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
