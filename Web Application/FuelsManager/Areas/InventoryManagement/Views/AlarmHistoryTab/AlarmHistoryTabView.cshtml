<script type="text/javascript">
    //# sourceURL=_AlarmHistoryTabView.cshtml
    $(document).ready(function () {
        $("#AlarmHistoryTable").removeClass("hidden").addClass("hidden");
        AlarmHistoryTab.HistoryInitialized = false;

        AlarmHistoryTab.Init();
    });

    $(window).resize(function () { AlarmHistoryTab.HandleWindowResize(); });

    $(document).mouseup(function (e) {
        // handler to make the options and columns dropdowns close back up on
        var dropdownsToCloseOnOutsideClick = new Array();

        // Only check the divs if they currently are visible
        if ($("#ColumnFilterDiv").length > 0 && !$("#ColumnFilterDiv").attr('class').includes("hidden")) {
            dropdownsToCloseOnOutsideClick.push($('#ColumnFilterDiv'));
        }

        $.each(dropdownsToCloseOnOutsideClick, function (key, value) {
            if (!$(value).is(e.target) // if the target of the click isn't the container...
                && $(value).has(e.target).length === 0) // ... nor a descendant of the container
            {
                if ($(value).selector == '#ColumnFilterDiv') {
                    if ($(e.target).attr('id') != 'ColumnFilterDropDownArrow') {
                        AlarmHistoryTab.HandleColumnFilterDropdownExpandCollapse();
                    }
                }
            }
        })

        return true;
    })
</script>
