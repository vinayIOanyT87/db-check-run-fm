                                                            <span></span>
                                                        </label>
                                                        <label for="UnitsCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Units")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="AlarmStateCheckbox" type="checkbox" value="8" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="AlarmStateCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Alarm State")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="PriorityCheckbox" type="checkbox" value="9" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="PriorityCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Priority")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="ActionCheckbox" type="checkbox" value="10" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="ActionCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Action")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="UserCheckbox" type="checkbox" value="11" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="UserCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("User")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="CommentsCheckbox" type="checkbox" value="12" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="CommentsCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Comments")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="CommentUserNameCheckbox" type="checkbox" value="13" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="CommentUserNameCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("User For Comment")</label>
                                                    </li>
                                                    <li class="ColumnFilterLiClass">
                                                        <label class="customCheckbox">
                                                            <input id="CommentDateTimeCheckbox" type="checkbox" value="14" onchange='AlarmHistoryTab.HandleColumnFilterCheckboxChange( this );' />
                                                            <span></span>
                                                        </label>
                                                        <label for="CommentDateTimeCheckbox" class="ColumnFilterCheckboxLabelClass">@FMBaseController.TranslateText("Date Of Comment")</label>
                                                    </li>
