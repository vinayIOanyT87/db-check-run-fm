
@using System.Web.Mvc.Html
@using System.Globalization
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@using FuelsManager.Areas.InventoryManagement.ViewModels
@using Microsoft.Ajax.Utilities
@using FMBusinessObjects.DataObjects
@using FMBusinessObjects.DataObjects.CodedVariables
@model FuelsManager.Areas.InventoryManagement.ViewModels.MovementModuleSettingsEditorModel

<link href="~/Areas/Content/MovementModuleSettingsEditor.css" rel="stylesheet" type="text/css" />
<script src="~/Areas/Scripts/MovementModuleSettingsEditor.js"></script>

@using (Html.BeginForm("MovementModuleSettingsEditor", "MovementModuleSettingsEditor", FormMethod.Post, new { id = "MovementModuleSettingsEditorForm" }))
{
	@Html.AntiForgeryToken()

	@Html.Hidden("urlSaveMovementModuleSettings", @Url.Action("SaveMovementModuleSettings", "MovementModuleSettingsEditor"));
	@Html.Hidden("urlGetMovementNodes", @Url.Action("GetMovementNodes", "MovementModuleSettingsEditor"));
	@Html.Hidden("urlGetMovementControlPoints", @Url.Action("GetMovementControlPoints", "MovementModuleSettingsEditor"));
	@Html.Hidden("urlCreateNewMovement", @Url.Action("CreateNewMovement", "MovementModuleSettingsEditor"));
	@Html.Hidden("urlGetMovementNodeTransferTagUnit", @Url.Action("GetMovementNodeTransferTagUnit", "MovementModuleSettingsEditor"));
	@Html.Hidden("urlMovementSettingsEditorPointCalculator", @Url.Action("RunCalculator", "MovementModuleSettingsEditor"));
	@Html.Hidden("urlEditMovementPointTagValue", @Url.Action("EditValueForMovement", "EditValue"))
	@Html.Hidden("urlMovementSettingsEditorPointCalculatorForInterlockedNodes", @Url.Action("RunCalculatorForInterlockedNodes", "MovementModuleSettingsEditor"));


	@Html.HiddenFor(m => m.NewId);
	@Html.HiddenFor(m => m.PointGuid);
	@Html.HiddenFor(m => m.PointPropertyGuid);
	@Html.HiddenFor(m => m.Readonly);
	@Html.Hidden("MovementModuleSettingsEditorModelStr", MovementModuleSettingsEditorController.SerializeModel(Model))
	@Html.Hidden("MEDeleteConfirmation", FMBaseController.TranslateText("Are you sure you wish to delete selected item(s)?"));

	// Data Dictionary items
	var movementNodeHeaderText = FMBaseController.TranslateText("Movement|Movement Node");
	var directionHeaderText = FMBaseController.TranslateText("Movement|Direction");
	var targetHeaderText = FMBaseController.TranslateText("Movement|Target");
	var transferModeHeaderText = FMBaseController.TranslateText("Transfer Mode");
	var individualNodeControlHeaderText = FMBaseController.TranslateText("Movement|Individual Node Control");
	var unitsHeaderText = FMBaseController.TranslateText("Movement|Units");
	var movementNodeGuidHeaderText = FMBaseController.TranslateText("Movement Node Guid");

	var orderLbl = FMBaseController.TranslateText("Movement|Order #");
	var controlPointLbl = FMBaseController.TranslateText("Movement|Control Point");
	var commentLbl = FMBaseController.TranslateText("Movement|Comment");
	var stopHaltLbl = FMBaseController.TranslateText("Movement|Stop/Halt based on Zero Flow");
	var deleteAfterCompletionLbl = FMBaseController.TranslateText("Movement|Delete After Completion");
	var deleteAfterStopLbl = FMBaseController.TranslateText("Movement|Delete After Stop");
	var startTimeBasedLbl = FMBaseController.TranslateText("Movement|Start Time based on Non Zero Flow");
	var setPendingStatusLbl = FMBaseController.TranslateText("Movement|Set Pending Status");
	var useControlPointLbl = FMBaseController.TranslateText("Movement|Use Control Point Start/Stop");
	var sendToAccountingLbl = FMBaseController.TranslateText("Movement|Send To Accounting");
	var zeroHoldOffLbl = FMBaseController.TranslateText("Movement|Zero Flow Hold Off Time (min.)");
	var sourceSetpointsLbl = FMBaseController.TranslateText("Movement|Source Setpoints Specified in Percent");
	var interlockSetpointsLbl = FMBaseController.TranslateText("Movement|Interlock Source & Destination Setpoints");
	var includeHandgaugeLbl = FMBaseController.TranslateText("Movement|Include Handgauge Values");
	var typeLbl = FMBaseController.TranslateText("Movement|Type");
	var ticketNameLbl = FMBaseController.TranslateText("Movement|Ticket Name");
	var printerNameLbl = FMBaseController.TranslateText("Movement|Printer");
	var movementSetupLbl = FMBaseController.TranslateText("Movement|Setup");
	var movementRecordingLbl = FMBaseController.TranslateText("Movement|Recording");
	var movementCreateNewMovementLbl = FMBaseController.TranslateText("Movement|Create New Movement");
	var movementStartTimesLbl = FMBaseController.TranslateText("Movement|Start Times");
	var plannedStartTimesLbl = FMBaseController.TranslateText("Movement|Planned Start Time");
	var dateTimePlaceHolderLbl = FMBaseController.TranslateText("Movement|date time");
	var movementNameLbl = FMBaseController.TranslateText("Movement|Movement Name");
	var createNewMovementBtnLbl = FMBaseController.TranslateText("Movement|Create New Movement");

	var numberFormatInfoString = String.Format("{{{0}"
		  + "\"NegativeSign\":\"{1}\",{0}"
		  + "\"NumberDecimalDigits\":{2},{0}"
		  + "\"NumberDecimalSeparator\":\"{3}\",{0}"
		  + "\"NumberGroupSeparator\":\"{4}\",{0}"
		  + "\"NumberGroupSizes\":{5},{0}"
		  + "\"NumberNegativePattern\":{6},{0}"
		  + "\"ShortDatePattern\":\"{7}\",{0}"
		  + "\"TimePattern\":\"{8}\"{0}}}"
		  , Environment.NewLine
		  , "-"
		  , 0
		  , Model.NumberDecimalSeparator
		  , Model.NumberGroupSeparator
		  , Model.NumberGroupSizes[0]
		  , 1
		  , Model.ShortDatePattern
		  , Model.TimePattern);

	<input id="CalendarLocationUrl" type="hidden" value='@Url.Content("~/DispatchWebApp/images")' />
	<input id="NumberFormatInfoString" type="hidden" value='@numberFormatInfoString' />

	<style>
		.header-whitespace {
			height: 4px;
		}

		.recording-whitespace {
			height: 7px;
		}

		.setup-whitespace {
			height: 4px;
		}
	</style>

	var title = Model.PointId + " - " + Model.PointPropertyId;

	<section id="movementSettingsEditorPartial" class="">
		<div class="MovementSettingsEditorHeader row">
			<button type="button" class="close" data-dismiss="modal" onclick="$('#PEMPEClosePropertyScreen').click();">&times;</button>
		</div>
		<div class="row">
			<div class="col-xs-6 col-sm-6 col-md-6 col-lg-6">
				<h4 id="MovementModuleSettingEditorTitle">@title</h4>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
				<h5>@FMBaseController.TranslateText("Movement|Movement Module Editor")</h5>
			</div>
		</div>
		<div class="recording-whitespace"></div>

		<table id="FormatTable" style="width: 100%;">
			<tr>
				<td>
					<div id="MovementModuleSetupDetailMenu" class="MovementModuleSetupDetailMenuDiv">
						<ul id="MovementModuleSetupMenuItems" class="list-inline col-lg-6 col-md-6">
							<li class="MovementModuleSetupDetailMenuItem selected" id="MovementSetupItem" onclick="FMMovementModuleSettingsEditor.ShowUserMovementSetupSection(); return false;">
								<b id="MovementSetupItemBtag">@movementSetupLbl</b>
							</li>
							<li class="MovementModuleSetupDetailMenuItem" id="MovementRecordingItem" onclick="FMMovementModuleSettingsEditor.ShowMovementRecordingSection(); return false;">
								<b id="MovementRecordingItemBtag">@movementRecordingLbl</b>
							</li>
							<li class="MovementModuleSetupDetailMenuItem" id="MovementCreateNewMovementItem" onclick="FMMovementModuleSettingsEditor.ShowMovementCreateNewMovementSection(); return false;">
								<b id="MovementCreateNewMovementItemBtag">@movementCreateNewMovementLbl</b>
							</li>
						</ul>
					</div>
				</td>
			</tr>
			<tr><td><div class="header-whitespace"></div></td></tr>
			<tr>
				<td class="MovementModuleSetupSectionsTd">
					<div id="SectionsDiv" style="margin-left: 12px; height: 390px">
						<!-- This is the Movement Setup section of the page. -->
            <section id="MovementSetupSection">
              <div class="panel-body" style="border: 1px solid gray; background: white; overflow-y: auto; max-height: 350px">
                <table style="width: 800px">
                  <tr>
                    <td>
                      <input type="checkbox" id="InterlockCB" name="InterlockCB" onchange="FMMovementModuleSettingsEditor.InterLockCbOnChange();" />
                      <label for="InterlockCB">@interlockSetpointsLbl</label>
                    </td>
                    <td>
                      <input type="checkbox" id="IncludeHandgaugeCB" name="IncludeHandgaugeCB" onchange="FMMovementModuleSettingsEditor.IncludeHandgaugeCbOnChange();" />
                      <label for="IncludeHandgaugeCB">@includeHandgaugeLbl</label>
                    </td>
                    <td>
                      <label for="MovementTypeDD">@typeLbl</label>
                      <select id="MovementTypeDD" name="MovementTypeDD" onchange="FMMovementModuleSettingsEditor.TypeDdOnChange();">
                        @foreach (var enumVal in PointsController.GetEnumSelectListRaw<MovementType>())
                        {
                          <option value=@enumVal.Value @{if (Convert.ToInt32(@Model.Type).ToString() == @enumVal.Value) { <text> selected</text> } }>@enumVal.Text</option>
                        }
                      </select>
                    </td>
                  </tr>
                </table>
              </div>
              <div class="setup-whitespace"></div>
              <table id="MovementModuleSettingsNodeTable" class="table table-striped table-bordered hover" style="width:100% !important">
                <thead class="">
                  <tr>
                    <th class="col-sm-3 col-md-3 text-center">
                      @movementNodeHeaderText
                    </th>
                    <th class="text-center">
                      @directionHeaderText
                    </th>
                    <th class="text-center">
                      @transferModeHeaderText
                    </th>
                    <th class="col-sm-2 col-md-2 text-center">
                      @targetHeaderText
                    </th>
                    <th class="text-center">
                      @individualNodeControlHeaderText
                    </th>
                    <th class="text-center">
                      @movementNodeGuidHeaderText
                    </th>
                    <th class="text-center">
                      @unitsHeaderText
                    </th>
                  </tr>
                </thead>
                <tbody id="MovementNodeTableEditorTableBody">
                  @for (var index = 0; index < Model.MovementNodeModelList.Count; ++index)
                  {
                    var nodeModel = Model.MovementNodeModelList[index];
                    var editRowId = "editRow_" + nodeModel.MovementNodeGuid;
                    var editTargetSPCellId = "editTargetSPCellId_" + nodeModel.MovementNodeGuid;

                    <tr>
                      <td class="col-sm-3 col-md-3">@nodeModel.MovementNodeId</td>
                      <td>@nodeModel.TransferDirection</td>
                      <td>@nodeModel.TransferMode</td>
                      <td id="@editTargetSPCellId" class="col-sm-2 col-md-2 text-center">
                        @nodeModel.TransferTarget
                      </td>
                      <td>@nodeModel.IndividualNodeControl</td>
                      <td>@nodeModel.MovementNodeGuid</td>
                      <td>@nodeModel.Units</td>
                    </tr>
                  }
                </tbody>
              </table>
              <div class="setup-whitespace"></div>
              <div class="row" role="group">
                <button id="addMovementNodeEntryButton" name="addMovementNodeEntryButton" type="button" value="addMovementNodeEntryButton"
                        accesskey="A" class="addMovementNodeEntryButton formfieldtitle tabPushButton" title="Add New Movement Node Entry"
                        style="width: 100px;">
                  @Html.Raw(FMControls.FormatButtonText(@FMBaseController.TranslateText("&Add")))
                </button>
                <button id="deleteMovementNodeEntriesButton" name="deleteMovementNodeEntriesButton" type="button" value="deleteMovementNodeEntriesButton"
                        accesskey="L" class="deleteMovementNodeButton formfieldtitle MovementSettingsEditorDeleteButtonDisabled tabPushButton" title="Delete Movement Node Entries"
                        disabled style="width: 100px;">
                  @Html.Raw(FMControls.FormatButtonText(FMBaseController.TranslateText("&Delete")))
                </button>
              </div>
            </section>

						<!-- This is the Movement Recording section of the page. -->
						<section id="MovementRecordingSection" class="hidden">
							<table>
								<tr>
									<td>
										<div class="panel-body" style="border: 1px solid gray; background: white; overflow-y: auto; height: 130px">
											<table>
												<tr>
													<td style="padding-left: 10px">
														<label>@orderLbl</label>
													</td>
												</tr>
												<tr>
													<td style="padding-left: 10px">
														<input id="OrderNumber" class="MovementSetupInputField" />
													</td>
												</tr>
												<tr><td>&nbsp;</td></tr>
												<tr>
													<td style="padding-left: 10px">
														<input type="checkbox" id="SendToAccountingCB" name="SendToAccountingCB" onchange="FMMovementModuleSettingsEditor.SendToAccountingCbOnChange();" />
														<label for="SendToAccountingCB">@sendToAccountingLbl</label>
													</td>
												</tr>
											</table>
										</div>
									</td>
									<td>&nbsp;</td>
									<td>&nbsp;</td>
									<td>
										<div class="panel-body" style="border: 1px solid gray; background: white; overflow-y: auto; height: 130px; ">
											<table style="width: 600px">
												<tr>
													<td>
														<label>@commentLbl</label>
													</td>
												</tr>
												<tr>
													<td>
														<textarea id="Comment" rows="3" cols="80" maxlength="1000" style="resize: none"></textarea>
													</td>
												</tr>
											</table>
										</div>
									</td>
								</tr>
							</table>

							<div class="recording-whitespace"></div>
							<div class="panel-body" style="border: 1px solid gray; background: white; overflow-y: auto; max-height: 350px">
								<table class="MovementModuleSetupGroupCbTable">
									<tr>
										<td>
											<input type="checkbox" id="SetPendingCB" name="SetPendingCB" onchange="FMMovementModuleSettingsEditor.SetPendingStatusCbOnChange();" />
											<label for="SetPendingCB" style="width: 130px">@setPendingStatusLbl</label>
										</td>
										<td>
											<label for="PlannedStartTimePicker">@plannedStartTimesLbl</label>
										</td>
										<td>
											<input id="PlannedStartTimePicker" type="text" class="form-control text-center datepicker .MovementModuleSetupInputHeight" style="width: 180px" />
										</td>
										<td style="padding-left: 50px">
											<input type="checkbox" id="DeleteCompCB" name="DeleteCompCB" onchange="FMMovementModuleSettingsEditor.DeleteCompletionCbOnChange();" />
											<label for="DeleteCompCB">@deleteAfterCompletionLbl</label>
										</td>
									</tr>
									<tr>
										<td></td>
										<td></td>
										<td></td>
										<td style="padding-left: 50px">
											<input type="checkbox" id="DeleteStopCB" name="DeleteStopCB" onchange="FMMovementModuleSettingsEditor.DeleteStopCbOnChange();" />
											<label for="DeleteCompCB">@deleteAfterStopLbl</label>
										</td>
									</tr>
								</table>
							</div>
							<div class="recording-whitespace"></div>
							<div class="panel-body" style="border: 1px solid gray; width: 855px; background: white; overflow-y: auto; max-height: 350px">
								<table id="ZeroFlowTbl" class="MovementModuleSetupTimesCbTable" style="width: 100%">
									<tr>
										<td>
											<input type="checkbox" id="StopHaltCB" name="StopHaltCB" onchange="FMMovementModuleSettingsEditor.StopHaltBasedCbOnChange();" />
											<label for="StopHaltCB" style="width: 230px">@stopHaltLbl</label>
										</td>
										<td>
											<input type="text" id="ZeroFlowHoldTB" name="ZeroFlowHoldTB" class="MovementTrackingSetupInputHeight"
													 style="width: 50px" maxlength="5" onblur="FMMovementModuleSettingsEditor.ZeroFlowTbOnblur();" />
											<label for="ZeroFlowHoldTB" style="width: 230px">@zeroHoldOffLbl</label>
										</td>
									</tr>
									<tr>
										<td colspan="2">
											<input type="checkbox" id="StartTimeCB" name="StartTimeCB" onchange="FMMovementModuleSettingsEditor.StartTimeBasedCbOnChange();" />
											<label for="StartTimeCB" style="width: 230px">@startTimeBasedLbl</label>
										</td>
									</tr>
									<tr>
										<td colspan="2">
											<input type="checkbox" id="UseControlTagCB" name="UseControlTagCB" onchange="FMMovementModuleSettingsEditor.UseControlTagCbOnChange();" />
											<label for="UseControlTagCB" style="width: 230px">@useControlPointLbl</label>
										</td>
									</tr>
									<tr>
										<td colspan="2">
											<label>@controlPointLbl</label>
										</td>
									</tr>
									<tr>
										<td colspan="2">
											<select id="ControlTagDD" name="ControlTagDD" style="width: 600px;">
												<option value="0">None</option>
											</select>
										</td>
									</tr>
								</table>
							</div>
						</section>

						<!-- This is the Movement create new movement section of the page. -->
						<section id="MovementCreateNewMovementSection" class="hidden">
							<table style="width: 840px;">
								<tr>
									<td>
										<div class="panel-body" style="border: 1px solid gray; background: white; overflow-y: auto; height: 130px">
											<table>
												<tr>
													<td style="padding-left: 10px" colspan="2">
														<label>@movementNameLbl</label>
													</td>
												</tr>
												<tr>
													<td style="padding-left: 10px">
														<input id="MovementNameTb" class="MovementSetupInputField" style="width: 400px;" maxLength="30" value="@Model.NewId" spellcheck="false" />
													</td>
													<td style="padding-left: 40px">
														<button id="CreateNewMovementBtn" type="button" class="formfieldtitle pushButton" style="width: 160px;" onclick="javascript: FMMovementModuleSettingsEditor.CreateNewMovementOnClick();">
															@createNewMovementBtnLbl
														</button>
													</td>
												</tr>
											</table>
										</div>
									</td>
								</tr>
							</table>
						</section>
					</div>
				</td>
			</tr>
		</table>

		<div class="row">
			<input id="PointTagNewValueInputId" type="hidden" value="" />
			<input id="PointTagNewRawValueInputId" type="hidden" value="" />
			<div id="MovementPointTagEditValueScreen" class="fade modal-md modal" data-backdrop="static" data-focus-on="input:first" role="dialog">
				<div class="modal-content">
					<div class="modal-header">
						<button id="MovementPointTagEditValueCloseButton" type="button" class="close" onclick="FMMovementModuleSettingsEditor.CloseEditTagValueModal();" data-dismiss="modal">&times;</button>
						<h4 id="PointTagEditValueScreenTitle" class="modal-title" style="text-align: center; color: rgb(194, 194, 194);">@FMBaseController.TranslateText("SET VALUE")</h4>
					</div>
					<div class="modal-body">
						<section id="MovementPointTagEditValueScreenBody" class=""></section>
					</div>
					<div class="modal-footer">
						<div class="btn-toolbar">
							<div class="pull-right">
								<button id="MovementPointTagEditValueOkButton" type="button" accesskey="O" class="btn btn-default">@FMBaseController.TranslateText("PointTagEditor|&Ok")</button>
								<button id="MovementPointTagEditValueCancelButton" type="button" accesskey="C" class="btn">@FMBaseController.TranslateText("PointTagEditor|&Cancel")</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

<script type="text/javascript">
	// This function is called by the EditValue partial page.
	function HandlePointTagEditorNewValueUpdate() {
		FMMovementModuleSettingsEditor.HandleUpdatingEditLimitTagValue();
	}
</script>



