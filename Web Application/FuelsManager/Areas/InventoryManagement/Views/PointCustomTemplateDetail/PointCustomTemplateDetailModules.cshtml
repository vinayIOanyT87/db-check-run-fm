		$('#AddModuleSelectButton').on('click', function ()
		{

			// If the user has selected a module open the module screen
			if ( $( '#AddModule' ).DataTable().rows( { selected: true } )[0].length > 0 )
			{
				var selectedModule = $('#AddModule').DataTable().rows({ selected: true }).data();
				var selectedModuleName = selectedModule[0][0];
				var selectedModuleGuid = selectedModule[0][1];

				$('#AddModuleModal').modal('hide');

				// create the backdrop and wait for next modal to be triggered
				var modalManager = $('body').modalmanager('loading');

				var token = $('input[name=__RequestVerificationToken]').val();
				var headers = {};
				headers['__RequestVerificationToken'] = token;

				$.ajax({
					url: '@Url.Action("GetModulesDetails", "PointCustomTemplateDetail")',
					cache: false,
					type: 'Get',
					headers: headers,
					data: { moduleGuid: selectedModuleGuid },
					success: function (response) {
						FMErrorAndExceptionHandling.HandleMessages(response, function (data, inError) {

							if (!inError)
							{
								$("#PTEModuleResolveInstanceName").val( data.ID );
								$("#PTEModuleResolveName").val(data.ID);
								$("#PTEModuleResolveName").data('guid', data.ModuleGuid);
								$("#ModuleResolveParameters tbody").empty();

								data.ModuleData.ModuleTags.forEach(function (tag) {
									// copy an empty row when adding a parameter
									var newRow = $("#empty_resolveparameterrow tbody").children().clone();
									// set the defaults
									newRow.find('[name=ResolveModuleTagNameInput]').val(tag.TagID);
									var tagList = "";
									var tagExists = false;
									FMPointEditor.tagList.forEach(function (existingTag)
									{
										if (existingTag.DataType === tag.DataType
										&& existingTag.EngineeringUnitsType === FMConvertEngUnits.unitsTypeArray[tag.UnitType]) {
											var selected = ((existingTag.Name === tag.TagID) ? 'selected' : '');
											if(selected === 'selected'){
												tagExists = true;
											}
											tagList += "<option value='" + existingTag.PointTagGuid + "' " + selected + ">" + existingTag.Name + "</option>";
										}
									});
									newRow.find('[name=ResolveModuleTagGuidSelect]').html(tagList);
									newRow.find('[name=ResolveModuleEngineeringUnitsType]').val(FMConvertEngUnits.unitsTypeArray[tag.UnitType]);
                            if (tag.DataType !== "System.Double"
                                && tag.DataType !== "System.Single")
									{
										newRow.find( '[name=ResolveModuleEngineeringUnitsType]' ).attr( "disabled", true ).addClass("hidden");
									}
									newRow.find('[name=ResolveModuleParameterName]').val(tag.ParameterName);

									newRow.appendTo("#ModuleResolveParameters tbody").find('[name=EditModuleParameterName]').focus();

									if (tagExists) {
										newRow.find('[name=resolveModuleModuleReuseTagSwitch] .radioBtn a')[0].click();
									}
								});

								$("#ModuleResolveSettings tbody").empty();
								data.ModuleData.ModuleSettings.forEach(function (module) {
									// copy an empty row when adding a setting
									var newRow = $("#empty_resolvesettingrow tbody").children().clone();
									// set the defaults
									newRow.find('[name=ResolveModuleSettingsInstanceName]').val(module.SettingName);

									newRow.find('[name=ResolveModuleSettingType]').val(module.DataType);
									newRow.find( '[name=ResolveModuleSettingType]' ).data( 'value', module.DataType );

									newRow.appendTo("#ModuleResolveSettings tbody").find('[name=ResolveModuleSettingsInstanceName]').focus();
								});

								$('#ResolveModuleModal').modal('show');
							}
							else {
								$('body').modalmanager('loading'); // remove the loading background
							}

						});
					},
					error: function (xhr, textStatus, error) {
						FMErrorAndExceptionHandling.ShowException(xhr, textStatus, error, function () { });
						$('body').modalmanager('loading'); // remove the loading background
					}

				});
			}

		});

		/* RESOLVE MODULE EVENTS */
		$('#ResolveModuleSaveButton').on('click', function ()
		{
			FMErrorAndExceptionHandling.CloseNotifications();

			var inError = false;
			var moduleName = $("#PTEModuleResolveName").val();
			var moduleGuid = $("#PTEModuleResolveName").data('guid');

			var instanceName = $("#PTEModuleResolveInstanceName").val();
			if (instanceName === "") {
				inError = true;
				$("#PTEModuleResolveInstanceName").parent().removeClass("has-error").addClass("has-error");
			}

			// get the tags
			$("#ModuleResolveParameters tbody tr").each(function (index)
			{
				var resolveSelectTag = $( this ).find( "[name=resolveModuleReuseTag]" ).val();
				var resolveModuleTagName = "";
				var resolveModuleTagGuid = null;
				if (resolveSelectTag === "true") {
					resolveModuleTagGuid = $(this).find("[name=ResolveModuleTagGuidSelect]").val();
					if (resolveModuleTagGuid == null) {
						inError = true;
						$(this).find("[name=ResolveModuleTagGuidSelect]").parent().removeClass("has-error").addClass("has-error");
					}
				}
				else {
					resolveModuleTagName = $(this).find("[name=ResolveModuleTagNameInput]").val();
					if (resolveModuleTagName === "")	{
						inError = true;
						$(this).find("[name=ResolveModuleTagNameInput]").parent().removeClass("has-error").addClass("has-error");
					}

				}
			});

			// get the Settings
			$("#ModuleResolveSettings tbody tr").each(function (index) {
				var resolveModuleSettingName = $(this).find("[name=ResolveModuleSettingsInstanceName]").val();
				if (resolveModuleSettingName === "") {
					inError = true;
					$(this).find("[name=ResolveModuleSettingsInstanceName]").parent().removeClass("has-error").addClass("has-error");
				}
			});

			if (!inError)
			{
				// display animation
				$('<div class=loadingDiv><img src="@(Url.Content("~/fmwebapp/images/loader_squares_120.gif"))" /></img></div>').prependTo(document.body);

				var tagTable = [];
				var settingsTable = [];

				$('#ModuleResolveParameters tbody tr').each(function () {
					if ($(this).find('td [name=ResolveModuleParameterName]').length > 0) {
						tagTable.push({
							ParameterName: $(this).find('td [name=ResolveModuleParameterName]').val(),
							TagName: ($(this).find('td [name=resolveModuleReuseTag]').val() == 'true' ? "" : $(this).find('td [name=ResolveModuleTagNameInput]').val()),
							TagGuid: ($(this).find('td [name=resolveModuleReuseTag]').val() == 'true' ? $(this).find('td [name=ResolveModuleTagGuidSelect]').val() : null),
							EngineeringUnitsType: $(this).find('td [name=ResolveModuleEngineeringUnitsType]').val() == "" ? "FMU_NODIM" : $(this).find('td [name=ResolveModuleEngineeringUnitsType]').val(),
						});
					}
				});

				$('#ModuleResolveSettings tbody tr').each(function () {
					if ($(this).find('td [name=ResolveModuleSettingType]').length > 0) {
						settingsTable.push({
							SettingType: $(this).find('td [name=ResolveModuleSettingType]').data('value'),
							newSettingName: ($(this).find('td [name=resolveModuleReuseSetting]').val() == 'true' ? "" : $(this).find('td [name=ResolveModuleSettingsInstanceName]').val()),
							newSettingGuid: ($(this).find('td [name=resolveModuleReuseSetting]').val() == 'true' ? $(this).find('td [name=ResolveModuleSettingsInstanceGuid]').val() : null)
						});
					}
				});
				var module = { id: FMPointEditor.pointGuid, moduleGuid: moduleGuid, InstanceName: instanceName, tagList: JSON.stringify(tagTable), settingsList: JSON.stringify(settingsTable) }

				var token = $('input[name=__RequestVerificationToken]').val();
				var headers = {};
				headers['__RequestVerificationToken'] = token;

				$.ajax( {
					url: '@Url.Action("PointsCustomTemplateAddModule", "PointCustomTemplateDetail")',
					cache: false,
					type: 'POST',
					headers: headers,
					data: module,
					success: function (response) {
						FMErrorAndExceptionHandling.HandleMessages(response, function (data, inError)
						{
							if (!inError)
							{
								$('#ResolveModuleModal').modal('hide');

								// check if we got a new view for the tags
								var tagList = $.grep(data, function (e) { return e.Key === "tagList"; });
								if ( tagList.length == 1 && tagList[0].Value !== "" )
								{
									FMPointEditor.tagList = JSON.parse( tagList[0].Value );
								}

								// check if we got a new view for the tags
								var tagView = $.grep(data, function (e) { return e.Key === "tagView"; });
								if ( tagView.length == 1 && tagView[0].Value !== "" )
								{
									//replace the tag view
									$("#PTTTagEditHolder").html(tagView[0].Value);
									FMPointEditor.initializeTagGrid();
								}

								// check if we got a new view for the modules
								var moduleView = $.grep(data, function (e) { return e.Key === "modulesView"; });
								if (moduleView.length == 1 && moduleView[0].Value !== "") {
									//replace the modules view
									$("#PTTModuleEditHolder").html(moduleView[0].Value);
								}

								// check if we got a new view for the settings
								var settingView = $.grep(data, function (e) { return e.Key === "settingsView"; });
								if (moduleView.length == 1 && moduleView[0].Value !== "") {
									//replace the settings view
									$("#PEModulePropertyList").html(settingView[0].Value);
									FMPointEditor.initializeModuleSettings();
								}


							}
							else {
								// display the error messages
								var messageList = [];
								// add messages but avoid duplicates
								var seen = {};

								$.each(response.ErrorMessage, function (key, message) {
									// set the control to be flagged as having an error

									$.each(message, function (i, val) {
										if (!seen[message[i]]) {
											seen[message[i]] = true;
											FMErrorAndExceptionHandling.FlagControlHavingError(key);
											messageList.push("<div>" + message[i] + "</div>");
										}
									});
								});
								var messages = messageList.join('');
								FMErrorAndExceptionHandling.ShowError(messages);
							}
							// hide the saving animation
							$(".loadingDiv").remove();
						});
					},
					error: function (xhr, textStatus, error) {
						FMErrorAndExceptionHandling.ShowException(xhr,
							textStatus,
							error,
							function () {
								// hide the saving animation
								$(".loadingDiv").remove();
							});
					}

				});

			}
		});

		// switch between Use Existing Tags or create new ones
		$("#ModuleResolveParameters").on('click', "[name=resolveModuleModuleReuseTagSwitch] .radioBtn a", function ()
		{
			var sel = $(this).data('title');
			var tog = $(this).data('toggle');
			$(this).closest('tr').find("[name=" + tog + "]").prop('value', sel);
			$(this).parent().find('a[data-toggle="' + tog + '"]').not('[data-title="' + sel + '"]').find('span').removeClass('hidden').addClass('hidden');
			$(this).parent().find('a[data-toggle="' + tog + '"][data-title="' + sel + '"]').find('span').removeClass('hidden');
			$(this).parent().find('a[data-toggle="' + tog + '"]').not('[data-title="' + sel + '"]').removeClass('active').addClass('notActive');
			$(this).parent().find('a[data-toggle="' + tog + '"][data-title="' + sel + '"]').removeClass('notActive').addClass('active');

			if ( sel === true )
			{
				$(this).closest('tr').find("[name=ResolveModuleTagNameInput]").removeClass('hidden').addClass('hidden');
				$(this).closest('tr').find("[name=ResolveModuleTagGuidSelect]").removeClass('hidden');
			}
			else
			{
				$(this).closest('tr').find("[name=ResolveModuleTagNameInput]").removeClass('hidden');
				$(this).closest('tr').find("[name=ResolveModuleTagGuidSelect]").removeClass('hidden').addClass('hidden');
			}

		});


		$("#ModuleResolveParameters").on('click', '.booleanImgSelect', function () {
			if ($(this).attr("data-value") === "true") {
				$(this).attr("data-value", "false");
				$(this).attr("alt", "toggleOff");
