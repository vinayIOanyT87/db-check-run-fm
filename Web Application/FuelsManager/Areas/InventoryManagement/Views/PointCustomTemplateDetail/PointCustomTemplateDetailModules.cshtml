				$(this).attr("title", "Yes");
				$(this).attr("src", "@(Url.Content("~/fmwebapp/images/On.png"))");
				$(this).parent().parent().find("[name=ResolveModuleTagNameInput]").removeClass("hidden").addClass("hidden");
				$(this).parent().parent().find("[name=ResolveModuleTagGuidSelect]").removeClass("hidden");
			}
		});

		$('#ModuleResolveParameters').on('change', "[name=ResolveModuleEngineeringUnitsType]", function () {
			var unitsType = $(this).val();
			var tagList = '';
			var row = $(this).closest('tr');
			var tagID = row.find('[name=ResolveModuleTagNameInput]').val();

			FMPointEditor.tagList.forEach(function (existingTag) {
				if (existingTag.DataType === 'System.Double'
				&& existingTag.EngineeringUnitsType === unitsType) {
					var selected = ((existingTag.Name === tagID) ? 'selected' : '');
					tagList += "<option value='" + existingTag.PointTagGuid + "' " + selected + ">" + existingTag.Name + "</option>";
				}
			});
			row.find('[name=ResolveModuleTagGuidSelect]').html(tagList);
		});

		/* MODULE EDITOR TAB EVENTS */
		if ($('#StandardPointTemplate').val() == 'False'
		&& $('#DerivedPoints').val() == 'False') {
			$("#PTTModuleList").sortable({
				change: function () {
					FMPointEditor.valuesChanged = true;
				}
			});
		}
			$("#PTTModuleList").disableSelection();
		$('#PTTModuleList').niceScroll({
			cursorwidth: '10px'
			, autohidemode: false
			, cursorcolor: "#486899"
			, background: "#f9f9f9"
			, horizrailenabled: false
			, railoffset: true
			, railpadding: { top: 0, right: 0, left: -5, bottom: 0 }
			, smoothscroll: true
		});

		if ( $( '#PTTModuleList' ).length > 0 )
		{
			$( '#PTTModuleList' ).children().first().click();
		}

		$('.scrollableModuleDetail').niceScroll({
			cursorwidth: '10px'
			, autohidemode: false
			, cursorcolor: "#486899"
			, background: "#f9f9f9"
			, horizrailenabled: false
			, railoffset: false
			, smoothscroll: true
		});

		$('#ResolveModuleDivScroll').niceScroll({
			cursorwidth: '10px'
			, autohidemode: false
			, cursorcolor: "#486899"
			, background: "#f9f9f9"
			, horizrailenabled: false
			, railoffset: false
			, smoothscroll: true
		});

	});


</script>
