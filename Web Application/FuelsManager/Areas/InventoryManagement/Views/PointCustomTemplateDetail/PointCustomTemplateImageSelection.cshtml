
@using FuelsManager.Areas.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.PictureSummaryModel
<script src="~/Areas/Lib/jquery.columnizer.js"></script>

<div id="PE_IconNameFilterMenuUL" class="pointListColumns">
    @foreach (var picture in Model.Pictures)
    {
        var pictureName = picture.ID;
        var pictureGuid = picture.IdentityGuid.ToString();
        var pictureDescription = picture.Description;

        <div class="PE_RolloutMenuLI icons-dontsplit" data_tag="@pictureGuid" data-name="@pictureName" onclick="FMPointEditor.changeTemplatePointIcon('@pictureGuid');">
            <div class="PE_RolloutMenuName list-view" title="@pictureName"><img src="~/DisplayImage.ashx?PictureGuid=@pictureGuid" class="PE_RolloutSmallMenuIcon"/><span>@pictureName</span></div>
            <div class="PE_RolloutMenuName detail-view" title="@pictureName">@pictureName</div>
            <div class="PE_RolloutMenuIcon detail-view"><img src="~/DisplayImage.ashx?PictureGuid=@pictureGuid"/></div>
            <textarea readonly class="PE_RolloutMenuDescription detail-view">@pictureDescription</textarea>
        </div>
    }
</div>

