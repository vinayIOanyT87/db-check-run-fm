@using System.Globalization
@using System.Web.Mvc.Html
@using FMBusinessObjects.DataObjects
@using FuelsManager.Areas.Controllers
@using FuelsManager.Areas.InventoryManagement.Controllers
@model FuelsManager.Areas.InventoryManagement.ViewModels.AlarmEditorModel

<link href="~/Areas/Content/AlarmEditor.css" rel="stylesheet" type="text/css" />

<script src="~/Areas/Scripts/FMCommon.js"></script>
<script src="~/Areas/Scripts/AlarmTestEquationEditor.js"></script>

<style>
	#alarmTagsTable {
		background-color: transparent;
	}

	#alarmTagsTable.table > tbody > tr > td.alarmRow {
		padding-top: 0px;
		padding-bottom: 0px;
	}

	.table.alarmAlarmsTable, .table.alarmTestsTable {
		margin-bottom: 0px;
	}

	.alarmTestsTable tr:nth-child(even) {
		background-color: rgb(239, 246, 252) !important;
	}

	.alarmTestsTable tr:nth-child(odd) {
		background-color: white !important;
	}

	#AlarmEditorAddAlarm .select2 {
		width: 100% !important;
	}

	#AlarmEditorAddAlarm .select2-container--default .select2-selection--single {
		background-color: #fff;
		border: 1px solid #ccc;
		border-radius: 0px;
		height: 34px;
	}

	.select2-container--open {
		z-index: 1060;
	}

	#AlarmEditorAddAlarm {
		overflow: hidden;
	}

	#AlarmEditorAddAlarm input::-webkit-input-placeholder {
		font-style: italic;
	}

	#AlarmEditorAddAlarm input:-moz-placeholder {
		font-style: italic;
	}

	#AlarmEditorAddAlarm input:-ms-input-placeholder {
		font-style: italic;
	}

	#AlarmTemplateEditorEquationEditor {
		overflow-y: hidden;
	}

	.alarmTestName, .alarmName {
		cursor: pointer;
		text-decoration: underline;
	}

	.alarmName.disabled, .alarmTestName.disabled {
		cursor: not-allowed !important;
		text-decoration: underline;
	}

	.limitTagValue {
		cursor: pointer;
	}

	.alarmtestsortcolumn {
		width: 10px !important;
		font-size: 14px;
		cursor: ns-resize;
	}

	img.disabled {
		cursor: not-allowed !important;
	}

	a.disabled {
		cursor: not-allowed !important;
	}

.disabledCursor {
	cursor: not-allowed !important;
}

	.booleanImgSelect.disabled {
		cursor: not-allowed;
	}
</style>

@{
	var numberFormatInfoString = String.Format("{{{0}" + "\"NegativeSign\":\"{1}\",{0}" + "\"NumberDecimalDigits\":{2},{0}" + "\"NumberDecimalSeparator\":\"{3}\",{0}" + "\"NumberGroupSeparator\":\"{4}\",{0}" + "\"NumberGroupSizes\":{5},{0}" + "\"NumberNegativePattern\":{6},{0}" + "\"ShortDatePattern\":\"{7}\"{0}}}", Environment.NewLine, "-", 0, Model.NumberDecimalSeparator, Model.NumberGroupSeparator, Model.NumberGroupSizes[0], 1, Model.ShortDatePattern);
	var PTModifyClassDisable = (Model.HasPTEditRight && Model.HasModifyEnabled) ? "" : "disabled";
	var PTModifyCursorDisable = (Model.HasPTEditRight && Model.HasModifyEnabled) ? "" : "disabledCursor";
	var PTModifyHiddenStyle = (Model.HasPTEditRight) ? "" : "display:none";
}
@Html.Hidden("alarmEditorNumberFormatInfo", numberFormatInfoString)
@Html.Hidden("urlGetGraphicNames", Url.Action("GetDrawingNames", "Draw"))
@Html.Hidden("urlAlarmEditorEditValue", Url.Action("EditValue", "EditValue"))
@Html.Hidden("urlGetAlarmTestEquationEditor", Url.Action("GetAlarmTestEquationEditorForUnsavedAlarmTest", "AlarmTestEquationEditor"))
@Html.Hidden("urlUpdateAlarmTest", Url.Action("AlarmEditorUpdateAlarmTest", "AlarmEditor"))
@Html.Hidden("AlarmEditorModel", AlarmEditorController.SerializeModel(Model))
@Html.Hidden("PTModifyRight", Model.HasPTEditRight)
@Html.Hidden("ExpandDataDictionary", FMBaseController.TranslateText("Expand"))
@Html.Hidden("CollapseDataDictionary", FMBaseController.TranslateText("Collapse"))
@Html.Hidden("EditAlarmDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Edit Alarm"))
@Html.Hidden("EditAlarmTestDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Edit Alarm Test"))
@Html.Hidden("AddAlarmTestDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Add Alarm Test"))
@Html.Hidden("AddAlarmDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Add Alarm"))
@Html.Hidden("AddAlarmNameMusBeAlphaNumericDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Name Must Be Alphanumeric"))
@Html.Hidden("AddAlarmTagNameMusBeAlphaNumericDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Status Tag Name Must Be Alphanumeric"))
@Html.Hidden("AddAlarmTestNameMusBeAlphaNumericDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Test Name Must Be Alphanumeric"))
@Html.Hidden("AddAlarmTestTagNameMusBeAlphaNumericDataDictionary", FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Test Limit Tag Name Must Be Alphanumeric"))

<div id="alarmEditorOutterDiv" class="table" style="height: calc(100vh - 80px)">
	<div id="expandContractButton" class="expandContractButtonClass" onclick="javascript: return AlarmEditor.ContractEnabledAlarms( this );">
		<Span style="vertical-align: middle; padding: 0; border: 0;">
			<img src="~/fmwebapp/images/minus.png" class="expandContractButtonImageClass" alt=@FMBaseController.TranslateText("ExpandContract") />
		</Span>
		@FMBaseController.TranslateText("Collapse")
	</div>
	<table id="alarmTagsTable" class="table alarmTagsTable">
		<thead class="tableHeaderFormating">
			<tr class="rowBorder">
				<th class="tagExpand text-center tagRowTd"></th>
				<th class="tagName text-left tagRowTd"></th>
				<th class="tagHysteresis text-center tagRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Deadband")</th>
				<th class="alarmsEnabledHeader text-left tagRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Enabled")<img id="AlarmTagTableAddAlarm" src="~/fmwebapp/images/Add-icon.png" title="@FMBaseController.TranslateText("Add Alarm")" style="width: 16px;position: relative;cursor: pointer;float: right; @PTModifyHiddenStyle"></th>
			</tr>
		</thead>
		<tbody id="alarmTagsTableBody">
			@{
				foreach (var tag in Model.Tags)
				{
					var tagRowId = "TagRow_" + tag.PointTagGuid;
					var alarmRowId = "AlarmRow_" + tag.PointTagGuid;
					var alarmRowTdId = "AlarmRowTd_" + tag.PointTagGuid;
					var tableId = "alarmsTable_" + tag.PointTagGuid;
					var tableBodyId = "alarmsTableBody_" + tag.PointTagGuid;
					var tagExpandId = "TagExpand_" + tag.PointTagGuid;
					var tagNameId = "TagName_" + tag.PointTagGuid;
					//(Eric Simmons - 8-11-2017) Make sure to fix this code call once we implement custom templates.
					var fromStandardTemplate = false; //FMBusinessObjects.Constants.Guids.VerticalTankTemplateGuid == Model.PointTemplateGuid;
					var hysteresisId = "Hysteresis_" + tag.PointTagGuid;
					var hysteresisInputId = "HysteresisInput_" + tag.PointTagGuid;
					var alarmsEnableToggleId = "AlarmsEnableToggle_" + tag.PointTagGuid;
					var alarmsEnableToggleImgId = "AlarmsEnableToggleImg_" + tag.PointTagGuid;
					var alarmsDeleteId = "AlarmTableAlarmDelete_" + tag.PointTagGuid;
					var alarmrowclassstring = "hidden rowBorder";

					if (tag.AlarmsEnabled)
					{
						alarmrowclassstring = "rowBorder";
					}
			<tr id="@tagRowId" class="rowBorder tagrowTr">
				@if (tag.Alarms.Count > 0)
				{
					if (tag.AlarmsEnabled)
					{
				<td id="@tagExpandId" class="tagExpand col-sm-2 col-md-2 text-right tagRowTd" onclick="javascript: return AlarmEditor.CollapseAlarms( this );"><img name="collapse" draggable="false" title="expanded" alt="expanded" src="~/fmwebapp/images/Arrow-downBl.png"></td>
					}
					else
					{
				<td id="@tagExpandId" class="tagExpand col-sm-2 col-md-2 text-right tagRowTd" onclick="javascript: return AlarmEditor.ExpandAlarms( this );"><img name="expand" draggable="false" title="collapsed" alt="collapsed" src="~/fmwebapp/images/Arrow-rightBL.png"></td>
					}
				}
				else
				{
				<td id="@tagExpandId" class="tagExpand col-sm-2 col-md-2 text-right tagRowTd"></td>
				}
				<td id="@tagNameId" class="tagName col-sm-2 col-md-2 text-left tagRowTd @PTModifyClassDisable" data-value="@tag.PointTagGuid">@tag.Id</td>
				<td id="@hysteresisId" class="tagHysteresis col-sm-2 col-md-2 text-center tagRowTd">
					<Span>
						<input id=@hysteresisInputId type="text" class="alarmEditorInput" data-value="@tag.Hysteresis" value="@tag.Hysteresis" onblur="AlarmEditor.SaveHysteresis( this )" @((PointTemplateTag.IsNumeric(@tag.DataType) && Model.HasPTEditRight) ? "" : "disabled") />
					</Span>
				</td>
				@if (tag.AlarmsEnabled)
				{
					<td class="alarmsEnabled col-sm-2 col-md-2 text-left tagRowTd" id="@alarmsEnableToggleId">
						@if (Model.HasDisableAlarmOnPointTemplateRight && Model.HasModifyEnabled)
						{
							<img id="@alarmsEnableToggleImgId" draggable="false" title="toggleOn" alt="toggleOn" src="~/fmwebapp/images/On.png" onclick="javascript: return AlarmEditor.DisableAlarms( this );">
						}
						else
						{
							<img id="@alarmsEnableToggleImgId" class="booleanImgSelect disabled" draggable="false" title="toggleOn" alt="toggleOn" src="~/fmwebapp/images/On.png">
						}
						<img id="@alarmsDeleteId" src="~/fmwebapp/images/Trash-icon.png" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Delete All Alarms For Tag")" style="width: 14px; position: relative; cursor: pointer; float: right; @PTModifyHiddenStyle" onclick=' AlarmEditor.DeleteAlarmsForTag( this ); '>
					</td>
				}
				else
				{
					<td class="alarmsEnabled col-sm-2 col-md-2 text-left tagRowTd" id="@alarmsEnableToggleId">
						@if (Model.HasEnableAlarmOnPointTemplateRight && Model.HasModifyEnabled)
						{
							<img id="@alarmsEnableToggleImgId" draggable="false" title="toggleOff" alt="toggleOff" src="~/fmwebapp/images/Off.png" onclick="javascript: return AlarmEditor.EnableAlarms( this );">
						}
						else
						{
							<img id="@alarmsEnableToggleImgId" class="booleanImgSelect disabled" draggable="false" title="toggleOff" alt="toggleOff" src="~/fmwebapp/images/Off.png" >
						}
						<img id="@alarmsDeleteId" src="~/fmwebapp/images/Trash-icon.png" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Delete All Alarms For Tag")" style="width: 14px; position: relative; cursor: pointer; float: right;" onclick=' AlarmEditor.DeleteAlarmsForTag( this ); '>
					</td>
				}
			</tr>
					if (tag.Alarms.Count > 0)
					{
			<tr class="@alarmrowclassstring alarmrowTr" id="@alarmRowId">
				<!--<td class="alarmDummyFirstColumn col-sm-2 col-md-2 text-left"></td>-->
				<td id="@alarmRowTdId" class="alarmRow col-sm-2 col-md-2 text-left" colspan="4">
					<table id="@tableId" class="table alarmAlarmsTable">
						<thead class="tableHeaderFormating">
							<tr class="rowBorder">
								<th class="col-sm-2 col-md-2 text-left alarmDummyFirstColumn alarmRowTd firstAlarmTd"></th>
								<th class="col-sm-2 col-md-2 text-left alarmRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Name")</th>
								<th class="col-sm-2 col-md-2 text-left alarmRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Category")</th>
								<th class="col-sm-2 col-md-2 text-center alarmRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Order")</th>
								<th class="col-sm-2 col-md-2 text-left alarmRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Status Tag")</th>
								<th class="col-sm-2 col-md-2 text-center alarmRowTd">
									@FMBaseController.TranslateText("AlarmTemplateEditor|Enabled")
									<img id="AlarmTableAddAlarm" src="~/fmwebapp/images/Add-icon.png" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Add Alarm")" style="width: 16px;position: relative;cursor: pointer;float: right; @PTModifyHiddenStyle">
								</th>
							</tr>
						</thead>
						<tbody id="@tableBodyId">
							@foreach (var alarm in tag.Alarms)
							{
								var alarmsTableAlarmRowId = "AlarmsTableAlarmRow_" + alarm.AlarmGuid;
								var alarmsTableAlarmIdCellId = "AlarmsTableAlarmIdCellId_" + alarm.AlarmGuid;
								var alarmsTableAlarmCategoryCellId = "alarmsTableAlarmCategoryCellId_" + alarm.AlarmGuid;
								var alarmsTableAlarmOrderCellId = "alarmsTableAlarmOrderCellId_" + alarm.AlarmGuid;
								var alarmsTableAlarmStateTagCellId = "alarmsTableAlarmStateTagCellId_" + alarm.AlarmGuid;
								var alarmsTableAlarmEnabledCellId = "alarmsTableAlarmEnabledCellId_" + alarm.AlarmGuid;
								var alarmsTableAlarmEnabledCellImgId = "alarmsTableAlarmEnabledCellImgId_" + alarm.AlarmGuid;
								var alarmsTableAlarmDeleteCellImgId = "alarmsTableAlarmDeleteCellImgId_" + alarm.AlarmGuid;
								var alarmExpandId = "AlarmExpand_" + alarm.AlarmGuid;
								var alarmTestsRowId = "AlarmTests_" + alarm.AlarmGuid;
								var alarmTestsRowTdId = "AlarmTestsTd_" + alarm.AlarmGuid;
								var alarmTestsTableId = "AlarmTestTable_" + alarm.AlarmGuid;
								var alarmTestsTableBodyId = "AlarmTestTableBody_" + alarm.AlarmGuid;
								var rowclassstring = "hidden rowBorder";

								if (tag.AlarmsEnabled && alarm.Enabled)
								{
									rowclassstring = "rowBorder";
								}
								//var suppressedShelvedSprocketId = "suppressedShelvedSprocketId_" + alarm.AlarmGuid;

							<tr id="@alarmsTableAlarmRowId" class="rowBorder alarmrowTr">
								@if (alarm.AlarmTests.Count > 0)
								{
									if (alarm.Enabled && tag.AlarmsEnabled)
									{
									<td class="col-sm-2 col-md-2 text-left alarmDummyFirstColumn alarmRowTd firstAlarmTd" id="@alarmExpandId" onclick="javascript: return AlarmEditor.CollapseTests( this );"><img name="contract" draggable="false" title="expanded" alt="expanded" src="~/fmwebapp/images/Arrow-downBl.png"></td>
									}
									else
									{
									<td class="col-sm-2 col-md-2 text-left alarmDummyFirstColumn alarmRowTd firstAlarmTd" id="@alarmExpandId" onclick="javascript: return AlarmEditor.ExpandTests( this );"><img name="expand" draggable="false" title="collapsed" alt="collapsed" src="~/fmwebapp/images/Arrow-rightBL.png"></td>
									}
								}
								else
								{
									<td class="col-sm-2 col-md-2 text-left alarmDummyFirstColumn alarmRowTd firstAlarmTd" id="@alarmExpandId"></td>
								}
								<td class="col-sm-2 col-md-2 text-left alarmRowTd alarmName @PTModifyClassDisable" style="padding-left: 5px;" data-value="@alarm.AlarmStatusTagGuid" id="@alarmsTableAlarmIdCellId">@alarm.Id</td>
								<td class="col-sm-2 col-md-2 text-left alarmRowTd" id="@alarmsTableAlarmCategoryCellId">@alarm.Category</td>
								<td class="col-sm-2 col-md-2 text-center alarmRowTd" id="@alarmsTableAlarmOrderCellId">@alarm.Order</td>
								<td class="col-sm-2 col-md-2 text-left alarmRowTd" id="@alarmsTableAlarmStateTagCellId">@alarm.AlarmStatusTagId</td>
								@if (alarm.Enabled)
								{
									<td class="col-sm-2 col-md-2 text-center alarmRowTd" id="@alarmsTableAlarmEnabledCellId">
										@if (Model.HasDisableAlarmOnPointTemplateRight  && Model.HasModifyEnabled)
										{
											<img id="@alarmsTableAlarmEnabledCellImgId" draggable="false" title="toggleOn" alt="toggleOn" src="~/fmwebapp/images/On.png" onclick="javascript: return AlarmEditor.DisableAlarm( this ); ">
										}
										else
										{
											<img id="@alarmsTableAlarmEnabledCellImgId" class="booleanImgSelect disabled" draggable="false" title="toggleOn" alt="toggleOn" src="~/fmwebapp/images/On.png" >
										}
										<img id="@alarmsTableAlarmDeleteCellImgId" src="~/fmwebapp/images/Trash-icon.png" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Delete Alarm Definition")" style="width: 14px; position: relative; cursor: pointer; float: right; @PTModifyHiddenStyle" onclick=' AlarmEditor.DeleteTemplateAlarm( this ); '>
									</td>
								}
								else
								{
									<td class="col-sm-2 col-md-2 text-center alarmRowTd" id="@alarmsTableAlarmEnabledCellId">
										@if (Model.HasEnableAlarmOnPointTemplateRight && Model.HasModifyEnabled)
										{
											<img id="@alarmsTableAlarmEnabledCellImgId" draggable="false" title="toggleOff" alt="toggleOff" src="~/fmwebapp/images/Off.png" onclick="javascript: return AlarmEditor.EnableAlarm( this ); ">
										}
										else
										{
											<img id="@alarmsTableAlarmEnabledCellImgId" class="booleanImgSelect disabled" draggable="false" title="toggleOff" alt="toggleOff" src="~/fmwebapp/images/Off.png">
										}
										<img id="@alarmsTableAlarmDeleteCellImgId" src="~/fmwebapp/images/Trash-icon.png" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Delete Alarm Definition")" style="width: 14px; position: relative; cursor: pointer; float: right; @PTModifyHiddenStyle" onclick=' AlarmEditor.DeleteTemplateAlarm( this ); '>
									</td>
								}
							</tr>
								if (alarm.AlarmTests.Count > 0)
								{
									<tr class="@rowclassstring" id="@alarmTestsRowId">
										<td class="alarmTestRowTd col-sm-2 col-md-2 text-left" colspan="6" id="@alarmTestsRowTdId">
											<table id="@alarmTestsTableId" class="table alarmTestsTable">
												<thead class="tableHeaderFormating">
													<tr class="rowBorder">
														<th class="testRowTd"></th>
														<th class="col-sm-2 col-md-2 text-left testRowTd firstTestTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Test Name")</th>
														<th class="col-sm-2 col-md-2 text-center testRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Limit Tag")</th>
														<th class="col-sm-2 col-md-2 text-center testRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Limit Value")</th>
														<th class="col-sm-2 col-md-2 text-center testRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Alarm State")</th>
														<th class="col-sm-2 col-md-2 text-center testRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Alarm Text")</th>
														<th class="tagHysteresis col-sm-2 col-md-2 text-center tagRowTd">@FMBaseController.TranslateText("AlarmTemplateEditor|Hold Off")</th>
														<th class="col-sm-2 col-md-2 text-center testRowTd">
															@FMBaseController.TranslateText("AlarmTemplateEditor|Test")
															<img class="AlarmTestTableAddAlarmTest" src="~/fmwebapp/images/Add-icon.png" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Add Alarm Test")" style="width: 16px; position: relative; cursor: pointer; float: right; @PTModifyHiddenStyle">
														</th>
													</tr>
												</thead>
												<tbody id="@alarmTestsTableBodyId">
													@foreach (var test in alarm.AlarmTests.OrderBy(x => x.Order))
													{
														var testObj = test;
														var testRowId = "testRow_" + test.AlarmTestGuid;
														var testNameCellId = "testNameCellId_" + test.AlarmTestGuid;
														var testTestCellId = "testTestCellId_" + test.AlarmTestGuid;
														var testTestCellDivId = "testTestCellDivId_" + test.AlarmTestGuid;
														var testLimitTagCellId = "testLimitTagCellId_" + test.AlarmTestGuid;
														var testLimitValueCellId = "testLimitValueCellId_" + test.AlarmTestGuid;
														var testAlarmStateCellId = "testAlarmStateCellId_" + test.AlarmTestGuid;
														var testAlarmTextCellId = "testAlarmTextCellId_" + test.AlarmTestGuid;
														var testHoldOffCellId = "testHoldOffCellId_" + test.AlarmTestGuid;
														var testHelpFileCellId = "testHelpFileCellId_" + test.AlarmTestGuid;
														var testGraphicCellId = "testGraphicCellId_" + test.AlarmTestGuid;
														var equationSprocketId = "equationSprockedId_" + test.AlarmTestGuid;
														var helpFileSprocketId = "helpFileSprockedId_" + test.AlarmTestGuid;
														var diagramSprockedId = "diagramSprockedId_" + test.AlarmTestGuid;
														var holdOffInputId = "holdOffInputId_" + test.AlarmTestGuid;
														var limitValueInputId = "limitValueInputId_" + test.AlarmTestGuid;
														var limitValueInputDisable = test.LimitTagEditable == true ? "" : "disabled";
														var holdOffId = "HoldOff_" + test.AlarmTestGuid;
														var timedHoldOffSecondsInputId = "TimedHoldOffSecondsInput_" + test.AlarmTestGuid;
														var timedHoldOffMinutesInputId = "TimedHoldOffMinutesInput_" + test.AlarmTestGuid;
														var alarmTestsSortableId = "alarmTestTableSortable_" + test.AlarmTestGuid;

												<tr id="@testRowId" class="rowBorder">
													<td id="@alarmTestsSortableId" class="text-right alarmtestsortcolumn">
														<span class="glyphicon glyphicon-option-vertical text-center" style ="@PTModifyHiddenStyle"></span>
													</td>
													<td id="@testNameCellId" class="col-sm-2 col-md-2 text-left testRowTd firstTestTd alarmTestName @PTModifyClassDisable">@test.Id</td>
													<td id="@testLimitTagCellId" class="col-sm-2 col-md-2 text-center testRowTd">@test.LimitTagId</td>
													<td id="@testLimitValueCellId" class="col-sm-2 col-md-2 text-center testRowTd limitTagValue @PTModifyClassDisable">
														<label id=@limitValueInputId type="text" data-value="@test.LimitValue" class ="@PTModifyCursorDisable @PTModifyClassDisable">@test.LimitValue</label>
														<span class="glyphicon glyphicon-pencil pull-right @PTModifyCursorDisable @PTModifyClassDisable"></span>
													</td>
													<td id="@testAlarmStateCellId" title="@test.AlarmState" class="col-sm-2 col-md-2 text-center testRowTd alarmTestState">
														@test.AlarmState
													</td>
													<td id="@testAlarmTextCellId" title="@test.AlarmText" class="col-sm-2 col-md-2 text-center testRowTd alarmTestText">
														@test.AlarmText
													</td>
													<td id="@holdOffId" class="tagHysteresis col-sm-2 col-md-2 text-center tagRowTd">
														<Span>
															<label class="minutesSecondsFormat">@FMBaseController.TranslateText("AlarmTemplateEditor|min:") </label>
															<label id=@timedHoldOffMinutesInputId class="text-left" style="width: 40px !important">@test.HoldOffMinutes</label>
															<label class="minutesSecondsFormat">@FMBaseController.TranslateText("AlarmTemplateEditor|sec:") </label>
															<label id=@timedHoldOffSecondsInputId class="text-left" style="width: 30px !important">@test.HoldOffSeconds</label>
														</Span>
													</td>
													<td id="@testTestCellId" class="col-sm-2 col-md-2 text-center testRowTd">
														<div id="@testTestCellDivId" title="@test.AlarmTestEquation" class="alarmEditorTestCell" style="width: calc( 100% - 40px) !important;padding-top: 3px;">
															@test.AlarmTestEquation
														</div>
														@if (!fromStandardTemplate)
														{
														<Span class="alarmEditorSprocketSpan" style="font-size: 14px; @PTModifyHiddenStyle" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Edit Test Formula")">
															<a id="@equationSprocketId" class="equationSprocket glyphicon glyphicon-cog @PTModifyCursorDisable" href='javascript:;' onclick='AlarmEditor.EditTestTemplateEquation( this ); '></a>
														</Span>
														}
														<img class="alarmEditorDeleteAlarmTest" src="~/fmwebapp/images/Trash-icon.png" title="@FMBaseController.TranslateText("AlarmTemplateEditor|Delete Alarm Test")" style="width: 14px;position: relative;cursor: pointer;float: right;display: inline-block; @PTModifyHiddenStyle" onclick='AlarmEditor.DeleteTemplateAlarmTest( this );'>
													</td>
												</tr>
													}
												</tbody>
											</table>
										</td>
									</tr>
								}
