		AlarmEditor.EditTestTemplateEquation = function( currentItem )
		{

			// create the backdrop and wait for next modal to be triggered
			var modalManager = $('body').modalmanager('loading');

			// remove the equation editor page from the add alarm wizard to avoid conflicts (like unique ids for tags)
			$("#AlarmEditorAddAlarmEditorScreenPage4").html('');

			//Use Guid to update Test Equation
			var alarmTestGuid = currentItem.id.replace( AlarmEditor.EquationSprocketPrefix, '' );
			var model = AlarmEditor.GetAlarmEditorModel();
			var pointGuid = model.PointGuid;
			var token = $( '#pointPropertiesForm input[name=__RequestVerificationToken]' ).val();
			var headers = {};
			headers['__RequestVerificationToken'] = token;
			var url = $( '#urlGetAlarmTestEquationEditor' ).val();
			var alarmDefinitionGuid = $( currentItem ).closest( 'table' ).attr('id').replace('AlarmTestTable_', '' );
			var alarmTagGuid = $( currentItem ).closest( 'table' ).parent().closest( 'table' ).parent().attr( 'id' ).replace( 'AlarmRowTd_', '' );

			var alartTestObject = null;
			var selectedAlarmTag = null;
			var selectedAlarmDefinition = null;
			var selectedAlarmTest = null;
			var selectedInputTagDataType = null;

			selectedAlarmTag = jQuery.grep( model.Tags, function( a ) {
				return a.PointTagGuid === alarmTagGuid;
			} );
			if (selectedAlarmTag.length > 0)
			{
				// get the input tag
				var inputTagList = jQuery.grep( FMPointEditor.tagList, function( a )
				{
					return a.PointTagGuid === selectedAlarmTag[0].PointTagGuid;
				} );
				if (inputTagList.length > 0 ) {
					selectedInputTagDataType = inputTagList[0].DataType;
				} else {
					FMErrorAndExceptionHandling.CloseNotifications();
					FMErrorAndExceptionHandling.ShowError("Input Tag not found.", function(){});
					return;
				}

				// get the alarm test configuration
				selectedAlarmDefinition = jQuery.grep( selectedAlarmTag[0].Alarms, function( a )
				{
					return a.AlarmGuid === alarmDefinitionGuid;
				} );
				if (selectedAlarmDefinition.length > 0){
					selectedAlarmTest = jQuery.grep( selectedAlarmDefinition[0].AlarmTests, function( a )
					{
						return a.AlarmTestGuid === alarmTestGuid;
					} );
					if (selectedAlarmTest.length > 0){
						alartTestObject = selectedAlarmTest[0];
					}
				} else {
					FMErrorAndExceptionHandling.CloseNotifications();
					FMErrorAndExceptionHandling.ShowError("Alarm information not found.", function(){})
					return;
				}

			} else {
				FMErrorAndExceptionHandling.CloseNotifications();
				FMErrorAndExceptionHandling.ShowError("Tag used in alarm not found.", function(){})
				return;
			}

			var requestParms = {alarmTestGuid: alarmTestGuid, tagName: selectedAlarmTag[0].Id, tagValueTypeString: selectedAlarmTest[0].LimitTagValueType, tagGuid: alarmTagGuid, limitTagName: selectedAlarmTest[0].LimitTagId, inputTagDataType: selectedInputTagDataType,tagField: selectedAlarmTest[0].TagField, testType: selectedAlarmTest[0].TestType, bitMask: selectedAlarmTest[0].BitMask, bitwiseOperator: selectedAlarmTest[0].BitwiseOperator}


			$.ajax( {
				type: 'POST',
				cache: false,
				headers: headers,
				url: url,
				data: requestParms,
				success: function( response )
				{
					FMErrorAndExceptionHandling.HandleMessages( response, function( data, inError )
					{
						if ( !inError || ( data != null ) )
						{
							$( '#AlarmTemplateEditorEquationEditorScreen' ).html( data );
							$( '#AlarmTemplateEditorEquationEditor' ).modal( 'show' );
						}
						else {
							$('body').modalmanager('loading'); // remove the loading background
						}
					} );
				},
				error: function( xhr, textStatus, error )
				{
					FMErrorAndExceptionHandling.ShowException( xhr, textStatus, error, function()
					{
						$('body').modalmanager('loading'); // remove the loading background
					} );
				}
			} );
		};

		AlarmEditor.SaveTestTemplateEquationChanges = function()
		{

			var ateModel = AlarmTestEquationEditor.GetUpdates();
			var model = AlarmEditor.GetAlarmEditorModel();
			var alarmTestEquation = ateModel.TagName + AlarmEditor.GetTagField( ateModel.TagAttribute ) + ' ' + AlarmEditor.GetBitmask( ateModel.TagAttribute, ateModel.UseBitmask, ("0000000000000000" + ateModel.Bitmask.toString(16).toUpperCase()).slice (ateModel.BitMaskDigits * -1), ateModel.BitwiseOperator ) + AlarmEditor.GetComparison( ateModel.ComparisonOperator ) + ' ' + ateModel.LimitName;
			$( '#AlarmTemplateEditorEquationEditor' ).modal( 'hide' );

			//update model
			for ( var i = 0; i < model.Tags.length; i++ )
			{
				if ( model.Tags[i].PointTagGuid === ateModel.TagGuid )
				{
					for ( var j = 0; j < model.Tags[i].Alarms.length; j++ )
					{
						for ( var k = 0; k < model.Tags[i].Alarms[j].AlarmTests.length; k++ )
						{
							if ( model.Tags[i].Alarms[j].AlarmTests[k].AlarmTestGuid === ateModel.AlarmTestGuid )
							{
								model.Tags[i].Alarms[j].AlarmTests[k].AlarmTestEquation = alarmTestEquation;
								model.Tags[i].Alarms[j].AlarmTests[k].TestType = parseInt( ateModel.ComparisonOperator);
								model.Tags[i].Alarms[j].AlarmTests[k].TagField = parseInt( ateModel.TagAttribute);
								model.Tags[i].Alarms[j].AlarmTests[k].BitMask = parseInt( ateModel.Bitmask);
								model.Tags[i].Alarms[j].AlarmTests[k].BitwiseOperator = parseInt( ateModel.BitwiseOperator);

								// check to see if we need to update the limit tag ( if changing from Value to Status the data type will change)
								var limitTagInfo = jQuery.grep(FMPointEditor.tagList, function (row) { return row.PointTagGuid === model.Tags[i].Alarms[j].AlarmTests[k].LimitTagGuid; });
								if (limitTagInfo.length > 0) {
									if ( model.Tags[i].Alarms[j].AlarmTests[k].TagField === 0) {
										// find the input tag
										var sourceTagInfo = jQuery.grep(FMPointEditor.tagList, function (row) { return row.PointTagGuid === ateModel.TagGuid; });
										if (sourceTagInfo.length > 0) {
											if ( $( "#Tags_" + limitTagInfo[0].index + "__DataType" ).val() != $( "#Tags_" + sourceTagInfo[0].index + "__DataType" ).val()
											&& $( "#Tags_" + sourceTagInfo[0].index + "__DataType" ).val() !== 'FMBusinessObjects.DataObjects.DeviceAlarmMapReference') {
												$( "#Tags_" + limitTagInfo[0].index + "__DataType" ).val( $( "#Tags_" + sourceTagInfo[0].index + "__DataType" ).val() );
												limitTagInfo[0].DataType = sourceTagInfo[0].DataType;
												$( "#limitValueInputId_" + model.Tags[i].Alarms[j].AlarmTests[k].AlarmTestGuid ).text( "" );
												$( "#limitValueInputId_" + model.Tags[i].Alarms[j].AlarmTests[k].AlarmTestGuid ).attr( "data-value", "" );
												$( "#Tags_" + limitTagInfo[0].index + "__Value" ).val( "" );
												$( "#Tags_" + limitTagInfo[0].index + "__Value" ).attr( "data-raw-value", "" );
												$( "#Tags_" + limitTagInfo[0].index + "__Value" ).attr( "title", "" );

											}

											$( "#Tags_" + limitTagInfo[0].index + "__Unit" ).removeClass("hidden");
											if ( $( "#Tags_" + sourceTagInfo[0].index + "__Unit" ).hasClass("hidden") ) {
												$( "#Tags_" + limitTagInfo[0].index + "__Unit" ).addClass("hidden");
											}
											$( "#Tags_" + limitTagInfo[0].index + "__Unit" ).html( $( "#Tags_" + sourceTagInfo[0].index + "__Unit" ).children().clone())
											$( "#Tags_" + limitTagInfo[0].index + "__Unit" ).val( $( "#Tags_" + sourceTagInfo[0].index + "__Unit" ).val( ) );
											limitTagInfo[0].Units = sourceTagInfo[0].Units;
											$( "#Tags_" + limitTagInfo[0].index + "__EngineeringUnitsType" ).val( $( "#Tags_" + sourceTagInfo[0].index + "__EngineeringUnitsType" ).val( ) );
											$( "#Tags_" + limitTagInfo[0].index + "__EngineeringUnitsType" ).removeClass("hidden");
											if ( $( "#Tags_" + sourceTagInfo[0].index + "__EngineeringUnitsType" ).hasClass("hidden") ) {
												$( "#Tags_" + limitTagInfo[0].index + "__EngineeringUnitsType" ).addClass("hidden");
											}
											limitTagInfo[0].EngineeringUnitsType = sourceTagInfo[0].EngineeringUnitsType;
											$( "#Tags_" + limitTagInfo[0].index + "__DecimalPlace" ).val( $( "#Tags_" + sourceTagInfo[0].index + "__DecimalPlace" ).val() );
											limitTagInfo[0].DecimalPlaces = sourceTagInfo[0].DecimalPlaces;
											$( "#Tags_" + limitTagInfo[0].index + "__Maximum" ).val( $( "#Tags_" + sourceTagInfo[0].index + "__Maximum" ).val( ) );
											$( "#Tags_" + limitTagInfo[0].index + "__Maximum" ).attr( "data-raw-value", $( "#Tags_" + sourceTagInfo[0].index + "__Maximum" ).attr( "data-raw-value" ) );
											limitTagInfo[0].Maximum = sourceTagInfo[0].Maximum;
											$( "#Tags_" + limitTagInfo[0].index + "__Minimum" ).val( $( "#Tags_" + sourceTagInfo[0].index + "__Minimum" ).val( ) );
											limitTagInfo[0].Minimum = sourceTagInfo[0].Minimum;
											$( "#Tags_" + limitTagInfo[0].index + "__Minimum" ).attr( "data-raw-value", $( "#Tags_" + sourceTagInfo[0].index + "__Minimum" ).attr( "data-raw-value" ) );
										}
									} else {
										if ( $( "#Tags_" + limitTagInfo[0].index + "__DataType" ).val() != "System.UInt32") {
											$( "#Tags_" + limitTagInfo[0].index + "__DataType" ).val( "System.UInt32" );
											limitTagInfo[0].DataType = ateModel.TagType;
											$( "#limitValueInputId_" + model.Tags[i].Alarms[j].AlarmTests[k].AlarmTestGuid ).text( "0" );
											$( "#limitValueInputId_" + model.Tags[i].Alarms[j].AlarmTests[k].AlarmTestGuid ).attr( "data-value", 0 );
											$( "#Tags_" + limitTagInfo[0].index + "__Value" ).val( 0 );
										}
										$( "#Tags_" + limitTagInfo[0].index + "__Unit" ).val( 255 );
										$( "#Tags_" + limitTagInfo[0].index + "__Unit" ).removeClass("hidden").addClass("hidden");
										limitTagInfo[0].Units = 255;
										$( "#Tags_" + limitTagInfo[0].index + "__EngineeringUnitsType" ).val( "FMU_NODIM" );
										$( "#Tags_" + limitTagInfo[0].index + "__EngineeringUnitsType" ).removeClass("hidden").addClass("hidden");
										limitTagInfo[0].EngineeringUnitsType = "FMU_NODIM";
										$( "#Tags_" + limitTagInfo[0].index + "__DecimalPlace" ).val( 0 );
										limitTagInfo[0].DecimalPlaces = 0;
										$( "#Tags_" + limitTagInfo[0].index + "__Maximum" ).val( 4294967295 );
										$( "#Tags_" + limitTagInfo[0].index + "__Maximum" ).attr( "data-raw-value", 4294967295 );
										limitTagInfo[0].Maximum = 4294967295;
										$( "#Tags_" + limitTagInfo[0].index + "__Minimum" ).val( 0 );
										$( "#Tags_" + limitTagInfo[0].index + "__Minimum" ).attr( "data-raw-value", 0 );
										limitTagInfo[0].Minimum = 0;
									}
								}
							}
						}
					}
				}
			}
			AlarmEditor.SetAlarmEditorModel( model );

			//update alarmtestequation field
			var alarmTestEquationDivId = AlarmEditor.TestTestCellDivPrefix + ateModel.AlarmTestGuid;
			$( "#" + alarmTestEquationDivId).text( alarmTestEquation );
			$( "#" + alarmTestEquationDivId).attr( 'title', alarmTestEquation );


		};

		// delete a template alarm test
		AlarmEditor.DeleteTemplateAlarmTest = function( currentItem ) {

			var alarmTestGuid = $( currentItem ).parent().attr("id").replace( "testTestCellId_", "" );
			var alarmDefinitionGuid = $( currentItem ).closest( 'table' ).attr('id').replace('AlarmTestTable_', '' );
			var alarmTagGuid = $( currentItem ).closest( 'table' ).parent().closest( 'table' ).attr('id').replace('alarmsTable_', '' );
			var alarmName = $( "#testNameCellId_" + alarmTestGuid ).text();

			var message = '<p>Do you want to delete the Alarm Test "' + alarmName + '"?</p>';
			var isLastAlarmTest = ( $( currentItem ).closest( 'table' ).find( 'tbody tr' ).length === 1 );
			var isLastAlarm = false;

			// if we are deleting the last Alarm Test we need to delete the last Alarm Test
			if ( isLastAlarmTest ) {
				message += '<p>Deleting this Alarm Test will also delete the Alarm.</p>';
				// if we are also deleting the last alarm for the tag we need to remove the tag from the list
				isLastAlarm = ($( currentItem ).closest( 'table' ).parent().closest( 'table > tbody' ).children().length === 2 );  // alarm table has a minimum of 2 rows (the name and the details)
			}

			// Prompt to confirm delete
			FMLayout.ConfirmYesNo( message,
				"Delete Alarm Test",
				function() {
					$( currentItem ).closest( 'tr' ).remove();
					if( isLastAlarmTest ) {
						$( "#AlarmsTableAlarmRow_" + alarmDefinitionGuid ).remove();
						$( "#AlarmTests_" + alarmDefinitionGuid ).remove();
					}
					if ( isLastAlarm) {
						$( "#TagRow_" + alarmTagGuid ).remove();
						$( "#AlarmRow_" + alarmTagGuid ).remove();
					}

					var model = AlarmEditor.GetAlarmEditorModel();
					// find the alarm we want to delete in the model
					var alarmTagIdx = model.Tags.map(function(x) {return x.PointTagGuid; }).indexOf(alarmTagGuid);
					if ( alarmTagIdx >= 0 ) {
						if( isLastAlarm ) {
							// if it's the last alarm test we delete the tag too

							$.each(model.Tags[alarmTagIdx].Alarms, function( alarmIdx, alarm ) {
								var statusTaginUse = AlarmEditor.isStatusTagUsed( alarm.AlarmStatusTagGuid, alarm.AlarmGuid, model );
								statusTaginUse = statusTaginUse || AlarmEditor.isTagUsedInModule( alarm.AlarmStatusTagGuid );
								if ( !statusTaginUse ) {
									FMPointEditor.deleteTagbyGuid( alarm.AlarmStatusTagGuid );
								}

								$.each(alarm.AlarmTests, function( alarmTestIdx, alarmTest ) {
									var limitTaginUse = AlarmEditor.isLimitTagUsed( alarmTest.LimitTagGuid, alarmTest.AlarmTestGuid, model );
									limitTaginUse = limitTaginUse || AlarmEditor.isTagUsedInModule( alarmTest.LimitTagGuid);
									if ( !limitTaginUse ) {
										FMPointEditor.deleteTagbyGuid( alarmTest.LimitTagGuid );
									}
								});
							});
							// we can enable the columns for the source tag since they are not used for an alarm
							AlarmEditor.EnableTagColumnsForAlarmTags( model.Tags[alarmTagIdx].PointTagGuid );

							model.Tags.splice(alarmTagIdx, 1);
						} else {
							var alarmDefinitionIdx = model.Tags[alarmTagIdx].Alarms.map(function(x) {return x.AlarmGuid; }).indexOf(alarmDefinitionGuid);
							if ( alarmDefinitionIdx >= 0 ) {
								var alarmTestIdx = model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmTests.map(function(x) {return x.AlarmTestGuid; }).indexOf(alarmTestGuid);
								if ( alarmTestIdx >= 0 ) {
									// check to see if the tag is being used
									var limitTagGuid = model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmTests[alarmTestIdx].LimitTagGuid;
									var limitTaginUse = AlarmEditor.isLimitTagUsed( limitTagGuid, alarmTestGuid, model );
									limitTaginUse = limitTaginUse || AlarmEditor.isTagUsedInModule( limitTagGuid);
									if ( !limitTaginUse ) {
										FMPointEditor.deleteTagbyGuid( limitTagGuid );
									}
								}
								if( isLastAlarmTest ) {
									// if it's the last alarm test we delete the alarm definition too
									var statusTaginUse = AlarmEditor.isStatusTagUsed( model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmStatusTagGuid, model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmGuid, model );
									statusTaginUse = statusTaginUse || AlarmEditor.isTagUsedInModule( model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmStatusTagGuid);
									if ( !statusTaginUse ) {
										FMPointEditor.deleteTagbyGuid( model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmStatusTagGuid );
									}
									model.Tags[alarmTagIdx].Alarms.splice(alarmDefinitionIdx, 1);

								} else {
									// delete the alarm test entry in the alarm model
									model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmTests.splice(alarmTestIdx, 1);

									// redo the sort order
									$.each(model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmTests, function( index, value ) {
										value.Order = $( "#testRow_" + value.AlarmTestGuid).index();
									});
								}
							}
						}
					}

					AlarmEditor.SetAlarmEditorModel(model);
				});
		}

		// delete a template alarm definition
		AlarmEditor.DeleteTemplateAlarm = function( currentItem ) {

			var alarmDefinitionGuid = $( currentItem ).parent().attr("id").replace( "alarmsTableAlarmEnabledCellId_", "" );
			var alarmTagGuid = $( currentItem ).closest( 'table' ).attr('id').replace('alarmsTable_', '' );
			var alarmName = $( "#AlarmsTableAlarmIdCellId_" + alarmDefinitionGuid ).text();

			var isLastAlarm = ($( currentItem ).closest( 'table  > tbody' ).children().length === 2 );

			// Prompt to confirm delete
			FMLayout.ConfirmYesNo('Do you want to delete the Alarm "' + alarmName + '"?',
				"Delete Alarm",
				function() {
					$( currentItem ).closest( 'tr' ).remove();
					$( "#AlarmTests_" + alarmDefinitionGuid ).closest( 'tr' ).remove();

					if ( isLastAlarm) {
						$( "#TagRow_" + alarmTagGuid ).remove();
						$( "#AlarmRow_" + alarmTagGuid ).remove();
					}
					var model = AlarmEditor.GetAlarmEditorModel();

					// find the alarm we want to delete in the model
					var alarmTagIdx = model.Tags.map(function(x) {return x.PointTagGuid; }).indexOf(alarmTagGuid);
					if ( alarmTagIdx >= 0 ) {
						if( isLastAlarm ) {
							$.each(model.Tags[alarmTagIdx].Alarms, function( alarmIdx, alarm ) {
								var statusTaginUse = AlarmEditor.isStatusTagUsed( alarm.AlarmStatusTagGuid, alarm.AlarmGuid, model );
								statusTaginUse = statusTaginUse || AlarmEditor.isTagUsedInModule( alarm.AlarmStatusTagGuid );
								if ( !statusTaginUse ) {
									FMPointEditor.deleteTagbyGuid( alarm.AlarmStatusTagGuid );
								}

								$.each(alarm.AlarmTests, function( alarmTestIdx, alarmTest ) {
									var limitTaginUse = AlarmEditor.isLimitTagUsed( alarmTest.LimitTagGuid, alarmTest.AlarmTestGuid, model );
									limitTaginUse = limitTaginUse || AlarmEditor.isTagUsedInModule( alarmTest.LimitTagGuid );
									if ( !limitTaginUse ) {
										FMPointEditor.deleteTagbyGuid( alarmTest.LimitTagGuid );
									}
								});
							});

							// we can enable the columns for the source tag since they are not used for an alarm
							AlarmEditor.EnableTagColumnsForAlarmTags( model.Tags[alarmTagIdx].PointTagGuid );

							model.Tags.splice(alarmTagIdx, 1);
						} else {
							var alarmDefinitionIdx = model.Tags[alarmTagIdx].Alarms.map(function(x) {return x.AlarmGuid; }).indexOf(alarmDefinitionGuid);
							if ( alarmDefinitionIdx >= 0 ) {
								var statusTaginUse = AlarmEditor.isStatusTagUsed( model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmStatusTagGuid, model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmGuid, model );
								statusTaginUse = statusTaginUse || AlarmEditor.isTagUsedInModule( model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmStatusTagGuid );
								if ( !statusTaginUse ) {
									FMPointEditor.deleteTagbyGuid( model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmStatusTagGuid );
								}

								$.each(model.Tags[alarmTagIdx].Alarms[alarmDefinitionIdx].AlarmTests, function( alarmTestIdx, alarmTest ) {
									var limitTaginUse = AlarmEditor.isLimitTagUsed( alarmTest.LimitTagGuid, alarmTest.AlarmTestGuid, model );
									limitTaginUse = limitTaginUse || AlarmEditor.isTagUsedInModule( alarmTest.LimitTagGuid );
									if ( !limitTaginUse ) {
										FMPointEditor.deleteTagbyGuid( alarmTest.LimitTagGuid );
									}
								});

								// delete the entry
								model.Tags[alarmTagIdx].Alarms.splice(alarmDefinitionIdx, 1);
							}
						}
					}

					AlarmEditor.SetAlarmEditorModel(model);
				});
		}

		// Validate Alarm Name
		AlarmEditor.isAlarmNameValid = function( alarmName, pointTagGuid ) {
			var errorMessage = "";
			var inputTagInfo = jQuery.grep(AlarmEditor.GetAlarmEditorModel().Tags, function (row) { return row.PointTagGuid === pointTagGuid; });
			if (inputTagInfo.length > 0) {
				if ( inputTagInfo[0].Alarms.length > 0) {
					var duplicateAlarmName = jQuery.grep(inputTagInfo[0].Alarms, function (alarm) { return alarm.Id.toUpperCase() === alarmName.toUpperCase(); });
					if ( duplicateAlarmName.length > 0) {
						$("#addAlarmName").parent().removeClass('has-error').addClass('has-error');
						errorMessage += "Alarm Name already in use for the selected Tag.\n";
						inError = true;
					}
				}
			}
			return errorMessage;
		}

		// In the tag grid disable the tag fields for tags used in alarms
		AlarmEditor.DisableTagColumnsForAlarmTags = function( tagGuid  ) {
			var tagInfo = jQuery.grep(FMPointEditor.tagList, function (row) { return row.PointTagGuid === tagGuid; });
			if (tagInfo.length > 0) {
				var rowIndex = tagInfo[0].index;
				$( "#Tags_" + rowIndex + "__DeleteTag" ).attr( 'disabled', 'true');
				$( "#Tags_" + rowIndex + "__DeleteTag" ).attr( 'src', '@(Url.Content("~/fmwebapp/images/Delete-column-inactive.png"))');

				$( "#Tags_" + rowIndex + "__Name" ).attr( 'disabled', 'true');
				$( "#Tags_" + rowIndex + "__DataType" ).attr( 'disabled', 'true');
				$( "#Tags_" + rowIndex + "__EngineeringUnitsType" ).attr( 'disabled', 'true');

				var alarmIcon = $( "#Tags_" + rowIndex + "__Name" ).closest('tr').find( '[name=alarm]' );
				alarmIcon.attr( 'alt', 'Associated Alarm');
				alarmIcon.attr( 'title', 'Used in Alarm');
				alarmIcon.attr( 'data-value', 'true');
				alarmIcon.attr( 'src', '@(Url.Content("~/fmwebapp/images/Alarm Blue.png"))');
			}
		}

		// In the tag grid enable the tag fields for tags used in alarms
		AlarmEditor.EnableTagColumnsForAlarmTags = function( tagGuid  ) {
			if ( !AlarmEditor.isTagUsedInModule( tagGuid ) ) {
				var tagInfo = jQuery.grep(FMPointEditor.tagList, function (row) { return row.PointTagGuid === tagGuid; });
				if (tagInfo.length > 0) {
					var rowIndex = tagInfo[0].index;
					$( "#Tags_" + rowIndex + "__DeleteTag" ).removeAttr( 'disabled');
					$( "#Tags_" + rowIndex + "__DeleteTag" ).attr( 'src', '@(Url.Content("~/fmwebapp/images/Delete-column.png"))');

					$( "#Tags_" + rowIndex + "__Name" ).removeAttr( 'disabled');
					$( "#Tags_" + rowIndex + "__DataType" ).removeAttr( 'disabled');
					$( "#Tags_" + rowIndex + "__EngineeringUnitsType" ).removeAttr( 'disabled');

					var alarmIcon = $( "#Tags_" + rowIndex + "__Name" ).closest('tr').find( '[name=alarm]' );
					alarmIcon.attr( 'alt', 'No Associated Alarm');
					alarmIcon.attr( 'title', 'No Associated Alarm');
					alarmIcon.attr( 'data-value', 'false');
					alarmIcon.attr( 'src', '@(Url.Content("~/fmwebapp/images/Alarm Disable.png"))');
				}
			}
		}



		if ($('#StandardPointTemplate').val() === 'True'
		|| $('#ModifyEnabled').val() === 'False') {

			// Difficult to find combination that works for IE and Chrome.  For instance .alarmTestName td didn't properly apply CSS with disabled attribute in IE
			$('#alarmTagsTable').find('img[src$="@(Url.Content("~/fmwebapp/images/Add-icon.png"))"]').addClass("disabled").prop("disabled",true).removeAttr('onclick').off('click');
			$('#alarmTagsTable').find('img[src$="@(Url.Content("~/fmwebapp/images/Trash-icon.png"))"]').addClass("disabled").prop("disabled",true).removeAttr('onclick').off('click');
			$('#alarmTagsTable .equationSprocket').addClass("disabled").attr("disabled","disabled").removeAttr('onclick').off('click');
			$('#alarmTagsTable .alarmName').addClass("disabled");
			$('#alarmTagsTable .alarmTestName').addClass("disabled");
		}
		else{
			// Call the initialization after the page loading
			AlarmEditor.initAlarmTestSorting();
		}


	});



</script>

