	$("#TagEditTable").on('click', '.tagColumnValue', function () {

		// Inhibit Edit
		if ($('#StandardPointTemplate').val() == 'True'
		|| $('#ModifyEnabled').val() == 'False') {
			return;
		}

		var row = $(this).closest('tr');

		var rowIndex = row.find('.column-tag-name').attr('id').replace('Tags_', '').replace('__Name', '');


		var dataType = FMPointEditor.tagList[rowIndex].DataType;
		var id = FMPointEditor.tagList[rowIndex].Name;
		var value = $(this).find('input').attr("data-raw-value");
		var unitsType = FMPointEditor.tagList[rowIndex].EngineeringUnitsType;
		var units = FMPointEditor.tagList[rowIndex].Units;
		var decimalPlaces = FMPointEditor.tagList[rowIndex].DecimalPlaces;
		var maximum = $("#Tags_" + rowIndex + "__Maximum").attr( "data-raw-value");
		var minimum = $("#Tags_" + rowIndex + "__Minimum").attr( "data-raw-value");
		var pointValueIdentifier = { IdentityGuid: FMPointEditor.tagList[rowIndex].PointTagGuid, PointValueType: 'Tag', PropertyID: '' };
		var pointTemplateGuid = FMPointEditor.pointGuid;
		var pointName = $("#PEID").val();
		var AllowOverUnderRange = "True";

		var url = $('#urlEditPointTemplateTags').val();
		var token = $('#pointPropertiesForm input[name=__RequestVerificationToken]').val();
		var headers = {};
		headers['__RequestVerificationToken'] = token;

		var requestParms = { isPointTemplate: true, pointValueIdentifier: pointValueIdentifier, valueTypeString: dataType, id: id, value: value, decimalPlaces: decimalPlaces, unitType: unitsType, unit: units, maximum: maximum, minimum: minimum, pointTemplateGuid: pointTemplateGuid, pointName: pointName, AllowOverUnderRange: AllowOverUnderRange }

		FMErrorAndExceptionHandling.CloseNotifications();

		// redefine the function that will be executed when applying changes to tag values
		HandlePointTagEditorNewValueUpdate = function ()
		{
			// get the new value
			var newVal = $("#PointTagNewValueInputId").val();
			var newRawVal = $("#PointTagNewRawValueInputId").val();
			$('#Tags_' + rowIndex + '__Value').val(newVal);
			$('#Tags_' + rowIndex + '__Value').attr('title', newVal);
			$('#Tags_' + rowIndex + '__Value').attr('data-raw-value', newRawVal);
			var tagGuid = FMPointEditor.tagList[rowIndex].PointTagGuid;

			// go through the alarms to see if the tag is being used as a limit tag
			$.each( AlarmEditor.GetAlarmEditorModel().Tags, function( index, tag )
			{
				$.each(tag.Alarms, function (index, alarm) {
					$.each(alarm.AlarmTests, function (index, alarmTest) {
						if ( alarmTest.LimitTagGuid == tagGuid )
						{
							$("#limitValueInputId_" + alarmTest.AlarmTestGuid).text(newVal);
							$("#limitValueInputId_" + alarmTest.AlarmTestGuid).attr('title', newVal);
						}
					});
				});
			} );
		}

		// create the backdrop and wait for next modal to be triggered
		var modalManager = $('body').modalmanager('loading');

		$.ajax({
			type: 'POST',
			cache: false,
			headers: headers,
			url: url,
			data: requestParms,
			success: function (response) {
				FMErrorAndExceptionHandling.HandleMessages(response, function (data, inError) {
					if (!inError || (data != null)) {
						$('#PointTemplateTagEditValueScreenBody').html(response.Data);
						$('#PointTemplateTagEditValueScreen').modal('show');
					}
					else {
						$('body').modalmanager('loading'); // remove the loading background
					}
				});
			},
			error: function (xhr, textStatus, error) {
				FMErrorAndExceptionHandling.ShowException(xhr, textStatus, error, function () {
					$('body').modalmanager('loading'); // remove the loading background
				});
			}
		});
	});

	$("#TagEditTable").on('click', '.tagColumnID span', function () {
		var row = $(this).closest('tr');
		var pointTagGuid = row.find('.tagColumnPointTagGuid').text();
		var pointTagName = row.find('.tagColumnID input').val();

		onPointValueConfigurationEdit('true', 'false', pointTagGuid, pointTagName);
	} );

	// add a tag
	$("#AddTagButtonId").on('click', function () {
		var newGuid = FMPointEditor.newGuid();
		var newName = 'New Tag';
		var dataType = 'System.Double';
		var inputOutputType = '1'; // Manual
		var unitsType = 'FmuNodim'; // Dimensionless
		var units = '255'; // No Dimensions
		var decimalPlaces = 2;
		var maximum = 1000000.00;
		var minimum = 0;
		var applyPointDecimalPlaces = false;
		var applyPointUnits = false;
		var applyPointMaximum = false;
		var applyPointMinimum = false;

		FMPointEditor.addTag(newGuid, newName, dataType, inputOutputType, unitsType, units, decimalPlaces, '', maximum, minimum, applyPointDecimalPlaces, applyPointUnits, applyPointMaximum, applyPointMinimum);

		FMPointEditor.valuesChanged = true;
	});

	// delete tags
	$("#TagEditTable").on('click', '.deleteImg', function () {
		var control = $(this);
		FMLayout.ConfirmYesNo($('#confirm-delete-tag-dialog'),
			'Delete Tag',
			function () {

				var rowNum = parseInt(control.attr('id').replace('Tags_', '').replace('__Name', ''));
				control.closest('tr').remove();
				FMPointEditor.tagList.splice(rowNum, 1);

				// reset the row numbers
				rowNum = 0;
				$('#TagEditTable tr .column-tag-name').each(function (index) {
					var rowId = parseInt($(this).attr('id').replace('Tags_', '').replace('__Name', ''));
					if (rowNum == rowId) {
						rowNum++;
						return;
					}

					var row = $(this).closest('tr');
					row.find("[id]").each(function (index) {
						var id = $(this).attr('id');
						$(this).attr('id', id.replace(rowId, rowNum));
					});
					row.find("[name]").each(function (index) {
						var name = $(this).attr('name');
						$(this).attr('name', name.replace(rowId, rowNum));
					});

					FMPointEditor.tagList[rowNum].index = rowNum;
					rowNum++;
				});

				FMPointEditor.valuesChanged = true;
			});
	});


</script>
