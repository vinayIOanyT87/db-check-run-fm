@using FMBusinessObjects.DataObjects
@using FuelsManager.Areas.Controllers
@model FuelsManager.Areas.Config.Models.ConfigurationSettingsModel
@{
    ViewBag.Title = "ConfigurationSettingsIndex";
    Layout = "~/Areas/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">
    window.onload = function (e) {
        window.parent.CurrentHelpKey = "MenuBar/FMMenuBar.aspx?target=../Config/ConfigurationSettings/ConfigurationSettingsIndex";
    }
</script>
@using (Html.BeginForm("ConfigurationSettingsIndex"))
{
    @Html.AntiForgeryToken()

    var editText = FMBaseController.TranslateText("Edit");
    var deleteText = FMBaseController.TranslateText("Delete");
    var settingKeyText = FMBaseController.TranslateText("Setting Key");
    var settingValueText = FMBaseController.TranslateText("Setting Value");

    var settingCount = Model.Settings.Count;
    var displayCount = Math.Min(settingCount, 500);

    <div>
        <div class="container-fluid">
            <div class="row headline" style="padding-bottom:10px">@FMBaseController.TranslateText("Configuration Settings")</div>

            <div class="row formfieldtitle">@FMBaseController.TranslateText("Find Text")</div>

            <div class="row">
                @Html.TextBoxFor(m => m.FindText, new { autofocus = "autofocus", @class = "formfield minWidth300", alt = "Find text" })
                <input style="left: 10px;" type="submit" onclick="this.disabled=true; this.form.submit(); return true;" value='@FMBaseController.TranslateText("Find")' class="formfieldtitle pushButton maxWidth100" />
            </div>

            <div class="row" style="padding-top: 10px;">
                <section class="FMGridSection">
                    <div class="FMGridContainer">
                        <table>
                            <thead>
										 <tr>
										 	<th>
										 		@editText<div>@editText</div>
										 </th>
										 <th>
										 	@settingKeyText<div>@settingKeyText</div>
										 </th>
										 <th>
										 	@settingValueText<div>@settingValueText</div>
										 </th>
										 <th>
										 	@deleteText<div>@deleteText</div>
										 </th>
										 </tr>
                            </thead>
                            <tbody>
                                @for (var index = 0; index < settingCount; ++index)
                                {
                                    var setting = Model.Settings.Item(index);

                                    var editThisItem = FMBaseController.TranslateText("Edit key " + setting.SettingKey);

												<tr>
												<td style="width: 36px; text-align: center">
													<a class="editLinkClass" title="@editThisItem" href='@Url.Action( "ConfigurationSettingsDetail", "ConfigurationSettings", new { id = @setting.ConfigurationSettingGuid} )'>@editText</a>
												</td>

												<td>@setting.SettingKey</td>
												<td>@(string.Compare(@setting.KeyType, ConfigurationSettingDOClass.Key_Type_Password, StringComparison.CurrentCultureIgnoreCase) == 0 ? "********" : @setting.SettingValue)</td>
												@if (Model.DeleteEnabled)
												{
												<td style="width: 36px; vertical-align: top; text-align: center">
													@Html.ActionLink(@deleteText, "Delete", new { id = @setting.ConfigurationSettingGuid }, new { onclick = "if (disabled) return; return confirm('Are you sure you wish to delete this item?');", @class = "deleteLinkClass" })
												</td>
												}
												else
												{
												<td style="width: 36px; vertical-align: top; text-align: center">
												<img title="Delete not supported" src="~/FMWebApp/Images/delete_un.gif" alt="Delete setting key" />
												</td>
												}
												</tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
                <table class="FMGridFoot" style="width:100%; max-height: 35px">
                    <tfoot>
                        @if (displayCount < settingCount)
                        {
                            <tr><th>@string.Format(FMBaseController.TranslateText("Limiting display to {0} of {1} total records.  Use filters to reduce record count."), displayCount, settingCount)</th></tr>
                        }
                        else if (displayCount > 0)
                        {
                            <tr>
                                <th>
                                    @string.Format(FMBaseController.TranslateText("Showing {0} records."), settingCount)
                                </th>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td class="formfieldtitle" style="padding-top: 5px;">
                                    @FMBaseController.TranslateText("No records found.")
                                </td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}