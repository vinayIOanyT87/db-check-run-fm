                    @Html.LabelFor(m => m.FailedTransaction.FuelingVehiclePlate, FMBaseController.TranslateText("Fueling Vehicle Plate") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.FuelingVehiclePlate, new { maxlength = "20" })
                </div>
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.DriverMeanID, FMBaseController.TranslateText("Driver Mean ID") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.DriverMeanID, new { maxlength = "20" })
