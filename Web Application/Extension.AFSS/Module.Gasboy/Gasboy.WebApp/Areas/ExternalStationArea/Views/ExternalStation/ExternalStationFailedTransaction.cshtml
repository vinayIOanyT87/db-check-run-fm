@using FuelsManager.Areas.Controllers
@using FuelsManager.Afss.Module.Gasboy.BusinessObjects.DataObjects

@model FuelsManager.Afss.Module.Gasboy.WebApp.Areas.ExternalStationArea.Models.ExternalStationFailedTransactionModel
@{
    ViewBag.Title = "ExternalStationFailedTransaction";
    Layout = "~/Areas/Views/Shared/_Layout.cshtml";
}
<style>
    .row {
        max-width: 1100px;
    }

    form input[type=text] {
        width: 200px;
    }
</style>
<script>
    $(document).ready(function() {
        $('#externalStationFailedTransactionErrorTable')
            .DataTable(
            {
                // We do not allow searching through the results via the datatable search control
                "searching": false,
                // Show First, Previous, Next, and Last buttons for paging
                "pagingType": "full",
                // Embed a div in the datatables controls so we can color the bottom of the grid 
                // like a footer
                "dom": 'lrt<"#DataTablesFooter"ip>',
                // Apply no initial sort
                "order": [],
                // Tell datatables that we don't care about highlighting the columns that have been sorted. According to the documentation, this improves performance.
                "orderClasses": false
            });
    });  
</script>
<div>
    <div class="container-fluid">
        <div class="row headline" style="padding-bottom:10px">@FMBaseController.TranslateText("External Fuel Service Station Failed Transaction")</div>

        @using (Html.BeginForm("ExternalStationFailedTransaction", "ExternalStation", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.FailedTransaction.IdentityGuid)
            @Html.HiddenFor(m => m.FailedTransaction.ExternalStationGuid)
            @Html.HiddenFor(m => m.FailedTransaction.ExternalStationID)
            @Html.HiddenFor(m => m.FailedTransaction.ID)
            @Html.HiddenFor(m => m.FailedTransaction.SiteGuid)

            if (ViewBag.SaveTransactionErrors != null)
            {
                // Display any errors encountered when attempting to reprocess the failed transaction
                <script>
                    setTimeout(function () {
                        alert('@ViewBag.SaveTransactionErrors');
                    }, 100);
                </script>
            }
    
            <div class="row">
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.ExternalStationID, FMBaseController.TranslateText("External Station") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.ExternalStationID, new { disabled = "disabled", maxlength = "50" })
                </div>
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.ID, FMBaseController.TranslateText("External Transaction ID") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.ID, new { disabled = "disabled", maxlength = "100" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.FleetID, FMBaseController.TranslateText("Fleet ID") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.FleetID, new { maxlength = "20" })
                </div>
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.FleetName, FMBaseController.TranslateText("Fleet Name") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.FleetName, new { maxlength = "100" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.FleetCode, FMBaseController.TranslateText("Fleet Code") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.FleetCode, new { maxlength = "10" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.ProductName, FMBaseController.TranslateText("Product Name") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.ProductName, new { maxlength = "30" })
                </div>
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.ProductCode, FMBaseController.TranslateText("Product Code") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.ProductCode, new { maxlength = "15" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    @Html.LabelFor(m => m.FailedTransaction.MeanID, FMBaseController.TranslateText("Mean ID") + ":", new { @class = "formfieldtitle" })
                </div>
                <div class="col-md-4 formfield">
                    @Html.TextBoxFor(m => m.FailedTransaction.MeanID, new { maxlength = "20" })
                </div>
                <div class="col-md-2">
