@using FMBusinessObjects.DataObjects
@using FuelsManager.Afss.Module.Gasboy.BusinessObjects.DataObjects
@using FuelsManager.Afss.BusinessObjects.DataObjects
@model GasboyStationProductMapping

<tr>
    @{ var identifier = Guid.NewGuid(); }
    @Html.Hidden("Index", identifier, new { Name = "GasboyStation.ProductMappings.Index" })
    @Html.HiddenFor(m => m.IdentityGuid, new { Name = "GasboyStation.ProductMappings[" + identifier + "].IdentityGuid" })
    @Html.HiddenFor(m => m.ExternalStationGuid, new { Name = "GasboyStation.ProductMappings[" + identifier + "].ExternalStationGuid" })
    <td style="width: 36px; vertical-align: top; text-align: center">
        <a class="deleteLinkClass" title="@ViewBag.deleteText">@ViewBag.deleteText</a>
    </td>
    <td>
        @Html.TextBoxFor(m => m.ID, new { Name = "GasboyStation.ProductMappings[" + identifier + "].ID", maxlength = "50", style = "width: 200px;" })
    </td>
    <td>
        @Html.DropDownListFor(m => m.FuelsManagerProductMasterRecordGuid, new SelectList(ViewBag.products as List<ProductClass>, "MasterRecordGuid", "ID"), string.Empty, new { Name = "GasboyStation.ProductMappings[" + identifier + "].FuelsManagerProductMasterRecordGuid", style = "width: 200px;" })
    </td>
</tr>
