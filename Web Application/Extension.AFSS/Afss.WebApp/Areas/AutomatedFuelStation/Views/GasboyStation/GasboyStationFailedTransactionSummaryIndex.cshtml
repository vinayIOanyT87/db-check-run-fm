@using FuelsManager.Areas.Controllers
@using FuelsManager.Afss.Module.Gasboy.BusinessObjects.DataObjects

@model FuelsManager.Afss.WebApp.Areas.AutomatedFuelStation.Models.GasboyStationFailedTransactionSummaryModel
@{
	ViewBag.Title = "GasboyStationFailedTransactionSummaryIndex";
}

<style>
	.centeredTableData {
		text-align: center;
		vertical-align: middle;
	}
</style>
<script>
	FMLayout.dateFormat = '@Html.ConvertDateFormat(Model.ShortDatePattern)';
	FMLayout.calendarLocation = '@Url.Content("~/DispatchWebApp/images")';

	$(document).ready(function () {
		$('#gasboyStationFailedTransactionSummaryTable')
			.DataTable(
			{
				// We do not allow searching through the results via the datatable search control
				"searching": false,
				// Show First, Previous, Next, and Last buttons for paging
				"pagingType": "full",
				// Embed a div in the datatables controls so we can color the bottom of the grid
				// like a footer
				"dom": 'lrt<"#DataTablesFooter"ip>',
				// Apply no initial sort
				"order": [],
				// Save the sort order so that if users navigate away from the page and return their sort is retained
				"stateSave": true,
				// Tell datatables that we don't care about highlighting the columns that have been sorted. According to the documentation, this improves performance.
				"orderClasses": false,
				"columnDefs": [
					// Disallow sorting of the edit / delete columns
					{ "targets": [0, 1], "orderable": false },
					// in order to support our various date formats, we have a hidden column with the date in a parseable format that the sort is done on when the user
					// sorts on the Receive Date
					{ "targets": 4, "orderData": 5 },
					{ "targets": 5, "visible": false }
				]
			});
	});
</script>
<div>
	<div class="container-fluid">
		<div class="row headline" style="padding-bottom:10px">@FMBaseController.TranslateText("Gasboy Fuel Service Station Failed Transactions")</div>

		@using (Html.BeginForm("GasboyStationFailedTransactionSummaryIndex", "GasboyStation", FormMethod.Post))
		{
			@Html.AntiForgeryToken()
			@Html.HiddenFor(m => m.ShortDatePattern)
			@Html.HiddenFor(m => m.TimePattern)

			if (ViewBag.SaveTransactionResults != null)
			{
				// Display the result during transaction reprocessing
		<script>
					setTimeout(function () {
						alert('@ViewBag.SaveTransactionResults');
					}, 100);
		</script>
			}

			var editText = FMBaseController.TranslateText("Edit");
			var deleteText = FMBaseController.TranslateText("Delete");
			var externalStationIDText = FMBaseController.TranslateText("Gasboy Station");
			var externalTransactionIDText = FMBaseController.TranslateText("Transaction ID");
			var receiveDateText = FMBaseController.TranslateText("Receive Date");

			<div class="row">
				<div class="col-md-2">
					<label class="formfieldtitle">
						@FMBaseController.TranslateText("Gasboy Station")
					</label>
					<div>
						@Html.DropDownListFor(m => m.SelectedExternalStationGuid, new SelectList(Model.ExternalStations as List<GasboyStation>, "IdentityGuid", "ID"), FMBaseController.TranslateText("{All}"), new { @class = "formfield" })
					</div>
				</div>
				<div class="col-md-3">
					<label class="formfieldtitle">
						@FMBaseController.TranslateText("Gasboy Transaction ID")
					</label>
					<div>
						@Html.TextBoxFor(m => m.TransactionID, new { style = "width:150px;", maxlength = "50", @class = "formfield" })
					</div>
				</div>
				<div class="col-md-7">
					<input type="submit" name="submitButton" value='@FMBaseController.TranslateText("Refresh")' class="formfieldtitle pushButton maxWidth100" style="margin-top:21px; margin-bottom: 5px" maxlength="50" />
				</div>
			</div>
			<div class="row">
				<div class="col-md-12">
					<label class="formfieldtitle">
						@FMBaseController.TranslateText("Date Range")
					</label>
					<div class="formfieldtitle">
						From:
						@Html.TextBoxFor(m => m.BeginDate, new { @class = "formfield minWidth100 datepicker" })
						@Html.TextBoxFor(m => m.BeginTime, new { @class = "formfield minWidth100" })
						To:
						@Html.TextBoxFor(m => m.EndDate, new { @class = "formfield minWidth100 datepicker" })
						@Html.TextBoxFor(m => m.EndTime, new { @class = "formfield minWidth100" })
					</div>
				</div>
			</div>
			<div class="row" style="margin-top: 5px;">
				<section class="FMGridSection">
					<div class="FMGridContainer">
						<table id="gasboyStationFailedTransactionSummaryTable" class="hover stripe row-border cell-border" style="width:100%">
							<thead>
								<tr>
									<th>
										@editText
									</th>
									<th>
										@deleteText
									</th>
									<th>
										@externalStationIDText
									</th>
									<th>
										@externalTransactionIDText
									</th>
									<th>
										@receiveDateText
									</th>
									<th style="display:none">
										@receiveDateText
									</th>
								</tr>
							</thead>
							<tbody>
								@foreach (GasboyStationTransaction failedTransaction in @Model.FailedTransactions)
								{
									var deleteImage = @Model.IsEditable ? Url.Content("~/FMWebApp/Images/delete.gif") : Url.Content("~/FMWebApp/Images/delete_un.gif");

									<tr>
										<td style="width: 36px;" class="centeredTableData">
											<a class="editLinkClass" title="@editText" href='@Url.Action("GasboyStationFailedTransaction", "GasboyStation", new { externalStationFailedTransactionGuid = @failedTransaction.IdentityGuid })'>@editText</a>
										</td>
										<td style="width: 36px;" class="centeredTableData">
											<button name="deleteButton" value="@failedTransaction.IdentityGuid" disabled="@(!Model.IsEditable)" style="background: transparent; color: transparent; height: 22px;" onclick=" if (disabled) return; return confirm('Are you sure you want to delete?'); ">
												<span>
													<img src="@deleteImage" style="margin-left: -10px; margin-right: -10px; margin-top: -3px; margin-bottom: -3px; padding-bottom: 9px" alt="Delete" />
												</span>
											</button>
										</td>
										<td>@failedTransaction.ExternalStationID</td>
										<td>@failedTransaction.ID</td>
										<td>@failedTransaction.CreatedDate.ToString(Model.ShortDatePattern + " " + Model.TimePattern)</td>
										<td style="display:none">@failedTransaction.CreatedDate.ToString("MM-dd-yyyy HH:mm:ss")</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</section>
			</div>
		}
	</div>
</div>
