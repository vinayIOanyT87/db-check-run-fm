  <cpumoduleconfiguration>
    <Name> CPU Module </Name>
    <MaxAllowed>1</MaxAllowed>
    <Deletable>nodelete</Deletable>
    <moduleconfiguration>
      <Name>Module Command</Name>
      <Datatype>string</Datatype>
      <VariableName>ModCmd</VariableName>
