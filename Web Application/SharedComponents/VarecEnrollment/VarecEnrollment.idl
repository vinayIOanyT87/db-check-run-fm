#include <olectl.h>
#include <idispids.h>

[ uuid(328129DD-D0E4-4F09-A782-BF05EBE356B9), version(1.0),
  helpfile("VarecEnrollment.hlp"),
  helpstring("VarecEnrollment ActiveX Control module"),
  control ]
library VarecEnrollmentLib
{
	importlib(STDOLE_TLB);

	//  Primary dispatch interface for CVarecEnrollmentCtrl

	[ uuid(AF61B8BF-B180-49F8-AD3E-957D666C11E5),
	  helpstring("Dispatch interface for VarecEnrollment Control")]
	dispinterface _DVarecEnrollment
	{
		properties:
			[id(2), helpstring("property TWIC_ErrorMessage")] BSTR TWIC_ErrorMessage;
			[id(3), helpstring("property TWIC_PersonIdentifier")] BSTR TWIC_PersonIdentifier;
			[id(4), helpstring("property TWIC_ExpirationDate")] BSTR TWIC_ExpirationDate;
		methods:
			[id(1), helpstring("method GetTWICData")] SHORT GetTWICData(void);
	};

	//  Event dispatch interface for CVarecEnrollmentCtrl

	[ uuid(EDE76D49-783F-4AAD-953D-F4CFCF3C6F76),
	  helpstring("Event interface for VarecEnrollment Control") ]
	dispinterface _DVarecEnrollmentEvents
	{
		properties:
			//  Event interface has no properties

		methods:
	};

	//  Class information for CVarecEnrollmentCtrl

	[ uuid(C6AD5C3A-DB26-450A-82C7-890D2D23A8D9),
	  helpstring("VarecEnrollment Control"), control ]
	coclass VarecEnrollment
	{
		[default] dispinterface _DVarecEnrollment;
		[default, source] dispinterface _DVarecEnrollmentEvents;
	};

};
