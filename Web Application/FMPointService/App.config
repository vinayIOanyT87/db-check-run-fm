<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings file="FMPointService.config">
    <!-- Recommended: For better performance use NetNamedPipeBidning in place of NetTcpBindingIIS when this service and FMBusinessService are hosted on same machine.-->
    <!--
    <add key="bindingName" value="FMPointServiceNetNamedPipeBinding" />
    <add key="endPointAddress" value="net.pipe://localhost/FMBusinessServices" />
    -->
    <add key="bindingName" value="FMBusinessServicesBinding" />
    <add key="endPointAddress" value="net.tcp://localhost:808/FMBusinessServices" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="BusinessServicesAccessMethod" value="WCF" />
    <add key="OpcUaOperationTimeout" value="120000" />
    <add key="OpcUaDefaultSessionTimeout" value="10000" />
    <add key="OpcUaDefaultSessionKeepAliveInterval" value="5000" />
    <add key="OpcUaDefaultSessionKeepAliveTimeout" value="20000" />
    <add key="OpcUaSessionReconnectDelay" value="60000" />
    <add key="OpcUaDefaultSubscriptionKeepAliveCount" value="10" />
    <add key="OpcUaDefaultSubscriptionLifeTimeCount" value="11000" />
    <add key="OpcUaAutoAcceptUntrustedCertificates" value="true" />
    <add key="OpcUaTraceMasks" value="1" />
	 <add key="OpcUaDeleteOnLoad" value="true" />
	 <add key="OpcUaCertificateLifeTime" value ="12"/>
	 <add key="PingIntervalInSeconds" value="30" />
	 <add key="MovementResolutionInSeconds" value="1" />
	 <add key="UpdateInactiveMovementsEveryXIterations" value="10" />
    <add key="PercentCpuUtilizationThrottleLevel" value="100" />
    <add key="PercentMemoryUtilizationThrottleLevel" value="100" />
    <add key="MaxPointsToProcess" value="5000" />
    <add key="PointProcessingThreads" value="8" />
	 <add key="ForceGarbageCollection" value="false"/>
    <add key="EnableArchivingData" value="true" />
    <add key="ArchiveQueueMaximum" value="10000000" />
	 <add key="MaxArchiveRecordsPerCall" value="16" />
    <add key="UseOpcUaClientPolling" value="False" />
    <add key="DisplayWindows" value="true" />
    <add key="UsePointLogicEngine" value="true" />
    <add key="RateModuleLogDataTrueorFalse" value="False" />
    <add key="RateModuleDirectoryForFiles" value="C:\ratemodulelogs/" />
    <add key="RateModuleDaystoRetainRecords" value="1" />
    <add key="TimerServiceMaxQueueCount" value="5000" />
	  <!-- FOR FDS
	 <add key="FmvUsGal_alias" value="GL"/>
	 <add key="FmvImpGal_alias" value="GAL"/>
	 <add key="FmvLitre_alias" value="L"/>
	 <add key="FmtDegC_alias" value="°C"/>
	 <add key="FmdKgM3_alias" value="kg/m³"/>
	 <add key="FmpKPa_alias" value="kPa"/>
	 <add key="FmpPsi_alias" value="PSI"/>
	 <add key="FmtDegF_alias" value="°F"/>
	 <add key="FmdDegApi_alias" value="API"/>
	 <add key="FmmLb_alias" value="LB"/>
	 <add key="FmvBlOil_alias" value="BB6"/>
	 <add key="FmvBlLiq_alias" value="BBL"/>
	 <add key="FmvFeet3_alias" value="CF"/>
	 <add key="FmvMeter3_alias" value="CZ"/>
	 <add key="FmmKg_alias" value="KG"/>
	 <add key="FmvMsFt3_alias" value="MC"/>
	 <add key="FmmSTon_alias" value="TN"/>
	 <add key="FmduPpm_alias" value="PPM"/>
	 <add key="FmlInch_alias" value="IN"/>
	 <add key="FmlFeet_alias" value="FT"/>
	 <add key="FmlFtIn8Th_alias" value="8th/IN"/>
	 <add key="FmlFtIn16Th_alias" value="16th/IN"/>
	 <add key="FmvfGpm_alias" value="GPM"/>
    -->

	  <!--<add key="actualTonnes_alias" value="7M"/>-->
	  <!--<add key="Cylinder_alias" value="CY"/>-->
	  <!--<add key="FmvUsGal_alias" value="DR"/>-->
	  <!--<add key="FmvUsGal_alias" value="EA"/>-->
	  <!--<add key="FmvUsGal_alias" value="LI"/>-->
	  <!--<add key="FmvMeter3_alias" value="M3"/> Already mapped to CZ-->
	  <!--<add key="FmvUsGal_alias" value="UG6"/>-->
	  <!--<add key="FmvUsGal_alias" value="Qt"/>-->
	  <!--<add key="FmvUsGal_alias" value="Mg/GL"/>-->
	  <!--<add key="FmvUsGal_alias" value="Mg/L"/>-->

  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="FMBusinessServicesBinding" maxReceivedMessageSize="2147483647" maxConnections="100" listenBacklog="100">
          <!--
          <security mode="None">
            <message clientCredentialType="None" />
            <transport clientCredentialType="None" />
          </security>
          -->
          <security mode="Transport">
            <transport clientCredentialType="Windows" />
          </security>
        </binding>
        <binding name="FMPointServiceNetTcpBinding" maxReceivedMessageSize="2147483647" maxBufferPoolSize="2147483647">
          <!--
          <security mode="None">
            <message clientCredentialType="None" />
            <transport clientCredentialType="None" />
          </security>
          -->
          <security mode="Transport">
            <transport clientCredentialType="Windows" />
          </security>
        </binding>
      </netTcpBinding>
      <netNamedPipeBinding>
        <binding name="FMPointServiceNetNamedPipeBinding" maxReceivedMessageSize="2147483647">
          <security mode="Transport">
            <transport protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netNamedPipeBinding>
    </bindings>
    <services>
      <service name="FMPointService.WcfPointService.PointService" behaviorConfiguration="FMPointService.PointServiceBehavior">
        <endpoint address="IPointService.svc" binding="netTcpBinding" bindingConfiguration="FMPointServiceNetTcpBinding" contract="FMPointCommon.IPointService">
          <identity>
            <dns value="localhost" />
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexTcpBinding" bindingConfiguration="" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8524/FMPointService/" />
          </baseAddresses>
        </host>
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="FMPointService.PointServiceBehavior">
          <serviceMetadata httpGetEnabled="false" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceCredentials>
            <!--<windowsAuthentication/>-->
            <!--Uncomment when using Message security and set the certificate thumbprint-->
            <!--<serviceCertificate storeLocation="LocalMachine" findValue="d75d577f3ff0aaa948b16861b64d621577955def" x509FindType="FindByThumbprint" storeName="My" />-->
          </serviceCredentials>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <protocolMapping>
      <!--<add scheme="http" binding="wsHttpBinding" bindingConfiguration="WsHttpBinding" />-->
      <add scheme="net.pipe" binding="netNamedPipeBinding" bindingConfiguration="FMPointServiceNetNamedPipeBindingIIS" />
      <add scheme="net.tcp" binding="netTcpBinding" bindingConfiguration="FMBusinessServicesBinding" />
      <add binding="wsHttpBinding" bindingConfiguration="WsHttpsBinding" scheme="http" />
    </protocolMapping>
  </system.serviceModel>
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel" switchValue="Error" propagateActivity="true">
        <listeners>
          <add name="traceListener" type="System.Diagnostics.XmlWriterTraceListener" initializeData="c:\logs\FMPointService.svclog" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Interop.FMUtil" publicKeyToken="e6190a5bf6c69d61" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.1.0.0" newVersion="9.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Crypt" publicKeyToken="e6190a5bf6c69d61" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-11.0.0.0" newVersion="11.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.Edm" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.6.3.0" newVersion="5.6.3.0" />
