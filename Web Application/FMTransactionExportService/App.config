<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>

    <!-- Defines the type of schedule used to determine when to perform exports ('Interval' or 'FixedTime') -->
    <add key="ExportSchedule" value="Interval" />

    <!-- The frequency, in seconds, to perform an export when using the Interval export schedule -->
    <add key="PollingIntervalSeconds" value="3600" />

    <!-- The fixed time of day, local to the server, at which to perform an export when using the FixedTime export schedule -->
    <!-- Values are in 24h format (0:00 - 23:59) -->
    <add key="ExportScheduleFixedTimeLocal" value="3:00"/>

    <!-- An optional filter on the status of transactions that are exported (e.g. 'Completed,Posted') -->
    <!-- This can be a single status or a comma separated list -->
    <!-- If blank or not set, all transactions will be exported when added/edited -->
    <add key="ExportableTransactionStatuses" value="Completed"/>

    <!-- Optionally set transaction status to Posted after being exported to prevent any modification (true/false), defaults to false -->
    <!-- WARNING - Using this feature with an 'ExportableTransactionStatus' value other than 'Completed' and/or 'Posted' could cause unintended side effects -->
    <add key="SetTransactionStatusToPostedAfterExport" value="true"/>

    <!-- Define which columns and in which order they should appear in the export -->
    <!-- Available Columns: BillTo,Carrier,Carrier_Code,CLIN_Index,Closeout_Date,Contract_Index,Deleted,Destination_Reg_ID,Direction,Document_Number,FinalFlag,From_Carrier,From_Manager,From_Owner,From_Product,From_Source,From_UserData,FuelCP,GBL,Gravity,Gross_Inventory,Gross_Volume,Location,Manager,Meter_Start,Meter_Stop,MeterFactor,Net_Inventory,Net_Volume,Notes,Owner,Product_ID,Registration_ID,Request_By_Date,Request_Transaction_ID,ReversalType,Serial_Number,Shipping_Mode_Index,ShipTo,SubType_Code,SubType_Code_2,SubTypeCode_3,Supplier_Index,Temperature,To_Carrier,To_Manager,To_Owner,To_Product,To_Source,To_UserData,Transaction_Alias,Transaction_Date,Transaction_ID,Transaction_Type,UpdatedBy,UpdatedDateUTC,UserData_1,UserData_10,UserData_11,UserData_12,UserData_13,UserData_14,UserData_15,UserData_16,UserData_17,UserData_18,UserData_19,UserData_2,UserData_20,UserData_21,UserData_22,UserData_23,UserData_24,UserData_3,UserData_4,UserData_5,UserData_6,UserData_7,UserData_8,UserData_9,VCF -->
    <!-- To replicate export formats from before this feature was added use: Transaction_Date,Transaction_Type,Transaction_ID,Gross_Volume,Direction,Notes,Temperature,Gravity,Meter_Stop,Meter_Start,Net_Volume,Transaction_Alias,VCF,Product_ID,Manager,Owner,Carrier,SubType_Code,SubType_Code_2,SubTypeCode_3,Closeout_Date,Serial_Number,ShipTo,Destination_Reg_ID,Document_Number,Shipping_Mode_Index,FinalFlag,Request_Transaction_ID,Supplier_Index,GBL,Carrier_Code,Request_By_Date,Contract_Index,CLIN_Index,From_Owner,To_Owner,From_Manager,To_Manager,From_Source,To_Source,From_Carrier,To_Carrier,From_UserData,To_UserData,From_Product,To_Product,Gross_Inventory,Net_Inventory,Location,Registration_ID,UserData_1,UserData_2,UserData_3,UserData_4,UserData_5,UserData_6,UserData_7,UserData_8,UserData_9,UserData_10,UserData_11,UserData_12,UserData_13,UserData_14,UserData_15,UserData_16,UserData_17,UserData_18,UserData_19,UserData_20,UserData_21,UserData_22,UserData_23,UserData_24,Deleted,UpdatedBy,UpdatedDateUTC,MeterFactor,FuelCP -->
    <add key="ExportFileColumns" value="Transaction_Date,Transaction_ID,Deleted,Transaction_Alias,Document_Number,Supplier_Index,Shipping_Mode_Index,Manager,Owner,Carrier_Code,Carrier,Registration_ID,Destination_Reg_ID,BillTo,ShipTo,Product_ID,Temperature,Gravity,VCF,Gross_Volume,Net_Volume,ReversalType,Location,Meter_Start,Meter_Stop,Notes,UpdatedBy,UpdatedDateUTC"/>

    <!-- provide full path to write results to otherwise will go to a system directory -->
    <add key="Export Path" value="C:\BSME\FMTransactionExportService" />
    <add key="Debugging Enabled" value="true" />
    <!--  ToSiteUnits = 1, ToCongfigFileSettings =  2, DontConvert =3 -->
    <add key="ConvertUnitsOption" value="1" />
    <!-- EngineeringUnit e.g. 42="FmvLitre" 46="FmvUsGal" -->
    <add key="DEFAULT_UNITS_VAL_VOL" value="46" />
    <!-- EngineeringUnit e.g. 1="FmtDegC" 2="FmtDegF" -->
    <add key="DEFAULT_UNITS_VAL_TEMP" value="2" />
    <!-- EngineeringUnit e.g. 18="FmdKgM3" 186="FmdLbFt3" -->
    <add key="DEFAULT_UNITS_VAL_DENSITY" value="191" />

    <!-- comma separated list of productName|replacmentName if no match DB value is used-->
    <add key="ProductsMap" value="" />

    <add key="DateFormat" value="MM-dd-yyyy HH:mm:ss" />
    <add key="TimeFormat" value="HH:mm:ss" />

    <!-- comma separated list of LoadingLocationID|ArmNumbers with armnumbers separated by an underscore _ -->
    <!-- e.g  Bay3|1_3_5,Bay5|5_7_9  -->
    <add key="LoadRackIdentification" value="" />

    <!-- comma separated list of LoadingLocationID to add ArmNumber to when filling Location column-->
    <add key="LoadingLocationIDWithArmNumber" value="" />

    <add key="OperatorId_to_Column" value="" />
    <add key="TransLineOperatorId_to_Column" value="" />
    <add key="FST_to_Column" value="" />
    <add key="TimeEnd_to_Column" value="" />
    <add key="LoadID_to_Column" value="" />

    <!-- comma separated list of columnName|defaultValue -->
    <add key="DefaultValuesMap" value="" />

    <!-- comma separated list of Transaction Alias Names to export -->
    <!--<add key="AliasNames" value="Physical Inventory,Regrade,Shipment,Order,Meter Closeout,Weight BOL,End Of Month,Transfer,Supply Order,End Of Day,Receipt,BOL,Adjustment" />-->
    <add key="AliasNames" value="BOL" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <!-- Recommended: For better performance use NetNamedPipeBidning in place of NetTcpBindingIIS when this service and FMBusinessService are hosted on same machine.-->
    <!--
    <add key="bindingName" value="FMBusinessServicesNetNamedPipeBinding" />
    <add key="endPointAddress" value="net.pipe://localhost/FMBusinessServices" />
    -->
    <add key="endPointAddress" value="net.tcp://localhost:808/FMBusinessServices" />
    <add key="bindingName" value="FMBusinessServicesBinding" />
    <add key="BusinessServicesAccessMethod" value="WCF" />
  </appSettings>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="FMBusinessServicesBinding" maxReceivedMessageSize="2147483647" maxConnections="100" listenBacklog="100">
          <!--
         <security mode="None">
            <message clientCredentialType="None" />
            <transport clientCredentialType="None" />
          </security>
          -->
           <security mode="Transport">
            <transport clientCredentialType="Windows" />
          </security>
        </binding>
      </netTcpBinding>
      <netNamedPipeBinding>
        <binding name="FMBusinessServicesNetNamedPipeBinding" maxReceivedMessageSize="2147483647">
          <security mode="Transport">
            <transport protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netNamedPipeBinding>
    </bindings>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>