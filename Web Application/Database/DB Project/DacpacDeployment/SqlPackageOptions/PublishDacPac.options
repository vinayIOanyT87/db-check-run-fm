/Action:Publish
/p:BlockOnPossibleDataLoss=True
/p:DisableAndReenableDdlTriggers=True
/p:DropConstraintsNotInSource=True
/p:DropDmlTriggersNotInSource=True
/p:DropExtendedPropertiesNotInSource=True
/p:DropIndexesNotInSource=True
/p:DropObjectsNotInSource=False
/p:DropRoleMembersNotInSource=False
/p:DropPermissionsNotInSource=False
/p:GenerateSmartDefaults=False
/p:IgnoreFileSize=True
/p:TreatVerificationErrorsAsWarnings=False
/p:BlockWhenDriftDetected=False
/p:IgnoreAnsiNulls=True
/p:IgnoreAuthorizer=True
/p:IgnoreIdentitySeed=True
/p:IgnoreTableOptions=True
/p:IncludeCompositeObjects=True
/p:NoAlterStatementsToChangeClrTypes=True
/p:RegisterDataTierApplication=True
/p:Storage=File