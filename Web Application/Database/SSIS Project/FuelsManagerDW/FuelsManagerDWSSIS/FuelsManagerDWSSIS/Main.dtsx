        <DTS:Executable
          DTS:refId="Package\Log Master End\Set up Process End Email Message"
          DTS:CreationName="Microsoft.ScriptTask"
          DTS:Description="Script Task"
          DTS:DTSID="{3D4A4DAF-8B69-4779-BA3C-C311190AA589}"
          DTS:ExecutableType="Microsoft.ScriptTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Set up Process End Email Message"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <ScriptProject
              Name="ST_3c65fc16b95449c4a3d5b8af79ea3760"
              VSTAMajorVersion="15"
              VSTAMinorVersion="0"
