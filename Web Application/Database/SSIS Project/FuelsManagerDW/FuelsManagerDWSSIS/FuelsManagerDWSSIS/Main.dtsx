      <DTS:Variables />
      <DTS:ObjectData>
        <ExecutePackageTask>
          <UseProjectReference>True</UseProjectReference>
          <PackageName>TransactionExtractionAndLoading.dtsx</PackageName>
          <ParameterAssignment>
            <ParameterName>IsCDCOnlyExtraction</ParameterName>
            <BindedVariableOrParameterName>User::IsCDCOnlyExtraction</BindedVariableOrParameterName>
