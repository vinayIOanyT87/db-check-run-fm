              <DTS:Variables />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{95426AEF-CB14-4F71-9C93-631E4CAD1A8C}"
                  SQLTask:SqlStatementSource="INSERT INTO dbo.tblETLAudit&#xA;(Operation, ParentAuditKey , PkgName , PkgGUID , PkgVersionGUID , PkgVersionMajor , PkgVersionMinor , ExecStartDT , ProcessNote)&#xA;Values  ('FMDataWarehouse', 0 , @PkgName , @PkgGUID , @PkgVersionGUID , @PkgVersionMajor , @PkgVersionMinor , SYSDATETIMEOFFSET() , @ProcessNote)&#xA;&#xA;-- Get the key we just entered.&#xA;SELECT cast(IDENT_CURRENT('dbo.tblETLAudit') AS bigint) AS AuditKey"
                  SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ResultBinding
                    SQLTask:ResultName="0"
                    SQLTask:DtsVariableName="User::BatchAuditKey" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="@PkgName"
                    SQLTask:DtsVariableName="System::PackageName"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="16"
                    SQLTask:ParameterSize="-1" />
                  <SQLTask:ParameterBinding
                    SQLTask:ParameterName="@PkgVersionGUID"
                    SQLTask:DtsVariableName="System::VersionGUID"
                    SQLTask:ParameterDirection="Input"
                    SQLTask:DataType="16"
                    SQLTask:ParameterSize="-1" />
