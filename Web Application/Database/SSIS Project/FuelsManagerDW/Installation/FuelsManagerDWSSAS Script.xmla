                      <QueryDefinition>SELECT [dbo].[vw_FactTransaction].[SKey],[dbo].[vw_FactTransaction].[BillToCompanySKey],[dbo].[vw_FactTransaction].[CarrierCompanySKey],[dbo].[vw_FactTransaction].[ConjoinOwnerSKey],[dbo].[vw_FactTransaction].[ConjoinTransID],[dbo].[vw_FactTransaction].[CreatedDateSKey],[dbo].[vw_FactTransaction].[CreatedTimeSKey],[dbo].[vw_FactTransaction].[Date01DateSKey],[dbo].[vw_FactTransaction].[Date01TimeSKey],[dbo].[vw_FactTransaction].[DeleteFlag],[dbo].[vw_FactTransaction].[DestinationEquipment1SKey],[dbo].[vw_FactTransaction].[InventoryDateSKey],[dbo].[vw_FactTransaction].[Line_ConjoinProductSKey],[dbo].[vw_FactTransaction].[Line_DestinationEquipmentSKey],[dbo].[vw_FactTransaction].[Line_GrossQuantitySI],[dbo].[vw_FactTransaction].[Line_GrossQuantityUSGallon],[dbo].[vw_FactTransaction].[Line_MeterID],[dbo].[vw_FactTransaction].[Line_NetQuantitySI],[dbo].[vw_FactTransaction].[Line_NetQuantityUSGallon],[dbo].[vw_FactTransaction].[Line_NetVolumeIndicator],[dbo].[vw_FactTransaction].[Line_ProductSKey],[dbo].[vw_FactTransaction].[Line_SourceEquipmentSKey],[dbo].[vw_FactTransaction].[Line_Temperature],[dbo].[vw_FactTransaction].[Line_Vcf],[dbo].[vw_FactTransaction].[LineUData_UserData1],[dbo].[vw_FactTransaction].[ManagerCompanySKey],[dbo].[vw_FactTransaction].[Number01],[dbo].[vw_FactTransaction].[OperatorPersonnelSKey],[dbo].[vw_FactTransaction].[OwnerCompanySKey],[dbo].[vw_FactTransaction].[ReasonCodeSKey],[dbo].[vw_FactTransaction].[ReversalType],[dbo].[vw_FactTransaction].[ReversedTransID],[dbo].[vw_FactTransaction].[ShipperCompanySKey],[dbo].[vw_FactTransaction].[ShipToCompanySKey],[dbo].[vw_FactTransaction].[SiteSKey],[dbo].[vw_FactTransaction].[SourceEquipment1SKey],[dbo].[vw_FactTransaction].[SubType],[dbo].[vw_FactTransaction].[SupplierCompanySKey],[dbo].[vw_FactTransaction].[TransactionAliasSKey],[dbo].[vw_FactTransaction].[TransactionAttributesSKey],[dbo].[vw_FactTransaction].[TransactionStatusIndex],[dbo].[vw_FactTransaction].[TransactionTypeSKey],[dbo].[vw_FactTransaction].[TransDateTime],[dbo].[vw_FactTransaction].[TransID],[dbo].[vw_FactTransaction].[TransVersion],[dbo].[vw_FactTransaction].[UData_UserData2],[dbo].[vw_FactTransaction].[UData_UserData23],[dbo].[vw_FactTransaction].[UData_UserData3],[dbo].[vw_FactTransaction].[UData_UserData4SI],[dbo].[vw_FactTransaction].[UData_UserData4USGallon],[dbo].[vw_FactTransaction].[UData_UserData5SI],[dbo].[vw_FactTransaction].[UData_UserData5USGallon],[dbo].[vw_FactTransaction].[UData_UserData6SI],[dbo].[vw_FactTransaction].[UData_UserData6USGallon],[dbo].[vw_FactTransaction].[_IsRecordDeleted],[dbo].[vw_FactTransaction].[_RecordUpdatedDate],[dbo].[vw_FactTransaction].[_RecordUpdatedDateSKey],[dbo].[vw_FactTransaction].[Line_MeterStart],[dbo].[vw_FactTransaction].[Line_MeterStop],[dbo].[vw_FactTransaction].[Line_MeterStartStopTimeDiff],[dbo].[vw_FactTransaction].[Line_MeterStopDateTime],[dbo].[vw_FactTransaction].[TimeIn],[dbo].[vw_FactTransaction].[TimeOut],[dbo].[vw_FactTransaction].[TimeInDateSKey],[dbo].[vw_FactTransaction].[TimeInTimeSKey],[dbo].[vw_FactTransaction].[TimeOutDateSKey],[dbo].[vw_FactTransaction].[TimeOutTimeSKey],[dbo].[vw_FactTransaction].[TransDateSKey],[dbo].[vw_FactTransaction].[TransTimeSKey],[dbo].[vw_FactTransaction].[TransactionKey],[dbo].[vw_FactTransaction].[TransactionLineItemKey],[dbo].[vw_FactTransaction].[TransactionLineItemUserDataKey],[dbo].[vw_FactTransaction].[TransactionUserDataKey],[dbo].[vw_FactTransaction].[TransactionSubLineItemKey],[dbo].[vw_FactTransaction].[Line_LoadArmSKey],[dbo].[vw_FactTransaction].[Line_StationSKey],[dbo].[vw_FactTransaction].[Line_StorageLocationTankSKey]
FROM [dbo].[vw_FactTransaction]
WHERE [dbo].[vw_FactTransaction].[InventoryDateSKey] &gt;= 20390101</QueryDefinition>
                    </Source>
                    <StorageMode>Molap</StorageMode>
                    <ProcessingMode>Regular</ProcessingMode>
                  </Partition>
                </Partitions>
              </MeasureGroup>
            </MeasureGroups>
            <Source>
              <DataSourceViewID>Fuels Manager DW</DataSourceViewID>
            </Source>
            <MdxScripts>
              <MdxScript>
                <ID>MdxScript</ID>
                <Name>MdxScript</Name>
                <Commands>
                  <Command>
                    <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;      
CREATE MEMBER CURRENTCUBE.[Measures].[GrossQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossQuantitySI] * 1000
	ELSE [Measures].[GrossQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Core Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';      
CREATE MEMBER CURRENTCUBE.[Measures].[NetQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[NetQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[NetQuantitySI] * 1000
	ELSE [Measures].[NetQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [NetQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Core Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                         
CREATE MEMBER CURRENTCUBE.[Measures].[AvgIssueGrossQuantityPerTransaction]
 AS [Measures].[AbsIssueGrossQuantity]/[Measures].[TransactionDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[AbsGrossQuantity]
 AS ABS([GrossQuantity]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                 
CREATE MEMBER CURRENTCUBE.[Measures].[AbsIssueGrossQuantity]
 AS ABS([IssueGrossQuantity]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                               
CREATE MEMBER CURRENTCUBE.[Measures].[AvgGrossQuantityPerDay]
 AS [Measures].[GrossQuantity] / [Measures].[InventoryDayDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[AvgIssueGrossQuantityPerDay]
 AS [AbsIssueGrossQuantity] / [Measures].[InventoryDayDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[AvgIssueDaysSupply]
 AS [Measures].[BaselineGrossPhysicalInventory] / [AvgIssueGrossQuantityPerDay], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI], [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';      
CREATE MEMBER CURRENTCUBE.[Measures].[BaselineGrossPhysicalInventory]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossPhysicalInventorySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossPhysicalInventorySI] * 1000
	ELSE [Measures].[GrossPhysicalInventorySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Core Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';    
CREATE MEMBER CURRENTCUBE.[Measures].[BaselineNetPhysicalInventory]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[NetPhysicalInventorySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[NetPhysicalInventorySI] * 1000
	ELSE [Measures].[NetPhysicalInventorySI]
END, 
NON_EMPTY_BEHAVIOR = { [NetPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Core Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                               
CREATE MEMBER CURRENTCUBE.[Measures].[AvgGrossQuantityPerTrans]
 AS [Measures].[GrossQuantity]/[Measures].[TransactionDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                               
CREATE MEMBER CURRENTCUBE.[Measures].[AvgNetQuantityPerDay]
 AS [Measures].[NetQuantity] / Count(Descendants([Transaction Date].[Date Hierarchy].CurrentMember, [Transaction Date].[Date Hierarchy].[Day Number Of Month])), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [NetQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                          
CREATE MEMBER CURRENTCUBE.[Measures].[AvgStationArmTime]
 AS IIF
(
[Measures].[TransactionLineItemDistinctCount]=0,
NULL,
[Measures].[MeterStartStopTimeDifference]/[Measures].[Measures].[TransactionLineItemDistinctCount]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [MeterStartStopTimeDifference] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction Summary';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[AdjustmentGrossQuantitySI]
 AS Aggregate
(
  (
    FILTER
	(
		[Transaction Type].[Transaction Type Code].Members, 
		[Transaction Type].[Transaction Type Code].Member_Value = "T1_PrimaryAdjustment"
		OR [Transaction Type].[Transaction Type Code].Member_Value = "T2_SecondaryAdjustment"
	)
  ),
  [Measures].[GrossQuantitySI]
), 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[AdjustmentGrossQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[AdjustmentGrossQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[AdjustmentGrossQuantitySI] * 1000
	ELSE [Measures].[AdjustmentGrossQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                            
CREATE MEMBER CURRENTCUBE.[Measures].[AvgTimeInTerminal]
 AS IIF
(
[Measures].[FactTransactionSummaryCount]=0,
NULL,
[Measures].[TimeInTerminal]/[Measures].[FactTransactionSummaryCount]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [TimeInTerminal] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction Summary';                            
CREATE MEMBER CURRENTCUBE.[Measures].[AvgTimeInRack]
 AS IIF
(
[Measures].[FactTransactionSummaryCount]=0,
NULL,
[Measures].[TimeInRack]/[Measures].[FactTransactionSummaryCount]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [TimeInRack] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction Summary';                            
CREATE MEMBER CURRENTCUBE.[Measures].[AvgTimeToLeaveRack]
 AS IIF
(
[Measures].[FactTransactionSummaryCount]=0,
NULL,
[Measures].[TimeToLeaveRack]/[Measures].[FactTransactionSummaryCount]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [TimeToLeaveRack] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction Summary';                            
CREATE MEMBER CURRENTCUBE.[Measures].[AvgTimeToRack]
 AS IIF
(
[Measures].[FactTransactionSummaryCount]=0,
NULL,
[Measures].[TimeToRack]/[Measures].[FactTransactionSummaryCount]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [TimeToRack] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction Summary';                                               
CREATE MEMBER CURRENTCUBE.[Measures].[AvgTransactionCountPerInventoryDay]
 AS [Measures].[TransactionDistinctCount]/[Measures].[InventoryDayDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [TransactionDistinctCount] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[DefuelGrossQuantitySI]
 AS Aggregate
(
  (
    FILTER
	(
		[Transaction Type].[Transaction Type Code].Members, 
		[Transaction Type].[Transaction Type Code].Member_Value = "T3_PrimaryDefuel"
		OR [Transaction Type].[Transaction Type Code].Member_Value = "T4_SecondaryDefuel"
	)
  ),
  [Measures].[GrossQuantitySI]
), 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[DefuelGrossQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[DefuelGrossQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[DefuelGrossQuantitySI] * 1000
	ELSE [Measures].[DefuelGrossQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBeginBookInventory]
 AS CASE
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Calendar Year') THEN [Measures].[GrossPrevYearPhysicalInventory]
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Calendar Quarter') THEN [Measures].[GrossPrevQuarterPhysicalInventory]
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Calendar Year Month') THEN [Measures].[GrossPrevMonthPhysicalInventory]
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Full Date') THEN [Measures].[GrossPrevDayPhysicalInventory]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBeginTrueBookInventory]
 AS [GrossTrueBookInventoryToDate] - [GrossBookQuantity], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookQuantitySI]
 AS Aggregate
(
  (
    Except
	(
		[Transaction Type].[Transaction Type Code].[Transaction Type Code], 
		{				
			[Transaction Type].[Transaction Type Code].&amp;[T7_FillStand],
			[Transaction Type].[Transaction Type Code].&amp;[T9_Request],
			[Transaction Type].[Transaction Type Code].&amp;[T10_Unload],
			[Transaction Type].[Transaction Type Code].&amp;[T11_ConsumerTransfer],
			[Transaction Type].[Transaction Type Code].&amp;[T12_InventoryNotAffected],
			[Transaction Type].[Transaction Type Code].&amp;[T14_PhysicalInventory],
			[Transaction Type].[Transaction Type Code].&amp;[T17_Order],
			[Transaction Type].[Transaction Type Code].&amp;[T18_SupplyOrder],
			[Transaction Type].[Transaction Type Code].&amp;[T19_EndOfDay],
			[Transaction Type].[Transaction Type Code].&amp;[T20_EndOfMonth],
			[Transaction Type].[Transaction Type Code].&amp;[T21_AccountPayableInvoice],
			[Transaction Type].[Transaction Type Code].&amp;[T22_AccountReceivableInvoice],
			[Transaction Type].[Transaction Type Code].&amp;[T23_StorageTransfer],
			[Transaction Type].[Transaction Type Code].&amp;[T_Maximum],
			[Transaction Type].[Transaction Type Code].&amp;[TransactionType_None],
			[Transaction Type].[Transaction Type Code].[All].UNKNOWNMEMBER
		}	
	)
  ),
  [Measures].[GrossQuantitySI]
), 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossBookQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossBookQuantitySI] * 1000
	ELSE [Measures].[GrossBookQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookInventoryToDate]
 AS [GrossBeginBookInventory] + [GrossBookQuantity], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookInventoryVariance]
 AS [Measures].[BaselineGrossPhysicalInventory] - [GrossUnadjBookInventory], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookInventoryVariancePercent]
 AS ([GrossBookInventoryVariance]/[Measures].[BaselineGrossPhysicalInventory])*100, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                  
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPhysicalInventoryMonthPercentChange]
 AS IIF
(
	ISEMPTY([Measures].[GrossPrevMonthPhysicalInventory]), 
	NUll,
	Divide(
		([Measures].[BaselineGrossPhysicalInventory] - [Measures].[GrossPrevMonthPhysicalInventory]), 
		[Measures].[GrossPrevMonthPhysicalInventory]
	) * 100
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevDayPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Full Date], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                 
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevMonthPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Calendar Year Month], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevQuarterPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Calendar Quarter], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevYearPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Calendar Year], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                  
CREATE MEMBER CURRENTCUBE.[Measures].[GrossTrueBookInventoryToDateSI]
 AS CASE WHEN ISEMPTY([Measures].[GrossQuantitySI]) THEN NULL
	 	 WHEN [Inventory Date].[Date Hierarchy].[Calendar Year].Hierarchy.CurrentMember.MemberValue = [Inventory Date].[Date Hierarchy].[Calendar Year].&amp;[1900].MemberValue THEN NULL
	 ELSE 
		Aggregate
		(
			(
				Except
				(
					[Transaction Type].[Transaction Type Code].[Transaction Type Code], 
					{				
						[Transaction Type].[Transaction Type Code].&amp;[T7_FillStand],
						[Transaction Type].[Transaction Type Code].&amp;[T9_Request],
						[Transaction Type].[Transaction Type Code].&amp;[T10_Unload],
						[Transaction Type].[Transaction Type Code].&amp;[T11_ConsumerTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T12_InventoryNotAffected],
						[Transaction Type].[Transaction Type Code].&amp;[T14_PhysicalInventory],
						[Transaction Type].[Transaction Type Code].&amp;[T17_Order],
						[Transaction Type].[Transaction Type Code].&amp;[T18_SupplyOrder],
						[Transaction Type].[Transaction Type Code].&amp;[T19_EndOfDay],
						[Transaction Type].[Transaction Type Code].&amp;[T20_EndOfMonth],
						[Transaction Type].[Transaction Type Code].&amp;[T21_AccountPayableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T22_AccountReceivableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T23_StorageTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T_Maximum],
						[Transaction Type].[Transaction Type Code].&amp;[TransactionType_None],
						[Transaction Type].[Transaction Type Code].[All].UNKNOWNMEMBER
					}
				),   
				PeriodsToDate
				(
					[Inventory Date].[Date Hierarchy].[(All)], 
				   [Inventory Date].[Date Hierarchy].CurrentMember
				) 
			),
			[Measures].[GrossQuantitySI]
		)
END, 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[GrossTrueBookInventoryToDate]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossTrueBookInventoryToDateSI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossTrueBookInventoryToDateSI] * 1000
	ELSE [Measures].[GrossTrueBookInventoryToDateSI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[GrossTrueBookInventoryToDateBeforeAdj]
 AS [GrossBeginTrueBookInventory] + [GrossUnadjBookInventory], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossTrueBookInventoryVariance]
 AS [Measures].[BaselineGrossPhysicalInventory] - [GrossTrueBookInventoryToDateBeforeAdj], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossUnadjBookInventory]
 AS [GrossBeginBookInventory] + [GrossUnadjBookQuantity], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[GrossUnadjBookQuantitySI]
 AS CASE WHEN ISEMPTY([Measures].[GrossQuantitySI]) THEN NULL
	 	 WHEN [Inventory Date].[Date Hierarchy].[Calendar Year].Hierarchy.CurrentMember.MemberValue = [Inventory Date].[Date Hierarchy].[Calendar Year].&amp;[1900].MemberValue THEN NULL
	 ELSE 
		Aggregate
		(
			(
				Except
				(
					[Transaction Type].[Transaction Type Code].[Transaction Type Code], 
					{				
						[Transaction Type].[Transaction Type Code].&amp;[T7_FillStand],
						[Transaction Type].[Transaction Type Code].&amp;[T9_Request],
						[Transaction Type].[Transaction Type Code].&amp;[T10_Unload],
						[Transaction Type].[Transaction Type Code].&amp;[T11_ConsumerTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T12_InventoryNotAffected],
						[Transaction Type].[Transaction Type Code].&amp;[T14_PhysicalInventory],
						[Transaction Type].[Transaction Type Code].&amp;[T17_Order],
						[Transaction Type].[Transaction Type Code].&amp;[T18_SupplyOrder],
						[Transaction Type].[Transaction Type Code].&amp;[T19_EndOfDay],
						[Transaction Type].[Transaction Type Code].&amp;[T20_EndOfMonth],
						[Transaction Type].[Transaction Type Code].&amp;[T21_AccountPayableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T22_AccountReceivableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T23_StorageTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T_Maximum],
						[Transaction Type].[Transaction Type Code].&amp;[TransactionType_None],
						[Transaction Type].[Transaction Type Code].[All].UNKNOWNMEMBER,
						[Transaction Type].[Transaction Type Code].&amp;[T1_PrimaryAdjustment],
						[Transaction Type].[Transaction Type Code].&amp;[T2_SecondaryAdjustment]
					}
				)
			),
			[Measures].[GrossQuantitySI]
		)
END, 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[GrossUnadjBookQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossUnadjBookQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossUnadjBookQuantitySI] * 1000
	ELSE [Measures].[GrossUnadjBookQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                     
