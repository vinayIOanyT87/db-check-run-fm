NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                   
