), 
NON_EMPTY_BEHAVIOR = { [NetQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[NetBookInventory]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[NetBookInventorySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[NetBookInventorySI] * 1000
	ELSE [Measures].[NetBookInventorySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [NetQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                   
CREATE MEMBER CURRENTCUBE.[Measures].[NetTrueBookInventoryToDateSI]
 AS Aggregate
(
  (
    Except
	(
		[Transaction Type].[Transaction Type Code].[Transaction Type Code], 
		{				
			[Transaction Type].[Transaction Type Code].&amp;[T7_FillStand],
			[Transaction Type].[Transaction Type Code].&amp;[T9_Request],
			[Transaction Type].[Transaction Type Code].&amp;[T10_Unload],
			[Transaction Type].[Transaction Type Code].&amp;[T11_ConsumerTransfer],
			[Transaction Type].[Transaction Type Code].&amp;[T12_InventoryNotAffected],
			[Transaction Type].[Transaction Type Code].&amp;[T14_PhysicalInventory],
			[Transaction Type].[Transaction Type Code].&amp;[T17_Order],
			[Transaction Type].[Transaction Type Code].&amp;[T18_SupplyOrder],
			[Transaction Type].[Transaction Type Code].&amp;[T19_EndOfDay],
			[Transaction Type].[Transaction Type Code].&amp;[T20_EndOfMonth],
			[Transaction Type].[Transaction Type Code].&amp;[T21_AccountPayableInvoice],
			[Transaction Type].[Transaction Type Code].&amp;[T22_AccountReceivableInvoice],
			[Transaction Type].[Transaction Type Code].&amp;[T23_StorageTransfer],
			[Transaction Type].[Transaction Type Code].&amp;[T_Maximum],
			[Transaction Type].[Transaction Type Code].&amp;[TransactionType_None],
			[Transaction Type].[Transaction Type Code].[All].UNKNOWNMEMBER
		}	
	), 
    PeriodsToDate
    (
       [Inventory Date].[Date Hierarchy].[(All)],
	   [Inventory Date].[Date Hierarchy].CurrentMember
    ) 
  ),
  [Measures].[NetQuantitySI]
), 
NON_EMPTY_BEHAVIOR = { [NetQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[NetTrueBookInventoryToDate]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[NetTrueBookInventoryToDateSI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[NetTrueBookInventoryToDateSI] * 1000
	ELSE [Measures].[NetTrueBookInventoryToDateSI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [NetQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[ReceiptGrossQuantitySI]
 AS Aggregate
(
  (
    FILTER
	(
		[Transaction Type].[Transaction Type Code].Members, 
		[Transaction Type].[Transaction Type Code].Member_Value = "T8_Receipt"
	)
  ),
  [Measures].[GrossQuantitySI]
), 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[ReceiptGrossQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[ReceiptGrossQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[ReceiptGrossQuantitySI] * 1000
	ELSE [Measures].[ReceiptGrossQuantitySI]
END, 
