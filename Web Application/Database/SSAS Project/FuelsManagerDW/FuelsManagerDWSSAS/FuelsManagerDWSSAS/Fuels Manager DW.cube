CREATE MEMBER CURRENTCUBE.[Measures].[GrossBeginBookInventory]
 AS CASE
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Calendar Year') THEN [Measures].[GrossPrevYearPhysicalInventory]
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Calendar Quarter') THEN [Measures].[GrossPrevQuarterPhysicalInventory]
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Calendar Year Month') THEN [Measures].[GrossPrevMonthPhysicalInventory]
	WHEN ([Inventory Date].[Date Hierarchy].CurrentMember.Level.Name = 'Full Date') THEN [Measures].[GrossPrevDayPhysicalInventory]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBeginTrueBookInventory]
 AS [GrossTrueBookInventoryToDate] - [GrossBookQuantity], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookQuantitySI]
 AS Aggregate
(
  (
    Except
	(
		[Transaction Type].[Transaction Type Code].[Transaction Type Code], 
		{				
			[Transaction Type].[Transaction Type Code].&amp;[T7_FillStand],
			[Transaction Type].[Transaction Type Code].&amp;[T9_Request],
			[Transaction Type].[Transaction Type Code].&amp;[T10_Unload],
			[Transaction Type].[Transaction Type Code].&amp;[T11_ConsumerTransfer],
			[Transaction Type].[Transaction Type Code].&amp;[T12_InventoryNotAffected],
			[Transaction Type].[Transaction Type Code].&amp;[T14_PhysicalInventory],
			[Transaction Type].[Transaction Type Code].&amp;[T17_Order],
			[Transaction Type].[Transaction Type Code].&amp;[T18_SupplyOrder],
			[Transaction Type].[Transaction Type Code].&amp;[T19_EndOfDay],
			[Transaction Type].[Transaction Type Code].&amp;[T20_EndOfMonth],
			[Transaction Type].[Transaction Type Code].&amp;[T21_AccountPayableInvoice],
			[Transaction Type].[Transaction Type Code].&amp;[T22_AccountReceivableInvoice],
			[Transaction Type].[Transaction Type Code].&amp;[T23_StorageTransfer],
			[Transaction Type].[Transaction Type Code].&amp;[T_Maximum],
			[Transaction Type].[Transaction Type Code].&amp;[TransactionType_None],
			[Transaction Type].[Transaction Type Code].[All].UNKNOWNMEMBER
		}	
	)
  ),
  [Measures].[GrossQuantitySI]
), 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossBookQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossBookQuantitySI] * 1000
	ELSE [Measures].[GrossBookQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookInventoryToDate]
 AS [GrossBeginBookInventory] + [GrossBookQuantity], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookInventoryVariance]
 AS [Measures].[BaselineGrossPhysicalInventory] - [GrossUnadjBookInventory], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[GrossBookInventoryVariancePercent]
 AS ([GrossBookInventoryVariance]/[Measures].[BaselineGrossPhysicalInventory])*100, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                  
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPhysicalInventoryMonthPercentChange]
 AS IIF
(
	ISEMPTY([Measures].[GrossPrevMonthPhysicalInventory]), 
	NUll,
	Divide(
		([Measures].[BaselineGrossPhysicalInventory] - [Measures].[GrossPrevMonthPhysicalInventory]), 
		[Measures].[GrossPrevMonthPhysicalInventory]
	) * 100
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevDayPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Full Date], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                 
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevMonthPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Calendar Year Month], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevQuarterPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Calendar Quarter], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                
CREATE MEMBER CURRENTCUBE.[Measures].[GrossPrevYearPhysicalInventory]
 AS (
    [Measures].[BaselineGrossPhysicalInventory],
    ParallelPeriod([Inventory Date].[Date Hierarchy].[Calendar Year], 1, [Inventory Date].[Date Hierarchy].CurrentMember)
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Physical Inventory\Additional Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                                  
CREATE MEMBER CURRENTCUBE.[Measures].[GrossTrueBookInventoryToDateSI]
 AS CASE WHEN ISEMPTY([Measures].[GrossQuantitySI]) THEN NULL
	 	 WHEN [Inventory Date].[Date Hierarchy].[Calendar Year].Hierarchy.CurrentMember.MemberValue = [Inventory Date].[Date Hierarchy].[Calendar Year].&amp;[1900].MemberValue THEN NULL
	 ELSE 
		Aggregate
		(
			(
				Except
				(
					[Transaction Type].[Transaction Type Code].[Transaction Type Code], 
					{				
						[Transaction Type].[Transaction Type Code].&amp;[T7_FillStand],
						[Transaction Type].[Transaction Type Code].&amp;[T9_Request],
						[Transaction Type].[Transaction Type Code].&amp;[T10_Unload],
						[Transaction Type].[Transaction Type Code].&amp;[T11_ConsumerTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T12_InventoryNotAffected],
						[Transaction Type].[Transaction Type Code].&amp;[T14_PhysicalInventory],
						[Transaction Type].[Transaction Type Code].&amp;[T17_Order],
						[Transaction Type].[Transaction Type Code].&amp;[T18_SupplyOrder],
						[Transaction Type].[Transaction Type Code].&amp;[T19_EndOfDay],
						[Transaction Type].[Transaction Type Code].&amp;[T20_EndOfMonth],
						[Transaction Type].[Transaction Type Code].&amp;[T21_AccountPayableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T22_AccountReceivableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T23_StorageTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T_Maximum],
						[Transaction Type].[Transaction Type Code].&amp;[TransactionType_None],
						[Transaction Type].[Transaction Type Code].[All].UNKNOWNMEMBER
					}
				),   
				PeriodsToDate
				(
					[Inventory Date].[Date Hierarchy].[(All)], 
				   [Inventory Date].[Date Hierarchy].CurrentMember
				) 
			),
			[Measures].[GrossQuantitySI]
		)
END, 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
CREATE MEMBER CURRENTCUBE.[Measures].[GrossTrueBookInventoryToDate]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossTrueBookInventoryToDateSI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossTrueBookInventoryToDateSI] * 1000
	ELSE [Measures].[GrossTrueBookInventoryToDateSI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'True Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
