  <Kpis>
    <Kpi dwd:design-time-name="ad680483-1a33-4aad-be16-c0f1dace81c2">
      <ID>KPI</ID>
      <Name>PhysicalInventoryMonthPercentChangeKPI</Name>
      <AssociatedMeasureGroupID>Vw Fact Physical Inventory</AssociatedMeasureGroupID>
      <Value>[Measures].[GrossPhysicalInventoryMonthPercentChange]</Value>
      <Goal>0</Goal>
      <Status>Case
    When KpiValue( "PhysicalInventoryMonthPercentChangeKPI" ) &lt; -25.0
        And
        KpiValue( "PhysicalInventoryMonthPercentChangeKPI" ) &gt; -50.0
    Then 0
    When KpiValue( "PhysicalInventoryMonthPercentChangeKPI" ) &gt;= -25.0
         And
        KpiValue( "PhysicalInventoryMonthPercentChangeKPI" ) &lt;= 25.0
    Then 1
    Else -1
End</Status>
      <Trend>Case 
  When KpiValue("PhysicalInventoryVarianceKPI") &gt; 
    ([Inventory Date].[YearMonth Hierarchy].CurrentMember.PrevMember, KpiValue("PhysicalInventoryVarianceKPI")) 
    Then 1 
  When KpiValue("PhysicalInventoryVarianceKPI") &lt; 
    ([Inventory Date].[YearMonth Hierarchy].CurrentMember.PrevMember, KpiValue("PhysicalInventoryVarianceKPI")) 
    Then -1 
  Else 0 
End</Trend>
      <TrendGraphic>Status Arrow - Ascending</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
