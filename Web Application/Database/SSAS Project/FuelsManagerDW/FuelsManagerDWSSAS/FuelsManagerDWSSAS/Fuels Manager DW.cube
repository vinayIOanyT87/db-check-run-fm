  <Source dwd:design-time-name="dfd3b072-104a-41c5-8032-1b0b7bebf467">
    <DataSourceViewID>Fuels Manager DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="6dc09a13-5dc0-4a3a-b4ef-0213379734ef">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T05:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T05:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;      
CREATE MEMBER CURRENTCUBE.[Measures].[GrossQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossQuantitySI] * 1000
	ELSE [Measures].[GrossQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Core Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';      
CREATE MEMBER CURRENTCUBE.[Measures].[NetQuantity]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[NetQuantitySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[NetQuantitySI] * 1000
	ELSE [Measures].[NetQuantitySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [NetQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Core Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                         
CREATE MEMBER CURRENTCUBE.[Measures].[AvgIssueGrossQuantityPerTransaction]
 AS [Measures].[AbsIssueGrossQuantity]/[Measures].[TransactionDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[AbsGrossQuantity]
 AS ABS([GrossQuantity]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                 
CREATE MEMBER CURRENTCUBE.[Measures].[AbsIssueGrossQuantity]
 AS ABS([IssueGrossQuantity]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                               
CREATE MEMBER CURRENTCUBE.[Measures].[AvgGrossQuantityPerDay]
 AS [Measures].[GrossQuantity] / [Measures].[InventoryDayDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[AvgIssueGrossQuantityPerDay]
 AS [AbsIssueGrossQuantity] / [Measures].[InventoryDayDistinctCount], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                      
CREATE MEMBER CURRENTCUBE.[Measures].[AvgIssueDaysSupply]
 AS [Measures].[BaselineGrossPhysicalInventory] / [AvgIssueGrossQuantityPerDay], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI], [GrossPhysicalInventorySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Statistical Measures' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';      
CREATE MEMBER CURRENTCUBE.[Measures].[BaselineGrossPhysicalInventory]
 AS CASE
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Imperial]) THEN [Measures].[GrossPhysicalInventorySI]*264.172037284185
	WHEN ([Unit Of Measure].[Unit Of Measure Code].CURRENTMEMBER = [Metric]) THEN [Measures].[GrossPhysicalInventorySI] * 1000
	ELSE [Measures].[GrossPhysicalInventorySI]
END, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
NON_EMPTY_BEHAVIOR = { [GrossPhysicalInventorySI] }, 
