VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';                                       
CREATE MEMBER CURRENTCUBE.[Measures].[GrossUnadjBookQuantitySI]
 AS CASE WHEN ISEMPTY([Measures].[GrossQuantitySI]) THEN NULL
	 	 WHEN [Inventory Date].[Date Hierarchy].[Calendar Year].Hierarchy.CurrentMember.MemberValue = [Inventory Date].[Date Hierarchy].[Calendar Year].&amp;[1900].MemberValue THEN NULL
	 ELSE 
		Aggregate
		(
			(
				Except
				(
					[Transaction Type].[Transaction Type Code].[Transaction Type Code], 
					{				
						[Transaction Type].[Transaction Type Code].&amp;[T7_FillStand],
						[Transaction Type].[Transaction Type Code].&amp;[T9_Request],
						[Transaction Type].[Transaction Type Code].&amp;[T10_Unload],
						[Transaction Type].[Transaction Type Code].&amp;[T11_ConsumerTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T12_InventoryNotAffected],
						[Transaction Type].[Transaction Type Code].&amp;[T14_PhysicalInventory],
						[Transaction Type].[Transaction Type Code].&amp;[T17_Order],
						[Transaction Type].[Transaction Type Code].&amp;[T18_SupplyOrder],
						[Transaction Type].[Transaction Type Code].&amp;[T19_EndOfDay],
						[Transaction Type].[Transaction Type Code].&amp;[T20_EndOfMonth],
						[Transaction Type].[Transaction Type Code].&amp;[T21_AccountPayableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T22_AccountReceivableInvoice],
						[Transaction Type].[Transaction Type Code].&amp;[T23_StorageTransfer],
						[Transaction Type].[Transaction Type Code].&amp;[T_Maximum],
						[Transaction Type].[Transaction Type Code].&amp;[TransactionType_None],
						[Transaction Type].[Transaction Type Code].[All].UNKNOWNMEMBER,
						[Transaction Type].[Transaction Type Code].&amp;[T1_PrimaryAdjustment],
						[Transaction Type].[Transaction Type Code].&amp;[T2_SecondaryAdjustment]
					}
				)
			),
			[Measures].[GrossQuantitySI]
		)
END, 
NON_EMPTY_BEHAVIOR = { [GrossQuantitySI] }, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Book Inventory SI' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Transaction';     
