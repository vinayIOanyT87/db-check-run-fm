            <SQLTask:SqlTaskData
              SQLTask:Connection="{4F5AE697-7607-41BD-97E4-4208069BDC4B}"
              SQLTask:SqlStatementSource="INSERT INTO dbo.tblETLAudit&#xA;(Operation, ParentAuditKey , LoadDate , PkgName , PkgGUID , PkgVersionGUID , PkgVersionMajor , PkgVersionMinor , ExecStartDT , ProcessNote)&#xA;Values  ('ETL', @ParentAuditKey , @LoadDate , @PkgName , @PkgGUID , @PkgVersionGUID , @PkgVersionMajor , @PkgVersionMinor , GetDate() , @ProcessNote)&#xA;&#xA;-- Get the key we just entered.&#xA;SELECT cast(IDENT_CURRENT('dbo.tblETLAudit') AS bigint) AS AuditKey"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::BatchAuditKey" />
              <SQLTask:ParameterBinding
