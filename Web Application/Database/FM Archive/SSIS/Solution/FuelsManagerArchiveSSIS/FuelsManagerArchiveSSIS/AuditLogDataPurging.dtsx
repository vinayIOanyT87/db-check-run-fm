        <DTS:Executable
          DTS:refId="Package\Batch Processing\Open Batch Audit Record"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5a543e28-97af-42ba-9771-c850c41f8374}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
