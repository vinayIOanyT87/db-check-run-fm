          DTS:ObjectName="Open Batch Audit Record"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{4F5AE697-7607-41BD-97E4-4208069BDC4B}"
              SQLTask:SqlStatementSource="INSERT INTO dbo.tblETLAudit&#xA;(Operation, ParentAuditKey , PkgName , PkgGUID , PkgVersionGUID , PkgVersionMajor , PkgVersionMinor , ExecStartDT , ProcessNote)&#xA;Values  ('ETL', @ParentAuditKey , @PkgName , @PkgGUID , @PkgVersionGUID , @PkgVersionMajor , @PkgVersionMinor , GetDate() , @ProcessNote)&#xA;&#xA;-- Get the key we just entered.&#xA;SELECT cast(IDENT_CURRENT('dbo.tblETLAudit') AS bigint) AS AuditKey"
