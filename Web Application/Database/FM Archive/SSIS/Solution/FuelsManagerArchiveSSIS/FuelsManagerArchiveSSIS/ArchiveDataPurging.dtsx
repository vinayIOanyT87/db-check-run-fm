    <DTS:Executable
      DTS:refId="Package\Get Any Outstanding Records"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7592cfd3-7aba-42a7-89f4-fa6521fa0c08}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Get Any Outstanding Records"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BE2D1CF-4CEF-403E-AE67-AE8DF88C8196}"
          SQLTask:SqlStatementSource="SELECT COUNT(*) FROM &#xA;(&#xA;&#x9;SELECT 'AlarmAndEventLogScope' Scope, COUNT(*) RecordCount FROM archive.tblAlarmAndEventLogLastProcessedRecords&#xA;&#x9;WHERE IsProcessed &lt;&gt; 1&#xA;&#x9;UNION&#xA;&#x9;SELECT 'AuditLogScope' Scope, COUNT(*) RecordCount FROM archive.tblAuditLogLastProcessedRecords&#xA;&#x9;WHERE IsProcessed &lt;&gt; 1&#xA;&#x9;UNION&#xA;&#x9;SELECT 'TransactionScope' Scope, COUNT(*) RecordCount FROM archive.tblTransactionLastProcessedRecords&#xA;&#x9;WHERE IsProcessed &lt;&gt; 1&#xA;) x&#xA;WHERE RecordCount &gt; 0"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::OutstandingRecordCount" />
