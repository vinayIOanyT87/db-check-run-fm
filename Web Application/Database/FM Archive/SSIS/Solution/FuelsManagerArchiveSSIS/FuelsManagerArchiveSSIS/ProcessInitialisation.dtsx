        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BE2D1CF-4CEF-403E-AE67-AE8DF88C8196}"
          SQLTask:SqlStatementSource="EXEC [archive].[usp_DisableTriggersForOfflineArchiving]" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
