                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Site.Value+vbcrlf+
IIf(IsNothing(Fields!SiteCity.Value + Fields!SiteState.Value) OR Len(Fields!SiteCity.Value + Fields!SiteState.Value) = 0, 
