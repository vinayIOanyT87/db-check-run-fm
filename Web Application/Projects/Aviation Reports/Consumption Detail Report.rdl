  <Code>Public Function ManagedDate(ByVal i As Integer) As String
    Dim CurrentDate As Date
    CurrentDate = DateTime.Now
    Dim DateFormat As String

    If i &lt;= 1 Then
        DateFormat = "dd-MMM-yy"
    Else
        DateFormat = "MMMM yyyy"
    End If

    Select Case i
    Case 1  ' Previous Day
        Return CurrentDate.AddDays(-2).ToString(DateFormat)
    Case 2  ' Current Month
        Return New Date(CurrentDate.Year, CurrentDate.Month, 1).ToString(DateFormat)
    Case 3  ' Previous Month
        Return New Date(CurrentDate.Year, CurrentDate.Month, 1).AddMonths(-1).ToString(DateFormat)
    Case Else  ' 30 days
        Return CurrentDate.AddDays(-30).ToString(DateFormat) &amp; " through " &amp; CurrentDate.ToString(DateFormat)
    End Select
End Function
</Code>
