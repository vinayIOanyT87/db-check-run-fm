					<dataContractSerializer maxItemsInObjectGraph="2147483647" />
					<serviceTimeouts transactionTimeout="00:45:00" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
		<services>
			<!-- Note: the service name must match the configuration name for the service implementation. -->
			<service name="LedgerReportCalculator" behaviorConfiguration="FMBusinessServicesBehaviorReports">
				<!-- Add the following endpoint.  -->
				<!-- Note: your service must have an http base address to add this endpoint. -->
				<endpoint contract="IMetadataExchange" binding="mexHttpBinding" address="mex" />
				<endpoint address="" binding="basicHttpBinding" bindingConfiguration="" contract="FMBusinessServices.ServiceClasses.LedgerReportClasses.ILedgerReportCalculator" />
			</service>
		</services>
		<serviceHostingEnvironment configSource="ServiceHostingEnvironment.config" />
		<protocolMapping>
			<add scheme="http" binding="wsHttpBinding" bindingConfiguration="WsHttpBinding" />
			<add scheme="net.tcp" binding="netTcpBinding" bindingConfiguration="NetTcpBindingIIS" />
			<add binding="wsHttpBinding" bindingConfiguration="WsHttpsBinding" scheme="https" />
		</protocolMapping>
	</system.serviceModel>
	<system.webServer>
		<modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="false" />
		<handlers accessPolicy="Read, Script">
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
		<defaultDocument>
			<files>
				<clear />
				<add value="Default.asp" />
			</files>
		</defaultDocument>
		<httpErrors>
			<clear />
