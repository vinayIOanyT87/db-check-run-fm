      <service name="MockEBSService.Pull" behaviorConfiguration="MockEBSService.ServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" contract="MockEBSService.IPull">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
      </service>

      <service name="MockEBSService.RequestService" behaviorConfiguration="MockEBSService.ServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" contract="MockEBSService.IREQ_PortType">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
      </service>
      
    </services>
    
    <behaviors>
      <serviceBehaviors>
        
      <behavior name="MockEBSService.ServiceBehavior">
        <serviceMetadata httpGetEnabled="True"/>
        <serviceDebug includeExceptionDetailInFaults="False"/>
      </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/></startup></configuration>
