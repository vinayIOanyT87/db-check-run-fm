<?xml version="1.0" encoding="utf-8" ?>
<s0:InstalledApplication
  xmlns:s0="http://opcfoundation.org/UA/SDK/Installation.xsd"
  xmlns:s1="http://opcfoundation.org/UA/SDK/Configuration.xsd"
  xmlns="http://opcfoundation.org/UA/2011/03/SecuredApplication.xsd"
  xmlns:ua="http://opcfoundation.org/UA/2008/02/Types.xsd">

  <ApplicationName>Softing OPC UA .NET Node Management Client</ApplicationName>
  <ApplicationUri></ApplicationUri>
  <ApplicationType>Client_1</ApplicationType>
  <ConfigurationFile>NodeManagementClient.Config.xml</ConfigurationFile>

  <ApplicationCertificate>
    <StoreType>Directory</StoreType>
    <StorePath>%CommonApplicationData%\Softing\OpcUaNetToolkit\V1.27\src\Samples\Client\pki\own</StorePath>
  </ApplicationCertificate>
  <TrustedCertificateStore>
    <StoreType>Directory</StoreType>
    <StorePath>%CommonApplicationData%\Softing\OpcUaNetToolkit\V1.27\src\Samples\Client\pki\trusted</StorePath>
  </TrustedCertificateStore>
  <IssuerCertificateStore>
    <StoreType>Directory</StoreType>
    <StorePath>%CommonApplicationData%\Softing\OpcUaNetToolkit\V1.27\src\Samples\Client\pki\issuer</StorePath>
  </IssuerCertificateStore>

  <s0:DeleteCertificatesOnUninstall>true</s0:DeleteCertificatesOnUninstall>
  <s0:ConfigureFirewall>false</s0:ConfigureFirewall>
  <s0:SetConfigurationFilePermisions>false</s0:SetConfigurationFilePermisions>
  <s0:SetExecutableFilePermisions>false</s0:SetExecutableFilePermisions>
  <s0:InstallAsService>false</s0:InstallAsService>

	<s0:TraceConfiguration>
		<!-- Show StackTrace Core ServerSDK ClientSDK ConfigurationSDK -->
    <s1:TraceMasks>0x00FF00FF</s1:TraceMasks>
    <s1:Log4NetConfiguration>
			<log4net>
				<appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
					<file value="Logs\NodeManagementClient.txt" />
					<appendToFile value="true" />
					<maxSizeRollBackups value="5" />
					<maximumFileSize value="10MB" />
					<rollingStyle value="Size" />
					<staticLogFileName value="true" />
					<layout type="log4net.Layout.PatternLayout">
						<header value="[Header]&#13;&#10;" />
						<footer value="[Footer]&#13;&#10;" />
						<conversionPattern value="%date %thread %-5level - %message%newline" />
					</layout>
				</appender>
				<root>
					<level value="WARN" />
					<appender-ref ref="RollingLogFileAppender" />
				</root>
			</log4net>
		</s1:Log4NetConfiguration>
	</s0:TraceConfiguration>

</s0:InstalledApplication>
