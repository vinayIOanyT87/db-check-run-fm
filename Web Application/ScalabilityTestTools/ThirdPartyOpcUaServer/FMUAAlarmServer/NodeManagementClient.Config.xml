      <TrustedCertificates />
    </TrustedPeerCertificates>
    <NonceLength>32</NonceLength>
    <RejectedCertificateStore>
      <StoreType>Directory</StoreType>
      <StorePath>%CommonApplicationData%\Softing\OpcUaNetToolkit\V1.30\src\Samples\Client\pki\rejected</StorePath>
    </RejectedCertificateStore>
    <UserRoleDirectory i:nil="true" />
  </SecurityConfiguration>
  <TransportConfigurations />
  <TransportQuotas>
    <OperationTimeout>120000</OperationTimeout>
    <MaxStringLength>1048576</MaxStringLength>
    <MaxByteStringLength>4194304</MaxByteStringLength>
    <MaxArrayLength>65535</MaxArrayLength>
    <MaxMessageSize>4194304</MaxMessageSize>
    <MaxBufferSize>65535</MaxBufferSize>
    <ChannelLifetime>300000</ChannelLifetime>
    <SecurityTokenLifetime>3600000</SecurityTokenLifetime>
  </TransportQuotas>
  <ClientConfiguration>
    <DefaultSessionTimeout>600000</DefaultSessionTimeout>
    <WellKnownDiscoveryUrls xmlns:d3p1="http://opcfoundation.org/UA/2008/02/Types.xsd">
      <d3p1:String>opc.tcp://{0}:4840</d3p1:String>
      <d3p1:String>http://{0}:52601/UADiscovery</d3p1:String>
      <d3p1:String>http://{0}/UADiscovery/Default.svc</d3p1:String>
    </WellKnownDiscoveryUrls>
    <DiscoveryServers xmlns:d3p1="http://opcfoundation.org/UA/2008/02/Types.xsd" />
    <EndpointCacheFilePath>NodeManagementClient.Endpoints.xml</EndpointCacheFilePath>
    <MinSubscriptionLifetime>10000</MinSubscriptionLifetime>
    <DecodeCustomDataTypes>false</DecodeCustomDataTypes>
  </ClientConfiguration>
  <Extensions xmlns:d2p1="http://opcfoundation.org/UA/2008/02/Types.xsd" />
